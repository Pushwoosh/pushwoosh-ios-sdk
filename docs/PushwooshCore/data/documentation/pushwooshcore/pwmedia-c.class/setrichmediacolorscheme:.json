{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMedia-c.class"]]},"abstract":[{"type":"text","text":"Sets the color scheme reported to Rich Media content."}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["occ"],"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"text":") ","kind":"text"},{"kind":"identifier","text":"setRichMediaColorScheme:"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@E@PWRichMediaColorScheme","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRichMediaColorScheme","text":"PWRichMediaColorScheme"},{"text":") ","kind":"text"},{"text":"colorScheme","kind":"internalParam"},{"kind":"text","text":";"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The color scheme to use."}]}],"name":"colorScheme"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Rich Media content reads the scheme through the ","type":"text"},{"code":"prefers-color-scheme","type":"codeVoice"},{"text":" CSS media query.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The SDK never recolors content itself: a campaign without a dark variant stays light"},{"type":"text","text":" "},{"type":"text","text":"regardless of this setting."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PWRichMediaColorSchemeApp"},{"type":"text","text":" follows the interface style of your app UI (default)."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"PWRichMediaColorSchemeSystem"},{"text":" follows the device appearance setting, ignoring window- and","type":"text"},{"type":"text","text":" "},{"