te.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Legacy configuration applies when the presentation style is set to "},{"type":"codeVoice","code":".legacy"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The legacy presentation style displays Rich Media content in full-screen mode, similar to the original Pushwoosh Rich Media implementation.","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"inlineContent":[{"text":"Configure legacy Rich Media with delegate:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["func application(_ application: UIApplication,","                 didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    Pushwoosh.media.setRichMediaPresentationStyle(.legacy)","    Pushwoosh.media.legacyRichMedia.delegate = self","","    Pushwoosh.configure.registerForPushNotifications()","    return true","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Handle Rich Media lifecycle events:"}],"type":"paragraph"},{"code":["class AppDelegate: UIResponder, UIApplicationDelegate, PWRichMediaPresentingDelegate {","","    func application(_ application: UIApplication,","                     didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Pushwoosh.media.legacyRichMedia.delegate = self","        return true","    }","","    func richMediaManager(_ richMediaManager: PWRichMediaManager,","                          shouldPresent richMedia: PWRichMedia) -> Bool {","        return !userIsInCheckout","    }","","    func richMediaManager(_ richMediaManager: PWRichMediaManager,","                          didPresent richMedia: PWRichMedia) {","        Analytics.log(\"rich_media_shown\", payload: richMedia.pushPayload)","    }","","    func richMediaManager(_ richMediaManager: PWRichMediaManager,","                          didClose richMedia: PWRichMedia) {","        Analytics.log(\"rich_media_closed\", payload: richMedia.pushPayload)","    }","","    func richMediaManager(_ richMediaManager: PWRichMediaManager,","                          presentingDidFailFor richMedia: PWRichMedia,","                          withError error: Error) {","        Analytics.log(\"rich_media_failed\", error: error)","    }","}"],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWMedia-c.protocol":{"abstract":[{"text":"Protocol for configuring Rich Media presentation.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"PWMedia","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMedia-c.protocol","url":"\/documentation\/pushwooshcore\/pwmedia-c.protocol","fragments":[{"kind":"identifier","text":"PWMedia"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWMedia-c.protocol/modalRichMedia":{"abstract":[{"type":"text","text":"Provides access to modal Rich Media configuration."}],"role":"symbol","type":"topic","kind":"symbol","title":"modalRichMedia","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMedia-c.protocol\/modalRichMedia","navigatorTitle":[{"kind":"identifier","text":"modalRichMedia"}],"url":"\/documentation\/pushwooshcore\/pwmedia-c.protocol\/modalrichmedia","fragments":[{"text":"+ ","kind":"text"},{"text":"modalRichMedia","kind":"identifier"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWMedia-c.protocol/legacyRichMedia":{"abstract":[{"text":"Provides access to legacy Rich Media configuration.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"legacyRichMedia","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMedia-c.protocol\/legacyRichMedia","navigatorTitle":[{"kind":"identifier","text":"legacyRichMedia"}],"url":"\/documentation\/pushwooshcore\/pwmedia-c.