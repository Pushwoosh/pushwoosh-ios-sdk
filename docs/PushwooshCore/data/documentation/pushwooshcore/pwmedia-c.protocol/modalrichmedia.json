{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMedia-c.protocol"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"symbolKind":"method","externalID":"c:objc(pl)PWMedia(cm)modalRichMedia","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"modalRichMedia"}],"navigatorTitle":[{"kind":"identifier","text":"modalRichMedia"}],"title":"modalRichMedia","role":"symbol","modules":[{"name":"PushwooshCore"}],"roleHeading":"Type Method"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMedia-c.protocol\/legacyRichMedia"],"title":"Related Documentation"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMedia-c.protocol\/modalRichMedia"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:QOobjc(pl)PWModalRichMedia","text":"Class<PWModalRichMedia>","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"kind":"identifier","text":"modalRichMedia"},{"kind":"text","text":";"}],"platforms":["iOS"],"languages":["occ"]}]},{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this property to configure modal-specific settings such as window position, animations, haptic feedback, corner radius, and delegate."}],"type":"paragraph"},{"inlineContent":[{"text":"Modal configuration only applies when the presentation style is set to ","type":"text"},{"code":".modal","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Available configuration options:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Window position (top, center, bottom, bottom sheet, full screen)"}]}]},{"content":[{"inlineContent":[{"text":"Present and dismiss animations","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Swipe-to-dismiss directions","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Haptic feedback on presentation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Corner radius"}]}]},{"content":[{"inlineContent":[{"text":"Auto-dismiss timer","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Rich Media lifecycle delegate"}],"type":"paragraph"}]}]},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"type":"paragraph","inlineContent":[{"text":"Configure a bottom sheet modal with swipe-to-dismiss:","type":"text"}]},{"code":["func application(_ application: UIApplication,","                 didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    Pushwoosh.media.setRichMediaPresentationStyle(.modal)","","    Pushwoosh.media.modalRichMedia.configure(","        with: .PWModalWindowPositionBottom,","        present: .PWAnimationPresentSlideUp,","        dismiss: .PWAnimationDismissSlideDown","    )","","    Pushwoosh.media.modalRichMedia.setDismissSwipeDirections([","        NSNumber(value: DismissSwipeDirection.PWSwipeDismissDown.rawValue)","    ])","","    Pushwoosh.media.modalRichMedia.setCornerType([.PWCornerTypeTopLeft, .PWCornerTypeTopRight], withRadius: 16)","","    Pushwoosh.media.modalRichMedia.setHapticFeedbackType(.PWHapticFeedbackMedium)","    Pushwoosh.media.modalRichMedia.delegate = self","","    Pushwoosh.configure.registerForPushNotifications()","    return true","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Configure a centered popup with auto-dismiss:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func setupCenteredRichMedia() {","    Pushwoosh.media.setRichMediaPresentationStyle(.modal)","","    Pushwoosh.media.modalRichMedia.configure(","        with: .PWModalWindowPositionCenter,","        present: .PWAnimationPresentFadeIn,","        dismiss: .PWAnimationDismissFadeOut","    )","","    Pushwoosh.media.modalRichMedia.setCornerType(","        [.PWCornerTypeTopLeft, .PWCornerTypeTopRight, .PWCornerTypeBottomLeft, .PWCornerTypeBottomRight],","        withRadius: 12","    )","","    Pushwoosh.media.modalRichMedia.close(after: 10)","}"]},{"inlineContent":[{"type":"text","text":"Handle Rich Media lifecycle events:"}],"type":"paragraph"},{"code":["class AppDelegate: UIResponder, UIApplicationDelegate, PWRichMediaPresentingDelegate {","","    func application(_ application: UIApplication,","                     didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Pushwoosh.media.modalRichMedia.delegate = self","        return true","    }","","    func richMediaManager(_ richMediaManager: PWRichMediaManager,","                          shouldPresent richMedia: PWRichMedia) -> Bool {","        return !userIsInCheckout","    }","","    func richMediaManager(_ richMediaManager: PWRichMediaManager,","                          didPresent richMedia: PWRichMedia) {","        Analytics.log(\"rich_media_shown\", payload: richMedia.pushPayload)","    }","","    func richMediaManager(_ richMediaManager: PWRichMediaManager,","                          didClose richMedia: PWRichMedia) {","        Analytics.log(\"rich_media_closed\", payload: richMedia.pushPayload)","    }","","    func richMediaManager(_ richMediaManager: PWRichMediaManager,","                          presentingDidFailFor richMedia: PWRichMedia,","                          withError error: Error) {","        Analytics.log(\"rich_media_failed\", error: error)","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/pushwoo