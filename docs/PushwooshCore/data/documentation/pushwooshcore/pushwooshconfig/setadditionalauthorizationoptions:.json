pe":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionProvidesAppNotificationSettings"},{"text":" (iOS 12+) — Adds a “Configure in App” button","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to the system notification settings for your app. When tapped, iOS calls"},{"text":" ","type":"text"},{"code":"userNotificationCenter:openSettingsForNotification:","type":"codeVoice"},{"text":" on your ","type":"text"},{"code":"UNUserNotificationCenterDelegate","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig\/addNotificationCenterDelegate:"},{"type":"text","text":" to register your delegate and handle this callback."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionAnnouncement"},{"type":"text","text":" (iOS 13+) — Allows Siri to automatically read out notifications"},{"type":"text","text":" "},{"type":"text","text":"through AirPods and compatible headphones."}]}]}],"type":"unorderedList"},{"text":"Example — Provisional (Soft Opt-In)","anchor":"Example-Provisional-Soft-Opt-In","type":"heading","level":2},{"syntax":"swift","code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    if #available(iOS 12.0, *) {","        Pushwoosh.configure.setAdditionalAuthorizationOptions([.provisional])","    }","","    Pushwoosh.configure.registerForPushNotifications()","","    return true","}"],"type":"codeListing"},{"level":2,"text":"Example — In-App Notification Settings Button","type":"heading","anchor":"Example-In-App-Notification-Settings-Button"},{"code":["func application(_ application: UIApplication,","                didFinishLaunchin