{"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig\/setAdditionalAuthorizationOptions:","interfaceLanguage":"occ"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"text":"void","preciseIdentifier":"c:v","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"setAdditionalAuthorizationOptions:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UNAuthorizationOptions","kind":"typeIdentifier","preciseIdentifier":"c:@E@UNAuthorizationOptions"},{"kind":"text","text":") "},{"text":"options","kind":"internalParam"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The additional ","type":"text"},{"code":"UNAuthorizationOptions","type":"codeVoice"},{"type":"text","text":" to request."}],"type":"paragraph"}],"name":"options"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When calling "},{"type":"codeVoice","code":"registerForPushNotifications"},{"type":"text","text":", the SDK requests these permissions by default:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionBadge"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UNAuthorizationOptionSound","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"UNAuthorizationOptionAlert","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"UNAuthorizationOptionCarPlay","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to request additional capabilities on top of the defaults."},{"text":" ","type":"text"},{"text":"The options you set here are combined (bitwise OR) with the default options","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"before being passed to "},{"type":"codeVoice","code":"UNUserNotificationCenter.requestAuthorizationWithOptions:"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"text","text":"Must be called "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" "},{"code":"registerForPushNotifications","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Available-Options","level":2,"text":"Available Options","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionProvisional"},{"type":"text","text":" (iOS 12+) — Delivers notifications quietly to the Notification Center"},{"type":"text","text":" "},{"type":"text","text":"without showing a permission dialog. The user sees notifications silently and can then choose to keep or disable them."},{"type":"text","text":" "},{"text":"Use this for a “soft opt-in” strategy to avoid users declining the permission prompt upfront.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"UNAuthorizationOptionCriticalAlert","type":"codeVoice"},{"text":" (iOS 12+) — Allows notifications that bypass Do Not Disturb and the mute switch.","type":"text"},{"text":" ","type":"text"},{"text":"Requires a special entitlement from Apple (must be approved via Apple Developer portal).","type":"text"},{"type":"text","text":" "},{"text":"Intended for medical, health, safety, and public security apps.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionProvidesAppNotificationSettings"},{"text":" (iOS 12+) — Adds a “Configure in App” button","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to the system notification settings for your app. When tapped, iOS calls"},{"type":"text","text":" "},{"type":"codeVoice","code":"userNotificationCenter:openSettingsForNotification:"},{"type":"text","text":" on your "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig\/addNotificationCenterDelegate:","isActive":true,"type":"reference"},{"type":"text","text":" to register your delegate and handle this callback."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UNAuthorizationOptionAnnouncement","type":"codeVoice"},{"type":"text","text":" (iOS 13+) — Allows Siri to automatically read out notifications"},{"type":"text","text":" "},{"type":"text","text":"through AirPods and compatible headphones."}]}]}],"type":"unorderedList"},{"type":"heading","text":"Example — Provisional (Soft Opt-In)","anchor":"Example-Provisional-Soft-Opt-In","level":2},{"syntax":"swift","code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    if #available(iOS 12.0, *) {","        Pushwoosh.configure.setAdditionalAuthorizationOptions([.provisional])","    }","","    Pushwoosh.configure.registerForPushNotifications()","","    return true","}"],"type":"codeListing"},{"text":"Example — In-App Notification Settings Button","anchor":"Example-In-App-Notification-Settings-Button","level":2,"type":"heading"},{"code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    if #available(iOS 12.0, *) {","        Pushwoosh.configure.setAdditionalAuthorizationOptions([.providesAppNotificationSettings])","    }","","    Pushwoosh.configure.addNotificationCenterDelegate(self)","    Pushwoosh.configure.registerForPushNotifications()","","    return true","}","","\/\/ Called when user taps \"Configure in App\" in system notification settings","func userNotificationCenter(_ center: UNUserNotificationCenter,","                            openSettingsFor notification: UNNotification?) {","    \/\/ Navigate to your in-app notification settings screen","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Example-Combining-Multiple-Options","text":"Example — Combining Multiple Options","type":"heading"},{"code":["if #available(iOS 12.0, *) {","    Pushwoosh.configure.setAdditionalAuthorizationOptions([.provisional, .providesAppNotificationSettings])","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Objective-C:","type":"text"}]},{"code":["if (@available(iOS 12.0, *)) {","    [Pushwoosh.configure setAdditionalAuthorizationOptions:UNAuthorizationOptionProvisional | UNAuthorizationOptionProvidesAppNotificationSettings];","}","","[Pushwoosh.configure registerForPushNotifications];"],"syntax":"objc","type":"codeListing"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig"]]},"metadata":{"roleHeading":"Type Method","fragments":[{"kind":"text","text":"+ "},{"text":"setAdditionalAuthorizationOptions:","kind":"identifier"}],"externalID":"c:objc(cs)PushwooshConfig(cm)setAdditionalAuthorizationOptions:","symbolKind":"method","modules":[{"name":"PushwooshCore"}],"title":"setAdditionalAuthorizationOptions:","navigatorTitle":[{"text":"setAdditionalAuthorizationOptions:","kind":"identifier"}],"role":"symbol"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pushwooshconfig\/setadditionalauthorizationoptions:"]}],"abstract":[{"text":"Sets additional notification authorization options beyond the SDK defaults.","type":"text"}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PushwooshConfig":{"role":"symbol","abstract"