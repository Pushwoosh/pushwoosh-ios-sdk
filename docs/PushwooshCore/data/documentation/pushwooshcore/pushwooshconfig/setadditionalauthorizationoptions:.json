{"kind":"symbol","identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig\/setAdditionalAuthorizationOptions:","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"Sets additional notification authorization options beyond the SDK defaults."}],"variants":[{"paths":["\/documentation\/pushwooshcore\/pushwooshconfig\/setadditionalauthorizationoptions:"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Type Method","navigatorTitle":[{"kind":"identifier","text":"setAdditionalAuthorizationOptions:"}],"modules":[{"name":"PushwooshCore"}],"title":"setAdditionalAuthorizationOptions:","role":"symbol","symbolKind":"method","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"setAdditionalAuthorizationOptions:"}],"externalID":"c:objc(cs)PushwooshConfig(cm)setAdditionalAuthorizationOptions:"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"text","text":"+ ("},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"identifier","text":"setAdditionalAuthorizationOptions:"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"UNAuthorizationOptions","preciseIdentifier":"c:@E@UNAuthorizationOptions"},{"text":") ","kind":"text"},{"text":"options","kind":"internalParam"},{"kind":"text","text":";"}],"platforms":["iOS"],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"name":"options","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The additional "},{"type":"codeVoice","code":"UNAuthorizationOptions"},{"text":" to request.","type":"text"}]}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"When calling ","type":"text"},{"code":"registerForPushNotifications","type":"codeVoice"},{"type":"text","text":", the SDK requests these permissions by default:"}]},{"items":[{"content":[{"inlineContent":[{"code":"UNAuthorizationOptionBadge","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionSound"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionAlert"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionCarPlay"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to request additional capabilities on top of the defaults."},{"text":" ","type":"text"},{"type":"text","text":"The options you set here are combined (bitwise OR) with the default options"},{"text":" ","type":"text"},{"type":"text","text":"before being passed to "},{"type":"codeVoice","code":"UNUserNotificationCenter.requestAuthorizationWithOptions:"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Must be called "},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"type":"text","text":" "},{"code":"registerForPushNotifications","type":"codeVoice"},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Available Options","anchor":"Available-Options"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"UNAuthorizationOptionProvisional","type":"codeVoice"},{"text":" (iOS 12+) — Delivers notifications quietly to the Notification Center","type":"text"},{"text":" ","type":"text"},{"text":"without showing a permission dialog. The user sees notifications silently and can then choose to keep or disable them.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Use this for a “soft opt-in” strategy to avoid users declining the permission prompt upfront."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionCriticalAlert"},{"type":"text","text":" (iOS 12+) — Allows notifications that bypass Do Not Disturb and the mute switch."},{"text":" ","type":"text"},{"type":"text","text":"Requires a special entitlement from Apple (must be approved via Apple Developer portal)."},{"type":"text","text":" "},{"type":"text","text":"Intended for medical, health, safety, and public security apps."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionProvidesAppNotificationSettings"},{"type":"text","text":" (iOS 12+) — Adds a “Configure in App” button"},{"text":" ","type":"text"},{"type":"text","text":"to the system notification settings for your app. When tapped, iOS calls"},{"type":"text","text":" "},{"code":"userNotificationCenter:openSettingsForNotification:","type":"codeVoice"},{"text":" on your ","type":"text"},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig\/addNotificationCenterDelegate:","isActive":true,"type":"reference"},{"type":"text","text":" to register your delegate and handle this callback."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionAnnouncement"},{"type":"text","text":" (iOS 13+) — Allows Siri to automatically read out notifications"},{"text":" ","type":"text"},{"type":"text","text":"through AirPods and compatible headphones."}]}]}]},{"anchor":"Example-Provisional-Soft-Opt-In","type":"heading","text":"Example — Provisional (Soft Opt-In)","level":2},{"type":"codeListing","code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    if #available(iOS 12.0, *) {","        Pushwoosh.configure.setAdditionalAuthorizationOptions([.provisional])","    }","","    Pushwoosh.configure.registerForPushNotifications()","","    return true","}"],"syntax":"swift"},{"type":"heading","text":"Example — In-App Notification Settings Button","level":2,"anchor":"Example-In-App-Notification-Settings-Button"},{"type":"codeListing","syntax":"swift","code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    if #available(iOS 12.0, *) {","        Pushwoosh.configure.setAdditionalAuthorizationOptions([.providesAppNotificationSettings])","    }","","    Pushwoosh.configure.addNotificationCenterDelegate(self)","    Pushwoosh.configure.registerForPushNotifications()","","    return true","}","","\/\/ Called when user taps \"Configure in App\" in system notification settings","func userNotificationCenter(_ center: UNUserNotificationCenter,","                            openSettingsFor notification: UNNotification?) {","    \/\/ Navigate to your in-app notification settings screen","}"]},{"type":"heading","anchor":"Example-Combining-Multiple-Options","level":2,"text":"Example — Combining Multiple Options"},{"code":["if #available(iOS 12.0, *) {","    Pushwoosh.configure.setAdditionalAuthorizationOptions([.provisional, .providesAppNotificationSettings])","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Objective-C:","type":"text"}],"type":"paragraph"},{"syntax":"objc","code":["if (@available(iOS 12.0, *)) {","    [Pushwoosh.configure setAdditionalAuthorizationOptions:UNAuthorizationOptionProvisional | UNAuthorizationOptionProvidesAppNotificationSettings];","}","","[Pushwoosh.configure registerForPushNotifications];"],"type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig"]]},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PushwooshConfig/addNotificationCenterDelegat