{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig"]]},"kind":"symbol","metadata":{"roleHeading":"Type Method","symbolKind":"method","role":"symbol","title":"getLaunchNotification","navigatorTitle":[{"kind":"identifier","text":"getLaunchNotification"}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"getLaunchNotification"}],"externalID":"c:objc(cs)PushwooshConfig(cm)getLaunchNotification","modules":[{"name":"PushwooshCore"}]},"sections":[],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig\/getLaunchNotification","interfaceLanguage":"occ"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["occ"],"tokens":[{"kind":"text","text":"+ ("},{"text":"NSDictionary","preciseIdentifier":"c:objc(cs)NSDictionary","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"kind":"identifier","text":"getLaunchNotification"},{"text":";","kind":"text"}]}],"kind":"declarations"},{"content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The push notification payload dictionary, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the app was not launched from a push notification."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Use this method to retrieve the notification data that caused the app to launch from a terminated state."},{"type":"text","text":" "},{"text":"This is useful for handling deep links or navigation based on the push content.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The value is set when the app is cold-started by tapping a push notification and remains available","type":"text"},{"type":"text","text":" "},{"text":"for the lifetime of the process. If the app was already running (foreground or background),","type":"text"},{"type":"text","text":" "},{"text":"the value is ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" — use "},{"type":"codeVoice","code":"PWMessagingDelegate"},{"type":"text","text":" callbacks instead."}]},{"inlineContent":[{"type":"text","text":"Must be called "},{"type":"strong","inlineContent":[{"type":"text","text":"after"}]},{"text":" the SDK has finished initialization (e.g., in ","type":"text"},{"type":"codeVoice","code":"applicationDidBecomeActive:"},{"type":"text","text":" or later)."}],"type":"paragraph"},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"type":"codeListing","code":["func applicationDidBecomeActive(_ application: UIApplication) {","    if let launchNotification = Pushwoosh.configure.getLaunchNotification() {","        print(\"App launched from push: \\(launchNotification)\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Objective-C:"}]},{"syntax":"objc","code":["- (void)applicationDidBecomeActive:(UIApplication *)application {","    NSDictionary *launchNotification = [Pushwoosh.configure getLaunchNotification];","    if (launchNotification) {","        NSLog(@\"App launched from push: %@\", launchNotification);","    }","}"],"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/pushwooshcore\/pushwooshconfig\/getlaunchnotification"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"Returns push notification payload if the app was started in response to a push notification, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" otherwise."}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"abstract":[{"text":"Core foundation module for Pushwoosh SDK.","type":"text"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","title":"PushwooshCore","url":"\/documentation\/pushwooshcore","role":"collection","kind":"symbol","type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PushwooshConfig":{"type":"topic","kind":"symbol","abstract":[{"text":"Configuration interface for Pushwoosh SDK.","type":"text"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig","fragments":[{"kind":"identifier","text":"PushwooshConfig"}],"url":"\/documentation\/pushwooshcore\/pushwooshconfig","role":"symbol","title":"PushwooshConfig"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PushwooshConfig/getLaunchNotification":{"url":"\/documentation\/pushwooshcore\/pushwooshconfig\/getlaunchnotification","role":"symbol","fragments":[{"kind":"text","text":"+ "},{"text":"getLaunchNotification","kind":"identifier"}],"abstract":[{"type":"text","text":"Returns push notification payload if the app was started in response to a push notification, or "},{"type":"codeVoice","code":"nil"},{"text":" otherwise.","type":"text"}],"title":"getLaunchNotification","kind":"symbol","navigatorTitle":[{"text":"getLaunchNotification","kind":"identifier"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig\/getLaunchNotification","type":"topic"}}}