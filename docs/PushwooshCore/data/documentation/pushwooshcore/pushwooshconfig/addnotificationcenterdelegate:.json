 own "},{"code":"UNUserNotificationCenterDelegate","type":"codeVoice"},{"type":"text","text":" alongside Pushwoosh’s built-in delegate."},{"type":"text","text":" "},{"text":"Pushwoosh uses a delegate proxy to forward notification center callbacks to all registered delegates,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"enabling multiple components to respond to notification events without conflicts."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is the recommended way to handle notification center events when using Pushwoosh SDK 7.0+,"},{"type":"text","text":" "},{"type":"text","text":"as it avoids conflicts with Pushwoosh’s own notification handling."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Typical use cases:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Integrating multiple push notification SDKs","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Adding custom notification handling logic (e.g., analytics, local notifications)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementing custom notification actions"}]}]}]},{"type":"heading","level":2,"text":"Examples","anchor":"Examples"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register AppDelegate as a notification delegate:"}]},{"type":"codeListing","code":["func application(_ application: UIApplication,","                 didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","    Pushwoosh.configure.addNotificationCenterDelegate(self)","    return true","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Register a dedicated notification handler:"}],"type":"paragraph"},{"code":["class NotificationHandler: NSObject, UNUserNotificationCenterDelegate {","","    func userNotificationCenter(_ center: UNUserNotificationCenter,","                                willPresent notification: UNNotification,","                                withCompletionHandler completionHandler: @escaping (UNNotificationPresentationOptions) -> Void) {","        if !PWMessage.isPushwooshMessage(notification.request.content.userInfo) {","            completionHandler([.banner, .sound])","        }","    }","","    func userNotificationCenter(_ center: UNUserNotificationCenter,","                                didReceive response: UNNotificationResponse,","                                withCompletionHandler completionHandler: @escaping () -> Void) {","        if !PWMessage.isPushwooshMessage(response.notification.request.content.userInfo) {","            \/\/ Handle your custom notification","            completionHandler()","        }","    }","}","","let handler = NotificationHandler()","Pushwoosh.configure.addNotificationCenterDelegate(handler)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Objective-C:"}],"type":"paragraph"},{"code":["[Pushwoosh.configure addNotificationCenterDelegate:self];"],"syntax":"objc","type":"codeListing"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMessage\/isPushwooshMessage:","isActive":true,"type":"reference"},{"type":"text","text":" to distinguish Pushwoosh notifications from your own and handle only non-Pushwoosh notifications in your custom delegate."}],"type":"paragraph"}]}]}],"abstract":[{"type":"text","text":"Adds a custom "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" to the Pushwoosh notification center delegate proxy."}],"sections":[],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"kind":"symbol","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"type":"topic","title":"PushwooshCore","role":"collection","ur