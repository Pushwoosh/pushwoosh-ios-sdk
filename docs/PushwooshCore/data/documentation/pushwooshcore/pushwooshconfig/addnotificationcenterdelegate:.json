{"metadata":{"modules":[{"name":"PushwooshCore"}],"externalID":"c:objc(cs)PushwooshConfig(cm)addNotificationCenterDelegate:","symbolKind":"method","role":"symbol","roleHeading":"Type Method","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"addNotificationCenterDelegate:"}],"navigatorTitle":[{"text":"addNotificationCenterDelegate:","kind":"identifier"}],"title":"addNotificationCenterDelegate:"},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/pushwooshcore\/pushwooshconfig\/addnotificationcenterdelegate:"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Adds a custom ","type":"text"},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" to the Pushwoosh notification center delegate proxy."}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PushwooshConfig\/addNotificationCenterDelegate:","interfaceLanguage":"occ"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"kind":"identifier","text":"addNotificationCenterDelegate:"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:Qoobjc(pl)UNUserNotificationCenterDelegate","kind":"typeIdentifier","text":"id<UNUserNotificationCenterDelegate>"},{"kind":"text","text":") "},{"kind":"internalParam","text":"delegate"},{"text":";","kind":"text"}],"languages":["occ"]}]},{"parameters":[{"name":"delegate","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The delegate object that conforms to "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"text":" protocol. Must not be nil.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to register your own "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" alongside Pushwoosh’s built-in delegate."},{"type":"text","text":" "},{"text":"Pushwoosh uses a delegate proxy to forward notification center callbacks to all registered delegates,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"enabling multiple components to respond to notification events without conflicts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the recommended way to handle notification center events when using Pushwoosh SDK 7.0+,"},{"text":" ","type":"text"},{"text":"as it avoids conflicts with Pushwoosh’s own notification handling.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Typical use cases:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Integrating multiple push notification SDKs","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Adding custom notification handling logic (e.g., analytics, local notifications)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementing custom notification actions"}]}]}]},{"level":2,"anchor":"Examples","text":"Examples","type":"heading"},{"inlineContent":[{"type":"text","text":"Register AppDelegate as a notification delegate:"}],"type":"paragraph"},{"type":"codeListing","code":["func application(_ application: UIApplication,","                 didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","    Pushwoosh.configure.addNotificationCenterDelegate(self)","    return true","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Register a dedicated notification handler:","type":"text"}]},{"code":["class NotificationHandler: NSObject, UNUserNotificationCenterDelegate {","","    func userNotificationCenter(_ center: UNUserNotificationCenter,","                                willPresent notification: UNNotification,","                                withCompletionHandler completionHandler: @escaping (UNNotificationPresentationOptions) -> Void) {","        if !PWMessage.isPushwooshMessage(notification.request.content.userInfo) {","            completionHandler([.banner, .sound])","        }","    }","","    func userNotificationCenter(_ center: UNUserNotificationCenter,","                                didReceive response: UNNotificationResponse,","                                withCompletionHandler completionHandler: @escaping () -> Void) {","        if !PWMessage.isPushwooshMessage(response.notification.request.content.userInfo) {","            \/\/ Handle your custom notification","            completionHandler()","        }","    }","}","","let handler = NotificationHandler()","Pushwoosh.configure.addNotificationCenterDelegate(handler)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Objective-C:","type":"text"}]},{"syntax":"objc","type":"codeListing","code":["[Pushwoosh.configure addNotificationCenterDelegate:self];"]},{"type":"aside","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMessage\/isPushwooshMessage:"},{"type":"text","text":" to distinguish Pushwoosh notifications from your own and handle only non-Pushwoosh notifications in your custom delegate."}],"type":"paragraph"}],"style":"note","name":"Note"}]}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PushwooshConfig":{"type":"topic","kind":"symbol","abstract":[{"text":"Configuration interface for Pushwoosh SDK.","type":"text"}],"identifier":"doc:\/\/com.push