{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"requestIdentifier"}],"roleHeading":"Instance Method","role":"symbol","title":"requestIdentifier","externalID":"c:objc(cs)PWRequest(im)requestIdentifier","modules":[{"name":"PushwooshCore"}],"fragments":[{"text":"- ","kind":"text"},{"text":"requestIdentifier","kind":"identifier"}],"symbolKind":"method"},"sections":[],"abstract":[{"text":"Stable, unique-per-instance identifier used as the dedup \/ retry-tracking key","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in the offline retry queue."}],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwrequest\/requestidentifier"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"text":"- (","kind":"text"},{"text":"NSString","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString"},{"kind":"text","text":" *) "},{"kind":"identifier","text":"requestIdentifier"},{"text":";","kind":"text"}],"platforms":["iOS"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Lazily generated as a UUID on first access and snapshotted into ","type":"text"},{"code":"PWRetryEntry","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"so it survives archiving and app relaunches. It replaces the previous","type":"text"},{"type":"text","text":" "},{"code":"self.hash","type":"codeVoice"},{"type":"text","text":" derivation, which was the object pointer address — unstable and"},{"type":"text","text":" "},{"text":"prone to collisions between distinct requests once a freed address was reused.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Kept as a readonly method on the public surface (identical to the released"},{"type":"text","text":" "},{"type":"text","text":"API, so the Sw