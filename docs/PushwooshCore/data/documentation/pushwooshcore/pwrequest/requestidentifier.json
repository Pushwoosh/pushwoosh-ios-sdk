{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRequest\/requestIdentifier"},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRequest"]]},"metadata":{"title":"requestIdentifier","symbolKind":"method","externalID":"c:objc(cs)PWRequest(im)requestIdentifier","roleHeading":"Instance Method","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"requestIdentifier"}],"navigatorTitle":[{"text":"requestIdentifier","kind":"identifier"}],"role":"symbol","modules":[{"name":"PushwooshCore"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"- (","kind":"text"},{"kind":"typeIdentifier","text":"NSString","preciseIdentifier":"c:objc(cs)NSString"},{"text":" *) ","kind":"text"},{"kind":"identifier","text":"requestIdentifier"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lazily generated as a UUID on first access and snapshotted into "},{"type":"codeVoice","code":"PWRetryEntry"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"so it survives archiving and app relaunches. It replaces the previous","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"self.hash"},{"type":"text","text":" derivation, which was the object pointer address — unstable and"},{"text":" ","type":"text"},{"type":"text","text":"prone to collisions between distinct requests once a freed address was reused."}]},{"inlineContent":[{"type":"text","text":"Kept as a readonly method on the public surface (identical to the released"},{"type":"text","text":" "},{"text":"API, so the Swift bridge shape is unchanged) — the internal setter lives in","type":"text"},{"type":"text","text":" "},{"text":"a private category, used only when snapshotting a request for retry.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Stable, unique-per-instance identifier used as the dedup \/ retry-tracking key"},{"type":"text","text":" "},{"type":"text","text":"in the offline retry queue."}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwrequest\/requestidentifier"]}],"kind":"symbol","sections":[],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWRequest":{"kind":"symbol","fragments":[{"text":"PWRequest","kind":"identifier"}],"type":"topic","abstract":[],"title":"PWRequest","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRequest","url":"\/documentation\/pushwooshcore\/pwrequest","role":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWRequest/requestIdentifier":{"navigatorTitle":[{"kind":"identifier","text":"requestIdentifier"}],"fragments":[{"text":"- ","kind":"text"},{"text":"requestIdentifier","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRequest\/requestIdentifier","title":"requestIdentifier","type":"topic","kind":"symbol","url":"\/documentation\/pushwooshcore\/pwrequest\/requestidentifier","abstract":[{"type":"text","text":"Stable, unique-per-instance identifier used as the dedup \/ retry-tracking key"},{"type":"text","text":" "},{"text":"in the offline retry queue.","type":"text"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"title":"PushwooshCore","url":"\/documentation\/pushwooshcore","type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","kind":"symbol","abstract":[{"text":"Core foundation module for Pushwoosh SDK.","type":"text"}],"role":"collection"}}}