{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRequest\/requestIdentifier"},"metadata":{"externalID":"c:objc(cs)PWRequest(im)requestIdentifier","symbolKind":"method","modules":[{"name":"PushwooshCore"}],"title":"requestIdentifier","role":"symbol","roleHeading":"Instance Method","fragments":[{"text":"- ","kind":"text"},{"kind":"identifier","text":"requestIdentifier"}],"navigatorTitle":[{"text":"requestIdentifier","kind":"identifier"}]},"kind":"symbol","variants":[{"paths":["\/documentation\/pushwooshcore\/pwrequest\/requestidentifier"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRequest"]]},"abstract":[{"text":"Stable, unique-per-instance identifier used as the dedup \/ retry-tracking key","type":"text"},{"text":" ","type":"text"},{"text":"in the offline retry queue.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"- (","kind":"text"},{"kind":"typeIdentifier","text":"NSString","preciseIdentifier":"c:objc(cs)NSString"},{"text":" *) ","kind":"text"},{"text":"requestIdentifier","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS"],"languages":["occ"]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Lazily generated as a UUID on first access and snapshotted into "},{"code":"PWRetryEntry","type":"codeVoice"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"so it survives archiving and app relaunches. It replaces the previous"},{"type":"text","text":" "},{"type":"codeVoice","code":"self.hash"},{"type":"text","text":" derivation, which was the object pointer address — unstable and"},{"type":"text","text":" "},{"text":"prone to collisions between distinct requests once a freed address was reused.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Kept as a readonly method on the public surface (identical to the released"},{"text":" ","type":"text"},{"text":"API, so the Swift bridge shape is unchanged) — the internal setter lives in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a private category, used only when snapshotting a request for retry."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore","type":"topic","title":"PushwooshCore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","kind":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWRequest":{"title":"PWRequest","role":"symbol","kind":"symbol","fragments":[{"kind":"identifier","text":"PWRequest"}],"url":"\/documentation\/pushwooshcore\/pwrequest","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRequest","abstract":[],"type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWRequest/requestIdentifier":{"url":"\/documentation\/pushwooshcore\/pwrequest\/requestidentifier","abstract":[{"text":"Stable, unique-per-instance identifier used as the dedup \/ retry-tracking key","type":"text"},{"type":"text","text":" "},{"text":"in the offline retry queue.","type":"text"}],"fragments":[{"text":"- ","kind":"text"},{"text":"requestIdentifier","kind":"identifier"}],"title":"requestIdentifier","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRequest\/requestIdentifier","role":"symbol","navigatorTitle":[{"text":"requestIdentifier","kind":"identifier"}],"type":"topic","kind":"symbol"}}}