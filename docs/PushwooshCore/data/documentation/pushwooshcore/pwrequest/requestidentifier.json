":"text"},{"type":"text","text":"prone to collisions between distinct requests once a freed address was reused."}]},{"inlineContent":[{"type":"text","text":"Kept as a readonly method on the public surface (identical to the released"},{"text":" ","type":"text"},{"text":"API, so the Swift bridge shape is unchanged) — the internal setter lives in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a private category, used only when snapshotting a request for retry."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWRequest/requestIdentifier":{"navigatorTitle":[{"kind":"identifier","text":"requestIdentifier"}],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRequest\/requestIdentifier","type":"topic","role":"symbol","fragments":[{"kind":"text","text":"- "},{"text":"requestIdentifier","kind":"identifier"}],"title":"requestIdentifier","abstract":[{"type":"text","text":"Stable, unique-per-instance identifier used as the dedup \/ retry-tracking key"},{"type":"text","text":" "},{"text":"in the offline retry queue.","type":"text"}],"url":"\/documentation\/pushwooshcore\/pwrequest\/requestidentifier"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWRequest":{"fragments":[{"text":"PWRequest","kind":"identifier"}],"url":"\/documentation\/pushwooshcore\/pwrequest","kind":"symbol","abstract":[],"role":"symbol","title":"PWRequest","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRequest","type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"kind":"symbol","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"type":"topic","title":"PushwooshCore","role":"collection","url":"\/documentation\/pushwooshcore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore"}}}