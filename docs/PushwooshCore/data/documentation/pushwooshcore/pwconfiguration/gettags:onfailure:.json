"text":" ","type":"text"},{"type":"text","text":"Receives a dictionary containing all device tags, or nil if no tags are set."}]}]},{"name":"errorHandler","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Block called if the request fails."},{"text":" ","type":"text"},{"type":"text","text":"Receives an NSError describing the failure."}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Alternative method name for ","type":"text"},{"type":"codeVoice","code":"loadTags:error:"},{"type":"text","text":" following common SDK naming conventions."},{"type":"text","text":" "},{"text":"Fetches all tags currently associated with this device from the Pushwoosh server.","type":"text"}]},{"type":"heading","anchor":"Example","text":"Example","level":2},{"type":"paragraph","inlineContent":[{"text":"Verify tag updates were applied:","type":"text"}]},{"code":["class TagVerificationService {","","    func verifyTagsApplied(expectedTags: [String: Any],","                          completion: @escaping (Bool) -> Void) {","","        Pushwoosh.configure.getTags({ tags in","            guard let serverTags = tags else {","                completion(false)","                return","            }","","            let allMatch = expectedTags.allSatisfy { key, expectedValue in","                guard let serverValue = serverTags[key] else { return false }","","                if let expected = expectedValue as? String,","                   let server = serverValue as? String {","                    return expected == server","                }","                if let expected = expectedValue as? NSNumber,","                   let server = serverValue as? NSNumber {","                    return expected == server","                }","                return false","            }","","            completion(allMatch)","","        }, onFailure: { error in","            Logger.error(\"Tag verification failed: \\(error?.localizedDescription ?? \"Unknown\")\")","            completion(false)","        })","    }","}"],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/getTags:onFailure:":{"role":"symbol","abstract":[{"type":"text","text":"Retrieves the current device’s tags from the Pushwoosh server."}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getTags:onFailure:","fragments":[{"text":"+ ","kind":"text"},{"text":"getTags:onFailure:","kind":"identifier"}],"navigatorTitle":[{"text":"getTags:onFailure:","kind":"identifier"}],"title":"getTags:onFailure:","type":"topic","url":"\/documentation\/pushwooshcore\/pwconfiguration\/gettags:onfailure:","kind":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"abstract":[],"type":"topic","url":"\/documentation\/pushwooshcore\/pwconfiguration","kind":"symbol","role":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","kind":"symbol","title":"PushwooshCore","url":"\/documentation\/pushwooshcore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"type":"topic","role":"collection"}}}