"type":"text","text":" "},{"text":"Receives a dictionary containing all device tags, or nil if no tags are set.","type":"text"}]}]},{"name":"errorHandler","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Block called if the request fails."},{"text":" ","type":"text"},{"type":"text","text":"Receives an NSError describing the failure."}]}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Alternative method name for ","type":"text"},{"code":"loadTags:error:","type":"codeVoice"},{"type":"text","text":" following common SDK naming conventions."},{"type":"text","text":" "},{"text":"Fetches all tags currently associated with this device from the Pushwoosh server.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Example","level":2,"anchor":"Example"},{"inlineContent":[{"type":"text","text":"Verify tag updates were applied:"}],"type":"paragraph"},{"code":["class TagVerificationService {","","    func verifyTagsApplied(expectedTags: [String: Any],","                          completion: @escaping (Bool) -> Void) {","","        Pushwoosh.configure.getTags({ tags in","            guard let serverTags = tags else {","                completion(false)","                return","            }","","            let allMatch = expectedTags.allSatisfy { key, expectedValue in","                guard let serverValue = serverTags[key] else { return false }","","                if let expected = expectedValue as? String,","                   let server = serverValue as? String {","                    return expected == server","                }","                if let expected = expectedValue as? NSNumber,","                   let server = serverValue as? NSNumber {","                    return expected == server","                }","                return false","            }","","            completion(allMatch)","","        }, onFailure: { error in","            Logger.error(\"Tag verification failed: \\(error?.localizedDescription ?? \"Unknown\")\")","            completion(false)","        })","    }","}"],"syntax":"swift","type":"codeListing"}]}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"url":"\/documentation\/pushwooshcore","role":"collection","kind":"symbol","type":"topic","title":"PushwooshCore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","abstract":[],"url":"\/documentation\/pushwooshcore\/pwconfiguration","role":"symbol","kind":"symbol","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/getTags:onFailure:":{"title":"getTags:onFailure:","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getTags:onFailure:","abstract":[{"type":"text","text":"Retrieves the current device’s tags from the Pushwoosh server."}],"type":"topic","fragments":[{"kind":"text","text":"+ "},{"text":"getTags:onFailure:","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"getTags:onFailure:"}],"kind":"symbol","role":"symbol","url":"\/documentation\/pushwooshcore\/pwconfiguration\/gettags:onfailure:"}}}