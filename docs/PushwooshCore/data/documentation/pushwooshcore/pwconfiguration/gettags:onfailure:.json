{"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/gettags:onfailure:"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"getTags:onFailure:","roleHeading":"Type Method","externalID":"c:objc(pl)PWConfiguration(cm)getTags:onFailure:","modules":[{"name":"PushwooshCore"}],"symbolKind":"method","role":"symbol","navigatorTitle":[{"text":"getTags:onFailure:","kind":"identifier"}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"getTags:onFailure:"}]},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"getTags:","kind":"identifier"},{"kind":"text","text":"("},{"text":"void (^)(NSDictionary *)","preciseIdentifier":"c:BFv(#*$objc(cs)NSDictionary)","kind":"typeIdentifier"},{"kind":"text","text":") "},{"text":"successHandler","kind":"internalParam"},{"kind":"text","text":" "},{"text":"onFailure:","kind":"identifier"},{"kind":"text","text":"("},{"text":"void (^)(NSError *)","kind":"typeIdentifier","preciseIdentifier":"c:BFv(#*$objc(cs)NSError)"},{"kind":"text","text":") "},{"kind":"internalParam","text":"errorHandler"},{"text":";","kind":"text"}],"languages":["occ"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Block called when tags are successfully retrieved.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Receives a dictionary containing all device tags, or nil if no tags are set."}]}],"name":"successHandler"},{"content":[{"inlineContent":[{"type":"text","text":"Block called if the request fails."},{"type":"text","text":" "},{"text":"Receives an NSError describing the failure.","type":"text"}],"type":"paragraph"}],"name":"errorHandler"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Alternative method name for ","type":"text"},{"type":"codeVoice","code":"loadTags:error:"},{"text":" following common SDK naming conventions.","type":"text"},{"type":"text","text":" "},{"text":"Fetches all tags currently associated with this device from the Pushwoosh server.","type":"text"}],"type":"paragraph"},{"anchor":"Example","type":"heading","level":2,"text":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify tag updates were applied:"}]},{"type":"codeListing","syntax":"swift","code":["class TagVerificationService {","","    func verifyTagsApplied(expectedTags: [String: Any],","                          completion: @escaping (Bool) -> Void) {","","        Pushwoosh.configure.getTags({ tags in","            guard let serverTags = tags else {","                completion(false)","                return","            }","","            let allMatch = expectedTags.allSatisfy { key, expectedValue in","                guard let serverValue = serverTags[key] else { return false }","","                if let expected = expectedValue as? String,","                   let server = serverValue as? String {","                    return expected == server","                }","                if let expected = expectedValue as? NSNumber,","                   let server = serverValue as? NSNumber {","                    return expected == server","                }","                return false","            }","","            completion(allMatch)","","        }, onFailure: { error in","            Logger.error(\"Tag verification failed: \\(error?.localizedDescription ?? \"Unknown\")\")","            completion(false)","        })","    }","}"]}]}],"abstract":[{"text":"Retrieves the current device’s tags from the Pushwoosh server.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/