{"abstract":[{"type":"text","text":"Retrieves the current device’s tags from the Pushwoosh server."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Type Method","symbolKind":"method","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"getTags:onFailure:"}],"externalID":"c:objc(pl)PWConfiguration(cm)getTags:onFailure:","navigatorTitle":[{"text":"getTags:onFailure:","kind":"identifier"}],"role":"symbol","modules":[{"name":"PushwooshCore"}],"title":"getTags:onFailure:"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/gettags:onfailure:"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["occ"],"tokens":[{"kind":"text","text":"+ ("},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"getTags:","kind":"identifier"},{"kind":"text","text":"("},{"text":"void (^)(NSDictionary *)","kind":"typeIdentifier","preciseIdentifier":"c:BFv(#*$objc(cs)NSDictionary)"},{"text":") ","kind":"text"},{"kind":"internalParam","text":"successHandler"},{"kind":"text","text":" "},{"text":"onFailure:","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:BFv(#*$objc(cs)NSError)","text":"void (^)(NSError *)"},{"kind":"text","text":") "},{"text":"errorHandler","kind":"internalParam"},{"kind":"text","text":";"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"Block called when tags are successfully retrieved.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Receives a dictionary containing all device tags, or nil if no tags are set."}],"type":"paragraph"}],"name":"successHandler"},{"name":"errorHandler","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Block called if the request fails."},{"type":"text","text":" "},{"text":"Receives an NSError describing the failure.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Alternative method name for ","type":"text"},{"type":"codeVoice","code":"loadTags:error:"},{"type":"text","text":" following common SDK naming conventions."},{"type":"text","text":" "},{"type":"text","text":"Fetches all tags currently associated with this device from the Pushwoosh server."}]},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"inlineContent":[{"text":"Verify tag updates were applied:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["class TagVerificationService {","","    func verifyTagsApplied(expectedTags: [String: Any],","                          completion: @escaping (Bool) -> Void) {","","        Pushwoosh.configure.getTags({ tags in","            guard let serverTags = tags else {","                completion(false)","                return","            }","","            let allMatch = expectedTags.allSatisfy { key, expectedValue in","                guard let serverValue = serverTags[key] else { return false }","","                if let expected = expectedValue as? String,","                   let server = serverValue as? String {","                    return expected == server","                }","                if let expected = expectedValue as? NSNumber,","                   let server = serverValue as? NSNumber {","                    return expected == server","                }","                return false","            }","","            completion(allMatch)","","        }, onFailure: { error in","            Logger.error(\"Tag verification failed: \\(error?.localizedDescription ?? \"Unknown\")\")","            completion(false)","        })","    }","}"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getTags:onFailure:","interfaceLanguage":"occ"},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/getTags:onFailure:":{"type":"topic","abstract":[{"type":"text","text":"Retrieves the current device’s tags from the Pushwoosh server."}],"kind":"symbol","url":"\/documentation\/pushwooshcore\/pwconfiguration\/gettags:onfailure:","fragments":[{"kind":"text","text":"+ "},{"text":"getTags:onFailure:","kind":"identifier"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getTags:onFailure:","navigatorTitle":[{"text":"getTags:onFailure:","kind":"identifier"}],"role":"symbol","title":"getTags:onFailure:"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","title":"PushwooshCore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","kind":"symbol","role":"symbol","abstract":[],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","type":"topic","fragments":[{"kind":"identifier","text":"PWConfiguration"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration"}}}