{"sections":[],"kind":"symbol","abstract":[{"text":"Sets the Pushwoosh Application Code programmatically.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setappcode:"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"symbol","symbolKind":"method","modules":[{"name":"PushwooshCore"}],"roleHeading":"Type Method","fragments":[{"text":"+ ","kind":"text"},{"text":"setAppCode:","kind":"identifier"}],"externalID":"c:objc(pl)PWConfiguration(cm)setAppCode:","navigatorTitle":[{"text":"setAppCode:","kind":"identifier"}],"title":"setAppCode:"},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAppCode:"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"text":") ","kind":"text"},{"kind":"identifier","text":"setAppCode:"},{"text":"(","kind":"text"},{"text":"NSString","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString"},{"kind":"text","text":" *) "},{"text":"appCode","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Your Pushwoosh Application Code (e.g., “XXXXX-XXXXX”)"}],"type":"paragraph"}],"name":"appCode"}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"The Application Code uniquely identifies your app in the Pushwoosh system."},{"type":"text","text":" "},{"text":"You can find it in the Pushwoosh Control Panel under your application settings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"While you can set the code programmatically, the recommended approach is to configure","type":"text"},{"text":" ","type":"text"},{"text":"it in your Info.plist file using the ","type":"text"},{"type":"codeVoice","code":"Pushwoosh_APPID"},{"type":"text","text":" key."}],"type":"paragraph"},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"inlineContent":[{"text":"Configure app code during white-label app initialization:","type":"text"}],"type":"paragraph"},{"code":["class WhiteLabelConfigurator {","","    func configure(with config: AppConfiguration) {","        \/\/ Set Pushwoosh app code based on client configuration","        Pushwoosh.configure.setAppCode(config.pushwooshAppCode)","","        \/\/ Continue with other SDK setup","        Pushwoosh.configure.setDelegate(notificationHandler)","        Pushwoosh.configure.registerForPushNotifications()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"setAppCode:baseUrl:","type":"codeVoice"},{"text":", changing the Application Code here ","type":"text"},{"type":"strong","inlineContent":[{"text":"drops","type":"text"}]},{"text":" that endpoint and falls back to","type":"text"},{"type":"text","text":" "},{"text":"the default (Info.plist ","type":"text"},{"code":"Pushwoosh_BASEURL","type":"codeVoice"},{"type":"text","text":", otherwise"},{"type":"text","text":" "},{"code":"https:\/\/<appCode>.api.pushwoosh.com\/json\/1.3\/","type":"codeVoice"},{"type":"text","text":"), so one application’s data can never be addressed"},{"type":"text","text":" "},{"type":"text","text":"to the host chosen for another one. A warning naming the dropped endpoint is logged. To move an"},{"type":"text","text":" "},{"type":"text","text":"application and its endpoint together, use "},{"code":"setAppCode:baseUrl:","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"leaves** whenever the Application Code actually changes, addressed to that application’s own host, so"},{"type":"text","text":" "},{"type":"text","text":"the device stops receiving its pushes. The local push token is kept, so the device registers into the"},{"type":"text","text":" "},{"text":"new application right away. Re-applying the code the SDK already holds changes nothing and sends","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"nothing."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setAppCode:":{"title":"setAppCode:","role":"symbol","kind":"symbol","url":"\/documentation\/pushwooshcore\/pwconfiguration\/setappcode:","navigatorTitle":[{"text":"setAppCode:","kind":"identifier"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAppCode:","fragments":[{"text":"+ ","kind":"text"},{"text":"setAppCode:","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Sets the Pushwoosh Application Code programmatically."}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","kind":"symbol","role":"symbol","abstract":[],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","type":"topic","fragments":[{"kind":"identifier","text":"PWConfiguration"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","title":"PushwooshCore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore"}}}