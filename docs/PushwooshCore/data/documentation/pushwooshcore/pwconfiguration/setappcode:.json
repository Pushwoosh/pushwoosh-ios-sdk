{"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAppCode:","interfaceLanguage":"occ"},"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"text":"+ (","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"setAppCode:"},{"kind":"text","text":"("},{"preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier","text":"NSString"},{"text":" *) ","kind":"text"},{"text":"appCode","kind":"internalParam"},{"text":";","kind":"text"}],"platforms":["iOS"]}],"kind":"declarations"},{"parameters":[{"name":"appCode","content":[{"type":"paragraph","inlineContent":[{"text":"Your Pushwoosh Application Code (e.g., “XXXXX-XXXXX”)","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"The Application Code uniquely identifies your app in the Pushwoosh system.","type":"text"},{"type":"text","text":" "},{"text":"You can find it in the Pushwoosh Control Panel under your application settings.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"While you can set the code programmatically, the recommended approach is to configure"},{"text":" ","type":"text"},{"text":"it in your Info.plist file using the ","type":"text"},{"type":"codeVoice","code":"Pushwoosh_APPID"},{"type":"text","text":" key."}]},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"type":"paragraph","inlineContent":[{"text":"Configure app code during white-label app initialization:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class WhiteLabelConfigurator {","","    func configure(with config: AppConfiguration) {","        \/\/ Set Pushwoosh app code based on client configuration","        Pushwoosh.configure.setAppCode(config.pushwooshAppCode)","","        \/\/ Continue with other SDK setup","        Pushwoosh.configure.setDelegate(notificationHandler)","        Pushwoosh.configure.registerForPushNotifications()","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"setAppCode:baseUrl:","type":"codeVoice"},{"type":"text","text":", changing the Application Code here "},{"type":"strong","inlineContent":[{"type":"text","text":"drops"}]},{"type":"text","text":" that endpoint and falls back to"},{"type":"text","text":" "},{"type":"text","text":"the default (Info.plist "},{"type":"codeVoice","code":"Pushwoosh_BASEURL"},{"text":", otherwise","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/<appCode>.api.pushwoosh.com\/json\/1.3\/"},{"text":"), so one application’s data can never be addressed","type":"text"},{"text":" ","type":"text"},{"text":"to the host chosen for another one. A warning naming the dropped endpoint is logged. To move an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"application and its endpoint together, use "},{"code":"setAppCode:baseUrl:","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"leaves** whenever the Application Code actually changes, addressed to that application’s own host, so","type":"text"},{"type":"text","text":" "},{"text":"the device stops receiving its pushes. The local push token is kept, so the device registers into the","type":"text"},{"text":" ","type":"text"},{"text":"new application right away. Re-applying the code the SDK already holds changes nothing and sends","type":"text"},{"text":" ","type":"text"},{"text":"nothing.","type":"text"}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"metadata":{"roleHeading":"Type Method","externalID":"c:objc(pl)PWConfiguration(cm)setAppCode:","navigatorTitle":[{"text":"setAppCode:","kind":"identifier"}],"role":"