type":"text","text":"Configure app code during white-label app initialization:"}],"type":"paragraph"},{"code":["class WhiteLabelConfigurator {","","    func configure(with config: AppConfiguration) {","        \/\/ Set Pushwoosh app code based on client configuration","        Pushwoosh.configure.setAppCode(config.pushwooshAppCode)","","        \/\/ Continue with other SDK setup","        Pushwoosh.configure.setDelegate(notificationHandler)","        Pushwoosh.configure.registerForPushNotifications()","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setAppCode:baseUrl:"},{"type":"text","text":", changing the Application Code here "},{"inlineContent":[{"text":"drops","type":"text"}],"type":"strong"},{"text":" that endpoint and falls back to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the default (Info.plist "},{"type":"codeVoice","code":"Pushwoosh_BASEURL"},{"text":", otherwise","type":"text"},{"type":"text","text":" "},{"code":"https:\/\/<appCode>.api.pushwoosh.com\/json\/1.3\/","type":"codeVoice"},{"text":"), so one application’s data can never be addressed","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to the host chosen for another one. A warning naming the dropped endpoint is logged. To move an"},{"text":" ","type":"text"},{"type":"text","text":"application and its endpoint together, use "},{"code":"setAppCode:baseUrl:","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"leaves** whenever the Application Code actually changes, addressed to that application’s own host, so"},{"type":"text","text":" "},{"type":"text","text":"the device stops receiving its pushes. The local push token is kept, so the device registers into the"},{"type":"text","text":" "},{"type":"text","text":"new application right away. Re-applying the code the SDK already holds changes nothing and sends"},{"type":"text","text":" "},{"text":"nothing.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","externalID":"c:objc(pl)PWConfiguration(cm)setAppCode:","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"setAppCode:"}],"navigatorTitle":[{"text":"setAppCode:","kind":"identifier"}],"modules":[{"name":"PushwooshCore"}],"roleHeading":"Type Method","title":"setAppCode:","symbolKind":"method"},"kind":"symbol","sections":[],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"abstract":[],"type":"topic","title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","fragments":[{"kind":"identifier","text":"PWConfiguration"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration","kind":"symbol","role":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","type":"topic","url":"\/documentation\/pushwooshcore","title":"PushwooshCore","kind":"symbol","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setAppCode:":{"abstract":[{"text":"Sets the Pushwoosh Application Code programmatically.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAppCode:","title":"setAppCode:","type":"topic","role":"symbol","fragments":[{"text":"+ ","kind":"text"},{"text":"setAppCode:","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"setAppCode:"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration\/setappcode:"}}}