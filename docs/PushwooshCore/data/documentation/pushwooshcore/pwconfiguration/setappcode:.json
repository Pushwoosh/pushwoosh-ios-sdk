{"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAppCode:","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"Sets the Pushwoosh Application Code programmatically."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"setAppCode:","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NSString","preciseIdentifier":"c:objc(cs)NSString"},{"text":" *) ","kind":"text"},{"text":"appCode","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"appCode","content":[{"inlineContent":[{"type":"text","text":"Your Pushwoosh Application Code (e.g., “XXXXX-XXXXX”)"}],"type":"paragraph"}]}]},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"The Application Code uniquely identifies your app in the Pushwoosh system.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"You can find it in the Pushwoosh Control Panel under your application settings."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"While you can set the code programmatically, the recommended approach is to configure","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it in your Info.plist file using the "},{"type":"codeVoice","code":"Pushwoosh_APPID"},{"type":"text","text":" key."}]},{"type":"heading","anchor":"Example","level":2,"text":"Example"},{"inlineContent":[{"type":"text","text":"Configure app code during white-label app initialization:"}],"type":"paragraph"},{"code":["class WhiteLabelConfigurator {","","    func configure(with config: AppConfiguration) {","        \/\/ Set Pushwoosh app code based on client configuration","        Pushwoosh.configure.setAppCode(config.pushwooshAppCode)","","        \/\/ Continue with other SDK setup","        Pushwoosh.configure.setDelegate(notificationHandler)","        Pushwoosh.configure.registerForPushNotifications()","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"setAppCode:baseUrl:"},{"text":", changing the Application Code here ","type":"text"},{"type":"strong","inlineContent":[{"text":"drops","type":"text"}]},{"text":" that endpoint and falls back to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the default (Info.plist "},{"type":"codeVoice","code":"Pushwoosh_BASEURL"},{"type":"text","text":", otherwise"},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/<appCode>.api.pushwoosh.com\/json\/1.3\/"},{"type":"text","text":"), so one application’s data can never be addressed"},{"type":"text","text":" "},{"type":"text","text":"to the host chosen for another one. A warning naming the dropped endpoint is logged. To move an"},{"type":"text","text":" "},{"text":"application and its endpoint together, use ","type":"text"},{"code":"setAppCode:baseUrl:","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"leaves** whenever the Application Code actually changes, addressed to that application’s own host, so","type":"text"},{"text":" ","type":"text"},{"text":"the device stops receiving its pushes. The local push token is kept, so the device registers into the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"new application right away. Re-applying the code the SDK already holds changes nothing and sends"},{"type":"text","text":" "},{"text":"nothing.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"int