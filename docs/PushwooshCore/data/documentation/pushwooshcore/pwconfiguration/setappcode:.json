{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAppCode:","interfaceLanguage":"occ"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"setAppCode:","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString","text":"NSString"},{"text":" *) ","kind":"text"},{"text":"appCode","kind":"internalParam"},{"text":";","kind":"text"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"Your Pushwoosh Application Code (e.g., “XXXXX-XXXXX”)","type":"text"}],"type":"paragraph"}],"name":"appCode"}]},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Application Code uniquely identifies your app in the Pushwoosh system."},{"type":"text","text":" "},{"text":"You can find it in the Pushwoosh Control Panel under your application settings.","type":"text"}]},{"inlineContent":[{"text":"While you can set the code programmatically, the recommended approach is to configure","type":"text"},{"type":"text","text":" "},{"text":"it in your Info.plist file using the ","type":"text"},{"code":"Pushwoosh_APPID","type":"codeVoice"},{"text":" key.","type":"text"}],"type":"paragraph"},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"inlineContent":[{"type":"text","text":"Configure app code during white-label app initialization:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class WhiteLabelConfigurator {","","    func configure(with config: AppConfiguration) {","        \/\/ Set Pushwoosh app code based on client configuration","        Pushwoosh.configure.setAppCode(config.pushwooshAppCode)","","        \/\/ Continue with other SDK setup","        Pushwoosh.configure.setDelegate(notificationHandler)","        Pushwoosh.configure.registerForPushNotifications()","    }","}"]},{"inlineContent":[{"code":"setAppCode:baseUrl:","type":"codeVoice"},{"type":"text","text":", changing the Application Code here "},{"type":"strong","inlineContent":[{"type":"text","text":"drops"}]},{"type":"text","text":" that endpoint and falls back to"},{"type":"text","text":" "},{"text":"the default (Info.plist ","type":"text"},{"code":"Pushwoosh_BASEURL","type":"codeVoice"},{"type":"text","text":", otherwise"},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/<appCode>.api.pushwoosh.com\/json\/1.3\/"},{"text":"), so one application’s data can never be addressed","type":"text"},{"type":"text","text":" "},{"text":"to the host chosen for another one. A warning naming the dropped endpoint is logged. To move an","type":"text"},{"text":" ","type":"text"},{"text":"application and its endpoint together, use ","type":"text"},{"code":"setAppCode:baseUrl:","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"leaves** whenever the Application Code actually changes, addressed to that application’s own host, so"},{"text":" ","type":"text"},{"text":"the device stops receiving its pushes. The local push token is kept, so the device registers into the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"new application right away. Re-applying the code the SDK already holds changes nothing and sends"},{"text":" ","type":"text"},{"type":"text","text":"nothing."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setappcode:"],"traits":[{"interfaceLanguage":"occ"}]}],"kind":