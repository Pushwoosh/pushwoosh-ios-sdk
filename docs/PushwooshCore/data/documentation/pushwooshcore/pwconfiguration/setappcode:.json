xt"},{"text":" ","type":"text"},{"text":"it in your Info.plist file using the ","type":"text"},{"type":"codeVoice","code":"Pushwoosh_APPID"},{"type":"text","text":" key."}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Configure app code during white-label app initialization:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["class WhiteLabelConfigurator {","","    func configure(with config: AppConfiguration) {","        \/\/ Set Pushwoosh app code based on client configuration","        Pushwoosh.configure.setAppCode(config.pushwooshAppCode)","","        \/\/ Continue with other SDK setup","        Pushwoosh.configure.setDelegate(notificationHandler)","        Pushwoosh.configure.registerForPushNotifications()","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"setAppCode:baseUrl:"},{"type":"text","text":", changing the Application Code here "},{"inlineContent":[{"type":"text","text":"drops"}],"type":"strong"},{"text":" that endpoint and falls back to","type":"text"},{"text":" ","type":"text"},{"text":"the default (Info.plist ","type":"text"},{"type":"codeVoice","code":"Pushwoosh_BASEURL"},{"type":"text","text":", otherwise"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/<appCode>.api.pushwoosh.com\/json\/1.3\/"},{"text":"), so one application’s data can never be addressed","type":"text"},{"text":" ","type":"text"},{"text":"to the host chosen for another one. A warning naming the dropped endpoint is logged. To move an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"application and its endpoint together, use "},{"type":"codeVoice","code":"setAppCode:baseUrl:"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"leaves** whenever the Application Code actually changes, addressed to that application’s own host, so","type":"text"},{"text":" ","type":"text"},{"text":"the device stops receiving its pushes. The local push token is kept, so the device registers into the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"new application right away. Re-applying the code the SDK already holds changes nothing and sends"},{"text":" ","type":"text"},{"type":"text","text":"nothing."}]}]}],"sections":[],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setappcode:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setAppCode:":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"setAppCode:"}],"fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"setAppCode:"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration\/setappcode:","title":"setAppCode:","abstract":[{"type":"text","text":"Sets the Pushwoosh Application Code programmatically."}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAppCode:","role":"symbol","kind":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"url":"\/documentation\/pushwooshcore","role":"collection","kind":"symbol","type":"topic","title":"PushwooshCore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","abstract":[],"url":"\/documentation\/pushwooshcore\/pwconfiguration","role":"symbol","kind":"symbol","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"}}}