{"inlineContent":[{"type":"text","text":"While you can set the code programmatically, the recommended approach is to configure"},{"type":"text","text":" "},{"text":"it in your Info.plist file using the ","type":"text"},{"code":"Pushwoosh_APPID","type":"codeVoice"},{"text":" key.","type":"text"}],"type":"paragraph"},{"text":"Example","anchor":"Example","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Configure app code during white-label app initialization:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class WhiteLabelConfigurator {","","    func configure(with config: AppConfiguration) {","        \/\/ Set Pushwoosh app code based on client configuration","        Pushwoosh.configure.setAppCode(config.pushwooshAppCode)","","        \/\/ Continue with other SDK setup","        Pushwoosh.configure.setDelegate(notificationHandler)","        Pushwoosh.configure.registerForPushNotifications()","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"setAppCode:baseUrl:","type":"codeVoice"},{"type":"text","text":", changing the Application Code here "},{"type":"strong","inlineContent":[{"type":"text","text":"drops"}]},{"type":"text","text":" that endpoint and falls back to"},{"type":"text","text":" "},{"text":"the default (Info.plist ","type":"text"},{"code":"Pushwoosh_BASEURL","type":"codeVoice"},{"text":", otherwise","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/<appCode>.api.pushwoosh.com\/json\/1.3\/"},{"type":"text","text":"), so one application’s data can never be addressed"},{"text":" ","type":"text"},{"type":"text","text":"to the host chosen for another one. A warning naming the dropped endpoint is logged. To move an"},{"text":" ","type":"text"},{"text":"application and its endpoint together, use ","type":"text"},{"type":"codeVoice","code":"setAppCode:baseUrl:"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"text","text":"leaves** whenever the Application Code actually changes, addressed to that application’s own host, so"},{"text":" ","type":"text"},{"type":"text","text":"the device stops receiving its pushes. The local push token is kept, so the device registers into the"},{"type":"text","text":" "},{"text":"new application right away. Re-applying the code the SDK already holds changes nothing and sends","type":"text"},{"type":"text","text":" "},{"type":"text","text":"nothing."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setAppCode:":{"fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"setAppCode:"}],"kind":"symbol","title":"setAppCode:","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAppCode:","url":"\/documentation\/pushwooshcore\/pwconfiguration\/setappcode:","navigatorTitle":[{"kind":"identifier","text":"setAppCode:"}],"abstract":[{"type":"text","text":"Sets the Pushwoosh Application Code programmatically."}],"type":"topic","role":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","role":"symbol","fragments":[{"kind":"identifier","text":"PWConfiguration"}],"type":"topic","abstract":[],"kind":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"abstract":[{"text":"Core foundation module for Pushwoosh SDK.","type":"text"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","title":"PushwooshCore","url":"\/documentation\/pushwooshcore","role":"collection","kind":"symbol","type":"topic"}}}