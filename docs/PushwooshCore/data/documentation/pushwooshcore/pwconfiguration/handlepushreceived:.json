yload(customData)","        }","","        return true","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"metadata":{"roleHeading":"Type Method","externalID":"c:objc(pl)PWConfiguration(cm)handlePushReceived:","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"handlePushReceived:"}],"navigatorTitle":[{"text":"handlePushReceived:","kind":"identifier"}],"title":"handlePushReceived:","role":"symbol","modules":[{"name":"PushwooshCore"}],"symbolKind":"method"},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore","kind":"symbol","title":"PushwooshCore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"abstract":[{"text":"Protocol defining SDK configuration methods.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/handlePushReceived:":{"role":"symbol","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"handlePushReceived:"}],"title":"handlePushReceived:","navigatorTitle":[{"kind":"identifier","text":"handlePushReceived:"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration\/handlepushreceived:","abstract":[{"type":"text","text":"Handles a received push notification."}],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/handlePushReceived:","type":"topic"}}}