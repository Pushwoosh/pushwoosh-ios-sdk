:"text"},{"text":" ","type":"text"},{"text":"Pushwoosh uses a delegate proxy to forward notification center callbacks to all registered delegates,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"enabling multiple components to respond to notification events without conflicts."}]},{"inlineContent":[{"type":"text","text":"This is the recommended way to handle notification center events when using Pushwoosh SDK 7.0+,"},{"text":" ","type":"text"},{"text":"as it avoids conflicts with Pushwoosh’s own notification handling.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Typical use cases:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Integrating multiple push notification SDKs"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Adding custom notification handling logic (e.g., analytics, local notifications)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Implementing custom notification actions"}],"type":"paragraph"}]}]},{"text":"Examples","type":"heading","level":2,"anchor":"Examples"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register AppDelegate as a notification delegate:"}]},{"syntax":"swift","code":["func application(_ application: UIApplication,","                 didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","    Pushwoosh.configure.addNotificationCenterDelegate(self)","    return true","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register a dedicated notification handler:"}]},{"code":["class NotificationHandler: NSObject, UNUserNotificationCenterDelegate {","","    func userNotificationCenter(_ center: UNUserNotificationCenter,","                                willPresent notification: UNNotification,","                                withCompletionHandler completionHandler: @escaping (UNNo