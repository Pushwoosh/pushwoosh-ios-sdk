ler()","        }","    }","}","","let handler = NotificationHandler()","Pushwoosh.configure.addNotificationCenterDelegate(handler)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Objective-C:"}]},{"code":["[Pushwoosh.configure addNotificationCenterDelegate:self];"],"type":"codeListing","syntax":"objc"},{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMessage\/isPushwooshMessage:","isActive":true},{"type":"text","text":" to distinguish Pushwoosh notifications from your own and handle only non-Pushwoosh notifications in your custom delegate."}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"}]}],"abstract":[{"text":"Adds a custom ","type":"text"},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"text":" to the Pushwoosh notification center delegate proxy.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/addnotificationcenterdelegate:"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"symbolKind":"method","title":"addNotificationCenterDelegate:","roleHeading":"Type Method","modules":[{"name":"PushwooshCore"}],"fragments":[{"kind":"text","text":"+ "},{"text":"addNotificationCenterDelegate:","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"addNotificationCenterDelegate:"}],"externalID":"c:objc(pl)PWConfiguration(cm)addNotificationCenterDelegate:"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"url":"\/documentation\/pushwooshcore","role":"collection","title":"PushwooshCore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/Pushwoosh