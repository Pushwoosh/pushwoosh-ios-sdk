 to register your own ","type":"text"},{"code":"UNUserNotificationCenterDelegate","type":"codeVoice"},{"text":" alongside Pushwoosh’s built-in delegate.","type":"text"},{"type":"text","text":" "},{"text":"Pushwoosh uses a delegate proxy to forward notification center callbacks to all registered delegates,","type":"text"},{"type":"text","text":" "},{"text":"enabling multiple components to respond to notification events without conflicts.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This is the recommended way to handle notification center events when using Pushwoosh SDK 7.0+,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"as it avoids conflicts with Pushwoosh’s own notification handling."}]},{"inlineContent":[{"type":"text","text":"Typical use cases:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Integrating multiple push notification SDKs","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Adding custom notification handling logic (e.g., analytics, local notifications)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Implementing custom notification actions","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Examples","anchor":"Examples","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register AppDelegate as a notification delegate:"}]},{"code":["func application(_ application: UIApplication,","                 didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","    Pushwoosh.configure.addNotificationCenterDelegate(self)","    return true","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register a dedicated notification handler:"}]},{"code":["class NotificationHandler: NSObject, UNUserNotificationCenterDelegate {","","    func userNotificationCenter(_ center: UNUserNotificationCenter,","                                willPresent notification: UNNotification,","                                withCompletionHandler completionHandler: @escaping (UNNotificationPresentationOptions) -> Void) {","        if !PWMessage.isPushwooshMessage(notification.request.content.userInfo) {","            completionHandler([.banner, .sound])","        }","    }","","    func userNotificationCenter(_ center: UNUserNotificationCenter,","                                didReceive response: UNNotificationResponse,","                                withCompletionHandler completionHandler: @escaping () -> Void) {","        if !PWMessage.isPushwooshMessage(response.notification.request.content.userInfo) {","            \/\/ Handle your custom notification","            completionHandler()","        }","    }","}","","let handler = NotificationHandler()","Pushwoosh.configure.addNotificationCenterDelegate(handler)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Objective-C:"}]},{"type":"codeListing","syntax":"objc","code":["[Pushwoosh.configure addNotificationCenterDelegate:self];"]},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWMessage\/isPushwooshMessage:","type":"reference"},{"text":" to distinguish Pushwoosh notifications from your own and handle only non-Pushwoosh notifications in your custom delegate.","type":"text"}],"type":"paragraph"}],"name":"Note"}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/addNotificationCenterDelegate:"},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/addNotificationCenterDelegate:":{"abstract":[{"type":"text","text":"Adds a custom "},{"code":"UNUserNotificationCenterDelegate","type":"codeVoic