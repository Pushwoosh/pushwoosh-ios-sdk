{"sections":[],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/addNotificationCenterDelegate:","interfaceLanguage":"occ"},"metadata":{"roleHeading":"Type Method","modules":[{"name":"PushwooshCore"}],"fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"addNotificationCenterDelegate:"}],"title":"addNotificationCenterDelegate:","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"addNotificationCenterDelegate:"}],"externalID":"c:objc(pl)PWConfiguration(cm)addNotificationCenterDelegate:","symbolKind":"method"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["occ"],"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"kind":"text","text":") "},{"text":"addNotificationCenterDelegate:","kind":"identifier"},{"kind":"text","text":"("},{"text":"id<UNUserNotificationCenterDelegate>","kind":"typeIdentifier","preciseIdentifier":"c:Qoobjc(pl)UNUserNotificationCenterDelegate"},{"text":") ","kind":"text"},{"text":"delegate","kind":"internalParam"},{"text":";","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"delegate","content":[{"type":"paragraph","inlineContent":[{"text":"The delegate object that conforms to ","type":"text"},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" protocol. Must not be nil."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to register your own "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" alongside Pushwoosh’s built-in delegate."},{"type":"text","text":" "},{"type":"text","text":"Pushwoosh uses a delegate proxy to forward notification center callbacks to all registered delegates,"},{"text":" ","typ