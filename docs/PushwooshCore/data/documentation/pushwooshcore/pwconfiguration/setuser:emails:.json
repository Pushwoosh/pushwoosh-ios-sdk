{"metadata":{"modules":[{"name":"PushwooshCore"}],"symbolKind":"method","role":"symbol","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"setUser:emails:"}],"roleHeading":"Type Method","navigatorTitle":[{"text":"setUser:emails:","kind":"identifier"}],"title":"setUser:emails:","externalID":"c:objc(pl)PWConfiguration(cm)setUser:emails:"},"kind":"symbol","sections":[],"abstract":[{"text":"Sets user identifier and emails together in a single operation.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setuser:emails:"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setUser:emails:"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"kind":"text","text":") "},{"kind":"identifier","text":"setUser:"},{"kind":"text","text":"("},{"text":"NSString","preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier"},{"kind":"text","text":" *) "},{"text":"userId","kind":"internalParam"},{"kind":"text","text":" "},{"kind":"identifier","text":"emails:"},{"text":"(","kind":"text"},{"text":"NSArray","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSArray"},{"kind":"text","text":" *) "},{"text":"emails","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The custom user identifier."}]}],"name":"userId"},{"content":[{"inlineContent":[{"text":"Array of email address strings to associate with the user.","type":"text"}],"type":"paragraph"}],"name":"emails"}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience method that combines "},{"code":"setUserId:","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"setEmails:"},{"text":" into a single","type":"text"},{"type":"text","text":" "},{"type":"text","text":"server request. This is more efficient than calling both methods separately"},{"type":"text","text":" "},{"text":"and ensures atomic association of user ID with emails.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Use this during login or registration flows when you have both user ID"},{"type":"text","text":" "},{"type":"text","text":"and email available simultaneously."}],"type":"paragraph"},{"anchor":"Example","type":"heading","level":2,"text":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete registration with user ID and emails:"}]},{"code":["class RegistrationManager {","","    func completeRegistration(_ registration: RegistrationData) {","        \/\/ Create user on backend","        APIClient.shared.createUser(registration) { result in","            guard case .success(let user) = result else { return }","","            \/\/ Set both user ID and emails in single operation","            var emails = [user.email]","            if let secondaryEmail = registration.secondaryEmail {","                emails.append(secondaryEmail)","            }","","            Pushwoosh.configure.setUser(user.id, emails: emails)","","            \/\/ Set initial user tags","            Pushwoosh.configure.setTags([","                \"registration_date\": ISO8601DateFormatter().string(from: Date()),","                \"registration_source\": registration.source.rawValue,","                \"account_type\": user.accountType.rawValue,","                \"has_completed_onboarding\": false","            ])","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"codeListing","syntax":null,"code":["   when you need confirmation."]}],"kind":"content"}],"hierarchy":{"paths":[["d