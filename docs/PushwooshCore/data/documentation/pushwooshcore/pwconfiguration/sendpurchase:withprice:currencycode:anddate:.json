{"metadata":{"navigatorTitle":[{"text":"sendPurchase:withPrice:currencyCode:andDate:","kind":"identifier"}],"title":"sendPurchase:withPrice:currencyCode:andDate:","fragments":[{"kind":"text","text":"+ "},{"text":"sendPurchase:withPrice:currencyCode:andDate:","kind":"identifier"}],"modules":[{"name":"PushwooshCore"}],"externalID":"c:objc(pl)PWConfiguration(cm)sendPurchase:withPrice:currencyCode:andDate:","role":"symbol","roleHeading":"Type Method","symbolKind":"method"},"kind":"symbol","abstract":[{"text":"Tracks an individual in-app purchase with custom price information.","type":"text"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/sendpurchase:withprice:currencycode:anddate:"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"text":") ","kind":"text"},{"kind":"identifier","text":"sendPurchase:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString","text":"NSString"},{"kind":"text","text":" *) "},{"text":"productIdentifier","kind":"internalParam"},{"text":" ","kind":"text"},{"kind":"identifier","text":"withPrice:"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSDecimalNumber","text":"NSDecimalNumber","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"price","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"currencyCode:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSString","preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"currencyCode","kind":"internalParam"},{"kind":"text","text":" "},{"kind":"identifier","text":"andDate:"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSDate","kind":"typeIdentifier","text":"NSDate"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"date"},{"kind":"text","text":";"}]}]},{"parameters":[{"name":"productIdentifier","content":[{"inlineContent":[{"text":"The product identifier (SKU).","type":"text"}],"type":"paragraph"}]},{"name":"price","content":[{"type":"paragraph","inlineContent":[{"text":"The purchase price as NSDecimalNumber for precision.","type":"text"}]}]},{"name":"currencyCode","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"ISO 4217 currency code (e.g., “USD”, “EUR”, “GBP”)."}]}]},{"name":"date","content":[{"inlineContent":[{"text":"The date when the purchase occurred.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Manually track a purchase when you need more control than automatic"},{"text":" ","type":"text"},{"type":"text","text":"StoreKit tracking, or when processing purchases from other sources"},{"type":"text","text":" "},{"type":"text","text":"(web purchases, promotional codes, etc.)."}],"type":"paragraph"},{"inlineContent":[{"text":"Use this for:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-StoreKit purchases (web, third-party payment processors)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Custom price tracking (discounts, promotions)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Server-verified purchases"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Cross-platform purchase sync"}],"type":"paragraph"}]}]},{"text":"Example","anchor":"Example","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Track purchases from different sources:"}]},{"code":["class PurchaseTracker {","","    func trackStoreKitPurchase(_ transaction: SKPaymentTransaction, product: SKProduct) {","        Pushwoosh.configure.sendPurchase(","            product.productIdentifier,","            withPrice: product.price,","            currencyCode: product.priceLocale.currencyCode ?? \"USD\",","            andDate: transaction.transactionDate ?? Date()","        )","","        updatePurchaseTags(productId: product.productIdentifier, price: product.price)","    }","","    func trackWebPurchase(_ purchase: WebPurchase) {","        \/\/ Track purchase made through web checkout","        Pushwoosh.configure.sendPurchase(","            purchase.productId,","            withPrice: NSDecimalNumber(value: purchase.amount),","            currencyCode: purchase.currency,","            andDate: purchase.timestamp","        )","","        updatePurchaseTags(productId: purchase.productId,","                          price: NSDecimalNumber(value: purchase.amount))","    }","","    func trackPromotionalPurchase(productId: String, originalPrice: Decimal, discountedPrice: Decimal) {","        \/\/ Track discounted purchase","        Pushwoosh.configure.sendPurchase(","            productId,","            withPrice: NSDecimalNumber(decimal: discountedPrice),","            currencyCode: Locale.current.currencyCode ?? \"USD\",","            andDate: Date()","        )","","        Pushwoosh.configure.setTags([","            \"used_promotion\": true,","            \"discount_amount\": NSDecimalNumber(decimal: originalPrice - discountedPrice)","        ])","    }","","    private func updatePurchaseTags(productId: String, price: NSDecimalNumber) {","        Pushwoosh.configure.setTags([","            \"total_purchases\": incrementPurchaseCount(),","            \"total_spent\": calculateTotalSpent(adding: price),","            \"customer_tier\": determineCustomerTier()","        ])","    }","}"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/sendPurchase:withPrice:currencyCode:andDate:"},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/sendPurchase:withPrice:currencyCode:andDate:":{"navigatorTitle":[{"text":"sendPurchase:withPrice:currencyCode:andDate:","kind":"identifier"}],"title":"sendPurchase:withPrice:currencyCode:andDate:","kind":"symbol","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"sendPurchase:withPrice:currencyCode:andDate:"}],"type":"topic","abstract":[{"text":"Tracks an individual in-app purchase with custom price information.","type":"text"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration\/sendpurchase:withprice:currencycode:anddate:","role":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/sendPurchase:withPrice:currencyCode:andDate:"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"role":"collection","kind":"symbol","url":"\/documentation\/pushwooshcore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","title":"PushwooshCore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","type":"topic","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","role":"symbol","kind":"symbol","abstract":[],"url":"\/documentation\/pushwooshcore\/pwconfiguration"}}}