Content":[{"type":"text","text":"The email address to associate tags with."}],"type":"paragraph"}]},{"name":"completion","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Block called when the operation completes."},{"text":" ","type":"text"},{"text":"Receives nil on success, or an NSError on failure.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Same as "},{"type":"codeVoice","code":"setEmailTags:forEmail:"},{"type":"text","text":" but provides confirmation when the operation completes."},{"type":"text","text":" "},{"text":"Use this when you need to verify tags were set before proceeding with other operations.","type":"text"}],"type":"paragraph"},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify email and update tags with confirmation:"}]},{"syntax":"swift","type":"codeListing","code":["class EmailVerificationService {","","    func completeEmailVerification(email: String, verificationCode: String,","                                   completion: @escaping (Result<Void, Error>) -> Void) {","","        APIClient.shared.verifyEmail(email, code: verificationCode) { result in","            switch result {","            case .success:","                let verificationTags: [String: Any] = [","                    \"email_verified\": true,","                    \"verification_date\": ISO8601DateFormatter().string(from: Date()),","                    \"verification_method\": \"code\"","                ]","","                Pushwoosh.configure.setEmailTags(verificationTags, forEmail: email) { error in","                    if let error = error {","                        Logger.warning(\"Email tags update failed: \\(error.localizedDescription)\")","                        \/\/ Continue anyway - email is verified on backend","                    }","","                    \/\/ Also update device tags","                    Pushwoosh.configure.setTags([\"has_verified_email\": true])","","                    completion(.success(()))","                }","","            case .failure(let error):","                completion(.failure(error))","            }","        }","    }","}"]}]}],"metadata":{"roleHeading":"Type Method","title":"setEmailTags:forEmail:completion:","externalID":"c:objc(pl)PWConfiguration(cm)setEmailTags:forEmail:completion:","symbolKind":"method","fragments":[{"text":"+ ","kind":"text"},{"text":"setEmailTags:forEmail:completion:","kind":"identifier"}],"navigatorTitle":[{"text":"setEmailTags:forEmail:completion:","kind":"identifier"}],"role":"symbol","modules":[{"name":"PushwooshCore"}]},"abstract":[{"text":"Sets tags for a specific email address with a completion handler.","type":"text"}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"abstract":[],"type":"topic","url":"\/documentation\/pushwooshcore\/pwconfiguration","kind":"symbol","role":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setEmailTags:forEmail:completion:":{"role":"symbol","fragments":[{"kind":"text","text":"+ "},{"text":"setEmailTags:forEmail:completion:","kind":"identifier"}],"abstract":[{"type":"text","text":"Sets tags for a specific email address with a completion handler."}],"kind":"symbol","title":"setEmailTags:forEmail:completion:","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setEmailTags:forEmail:completion:","type":"topic","url":"\/documentation\/pushwooshcore\/pwconfiguration\/setemailtags:foremail:completion:","navigatorTitle":[{"text":"setEmailTags:forEmail:completion:","kind":"identifier"}]},"doc://com.