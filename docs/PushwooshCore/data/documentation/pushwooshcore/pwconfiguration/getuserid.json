chedProperties = properties","        enrichedProperties[\"pushwoosh_user_id\"] = Pushwoosh.configure.getUserId()","        enrichedProperties[\"pushwoosh_hwid\"] = Pushwoosh.configure.getHWID()","","        Analytics.track(event, properties: enrichedProperties)","    }","}"]}],"kind":"content"}],"sections":[],"kind":"symbol","metadata":{"fragments":[{"kind":"text","text":"+ "},{"text":"getUserId","kind":"identifier"}],"externalID":"c:objc(pl)PWConfiguration(cm)getUserId","navigatorTitle":[{"kind":"identifier","text":"getUserId"}],"roleHeading":"Type Method","modules":[{"name":"PushwooshCore"}],"role":"symbol","symbolKind":"method","title":"getUserId"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/getuserid"]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/getUserId":{"navigatorTitle":[{"kind":"identifier","text":"getUserId"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration\/getuserid","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getUserId","type":"topic","abstract":[{"type":"text","text":"Retrieves the current user identifier."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"text","text":"+ "},{"text":"getUserId","kind":"identifier"}],"title":"getUserId"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"kind":"symbol","role":"collection","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore","abstract":[{"text":"Core foundation module for Pushwoosh SDK.","type":"text"}],"type":"topic","title":"PushwooshCore"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"identifier":"doc:\/\/com.pushwoosh.Pushwoos