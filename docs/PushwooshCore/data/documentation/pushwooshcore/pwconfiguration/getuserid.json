{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Retrieves the current user identifier."}],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/getuserid"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"preciseIdentifier":"c:objc(cs)NSString","text":"NSString","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"getUserId","kind":"identifier"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The current user identifier (custom user ID or HWID)"}]}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns the user ID that was previously set via "},{"type":"codeVoice","code":"setUserId:"},{"type":"text","text":", or the HWID if no custom"},{"type":"text","text":" "},{"text":"user ID has been set.","type":"text"}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sync user ID with analytics platforms:"}]},{"syntax":"swift","type":"codeListing","code":["class AnalyticsCoordinator {","","    func syncIdentifiers() {","        let userId = Pushwoosh.configure.getUserId()","        let hwid = Pushwoosh.configure.getHWID()","","        \/\/ Sync with various analytics platforms","        Analytics.identify(userId)","        Crashlytics.setUserID(userId)","        MixpanelInstance.identify(distinctId: userId)","","        \/\/ Log device mapping for debugging","        Logger.debug(\"User identity: userId=\\(userId), hwid=\\(hwid)\")","    }","","    func trackEventWithUserContext(_ event: String, properties: [String: Any]) {","        var enrichedProperties = properties","        enrichedProperties[\"pushwoosh_user_id\"] = Pushwoosh.configure.getUserId()","        enrichedProperties[\"pushwoosh_hwid\"] = Pushwoosh.configure.getHWID()","","        Analytics.track(event, properties: enrichedProperties)","    }","}"]}],"kind":"content"}],"metadata":{"symbolKind":"method","roleHeading":"Type Method","title":"getUserId","externalID":"c:objc(pl)PWConfiguration(cm)getUserId","fragments":[{"text":"+ ","kind":"text"},{"text":"getUserId","kind":"identifier"}],"navigatorTitle":[{"text":"getUserId","kind":"identifier"}],"role":"symbol","modules":[{"name":"PushwooshCore"}]},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getUserId","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"kind":"symbol","sections":[],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/getUserId":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"getUserId"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getUserId","url":"\/documentation\/pushwooshcore\/pwconfiguration\/getuserid","role":"symbol","fragments":[{"kind":"text","text":"+ "},{"text":"getUserId","kind":"identifier"}],"title":"getUserId","kind":"symbol","abstract":[{"text":"Retrieves the current user identifier.","type":"text"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"type":"topic","url":"\/documentation\/pushwooshcore\/pwconfiguration","title":"PWConfiguration","kind":"symbol","fragments":[{"kind":"identifier","text":"PWConfiguration"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","abstract":[],"role":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"title":"Pushwoos