{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"sendSKPaymentTransactions:","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSArray","text":"NSArray"},{"text":" *) ","kind":"text"},{"text":"transactions","kind":"internalParam"},{"kind":"text","text":";"}],"platforms":["iOS"]}]},{"parameters":[{"name":"transactions","content":[{"type":"paragraph","inlineContent":[{"text":"Array of ","type":"text"},{"code":"SKPaymentTransaction","type":"codeVoice"},{"type":"text","text":" objects from StoreKit."}]}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Automatically tracks in-app purchases from StoreKit transactions.","type":"text"},{"type":"text","text":" "},{"text":"This enables:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Revenue tracking","type":"text"}],"type":"strong"},{"text":": Monitor purchase revenue in Pushwoosh dashboard","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Purchase-based segmentation"}]},{"type":"text","text":": Target paying users, high-value customers"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"LTV analysis"}]},{"type":"text","text":": Calculate customer lifetime value"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Purchase events","type":"text"}]},{"text":": Trigger automations based on purchases","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Call this method from your ","type":"text"},{"code":"SKPaymentTransactionObserver","type":"codeVoice"},{"text":" for all","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"completed transactions."}]},{"anchor":"Example","type":"heading","text":"Example","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Integrate with StoreKit payment observer:"}]},{"type":"codeListing","code":["class StoreKitManager: NSObject, SKPaymentTransactionObserver {","","    func paymentQueue(_ queue: SKPaymentQueue,","                     updatedTransactions transactions: [SKPaymentTransaction]) {","","        let completedTransactions = transactions.filter {","            $0.transactionState == .purchased || $0.transactionState == .restored","        }","","        \/\/ Send completed transactions to Pushwoosh","        if !completedTransactions.isEmpty {","            Pushwoosh.configure.sendSKPaymentTransactions(completedTransactions)","        }","","        \/\/ Process each transaction","        for transaction in transactions {","            switch transaction.transactionState {","            case .purchased:","                handlePurchase(transaction)","                queue.finishTransaction(transaction)","","            case .restored:","                handleRestore(transaction)","                queue.finishTransaction(transaction)","","            case .failed:","                handleFailure(transaction)","                queue.finishTransaction(transaction)","","            case .deferred, .purchasing:","                break","","            @unknown default:","                break","            }","        }","    }","","    private func handlePurchase(_ transaction: SKPaymentTransaction) {","        let productId = transaction.payment.productIdentifier","","        \/\/ Update user tags for purchase segmentation","        Pushwoosh.configure.setTags([","            \"has_purchased\": true,","            \"last_purchase_date\": ISO8601DateFormatter().string(from: Date()),","            \"last_purchased_product\": productId","        ])","    }","}"],"syntax":"swift"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/sendskpaymenttransactions:"]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/sendSKPaymentTransactions:","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"Sends StoreKit payment transactions to Pushwoosh for purchase tracking."}],"metadata":{"roleHeading":"Type Method","externalID":"c:objc(pl)PWConfiguration(cm)sendSKPaymentTransactions:","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"sendSKPaymentTransactions:"}],"navigatorTitle":[{"text":"sendSKPaymentTransactions:","kind":"identifier"}],"title":"sendSKPaymentTransactions:","role":"symbol","modules":[{"name":"PushwooshCore"}],"symbolKind":"method"},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/sendSKPaymentTransactions:":{"kind":"symbol","title":"sendSKPaymentTransactions:","role":"symbol","navigatorTitle":[{"text":"sendSKPaymentTransactions:","kind":"identifier"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/sendSKPaymentTransactions:","url":"\/documentation\/pushwooshcore\/pwconfiguration\/sendskpaymenttransactions:","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"sendSKPaymentTransactions:"}],"type":"topic","abstract":[{"text":"Sends StoreKit payment transactions to Pushwoosh for purchase tracking.","type":"text"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore","kind":"symbol","title":"PushwooshCore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"abstract":[{"text":"Protocol defining SDK configuration methods.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}]}}}