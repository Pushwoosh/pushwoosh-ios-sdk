ociates tags with an email address independently of the current device."},{"text":" ","type":"text"},{"type":"text","text":"This is used for email-specific segmentation in Pushwoosh Email campaigns."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Email tags are separate from device tags:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Device tags: Associated with push token, used for push segmentation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Email tags: Associated with email address, used for email segmentation","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Use this for email-specific attributes like email preferences, engagement metrics,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or email-only campaign targeting."}],"type":"paragraph"},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"inlineContent":[{"type":"text","text":"Update email campaign preferences:"}],"type":"paragraph"},{"type":"codeListing","code":["class EmailPreferencesManager {","","    func updateEmailPreferences(for email: String, preferences: EmailPreferences) {","        let tags: [String: Any] = [","            \"email_frequency\": preferences.frequency.rawValue,","            \"email_categories\": preferences.subscribedCategories.map { $0.rawValue },","            \"email_format\": preferences.preferHTML ? \"html\" : \"plain\",","            \"unsubscribed_categories\": preferences.unsubscribedCategories.map { $0.rawValue },","            \"last_preference_update\": ISO8601DateFormatter().string(from: Date())","        ]","","        Pushwoosh.configure.setEmailTags(tags, forEmail: email)","    }","","    func trackEmailEngagement(email: String, campaignId: String, action: EmailAction) {","        let engagementTags: [String: Any] = [","            \"last_email_open\": ISO8601DateFormatter().string(from: Date()),","            \"email_engagement_score\": c