{"abstract":[{"type":"text","text":"Sets a full BCP 47 locale tag for localized notifications and segmentation."}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setLocale:","interfaceLanguage":"occ"},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setlocale:"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"sections":[],"metadata":{"role":"symbol","roleHeading":"Type Method","externalID":"c:objc(pl)PWConfiguration(cm)setLocale:","title":"setLocale:","symbolKind":"method","navigatorTitle":[{"kind":"identifier","text":"setLocale:"}],"modules":[{"name":"PushwooshCore"}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"setLocale:"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"kind":"text","text":") "},{"text":"setLocale:","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier","text":"NSString"},{"kind":"text","text":" *) "},{"text":"locale","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A BCP 47 locale tag, or nil\/blank to restore the device locale"}],"type":"paragraph"}],"name":"locale"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Unlike ","type":"text"},{"type":"codeVoice","code":"setLanguage:"},{"type":"text","text":", which only carries a two-letter language code, this preserves the region"},{"type":"text","text":" "},{"text":"and script subtags (e.g. “pt-BR”, “es-419”, “zh-Hant-TW”) so the backend can target and localize","type":"text"},{"text":" ","type":"text"},{"text":"by full locale rather than language alone. When nothing is set, the device’s own locale is used.","type":"text"}]},{"inlineContent":[{"code":"language","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"locale","type":"codeVoice"},{"text":" are independent: the SDK does not derive either one from the other. An app","type":"text"},{"type":"text","text":" "},{"text":"that sets its own language with ","type":"text"},{"type":"codeVoice","code":"setLanguage:"},{"type":"text","text":" should also call "},{"type":"codeVoice","code":"setLocale:"},{"text":", otherwise ","type":"text"},{"type":"codeVoice","code":"locale"},{"text":" ","type":"text"},{"text":"keeps reporting the device’s own locale regardless of the language the app chose.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A new value is sent to Pushwoosh right away with a registration request once the device has a push","type":"text"},{"type":"text","text":" "},{"type":"text","text":"token; before that it goes out with the first registration. Re-setting the same value already stored"},{"type":"text","text":" "},{"text":"is a full no-op. When ","type":"text"},{"type":"codeVoice","code":"Pushwoosh_ALLOW_COLLECTING_DEVICE_LOCALE"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Pushwoosh_ALLOW_COLLECTING_DEVICE_DATA"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"NO"},{"type":"text","text":", the value is stored but not sent."}]},{"type":"heading","anchor":"Example","text":"Example","level":2},{"code":["Pushwoosh.configure.setLocale(\"pt-BR\")"],"syntax":"swift","type":"codeListing"}]}],"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"abstract":[{"text":"Protocol defining SDK configuration methods.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore","kind":"symbol","title":"PushwooshCore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setLocale:":{"title":"setLocale:","url":"\/documentation\/pushwooshcore\/pwconfiguration\/setlocale:","abstract":[{"text":"Sets a full BCP 47 locale tag for localized notifications and segmentation.","type":"text"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setLocale:","role":"symbol","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"setLocale:"}],"navigatorTitle":[{"kind":"identifier","text":"setLocale:"}],"type":"topic","kind":"symbol"}}}