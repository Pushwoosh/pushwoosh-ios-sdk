 if !isEnabled {","            promptToEnableNotifications()","        } else if !hasAlert {","            promptToEnableAlerts()","        }","    }","","    private func promptToEnableNotifications() {","        let alert = UIAlertController(","            title: \"Enable Notifications\",","            message: \"You're missing out on important updates. Enable notifications in Settings.\",","            preferredStyle: .alert","        )","","        alert.addAction(UIAlertAction(title: \"Open Settings\", style: .default) { _ in","            if let settingsURL = URL(string: UIApplication.openSettingsURLString) {","                UIApplication.shared.open(settingsURL)","            }","        })","","        alert.addAction(UIAlertAction(title: \"Not Now\", style: .cancel))","","        UIApplication.topViewController()?.present(alert, animated: true)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"for more detailed status information.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"sections":[],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getRemoteNotificationStatus","interfaceLanguage":"occ"},"metadata":{"externalID":"c:objc(pl)PWConfiguration(cm)getRemoteNotificationStatus","roleHeading":"Type Method","role":"symbol","modules":[{"name":"PushwooshCore"}],"title":"getRemoteNotificationStatus","navigatorTitle":[{"kind":"identifier","text":"getRemoteNotificationStatus"}],"symbolKind":"method","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"getRemoteNotificationStatus"}]},"kind":"symbol","abstract":[{"type":"text","text":"Returns dictionary with enabled remote notification types."}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/Pushwoos