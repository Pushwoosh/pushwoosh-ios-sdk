bled overall","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which notification types are allowed (alert, badge, sound)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The authorization status"}]}]}]},{"text":"Dictionary Keys","level":2,"anchor":"Dictionary-Keys","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"enabled"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bool"}]}],[{"inlineContent":[{"text":"Whether notifications are enabled","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"pushAlert","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Bool","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Whether alert banners are allowed"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"pushBadge","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bool"}]}],[{"inlineContent":[{"type":"text","text":"Whether badge updates are allowed"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"pushSound"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Bool","type":"text"}]}],[{"inlineContent":[{"text":"Whether notification sounds are allowed","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"type"}]}],[{"inlineContent":[{"text":"Int","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Combined notification type bitmask"}],"type":"paragraph"}]]],"type":"table"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"inlineContent":[{"text":"Check notification status and prompt user if disabled:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class NotificationStatusManager {","","    func checkAndPromptForNotifications() {","        guard let status = Pushwoosh.configure.getRemoteNotificationStatus() else {","            Logger.warning(\"Could not retrieve notification status\")","            return","        }","","        let isEnabled = status[\"enabled\"] as? Bool ?? false","        let hasAlert = status[\"pushAlert\"] as? Bool ?? false","        let hasBadge = status[\"pushBadge\"] as? Bool ?? false","        let hasSound = status[\"pushSound\"] as? Bool ?? false","","        Logger.debug(\"\"\"","            Notification Status:","            - Enabled: \\(isEnabled)","            - Alert: \\(hasAlert)","            - Badge: \\(hasBadge)","            - Sound: \\(hasSound)","            \"\"\")","","        if !isEnabled {","            promptToEnableNotifications()","        } else if !hasAlert {","            promptToEnableAlerts()","        }","    }","","    private func promptToEnableNotifications() {","        let alert = UIAlertController(","            title: \"Enable Notifications\",","            message: \"You're missing out on important updates. Enable notifications in Settings.\",","            preferredStyle: .alert","        )","","        alert.addAction(UIAlertAction(title: \"Open Settings\", style: .default) { _ in","            if let settingsURL = URL(string: UIApplication.openSettingsURLString) {","                UIApplication.shared.open(settingsURL)","            }","        })","","        alert.addAction(UIAlertAction(title: \"Not Now\", style: .cancel))","","        UIApplication.topViewController()?.present(alert, animated: true)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"for more detailed status information.","type":"text"}]}],"kind":"content"}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore","type":"topic","title":"PushwooshCore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","kind":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","type":"topic","abstract":[],"fragments":[{"kind":"identifier","text":"PWConfiguration"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration","kind":"symbol","title":"PWConfiguration","role":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/getRemoteNotificationStatus":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getRemoteNotificationStatus","url":"\/documentation\/pushwooshcore\/pwconfiguration\/getremotenotificationstatus","kind":"symbol","abstract":[{"type":"text","text":"Returns dictionary with enabled remote notification types."}],"role":"symbol","fragments":[{"text":"+ ","kind":"text"},{"text":"getRemoteNotificationStatus","kind":"identifier"}],"navigatorTitle":[{"text":"getRemoteNotificationStatus","kind":"identifier"}],"title":"getRemoteNotificationStatus","type":"topic"}}}