xt"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Dictionary Keys","anchor":"Dictionary-Keys","level":2,"type":"heading"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"enabled","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Bool","type":"text"}]}],[{"inlineContent":[{"text":"Whether notifications are enabled","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"pushAlert","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Bool"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether alert banners are allowed"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"pushBadge","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Bool"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Whether badge updates are allowed","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"pushSound","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bool"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether notification sounds are allowed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"type"}]}],[{"inlineContent":[{"type":"text","text":"Int"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combined notification type bitmask"}]}]]]},{"level":2,"anchor":"Example","type":"heading","text":"Example"},{"inlineContent":[{"text":"Check notification status and prompt user if disabled:","type":"text"}],"type":"paragraph"},{"code":["class NotificationStatusManager {","","    func checkAndPromptForNotifications() {","        guard let status = Pushwoosh.configure.getRemoteNotificationStatus() else {","            Logger.warning(\"Could not retrieve notification status\")","            return","        }","","        let isEnabled = status[\"enabled\"] as? Bool ?? false","        let hasAlert = status[\"pushAlert\"] as? Bool ?? false","        let hasBadge = status[\"pushBadge\"] as? Bool ?? false","        let hasSound = status[\"pushSound\"] as? Bool ?? false","","        Logger.debug(\"\"\"","            Notification Status:","            - Enabled: \\(isEnabled)","            - Alert: \\(hasAlert)","            - Badge: \\(hasBadge)","            - Sound: \\(hasSound)","            \"\"\")","","        if !isEnabled {","            promptToEnableNotifications()","        } else if !hasAlert {","            promptToEnableAlerts()","        }","    }","","    private func promptToEnableNotifications() {","        let alert = UIAlertController(","            title: \"Enable Notifications\",","            message: \"You're missing out on important updates. Enable notifications in Settings.\",","            preferredStyle: .alert","        )","","        alert.addAction(UIAlertAction(title: \"Open Settings\", style: .default) { _ in","            if let settingsURL = URL(string: UIApplication.openSettingsURLString) {","                UIApplication.shared.open(settingsURL)","            }","        })","","        alert.addAction(UIAlertAction(title: \"Not Now\", style: .cancel))","","        UIApplication.topViewController()?.present(alert, animated: true)","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"for more detailed status information."}]}]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getRemoteNotificationStatus","interfaceLanguage":"occ"},"abstract":[{"text":"Returns dictionary with enabled remote notification types.","type":"text"}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/Pushwoos