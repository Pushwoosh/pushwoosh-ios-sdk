{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getRemoteNotificationStatus","interfaceLanguage":"occ"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSDictionary","text":"NSDictionary","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"kind":"identifier","text":"getRemoteNotificationStatus"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"inlineContent":[{"text":"Dictionary containing notification status information, or nil if unavailable","type":"text"}],"type":"paragraph"}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Provides detailed information about the current notification settings for the app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Whether notifications are enabled overall","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which notification types are allowed (alert, badge, sound)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The authorization status"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Dictionary-Keys","type":"heading","text":"Dictionary Keys"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"enabled"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Bool","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether notifications are enabled"}]}]],[[{"inlineContent":[{"code":"pushAlert","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bool"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether alert banners are allowed"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"pushBadge"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Bool","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether badge updates are allowed"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"pushSound"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Bool","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Whether notification sounds are allowed","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"type","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Int"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combined notification type bitmask"}]}]]]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Check notification status and prompt user if disabled:"}]},{"syntax":"swift","code":["class NotificationStatusManager {","","    func checkAndPromptForNotifications() {","        guard let status = Pushwoosh.configure.getRemoteNotificationStatus() else {","            Logger.warning(\"Could not retrieve notification status\")","            return","        }","","        let isEnabled = status[\"enabled\"] as? Bool ?? false","        let hasAlert = status[\"pushAlert\"] as? Bool ?? false","        let hasBadge = status[\"pushBadge\"] as? Bool ?? false","        let hasSound = status[\"pushSound\"] as? Bool ?? false","","        Logger.debug(\"\"\"","            Notification Status:","            - Enabled: \\(isEnabled)","            - Alert: \\(hasAlert)","            - Badge: \\(hasBadge)","            - Sound: \\(hasSound)","            \"\"\")","","        if !isEnabled {","            promptToEnableNotifications()","        } else if !hasAlert {","            promptToEnableAlerts()","        }","    }","","    private func promptToEnableNotifications() {","        let alert = UIAlertController(","            title: \"Enable Notifications\",","            message: \"You're missing out on important updates. Enable notifications in Settings.\",","            preferredStyle: .alert","        )","","        alert.addAction(UIAlertAction(title: \"Open Settings\", style: .default) { _ in","            if let settingsURL = URL(string: UIApplication.openSettingsURLString) {","                UIApplication.shared.open(settingsURL)","            }","        })","","        alert.addAction(UIAlertAction(title: \"Not Now\", style: .cancel))","","        UIApplication.topViewController()?.present(alert, animated: true)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"for more detailed status information.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Type Method","modules":[{"name":"PushwooshCore"}],"navigatorTitle":[{"text":"getRemoteNotificationStatus","kind":"identifier"}],"title":"getRemoteNotificationStatus","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"getRemoteNotificationStatus"}],"role":"symbol","symbolKind":"method","externalID":"c:objc(pl)PWConfiguration(cm)getRemoteNotificationStatus"},"sections":[],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/getremotenotificationstatus"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"abstract":[{"type":"text","text":"Returns dictionary with enabled remote notification types."}],"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshCore/documentation/Pushwoos