{"kind":"symbol","metadata":{"externalID":"c:objc(pl)PWConfiguration(cm)startServerCommunication","role":"symbol","symbolKind":"method","navigatorTitle":[{"text":"startServerCommunication","kind":"identifier"}],"modules":[{"name":"PushwooshCore"}],"title":"startServerCommunication","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"startServerCommunication"}],"roleHeading":"Type Method"},"abstract":[{"type":"text","text":"Enables communication with Pushwoosh servers."}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/startServerCommunication","interfaceLanguage":"occ"},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"kind":"text","text":") "},{"kind":"identifier","text":"startServerCommunication"},{"text":";","kind":"text"}],"languages":["occ"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Starts or resumes communication with Pushwoosh servers. This allows the SDK to send and receive","type":"text"},{"type":"text","text":" "},{"type":"text","text":"data including device registration, tags, push tokens, and analytics."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this method after the user has consented to data collection, or to re-enable"},{"text":" ","type":"text"},{"text":"communication after it was previously stopped.","type":"text"}]},{"level":2,"anchor":"Example","text":"Example","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Enable communication after GDPR consent:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["class ConsentManager {","","    func handleUserConsent(accepted: Bool) {","        if accepted {","            \/\/ User accepted data collection","            Pushwoosh.configure.startServerCommunication()","","            \/\/ Register for push after consent","            Pushwoosh.configure.registerForPushNotifications()","","            \/\/ Sync any pending user data","            syncPendingUserData()","","            Logger.info(\"User consented - Pushwoosh communication enabled\")","        } else {","            \/\/ User declined - disable communication","            Pushwoosh.configure.stopServerCommunication()","            Logger.info(\"User declined - Pushwoosh communication disabled\")","        }","","        UserDefaults.standard.set(accepted, forKey: \"gdprConsent\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"called ","type":"text"},{"type":"codeVoice","code":"stopServerCommunication"},{"type":"text","text":"."}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/startservercommunication"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/startServerCommunication":{"role":"symbol","fragments":[{"text":"+ ","kind":"text"},{"text":"startServerCommunication","kind":"identifier"}],"title":"startServerCommunication","navigatorTitle":[{"kind":"identifier","text":"startServerCommunication"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration\/startservercommunication","abstract":[{"text":"Enables communication with Pushwoosh servers.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/startServerCommunication"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/document