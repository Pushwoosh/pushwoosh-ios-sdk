{"abstract":[{"text":"Sets the delegate for in-app purchase events from rich media.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"kind":"text","text":") "},{"text":"setPurchaseDelegate:","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:Qoobjc(pl)PWPurchaseDelegate","text":"id<PWPurchaseDelegate>","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"delegate","kind":"internalParam"},{"kind":"text","text":";"}],"platforms":["iOS"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Object implementing PWPurchaseDelegate protocol, or nil to remove the delegate"}],"type":"paragraph"}],"name":"delegate"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The delegate will receive callbacks for in-app purchase events triggered from"},{"text":" ","type":"text"},{"type":"text","text":"Pushwoosh rich media content (HTML pages, in-app messages)."}]},{"type":"paragraph","inlineContent":[{"text":"This enables:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handling promoted purchases from the App Store"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Processing purchases initiated from rich media"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tracking purchase completions and failures"}]}]},{"content":[{"inlineContent":[{"text":"Restoring previous purchases","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle in-app purchases from rich media:"}]},{"code":["class PurchaseCoordinator: NSObject, PWPurchaseDelegate {","","    static let shared = PurchaseCoordinator()","","    func setup() {","        Pushwoosh.configure.setPurchaseDelegate(self)","    }","","    \/\/ MARK: - PWPurchaseDelegate","","    func onPW(inAppPurchaseHelperCallPromotedPurchase identifier: String) {","        Logger.info(\"Promoted purchase initiated: \\(identifier)\")","","        \/\/ Verify user is ready to purchase","        guard UserSession.shared.isLoggedIn else {","            \/\/ Save for later and prompt login","            PendingPurchaseManager.shared.save(identifier)","            NavigationCoordinator.shared.showLogin(reason: .purchase)","            return","        }","","        \/\/ Process the purchase","        IAPManager.shared.purchase(productIdentifier: identifier)","    }","","    func onPWInAppPurchaseHelperPaymentComplete(_ identifier: String) {","        Logger.info(\"Purchase completed: \\(identifier)\")","","        \/\/ Update user status","        Pushwoosh.configure.setTags([","            \"last_purchase\": identifier,","            \"last_purchase_date\": Date(),","            \"has_purchased\": true","        ])","","        \/\/ Unlock content","        ContentUnlocker.shared.unlock(identifier)","","        \/\/ Track in analytics","        Analytics.track(\"purchase_completed\", properties: [","            \"product_id\": identifier,","            \"source\": \"rich_media\"","        ])","    }","","    func onPWInAppPurchaseHelperPaymentFailedProductIdentifier(_ identifier: String, error: Error) {","        Logger.error(\"Purchase failed: \\(identifier) - \\(error.localizedDescription)\")","","        Analytics.track(\"purchase_failed\", properties: [","            \"product_id\": identifier,","            \"error\": error.localizedDescription","        ])","    }","}"],"type":"codeListing","syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setpurchasedelegate:"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"roleHeading":"Type Method","externalID":"c:objc(pl)PWConfiguration(cm)setPurchaseDelegate:","modules":[{"name":"PushwooshCore"}],"title":"setPurchaseDelegate:","symbolKind":"method","role":"symbol","navigatorTitle":[{"text":"setPurchaseDelegate:","kind":"identifier"}],"fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"setPurchaseDelegate:"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setPurchaseDelegate:","interfaceLanguage":"occ"},"sections":[],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setPurchaseDelegate:":{"abstract":[{"type":"text","text":"Sets the delegate for in-app purchase events from rich media."}],"url":"\/documentation\/pushwooshcore\/pwconfiguration\/setpurchasedelegate:","kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setPurchaseDelegate:","title":"setPurchaseDelegate:","navigatorTitle":[{"text":"setPurchaseDelegate:","kind":"identifier"}],"role":"symbol","type":"topic","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"setPurchaseDelegate:"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","kind":"symbol","title":"PushwooshCore","url":"\/documentation\/pushwooshcore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"type":"topic","role":"collection"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"abstract":[],"type":"topic","url":"\/documentation\/pushwooshcore\/pwconfiguration","kind":"symbol","role":"symbol"}}}