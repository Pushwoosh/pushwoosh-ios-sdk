{"abstract":[{"type":"text","text":"Associates an email address with the current device."}],"metadata":{"modules":[{"name":"PushwooshCore"}],"roleHeading":"Type Method","navigatorTitle":[{"text":"setEmail:","kind":"identifier"}],"title":"setEmail:","symbolKind":"method","role":"symbol","fragments":[{"text":"+ ","kind":"text"},{"text":"setEmail:","kind":"identifier"}],"externalID":"c:objc(pl)PWConfiguration(cm)setEmail:"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setemail:"]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"kind":"text","text":"+ ("},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"setEmail:","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier","text":"NSString"},{"text":" *) ","kind":"text"},{"kind":"internalParam","text":"email"},{"text":";","kind":"text"}],"platforms":["iOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The user’s email address (must be valid and non-empty)","type":"text"}],"type":"paragraph"}],"name":"email"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register an email for the current user to enable:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Email-based campaigns and targeting"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross-device user identification","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Email channel for multi-channel messaging","type":"text"}]}]}]},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set email after user verification:"}]},{"code":["class UserAccountManager {","","    func handleEmailVerification(email: String, verificationCode: String) async throws {","        \/\/ Verify email with backend","        try await APIClient.shared.verifyEmail(email: email, code: verificationCode)","","        \/\/ Update Pushwoosh with verified email","        Pushwoosh.configure.setEmail(email)","","        \/\/ Update tags to reflect verified status","        Pushwoosh.configure.setTags([","            \"email_verified\": true,","            \"email_verified_date\": Date()","        ])","","        Logger.info(\"Email verified and synced with Pushwoosh: \\(email)\")","    }","","    func handleProfileUpdate(email: String?, phone: String?) {","        if let email = email, !email.isEmpty {","            Pushwoosh.configure.setEmail(email)","        }","","        \/\/ Update other contact methods via tags","        var tags: [String: Any] = [:]","        if let phone = phone {","            tags[\"phone_number\"] = phone","        }","        if !tags.isEmpty {","            Pushwoosh.configure.setTags(tags)","        }","    }","}"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setEmail:"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore","type":"topic","title":"PushwooshCore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","kind":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"identifier":"doc:\/\/