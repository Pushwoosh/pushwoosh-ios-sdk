{"kind":"symbol","identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setEmail:"},"abstract":[{"text":"Associates an email address with the current device.","type":"text"}],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setemail:"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"method","roleHeading":"Type Method","modules":[{"name":"PushwooshCore"}],"title":"setEmail:","navigatorTitle":[{"text":"setEmail:","kind":"identifier"}],"externalID":"c:objc(pl)PWConfiguration(cm)setEmail:","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"setEmail:"}],"role":"symbol"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"text":") ","kind":"text"},{"text":"setEmail:","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSString","text":"NSString","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"email","kind":"internalParam"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS"]}]},{"kind":"parameters","parameters":[{"name":"email","content":[{"type":"paragraph","inlineContent":[{"text":"The user’s email address (must be valid and non-empty)","type":"text"}]}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register an email for the current user to enable:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Email-based campaigns and targeting"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross-device user identification"}]}]},{"content":[{"inlineContent":[{"text":"Email channel for multi-channel messaging","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"inlineContent":[{"type":"text","text":"Set email after user verification:"}],"type":"paragraph"},{"type":"codeListing","code":["class UserAccountManager {","","    func handleEmailVerification(email: String, verificationCode: String) async throws {","        \/\/ Verify email with backend","        try await APIClient.shared.verifyEmail(email: email, code: verificationCode)","","        \/\/ Update Pushwoosh with verified email","        Pushwoosh.configure.setEmail(email)","","        \/\/ Update tags to reflect verified status","        Pushwoosh.configure.setTags([","            \"email_verified\": true,","            \"email_verified_date\": Date()","        ])","","        Logger.info(\"Email verified and synced with Pushwoosh: \\(email)\")","    }","","    func handleProfileUpdate(email: String?, phone: String?) {","        if let email = email, !email.isEmpty {","            Pushwoosh.configure.setEmail(email)","        }","","        \/\/ Update other contact methods via tags","        var tags: [String: Any] = [:]","        if let phone = phone {","            tags[\"phone_number\"] = phone","        }","        if !tags.isEmpty {","            Pushwoosh.configure.setTags(tags)","        }","    }","}"],"syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"abstract":[],"title":"PWConfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","role":"symbol","type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCo