{"kind":"symbol","abstract":[{"type":"text","text":"Associates an email address with the current device."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"kind":"identifier","text":"setEmail:"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString","text":"NSString"},{"text":" *) ","kind":"text"},{"kind":"internalParam","text":"email"},{"kind":"text","text":";"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user’s email address (must be valid and non-empty)"}]}],"name":"email"}],"kind":"parameters"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register an email for the current user to enable:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Email-based campaigns and targeting","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross-device user identification"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Email channel for multi-channel messaging"}]}]}],"type":"unorderedList"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set email after user verification:"}]},{"syntax":"swift","type":"codeListing","code":["class UserAccountManager {","","    func handleEmailVerification(email: String, verificationCode: String) async throws {","        \/\/ Verify email with backend","        try await APIClient.shared.verifyEmail(email: email, code: verificationCode)","","        \/\/ Update Pushwoosh with verified email","        Pushwoosh.configure.setEmail(email)","","        \/\/ Update tags to reflect verified status","        Pushwoosh.configure.setTags([","            \"email_verified\": true,","            \"email_verified_date\": Date()","        ])","","        Logger.info(\"Email verified and synced with Pushwoosh: \\(email)\")","    }","","    func handleProfileUpdate(email: String?, phone: String?) {","        if let email = email, !email.isEmpty {","            Pushwoosh.configure.setEmail(email)","        }","","        \/\/ Update other contact methods via tags","        var tags: [String: Any] = [:]","        if let phone = phone {","            tags[\"phone_number\"] = phone","        }","        if !tags.isEmpty {","            Pushwoosh.configure.setTags(tags)","        }","    }","}"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setemail:"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"metadata":{"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"setEmail:"}],"roleHeading":"Type Method","symbolKind":"method","title":"setEmail:","externalID":"c:objc(pl)PWConfiguration(cm)setEmail:","navigatorTitle":[{"kind":"identifier","text":"setEmail:"}],"role":"symbol","modules":[{"name":"PushwooshCore"}]},"sections":[],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setEmail:","interfaceLanguage":"occ"},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"abstract":[{"text":"Protocol defining SDK configuration methods.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","fragments":[{"text":"PWConfiguration","kind":"identi