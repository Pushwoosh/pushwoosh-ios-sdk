{"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAdvertisingId:","interfaceLanguage":"occ"},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"text":"Sets the advertising identifier (IDFA) for the device.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"kind":"typeIdentifier","text":"void","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"kind":"identifier","text":"setAdvertisingId:"},{"kind":"text","text":"("},{"text":"NSString","preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier"},{"kind":"text","text":" *) "},{"text":"advertisingId","kind":"internalParam"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"parameters":[{"name":"advertisingId","content":[{"inlineContent":[{"type":"text","text":"The advertising identifier string, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to clear it."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The SDK does not collect IDFA automatically. The integrator is responsible for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"requesting user consent via "},{"type":"codeVoice","code":"ATTrackingManager.requestTrackingAuthorization"},{"type":"text","text":" and"},{"type":"text","text":" "},{"text":"passing the resulting identifier to the SDK.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Pass "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", an empty string, or the zero UUID"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"codeVoice","code":"\"00000000-0000-0000-0000-000000000000\""},{"text":") to clear the identifier on the backend.","type":"text"},{"text":" ","type":"text"},{"text":"The zero UUID is what ","type":"text"},{"type":"codeVoice","code":"ASIdentifierManager.advertisingIdentifier"},{"text":" returns when","type":"text"},{"text":" ","type":"text"},{"text":"tracking is denied or restricted — the SDK normalizes it to ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" automatically."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fire-and-forget: no completion handler. The SDK retries on transient failures.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Deduplicated: repeated calls with the same value do not produce additional","type":"text"},{"type":"text","text":" "},{"text":"network requests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value is persisted locally only after a successful send and read back on"},{"type":"text","text":" "},{"text":"subsequent launches for the dedupe check.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"By default the IDFA is sent to ","type":"text"},{"type":"codeVoice","code":"https:\/\/tracking.svc-nue.pushwoosh.com\/api\/v2\/device-api\/setMADID"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"You can override the tracking endpoint via the "},{"type":"codeVoice","code":"Pushwoosh_TRACKING_URL"},{"text":" ","type":"text"},{"type":"text","text":"Info.plist key (useful for on-premise deployments and integration testing)."}]},{"level":2,"text":"App Store submission requirement","anchor":"App-Store-submission-requirement","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple requires that any tracking domain be declared in the "},{"type":"strong","inlineContent":[{"type":"text","text":"integrator’s"}]},{"type":"text","text":" "},{"text":"app-level ","type":"text"},{"type":"codeVoice","code":"PrivacyInfo.xcprivacy"},{"text":":","type":"text"}]},{"code":["<key>NSPrivacyTracking<\/key>","<true\/>","<key>NSPrivacyTrackingDomains<\/key>","<array>","    <string>tracking.svc-nue.pushwoosh.com<\/string>","<\/array>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you override "},{"type":"codeVoice","code":"Pushwoosh_TRACKING_URL"},{"type":"text","text":", list "},{"inlineContent":[{"type":"text","text":"your"}],"type":"strong"},{"type":"text","text":" host instead. Apps that"},{"text":" ","type":"text"},{"type":"text","text":"ship without this declaration will be blocked by iOS on non-authorized devices"},{"text":" ","type":"text"},{"text":"and may face App Store review issues.","type":"text"}]},{"inlineContent":[{"text":"You must also add ","type":"text"},{"type":"codeVoice","code":"NSUserTrackingUsageDescription"},{"type":"text","text":" to "},{"code":"Info.plist","type":"codeVoice"},{"text":" — it is the","type":"text"},{"text":" ","type":"text"},{"text":"text displayed in the ATT consent prompt.","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"code":["import AppTrackingTransparency","import AdSupport","","ATTrackingManager.requestTrackingAuthorization { status in","    if status == .authorized {","        let idfa = ASIdentifierManager.shared().advertisingIdentifier.uuidString","        Pushwoosh.configure.setAdvertisingId(idfa)","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To clear:"}]},{"code":["Pushwoosh.configure.setAdvertisingId(nil)"],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"PushwooshCore"}],"fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"setAdvertisingId:"}],"externalID":"c:objc(pl)PWConfiguration(cm)setAdvertisingId:","role":"symbol","