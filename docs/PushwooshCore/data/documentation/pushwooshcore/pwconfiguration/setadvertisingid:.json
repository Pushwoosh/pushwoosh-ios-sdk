{"kind":"symbol","abstract":[{"type":"text","text":"Sets the advertising identifier (IDFA) for the device."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"text":") ","kind":"text"},{"kind":"identifier","text":"setAdvertisingId:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"NSString","preciseIdentifier":"c:objc(cs)NSString"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"advertisingId"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The advertising identifier string, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to clear it."}]}],"name":"advertisingId"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The SDK does not collect IDFA automatically. The integrator is responsible for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"requesting user consent via "},{"type":"codeVoice","code":"ATTrackingManager.requestTrackingAuthorization"},{"text":" and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"passing the resulting identifier to the SDK."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"code":"nil","type":"codeVoice"},{"text":", an empty string, or the zero UUID","type":"text"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"\"00000000-0000-0000-0000-000000000000\""},{"type":"text","text":") to clear the identifier on the backend."},{"type":"text","text":" "},{"type":"text","text":"The zero UUID is what "},{"type":"codeVoice","code":"ASIdentifierManager.advertisingIdentifier"},{"type":"text","text":" returns when"},{"type":"text","text":" "},{"type":"text","text":"tracking is denied or restricted — the SDK normalizes it to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Fire-and-forget: no completion handler. The SDK retries on transient failures."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Deduplicated: repeated calls with the same value do not produce additional","type":"text"},{"text":" ","type":"text"},{"text":"network requests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The value is persisted locally only after a successful send and read back on","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"subsequent launches for the dedupe check."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"By default the IDFA is sent to "},{"type":"codeVoice","code":"https:\/\/tracking.svc-nue.pushwoosh.com\/api\/v2\/device-api\/setMADID"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"You can override the tracking endpoint via the "},{"type":"codeVoice","code":"Pushwoosh_TRACKING_URL"},{"text":" ","type":"text"},{"type":"text","text":"Info.plist key (useful for on-premise deployments and integration testing)."}],"type":"paragraph"},{"type":"heading","anchor":"App-Store-submission-requirement","level":2,"text":"App Store submission requirement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple requires that any tracking domain be declared in the "},{"type":"strong","inlineContent":[{"text":"integrator’s","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"app-level "},{"code":"PrivacyInfo.xcprivacy","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["<key>NSPrivacyTracking<\/key>","<true\/>","<key>NSPrivacyTrackingDomains<\/key>","<array>","    <string>tracking.svc-nue.pushwoosh.com<\/string>","<\/array>"],"syntax":"xml"},{"type":"paragraph","inlineContent":[{"text":"If you override ","type":"text"},{"type":"codeVoice","code":"Pushwoosh_TRACKING_URL"},{"type":"text","text":", list "},{"type":"strong","inlineContent":[{"text":"your","type":"text"}]},{"type":"text","text":" host instead. Apps that"},{"text":" ","type":"text"},{"type":"text","text":"ship without this declaration will be blocked by iOS on non-authorized devices"},{"text":" ","type":"text"},{"type":"text","text":"and may face App Store review issues."}]},{"inlineContent":[{"text":"You must also add ","type":"text"},{"code":"NSUserTrackingUsageDescription","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" — it is the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"text displayed in the ATT consent prompt."}],"type":"paragraph"},{"text":"Example","type":"heading","anchor":"Example","level":2},{"code":["import AppTrackingTransparency","import AdSupport","","ATTrackingManager.requestTrackingAuthorization { status in","    if status == .authorized {","        let idfa = ASIdentifierManager.shared().advertisingIdentifier.uuidString","        Pushwoosh.configure.setAdvertisingId(idfa)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"To clear:"}],"type":"paragraph"},{"code":["Pushwoosh.configure.setAdvertisingId(nil)"],"type":"codeListing","syntax":"swift"}]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"setAdvertisingId:"}],"symbolKind":"method","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"setAdvertisingId:"}],"roleHeading":"Type Method","title":"setAdvertisingId:","modules":[{"name":"PushwooshCore"}],"role":"symbol","externalID":"c:objc(pl)PWConfiguration(cm)setAdvertisingId:"},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"patch":0,"minor":3,