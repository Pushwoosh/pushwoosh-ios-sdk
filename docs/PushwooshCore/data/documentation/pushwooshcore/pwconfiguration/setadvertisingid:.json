{"sections":[],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAdvertisingId:"},"metadata":{"symbolKind":"method","externalID":"c:objc(pl)PWConfiguration(cm)setAdvertisingId:","fragments":[{"text":"+ ","kind":"text"},{"text":"setAdvertisingId:","kind":"identifier"}],"navigatorTitle":[{"text":"setAdvertisingId:","kind":"identifier"}],"title":"setAdvertisingId:","role":"symbol","modules":[{"name":"PushwooshCore"}],"roleHeading":"Type Method"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"setAdvertisingId:"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSString","text":"NSString","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"advertisingId","kind":"internalParam"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS"]}],"kind":"declarations"},{"parameters":[{"name":"advertisingId","content":[{"inlineContent":[{"type":"text","text":"The advertising identifier string, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to clear it."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"The SDK does not collect IDFA automatically. The integrator is responsible for","type":"text"},{"text":" ","type":"text"},{"text":"requesting user consent via ","type":"text"},{"type":"codeVoice","code":"ATTrackingManager.requestTrackingAuthorization"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"passing the resulting identifier to the SDK."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", an empty string, or the zero UUID","type":"text"},{"type":"text","text":" "},{"text":"(","type":"text"},{"type":"codeVoice","code":"\"00000000-0000-0000-0000-000000000000\""},{"text":") to clear the identifier on the backend.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The zero UUID is what "},{"code":"ASIdentifierManager.advertisingIdentifier","type":"codeVoice"},{"type":"text","text":" returns when"},{"type":"text","text":" "},{"text":"tracking is denied or restricted — the SDK normalizes it to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Fire-and-forget: no completion handler. The SDK retries on transient failures.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deduplicated: repeated calls with the same value do not produce additional"},{"type":"text","text":" "},{"type":"text","text":"network requests."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The value is persisted locally only after a successful send and read back on"},{"type":"text","text":" "},{"type":"text","text":"subsequent launches for the dedupe check."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default the IDFA is sent to "},{"code":"https:\/\/tracking.svc-nue.pushwoosh.com\/api\/v2\/device-api\/setMADID","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"You can override the tracking endpoint via the ","type":"text"},{"type":"codeVoice","code":"Pushwoosh_TRACKING_URL"},{"text":" ","type":"text"},{"type":"text","text":"Info.plist key (useful for on-premise deployments and integration testing)."}]},{"type":"heading","text":"App Store submission requirement","anchor":"App-Store-submission-requirement","level":2},{"inlineContent":[{"type":"text","text":"Apple requires that any tracking domain be declared in the "},{"type":"strong","inlineContent":[{"text":"integrator’s","type":"text"}]},{"type":"text","text":" "},{"text":"app-level ","type":"text"},{"type":"codeVoice","code":"PrivacyInfo.xcprivacy"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"xml","code":["<key>NSPrivacyTracking<\/key>","<true\/>","<key>NSPrivacyTrackingDomains<\/key>","<array>","    <string>tracking.svc-nue.pushwoosh.com<\/string>","<\/array>"]},{"inlineContent":[{"type":"text","text":"If you override "},{"type":"codeVoice","code":"Pushwoosh_TRACKING_URL"},{"type":"text","text":", list "},{"type":"strong","inlineContent":[{"text":"your","type":"text"}]},{"type":"text","text":" host instead. Apps that"},{"type":"text","text":" "},{"type":"text","text":"ship without this declaration will be blocked by iOS on non-authorized devices"},{"type":"text","text":" "},{"text":"and may face App Store review issues.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You must also add "},{"code":"NSUserTrackingUsageDescription","type":"codeVoice"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" — it is the"},{"text":" ","type":"text"},{"type":"text","text":"text displayed in the ATT consent prompt."}],"type":"paragraph"},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"code":["import AppTrackingTransparency","import AdSupport","","ATTrackingManager.requestTrackingAuthorization { status in","    if status == .authorized {","        let idfa = ASIdentifierManager.shared().advertisingIdentifier.uuidString","        Pushwoosh.configure.setAdvertisingId(idfa)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To clear:"}]},{"code":["Pushwoosh.configure.setAdvertisingId(nil)"],"type":"codeListing","syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","abstract":[{"type":"text","text":"Sets the advertising identifier (IDFA) for the device."}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"abstract":[{"text":"Protocol defining SDK configuration methods.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore","kind":"symbol","title":"PushwooshCore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setAdvertisingId:":{"title":"setAdvertisingId:","abstract":[{"type":"text","text":"Sets the advertising identifier (IDFA) for the device."}],"role":"symbol","navigatorTitle":[{"text":"setAdvertisingId:","kind":"identifier"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAdvertisingId:","url":"\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"setAdvertisingId:"}],"type":"topic","kind":"symbol"}}}