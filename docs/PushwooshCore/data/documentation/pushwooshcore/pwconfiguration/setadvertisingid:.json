{"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:"]}],"abstract":[{"text":"Sets the advertising identifier (IDFA) for the device.","type":"text"}],"metadata":{"title":"setAdvertisingId:","role":"symbol","roleHeading":"Type Method","modules":[{"name":"PushwooshCore"}],"fragments":[{"text":"+ ","kind":"text"},{"text":"setAdvertisingId:","kind":"identifier"}],"symbolKind":"method","navigatorTitle":[{"kind":"identifier","text":"setAdvertisingId:"}],"externalID":"c:objc(pl)PWConfiguration(cm)setAdvertisingId:"},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAdvertisingId:"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"text":") ","kind":"text"},{"text":"setAdvertisingId:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSString","preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"kind":"internalParam","text":"advertisingId"},{"text":";","kind":"text"}]}]},{"parameters":[{"name":"advertisingId","content":[{"type":"paragraph","inlineContent":[{"text":"The advertising identifier string, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" to clear it.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The SDK does not collect IDFA automatically. The integrator is responsible for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"requesting user consent via "},{"type":"codeVoice","code":"ATTrackingManager.requestTrackingAuthorization"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"passing the resulting identifier to the SDK."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", an empty string, or the zero UUID"},{"type":"text","text":" "},{"text":"(","type":"text"},{"type":"codeVoice","code":"\"00000000-0000-0000-0000-000000000000\""},{"text":") to clear the identifier on the backend.","type":"text"},{"type":"text","text":" "},{"text":"The zero UUID is what ","type":"text"},{"type":"codeVoice","code":"ASIdentifierManager.advertisingIdentifier"},{"text":" returns when","type":"text"},{"type":"text","text":" "},{"type":"text","text":"tracking is denied or restricted — the SDK normalizes it to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" automatically."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Fire-and-forget: no completion handler. The SDK retries on transient failures.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Deduplicated: repeated calls with the same value do not produce additional"},{"type":"text","text":" "},{"type":"text","text":"network requests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The value is persisted locally only after a successful send and read back on"},{"text":" ","type":"text"},{"text":"subsequent launches for the dedupe check.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"By default the IDFA is sent to ","type":"text"},{"code":"https:\/\/tracking.svc-nue.pushwoosh.com\/api\/v2\/device-api\/setMADID","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"You can override the tracking endpoint via the "},{"code":"Pushwoosh_TRACKING_URL","type":"codeVoice"},{"type":"text","text":" "},{"text":"Info.plist key (useful for on-premise deployments and integration testing).","type":"text"}],"type":"paragraph"},{"anchor":"App-Store-submission-requirement","type":"heading","level":2,"text":"App Store submission requirement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple requires that any tracking domain be declared in the "},{"type":"strong","inlineContent":[{"type":"text","text":"integrator’s"}]},{"text":" ","type":"text"},{"text":"app-level ","type":"text"},{"code":"PrivacyInfo.xcprivacy","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["<key>NSPrivacyTracking<\/key>","<true\/>","<key>NSPrivacyTrackingDomains<\/key>","<array>","    <string>tracking.svc-nue.pushwoosh.com<\/string>","<\/array>"],"type":"codeListing","syntax":"xml"},{"inlineContent":[{"type":"text","text":"If you override "},{"type":"codeVoice","code":"Pushwoosh_TRACKING_URL"},{"type":"text","text":", list "},{"inlineContent":[{"type":"text","text":"your"}],"type":"strong"},{"text":" host instead. Apps that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"ship without this declaration will be blocked by iOS on non-authorized devices"},{"text":" ","type":"text"},{"type":"text","text":"and may face App Store review issues."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You must also add "},{"code":"NSUserTrackingUsageDescription","type":"codeVoice"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Info.plist"},{"text":" — it is the","type":"text"},{"type":"text","text":" "},{"text":"text displayed in the ATT consent prompt.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Example","text":"Example","level":2},{"code":["import AppTrackingTransparency","import AdSupport","","ATTrackingManager.requestTrackingAuthorization { status in","    if status == .authorized {","        let idfa = ASIdentifierManager.shared().advertisingIdentifier.uuidString","        Pushwoosh.configure.setAdvertisingId(idfa)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To clear:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.configure.setAdvertisingId(nil)"]}]}],"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setAdvertisingId:":{"role":"symbol","title":"setAdvertisingId:","navigatorTitle":[{"kind":"identifier","text":"setAdvertisingId:"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:","abstract":[{"text":"Sets the advertising identifier (IDFA) for the device.","type":"text"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAdvertisingId:","type":"topic","kind":"symbol","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"setAdvertisingId:"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"role":"symbol","title":"PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","abstract":[],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","type":"topic","kind":"symbol","fragments":[{"kind":"identifier","text":"PWConfiguration"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"title":"PushwooshCore","abstract":[{"text":"Core foundation module for Pushwoosh SDK.","type":"text"}],"url":"\/documentation\/pushwooshcore","role":"collection","kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","type":"topic"}}}