{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAdvertisingId:"},"sections":[],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Sets the advertising identifier (IDFA) for the device."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"text":"void","preciseIdentifier":"c:v","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"identifier","text":"setAdvertisingId:"},{"kind":"text","text":"("},{"text":"NSString","preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier"},{"kind":"text","text":" *) "},{"text":"advertisingId","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"]}]},{"parameters":[{"name":"advertisingId","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The advertising identifier string, or "},{"type":"codeVoice","code":"nil"},{"text":" to clear it.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The SDK does not collect IDFA automatically. The integrator is responsible for"},{"type":"text","text":" "},{"text":"requesting user consent via ","type":"text"},{"type":"codeVoice","code":"ATTrackingManager.requestTrackingAuthorization"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"type":"text","text":"passing the resulting identifier to the SDK."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", an empty string, or the zero UUID"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"\"00000000-0000-0000-0000-000000000000\""},{"type":"text","text":") to clear the identifier on the backend."},{"text":" ","type":"text"},{"type":"text","text":"The zero UUID is what "},{"code":"ASIdentifierManager.advertisingIdentifier","type":"codeVoice"},{"type":"text","text":" returns when"},{"text":" ","type":"text"},{"text":"tracking is denied or restricted — the SDK normalizes it to ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" automatically."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Behavior:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Fire-and-forget: no completion handler. The SDK retries on transient failures.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deduplicated: repeated calls with the same value do not produce additional"},{"type":"text","text":" "},{"type":"text","text":"network requests."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The value is persisted locally only after a successful send and read back on"},{"text":" ","type":"text"},{"type":"text","text":"subsequent launches for the dedupe check."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"By default the IDFA is sent to ","type":"text"},{"type":"codeVoice","code":"https:\/\/tracking.svc-nue.pushwoosh.com\/api\/v2\/device-api\/setMADID"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"You can override the tracking endpoint via the ","type":"text"},{"code":"Pushwoosh_TRACKING_URL","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"Info.plist key (useful for on-premise deployments and integration testing)."}],"type":"paragraph"},{"type":"heading","level":2,"text":"App Store submission requirement","anchor":"App-Store-submission-requirement"},{"type":"paragraph","inlineContent":[{"text":"Apple requires that any tracking domain be declared in the ","type":"text"},{"inlineContent":[{"type":"text","text":"integrator’s"}],"type":"strong"},{"type":"text","text":" "},{"text":"app-level ","type":"text"},{"code":"PrivacyInfo.xcprivacy","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"xml","code":["<key>NSPrivacyTracking<\/key>","<true\/>","<key>NSPrivacyTrackingDomains<\/key>","<array>","    <string>tracking.svc-nue.pushwoosh.com<\/string>","<\/array>"]},{"inlineContent":[{"text":"If you override ","type":"text"},{"code":"Pushwoosh_TRACKING_URL","type":"codeVoice"},{"text":", list ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"your"}]},{"text":" host instead. Apps that","type":"text"},{"type":"text","text":" "},{"text":"ship without this declaration will be blocked by iOS on non-authorized devices","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and may face App Store review issues."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You must also add ","type":"text"},{"type":"codeVoice","code":"NSUserTrackingUsageDescription"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Info.plist"},{"text":" — it is the","type":"text"},{"type":"text","text":" "},{"text":"text displayed in the ATT consent prompt.","type":"text"}]},{"level":2,"type":"heading","anchor":"Example","text":"Example"},{"type":"codeListing","code":["import AppTrackingTransparency","import AdSupport","","ATTrackingManager.requestTrackingAuthorization { status in","    if status == .authorized {","        let idfa = ASIdentifierManager.shared().advertisingIdentifier.uuidString","        Pushwoosh.configure.setAdvertisingId(idfa)","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"To clear:"}],"type":"paragraph"},{"syntax":"swift","code":["Pushwoosh.configure.setAdvertisingId(nil)"],"type":"codeListing"}]}],"metadata"