fo.xcprivacy","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["<key>NSPrivacyTracking<\/key>","<true\/>","<key>NSPrivacyTrackingDomains<\/key>","<array>","    <string>tracking.svc-nue.pushwoosh.com<\/string>","<\/array>"],"type":"codeListing","syntax":"xml"},{"inlineContent":[{"type":"text","text":"If you override "},{"code":"Pushwoosh_TRACKING_URL","type":"codeVoice"},{"text":", list ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"your"}]},{"text":" host instead. Apps that","type":"text"},{"type":"text","text":" "},{"text":"ship without this declaration will be blocked by iOS on non-authorized devices","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and may face App Store review issues."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You must also add "},{"code":"NSUserTrackingUsageDescription","type":"codeVoice"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" — it is the"},{"text":" ","type":"text"},{"type":"text","text":"text displayed in the ATT consent prompt."}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["import AppTrackingTransparency","import AdSupport","","ATTrackingManager.requestTrackingAuthorization { status in","    if status == .authorized {","        let idfa = ASIdentifierManager.shared().advertisingIdentifier.uuidString","        Pushwoosh.configure.setAdvertisingId(idfa)","    }","}"]},{"inlineContent":[{"type":"text","text":"To clear:"}],"type":"paragraph"},{"type":"codeListing","code":["Pushwoosh.configure.setAdvertisingId(nil)"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"abstract":[{"text":"Sets the advertising identifier (IDFA) for the device.","type":"text"}],"metadata"