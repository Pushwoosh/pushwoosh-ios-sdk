{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"setAdvertisingId:","role":"symbol","externalID":"c:objc(pl)PWConfiguration(cm)setAdvertisingId:","symbolKind":"method","roleHeading":"Type Method","modules":[{"name":"PushwooshCore"}],"fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"setAdvertisingId:"}],"navigatorTitle":[{"text":"setAdvertisingId:","kind":"identifier"}]},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAdvertisingId:","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"Sets the advertising identifier (IDFA) for the device."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"kind":"text","text":") "},{"kind":"identifier","text":"setAdvertisingId:"},{"kind":"text","text":"("},{"preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier","text":"NSString"},{"text":" *) ","kind":"text"},{"text":"advertisingId","kind":"internalParam"},{"text":";","kind":"text"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The advertising identifier string, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to clear it."}],"type":"paragraph"}],"name":"advertisingId"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"The SDK does not collect IDFA automatically. The integrator is responsible for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"requesting user consent via "},{"type":"codeVoice","code":"ATTrackingManager.requestTrackingAuthorizat