t":" "},{"type":"text","text":"requesting user consent via "},{"code":"ATTrackingManager.requestTrackingAuthorization","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"passing the resulting identifier to the SDK.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", an empty string, or the zero UUID"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"\"00000000-0000-0000-0000-000000000000\""},{"text":") to clear the identifier on the backend.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The zero UUID is what "},{"code":"ASIdentifierManager.advertisingIdentifier","type":"codeVoice"},{"type":"text","text":" returns when"},{"type":"text","text":" "},{"type":"text","text":"tracking is denied or restricted — the SDK normalizes it to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" automatically."}]},{"inlineContent":[{"type":"text","text":"Behavior:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fire-and-forget: no completion handler. The SDK retries on transient failures.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deduplicated: repeated calls with the same value do not produce additional"},{"type":"text","text":" "},{"text":"network requests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The value is persisted locally only after a successful send and read back on","type":"text"},{"text":" ","type":"text"},{"text":"subsequent launches for the dedupe check.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"By default the IDFA is sent to ","type":"text"},{"type":"codeVoice","code":"https:\/\/tracking.svc-nue.pushwoosh.com\/api\/v2\/device-api\/setMADID"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"You 