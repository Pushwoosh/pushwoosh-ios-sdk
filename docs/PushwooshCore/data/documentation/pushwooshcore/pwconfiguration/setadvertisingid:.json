{"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:"]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["occ"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","text":"void","preciseIdentifier":"c:v"},{"kind":"text","text":") "},{"kind":"identifier","text":"setAdvertisingId:"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier","text":"NSString"},{"text":" *) ","kind":"text"},{"kind":"internalParam","text":"advertisingId"},{"text":";","kind":"text"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The advertising identifier string, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to clear it."}]}],"name":"advertisingId"}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The SDK does not collect IDFA automatically. The integrator is responsible for","type":"text"},{"type":"text","text":" "},{"type":"text","text":"requesting user consent via "},{"code":"ATTrackingManager.requestTrackingAuthorization","type":"codeVoice"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"type":"text","text":"passing the resulting identifier to the SDK."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", an empty string, or the zero UUID"},{"type":"text","text":" "},{"text":"(","type":"text"},{"code":"\"00000000-0000-0000-0000-000000000000\"","type":"codeVoice"},{"type":"text","text":") to clear the identifier on the backend."},{"type":"text","text":" "},{"type":"text","text":"The zero UUID is what "},{"code":"ASIdentifierManager.advertisingIdentifier","type":"codeVoice"},{"text":" returns when","type":"text"},{"type":"text","text":" "},{"text":"tracking is denied or restricted — the SDK normalizes it to ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" automatically."}]},{"type":"paragraph","inlineContent":[{"text":"Behavior:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fire-and-forget: no completion handler. The SDK retries on transient failures."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deduplicated: repeated calls with the same value do not produce additional"},{"text":" ","type":"text"},{"type":"text","text":"network requests."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The value is persisted locally only after a successful send and read back on"},{"type":"text","text":" "},{"type":"text","text":"subsequent launches for the dedupe check."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default the IDFA is sent to "},{"type":"codeVoice","code":"https:\/\/tracking.svc-nue.pushwoosh.com\/api\/v2\/device-api\/setMADID"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"You can override the tracking endpoint via the "},{"type":"codeVoice","code":"Pushwoosh_TRACKING_URL"},{"type":"text","text":" "},{"type":"text","text":"Info.plist key (useful for on-premise deployments and integration testing)."}]},{"text":"App Store submission requirement","anchor":"App-Store-submission-requirement","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple requires that any tracking domain be declared in the "},{"inlineContent":[{"text":"integrator’s","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"text":"app-level ","type":"text"},{"type":"codeVoice","code":"PrivacyInfo.xcprivacy"},{"text":":","type":"text"}]},{"syntax":"xml","code":["<key>NSPrivacyTracking<\/key>","<true\/>","<key>NSPrivacyTrackingDomains<\/key>","<array>","    <string>tracking.svc-nue.pushwoosh.com<\/string>","<\/array>"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you override "},{"code":"Pushwoosh_TRACKING_URL","type":"codeVoice"},{"type":"text","text":", list "},{"type":"strong","inlineContent":[{"type":"text","text":"your"}]},{"type":"text","text":" host instead. Apps that"},{"type":"text","text":" "},{"text":"ship without this declaration will be blocked by iOS on non-authorized devices","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and may face App Store review issues."}],"type":"paragraph"},{"inlineContent":[{"text":"You must also add ","type":"text"},{"type":"codeVoice","code":"NSUserTrackingUsageDescription"},{"type":"text","text":" to "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" — it is the"},{"type":"text","text":" "},{"type":"text","text":"text displayed in the ATT consent prompt."}],"type":"paragraph"},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"code":["import AppTrackingTransparency","import AdSupport","","ATTrackingManager.requestTrackingAuthorization { status in","    if status == .authorized {","        let idfa = ASIdentifierManager.shared().advertisingIdentifier.uuidString","        Pushwoosh.configure.setAdvertisingId(idfa)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To clear:"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.configure.setAdvertisingId(nil)"]}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"kind":"symbol","abstract":[{"type":"text","text":"Sets the advertising identifier (IDFA) for the device."}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"externalID":"c:objc(pl)PWConfiguration(cm)setAdvertisingId:","navigatorTitle":[{"kind":"identifier","text":"setAdvertisingId:"}],"symbolKind":"metho