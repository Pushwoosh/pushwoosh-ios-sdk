":"text"},{"type":"text","text":"requesting user consent via "},{"code":"ATTrackingManager.requestTrackingAuthorization","type":"codeVoice"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"text":"passing the resulting identifier to the SDK.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":", an empty string, or the zero UUID"},{"text":" ","type":"text"},{"type":"text","text":"("},{"code":"\"00000000-0000-0000-0000-000000000000\"","type":"codeVoice"},{"text":") to clear the identifier on the backend.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The zero UUID is what "},{"code":"ASIdentifierManager.advertisingIdentifier","type":"codeVoice"},{"text":" returns when","type":"text"},{"type":"text","text":" "},{"type":"text","text":"tracking is denied or restricted — the SDK normalizes it to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" automatically."}]},{"inlineContent":[{"type":"text","text":"Behavior:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Fire-and-forget: no completion handler. The SDK retries on transient failures.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deduplicated: repeated calls with the same value do not produce additional"},{"type":"text","text":" "},{"type":"text","text":"network requests."}]}]},{"content":[{"inlineContent":[{"text":"The value is persisted locally only after a successful send and read back on","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"subsequent launches for the dedupe check."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"By default the IDFA is sent to "},{"type":"codeVoice","code":"https:\/\/tracking.svc-nue.pushwoosh.com\/api\/v2\/device-api\/setMADID"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"You can override the tracking endpoint via the "},{"code":"Pushwoosh_TRACKING_URL","type":"codeVoice"},{"text":" ","type":"text"},{"text":"Info.plist key (useful for on-premise deployments and integration testing).","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"App-Store-submission-requirement","type":"heading","text":"App Store submission requirement"},{"inlineContent":[{"text":"Apple requires that any tracking domain be declared in the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"integrator’s"}]},{"type":"text","text":" "},{"type":"text","text":"app-level "},{"type":"codeVoice","code":"PrivacyInfo.xcprivacy"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["<key>NSPrivacyTracking<\/key>","<true\/>","<key>NSPrivacyTrackingDomains<\/key>","<array>","    <string>tracking.svc-nue.pushwoosh.com<\/string>","<\/array>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you override "},{"code":"Pushwoosh_TRACKING_URL","type":"codeVoice"},{"text":", list ","type":"text"},{"type":"strong","inlineContent":[{"text":"your","type":"text"}]},{"type":"text","text":" host instead. Apps that"},{"type":"text","text":" "},{"text":"ship without this declaration will be blocked by iOS on non-authorized devices","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and may face App Store review issues."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You must also add "},{"type":"codeVoice","code":"NSUserTrackingUsageDescription"},{"type":"text","text":" to "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" — it is the"},{"text":" ","type":"text"},{"type":"text","text":"text displayed in the ATT consent prompt."}]},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"code":["import AppTrackingTransparency","import AdSupport","","ATTrackingManager.requestTrackingAuthorization { status in","    if status == .authorized {","        let idfa = ASIdentifierManager.shared().advertisingIdentifier.uuidString","        Pushwoosh.configure.setAdvertisingId(idfa)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"To clear:"}],"type":"paragraph"},{"syntax":"swift","code":["Pushwoosh.configure.setAdvertisingId(nil)"],"type":"codeListing"}],"kind":"content"}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"url":"\/documentation\/pushwooshcore","role":"collection","title":"PushwooshCore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","kind":"symbol","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"url":"\/documentation\/pushwooshcore\/pwconfiguration","title":"PWConfiguration","type":"topic","fragments":[{"kind":"identifier","text":"PWConfiguration"}],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","role":"symbol","abstract":[]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setAdvertisingId:":{"url":"\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:","type":"topic","role":"symbol","fragments":[{"text":"+ ","kind":"text"},{"text":"setAdvertisingId:","kind":"identifier"}],"title":"setAdvertisingId:","kind":"symbol","abstract":[{"type":"text","text":"Sets the advertising identifier (IDFA) for the device."}],"navigatorTitle":[{"kind":"identifier","text":"setAdvertisingId:"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAdvertisingId:"}}}