automatically."}]},{"inlineContent":[{"type":"text","text":"Behavior:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fire-and-forget: no completion handler. The SDK retries on transient failures."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deduplicated: repeated calls with the same value do not produce additional"},{"text":" ","type":"text"},{"type":"text","text":"network requests."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The value is persisted locally only after a successful send and read back on","type":"text"},{"type":"text","text":" "},{"text":"subsequent launches for the dedupe check.","type":"text"}]}]}]},{"inlineContent":[{"text":"By default the IDFA is sent to ","type":"text"},{"type":"codeVoice","code":"https:\/\/tracking.svc-nue.pushwoosh.com\/api\/v2\/device-api\/setMADID"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You can override the tracking endpoint via the "},{"code":"Pushwoosh_TRACKING_URL","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"Info.plist key (useful for on-premise deployments and integration testing)."}],"type":"paragraph"},{"text":"App Store submission requirement","anchor":"App-Store-submission-requirement","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Apple requires that any tracking domain be declared in the "},{"type":"strong","inlineContent":[{"text":"integrator’s","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"app-level "},{"code":"PrivacyInfo.xcprivacy","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["<key>NSPrivacyTracking<\/key>","<true\/>","<key>NSPrivacyTrackingDomains<\/key>","<array>","    <string>tracking.svc-nue.pushwoosh.com<\/string>","<\/array>"],"syntax":"xml","type":"codeListing"},{"inlineContent":[{"text":"If you override ","type":"text"},{"code":"Pushwoosh_TRACKING_URL","type":"codeVoice"},{"text":", list ","type":"text"},{"inlineContent":[{"text":"your","type":"text"}],"type":"strong"},{"type":"text","text":" host instead. Apps that"},{"type":"text","text":" "},{"text":"ship without this declaration will be blocked by iOS on non-authorized devices","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and may face App Store review issues."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You must also add ","type":"text"},{"code":"NSUserTrackingUsageDescription","type":"codeVoice"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" — it is the"},{"text":" ","type":"text"},{"text":"text displayed in the ATT consent prompt.","type":"text"}]},{"type":"heading","anchor":"Example","level":2,"text":"Example"},{"code":["import AppTrackingTransparency","import AdSupport","","ATTrackingManager.requestTrackingAuthorization { status in","    if status == .authorized {","        let idfa = ASIdentifierManager.shared().advertisingIdentifier.uuidString","        Pushwoosh.configure.setAdvertisingId(idfa)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"To clear:"}],"type":"paragraph"},{"code":["Pushwoosh.configure.setAdvertisingId(nil)"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAdvertisingId:"},"sections":[],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Sets the advertising identifier (IDFA) for the device."}],"metadata":{"symbolKind":"method","fragments":[{"text":"+ ","kind":"text"},{"text":"setAdvertisingId:","kind":"identifier"}],"role":"symbol","externalID":"c:objc(pl)PWConfiguration(cm)setAdvertisingId:","m