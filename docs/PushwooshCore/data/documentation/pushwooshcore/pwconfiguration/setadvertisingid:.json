{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/setadvertisingid:"]}],"kind":"symbol","identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setAdvertisingId:","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"Sets the advertising identifier (IDFA) for the device."}],"metadata":{"symbolKind":"method","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"setAdvertisingId:"}],"modules":[{"name":"PushwooshCore"}],"roleHeading":"Type Method","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"setAdvertisingId:"}],"title":"setAdvertisingId:","externalID":"c:objc(pl)PWConfiguration(cm)setAdvertisingId:"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"kind":"text","text":") "},{"text":"setAdvertisingId:","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString","text":"NSString"},{"kind":"text","text":" *) "},{"text":"advertisingId","kind":"internalParam"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The advertising identifier string, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to clear it.","type":"text"}]}],"name":"advertisingId"}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK does not collect IDFA automatically. The integrator is responsible for"},{"text":" ","type":"text"},{"text":"requesting user consent via ","type":"text"},{"code":"ATTrackingManager.requestTrackingAuthorization","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"passing the resulting identifier to the SDK.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":", an empty string, or the zero UUID"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"codeVoice","code":"\"00000000-0000-0000-0000-000000000000\""},{"type":"text","text":") to clear the identifier on the backend."},{"type":"text","text":" "},{"text":"The zero UUID is what ","type":"text"},{"type":"codeVoice","code":"ASIdentifierManager.advertisingIdentifier"},{"type":"text","text":" returns when"},{"text":" ","type":"text"},{"text":"tracking is denied or restricted — the SDK normalizes it to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Behavior:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Fire-and-forget: no completion handler. The SDK retries on transient failures."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deduplicated: repeated calls with the same value do not produce additional"},{"type":"text","text":" "},{"type":"text","text":"network requests."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The value is persisted locally only after a successful send and read back on","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"subsequent launches for the dedupe check."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default the IDFA is sent to "},{"code":"https:\/\/tracking.svc-nue.pushwoosh.com\/api\/v2\/device-api\/setMADID","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You can override the tracking endpoint via the "},{"type":"codeVoice","code":"Pushwoosh_TRACKING_URL"},{"type":"text","text":" "},{"type":"text","text":"Info.plist key (useful for on-premise deployments and integration testing)."}]},{"text":"App Store submission requirement","level":2,"anchor":"App-Store-submission-requirement","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple requires that any tracking domain be declared in the "},{"type":"strong","inlineContent":[{"type":"text","text":"integrator’s"}]},{"type":"text","text":" "},{"type":"text","text":"app-level "},{"type":"codeVoice","code":"PrivacyInfo.xcprivacy"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<key>NSPrivacyTracking<\/key>","<true\/>","<key>NSPrivacyTrackingDomains<\/key>","<array>","    <string>tracking.svc-nue.pushwoosh.com<\/string>","<\/array>"]},{"type":"paragraph","inlineContent":[{"text":"If you override ","type":"text"},{"code":"Pushwoosh_TRACKING_URL","type":"codeVoice"},{"type":"text","text":", list "},{"type":"strong","inlineContent":[{"type":"text","text":"your"}]},{"text":" host instead. Apps that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"ship without this declaration will be blocked by iOS on non-authorized devices"},{"text":" ","type":"text"},{"type":"text","text":"and may face App Store review issues."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You must also add "},{"code":"NSUserTrackingUsageDescription","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" — it is the"},{"type":"text","text":" "},{"text":"text displayed in the ATT consent prompt.","type":"text"}]},{"type":"heading","level":2,"anchor":"Example","text":"Example"},{"code":["import AppTrackingTransparency","import AdSupport","","ATTrackingManager.requestTrackingAuthorization { status in","    if status == .authorized {","        let idfa = ASIdentifierMa