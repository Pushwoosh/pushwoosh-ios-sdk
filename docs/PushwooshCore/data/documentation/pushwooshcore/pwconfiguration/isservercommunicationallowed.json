":2,"type":"heading","text":"Example","anchor":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Check status before performing operations:"}]},{"syntax":"swift","code":["class AnalyticsManager {","","    func trackEvent(_ event: String, properties: [String: Any]) {","        \/\/ Check if Pushwoosh communication is allowed","        guard Pushwoosh.configure.isServerCommunicationAllowed() else {","            Logger.debug(\"Pushwoosh communication disabled - skipping event tracking\")","            return","        }","","        \/\/ Track event with Pushwoosh","        Pushwoosh.configure.setTags([","            \"last_event\": event,","            \"last_event_date\": Date()","        ])","    }","}"],"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/isservercommunicationallowed"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"symbolKind":"method","title":"isServerCommunicationAllowed","fragments":[{"kind":"text","text":"+ "},{"text":"isServerCommunicationAllowed","kind":"identifier"}],"externalID":"c:objc(pl)PWConfiguration(cm)isServerCommunicationAllowed","modules":[{"name":"PushwooshCore"}],"roleHeading":"Type Method","role":"symbol","navigatorTitle":[{"text":"isServerCommunicationAllowed","kind":"identifier"}]},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"role":"symbol","title":"PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"abstract":[],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/isServerCommunicationAllowed":{"abstract":[{"type":"text","text":"Checks whether communication with Pushwoosh servers is currently allowed."}],"type":"topic","url":"\/documentation\/pushwooshc