s"}]}]},{"content":[{"inlineContent":[{"text":"Analytics events","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Push token updates","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"This is useful for GDPR compliance where users can opt out of data collection.","type":"text"}]},{"type":"heading","text":"Example","level":2,"anchor":"Example"},{"type":"paragraph","inlineContent":[{"text":"Check status before performing operations:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["class AnalyticsManager {","","    func trackEvent(_ event: String, properties: [String: Any]) {","        \/\/ Check if Pushwoosh communication is allowed","        guard Pushwoosh.configure.isServerCommunicationAllowed() else {","            Logger.debug(\"Pushwoosh communication disabled - skipping event tracking\")","            return","        }","","        \/\/ Track event with Pushwoosh","        Pushwoosh.configure.setTags([","            \"last_event\": event,","            \"last_event_date\": Date()","        ])","    }","}"]}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/isServerCommunicationAllowed":{"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"isServerCommunicationAllowed"}],"role":"symbol","url":"\/documentation\/pushwooshcore\/pwconfiguration\/isservercommunicationallowed","abstract":[{"type":"text","text":"Checks whether communication with Pushwoosh servers is currently allowed."}],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/isServerCommunicationAllowed","type":"topic","navigatorTitle":[{"kind":"identifier","text":"isServerCommunicationAl