{"abstract":[{"text":"Checks whether communication with Pushwoosh servers is currently allowed.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/isServerCommunicationAllowed","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@BOOL","text":"BOOL"},{"text":") ","kind":"text"},{"kind":"identifier","text":"isServerCommunicationAllowed"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"text":"YES if server communication is allowed, NO otherwise","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Returns the current server communication status. When communication is disabled,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the SDK will not send any data to Pushwoosh servers, including:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Device registration"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Tag updates"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Analytics events"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Push token updates","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"This is useful for GDPR compliance where users can opt out of data collection.","type":"text"}]},{"type":"heading","anchor":"Example","text":"Example",