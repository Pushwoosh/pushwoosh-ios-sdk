graph","inlineContent":[{"type":"text","text":"When calling "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/registerForPushNotifications","type":"reference","isActive":true},{"type":"text","text":", the SDK requests these permissions by default:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionBadge"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UNAuthorizationOptionSound","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionAlert"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UNAuthorizationOptionCarPlay","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Use this method to request additional capabilities on top of the defaults.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The options you set here are combined (bitwise OR) with the default options"},{"text":" ","type":"text"},{"type":"text","text":"before being passed to "},{"code":"UNUserNotificationCenter.requestAuthorizationWithOptions:","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Must be called "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/registerForPushNotifications","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Available Options","anchor":"Available-Options"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"UNAuthorizationOptionProvisional","type":"codeVoice"},{"type":"text","text":" (iOS 12+) — Delivers notifications quietly to the Notification Center"},{"type":"text","text":" "},{"type":"text","text":"without showing a permission dialog. The user sees notifications silently and can then choose to keep or disable them."},{"type":"text","text":" "},{"type":"text","text":"Use this for a “soft opt-in” strategy to avoid users declining the permission prompt upfront."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionCriticalAlert"},{"type":"text","text":" (iOS 12+) — Allows notifications that bypass Do Not Disturb and the mute switch."},{"text":" ","type":"text"},{"type":"text","text":"Requires a special entitlement from Apple (must be approved via Apple Developer portal)."},{"type":"text","text":" "},{"text":"Intended for medical, health, safety, and public security apps.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UNAuthorizationOptionProvidesAppNotificationSettings","type":"codeVoice"},{"type":"text","text":" (iOS 12+) — Adds a “Configure in App” button"},{"type":"text","text":" "},{"type":"text","text":"to the system notification settings for your app. When tapped, iOS calls"},{"type":"text","text":" "},{"code":"userNotificationCenter:openSettingsForNotification:","type":"codeVoice"},{"type":"text","text":" on your "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"Use ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/addNotificationCenterDelegate:","isActive":true,"type":"reference"},{"text":" to register your delegate and handle this callback.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNAuthorizationOptionAnnouncement"},{"type":"text","text":" (iOS 13+) — Allows Siri to automatically read out notifications"},{"type":"text","text":" "},{"text":"through AirPods and compatible headphones.","type":"text"}]}]}]},{"anchor":"Example-Provisional-Soft-Opt-In","level":2,"text":"Example — Provisional (Soft Opt-In)","type":"heading"},{"code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    if #available(iOS 12.0, *) {","        Pushwoosh.configure.setAdditionalAuthorizationOptions([.provisional])","    }","","    Pushwoosh.configure.registerForPushNotifications()","","    return true","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Example — In-App Notification Settings Button","anchor":"Example-In-App-Notification-Settings-Button"},{"type":"codeListing","syntax":"swift","code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    if #available(iOS 12.0, *) {","        Pushwoosh.configure.setAdditionalAuthorizationOptions([.providesAppNotificationSettings])","    }","","    Pushwoosh.configure.addNotificationCenterDelegate(self)","    Pushwoosh.configure.registerForPushNotifications()","","    return true","}","","\/\/ Called when user taps \"Configure in App\" in system notification settings","func userNotificationCenter(_ center: UNUserNotificationCenter,","                            openSettingsFor notification: UNNotification?) {","    \/\/ Navigate to your in-app notification settings screen","}"]},{"text":"Example — Combining Multiple Options","anchor":"Example-Combining-Multiple-Options","level":2,"type":"heading"},{"syntax":"swift","type":"codeListing","code":["if #available(iOS 12.0, *) {","    Pushwoosh.configure.setAdditionalAuthorizationOptions([.provisional, .providesAppNotificationSettings])","}"]},{"inlineContent":[{"type":"text","text":"Objective-C:"}],"type":"paragraph"},{"type":"codeListing","syntax":"objc","code":["if (@available(iOS 12.0, *)) {","    [Pushwoosh.configure setAdditionalAuthorizationOptions:UNAuthorizationOptionProvisional | UNAuthorizationOptionProvidesAppNotificationSet