{"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getCustomPushData:","interfaceLanguage":"occ"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["occ"],"tokens":[{"kind":"text","text":"+ ("},{"text":"NSString","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString"},{"text":" *) ","kind":"text"},{"kind":"identifier","text":"getCustomPushData:"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSDictionary","text":"NSDictionary"},{"text":" *) ","kind":"text"},{"kind":"internalParam","text":"pushNotification"},{"text":";","kind":"text"}]}]},{"parameters":[{"name":"pushNotification","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The notification payload dictionary (userInfo from push)."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"The custom data as a JSON string, or nil if no custom data present.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieves the custom JSON data that was sent with a push notification."},{"text":" ","type":"text"},{"type":"text","text":"Custom data is set in Pushwoosh when creating the push and can contain"},{"text":" ","type":"text"},{"text":"any JSON-serializable content for app-specific handling.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The returned string is JSON-formatted and must be parsed by your app."},{"text":" ","type":"text"},{"type":"text","text":"Returns nil if no custom data was included in the notification."}],"type":"paragraph"},{"type":"heading","text":"Example","level":2,"anchor":"Example"},{"inlineContent":[{"type":"text","text":"Handle push notifications with custom data:"}],"type":"paragraph"},{"syntax":"swift","code":["class PushNotificationHandler: PWMessagingDelegate {","","    func pushwoosh(_ pushwoosh: Pushwoosh!,","                  onMessageReceived message: [AnyHashable: Any]!) {","","        \/\/ Extract and parse custom data","        guard let customDataString = Pushwoosh.configure.getCustomPushData(message),","              let customData = parseJSON(customDataString) else {","            handleStandardNotification(message)","            return","        }","","        \/\/ Route based on custom data","        if let deepLink = customData[\"deep_link\"] as? String {","            DeepLinkRouter.shared.navigate(to: deepLink)","        }","","        if let action = customData[\"action\"] as? String {","            handleCustomAction(action, data: customData)","        }","","        if let productId = customData[\"product_id\"] as? String {","            showProductDetail(productId)","        }","","        \/\/ Track custom data receipt","        Analytics.track(\"push_with_custom_data\", properties: [","            \"data_keys\": Array(customData.keys)","        ])","    }","","    private func parseJSON(_ jsonString: String) -> [String: Any]? {","        guard let data = jsonString.data(using: .utf8) else { return nil }","        return try? JSONSerialization.jsonObject(with: data) as? [String: Any]","    }","","    private func handleCustomAction(_ action: String, data: [String: Any]) {","        switch action {","        case \"show_promo\":","            if let promoCode = data[\"promo_code\"] as? String {","                PromoManager.shared.showPromo(code: promoCode)","            }","        case \"update_content\":","            ContentManager.shared.refreshContent()","        case \"show_survey\":","            if let surveyId = data[\"survey_id\"] as? String {","                SurveyManager.shared.presentSurvey(id: surveyId)","            }","        default:","            Logger.warning(\"Unknown custom action: \\(action)\")","        }","    }","}"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"type":"text","text":"Extracts custom data from a push notification payload."}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"metadata":{"symbolKind":"method","externalID":"c:objc(pl)PWConfiguration(cm)getCustomPushData:","roleHeading":"Type Method","modules":[{"name":"PushwooshCore"}],"title":"getCustomPushData:","role":"symbol","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"getCustomPushData:"}],"navigatorTitle":[{"kind":"identifier","text":"getCustomPushData:"}]},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/getcustompushdata:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","kind":"symbol","role":"symbol","abstract":[],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","type":"topic","fragments":[{"kind":"identifier","text":"PWConfiguration"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","title":"PushwooshCore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/getCustomPushData:":{"title":"getCustomPushData:","role":"symbol","kind":"symbol","url":"\/documentation\/pushwooshcore\/pwconfiguration\/getcustompushdata:","navigatorTitle":[{"text":"getCustomPushData:","kind":"identifier"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getCustomPushData:","fragments":[{"text":"+ ","kind":"text"},{"text":"getCustomPushData:","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Extracts custom data from a push notification payload."}]}}}