{"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"text":"NSString","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString"},{"text":" *) ","kind":"text"},{"kind":"identifier","text":"getCustomPushData:"},{"kind":"text","text":"("},{"text":"NSDictionary","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSDictionary"},{"kind":"text","text":" *) "},{"text":"pushNotification","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"pushNotification","content":[{"inlineContent":[{"type":"text","text":"The notification payload dictionary (userInfo from push)."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"inlineContent":[{"text":"The custom data as a JSON string, or nil if no custom data present.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Retrieves the custom JSON data that was sent with a push notification.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Custom data is set in Pushwoosh when creating the push and can contain"},{"text":" ","type":"text"},{"type":"text","text":"any JSON-serializable content for app-specific handling."}]},{"type":"paragraph","inlineContent":[{"text":"The returned string is JSON-formatted and must be parsed by your app.","type":"text"},{"type":"text","text":" "},{"text":"Returns nil if no custom data was included in the notification.","type":"text"}]},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"inlineContent":[{"type":"text","text":"Handle push notifications with custom data:"}],"type":"paragraph"},{"code":["class PushNotificationHandler: PWMessagingDelegate {","","    func pushwoosh(_ pushwoosh: Pushwoosh!,","                  onMessageReceived message: [AnyHashable: Any]!) {","","        \/\/ Extract and parse custom data","        guard let customDataString = Pushwoosh.configure.getCustomPushData(message),","              let customData = parseJSON(customDataString) else {","            handleStandardNotification(message)","            return","        }","","        \/\/ Route based on custom data","        if let deepLink = customData[\"deep_link\"] as? String {","            DeepLinkRouter.shared.navigate(to: deepLink)","        }","","        if let action = customData[\"action\"] as? String {","            handleCustomAction(action, data: customData)","        }","","        if let productId = customData[\"product_id\"] as? String {","            showProductDetail(productId)","        }","","        \/\/ Track custom data receipt","        Analytics.track(\"push_with_custom_data\", properties: [","            \"data_keys\": Array(customData.keys)","        ])","    }","","    private func parseJSON(_ jsonString: String) -> [String: Any]? {","        guard let data = jsonString.data(using: .utf8) else { return nil }","        return try? JSONSerialization.jsonObject(with: data) as? [String: Any]","    }","","    private func handleCustomAction(_ action: String, data: [String: Any]) {","        switch action {","        case \"show_promo\":","            if let promoCode = data[\"promo_code\"] as? String {","                PromoManager.shared.showPromo(code: promoCode)","            }","        case \"update_content\":","            ContentManager.shared.refreshContent()","        case \"show_survey\":","            if let surveyId = data[\"survey_id\"] as? String {","                SurveyManager.shared.presentSurvey(id: surveyId)","            }","        default:","            Logger.warning(\"Unknown custom action: \\(action)\")","        }","    }","}"],"syntax":"swift","type":"codeListing"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"getCustomPushData:","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"getCustomPushData:"}],"role":"symbol","symbolKind":"method","modules":[{"name":"PushwooshCore"}],"roleHeading":"Type Method","navigatorTitle":[{"kind":"identifier","text":"getCustomPushData:"}],"externalID":"c:objc(pl)PWConfiguration(cm)getCustomPushData:"},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/getcustompushdata:"]}],"kind":"symbol","identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getCustomPushData:"},"abstract":[{"type":"text","text":"Extracts custom data from a push notification payload."}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/getCustomPushData:":{"role":"symbol","abstract":[{"text":"Extracts custom data from a push notification payload.","type":"text"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getCustomPushData:","title":"getCustomPushData:","fragments":[{"text":"+ ","kind":"text"},{"text":"getCustomPushData:","kind":"identifier"}],"navigatorTitle":[{"text":"getCustomPushData:","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/pushwooshcore\/pwconfiguration\/getcustompushdata:"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"role":"symbol","kind":"symbol","abstract":[],"url":"\/documentation\/pushwooshcore\/pwconfiguration","fragments":[{"kind":"identifier","text":"PWConfiguration"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","type":"topic","title":"PWConfiguration"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","role":"collection","kind":"symbol","title":"PushwooshCore","type":"topic","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"url":"\/documentation\/pushwooshcore"}}}