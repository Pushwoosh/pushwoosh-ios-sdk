nlineContent":[{"type":"text","text":"The value is set when the app is cold-started by tapping a push notification and remains available"},{"text":" ","type":"text"},{"type":"text","text":"for the lifetime of the process. If the app was already running (foreground or background),"},{"text":" ","type":"text"},{"text":"the value is ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" — use "},{"type":"codeVoice","code":"PWMessagingDelegate"},{"type":"text","text":" callbacks instead."}],"type":"paragraph"},{"inlineContent":[{"text":"Must be called ","type":"text"},{"type":"strong","inlineContent":[{"text":"after","type":"text"}]},{"text":" the SDK has finished initialization (e.g., in ","type":"text"},{"type":"codeVoice","code":"applicationDidBecomeActive:"},{"text":" or later).","type":"text"}],"type":"paragraph"},{"anchor":"Example","text":"Example","level":2,"type":"heading"},{"type":"codeListing","syntax":"swift","code":["func applicationDidBecomeActive(_ application: UIApplication) {","    if let launchNotification = Pushwoosh.configure.getLaunchNotification() {","        print(\"App launched from push: \\(launchNotification)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Objective-C:","type":"text"}]},{"syntax":"objc","code":["- (void)applicationDidBecomeActive:(UIApplication *)application {","    NSDictionary *launchNotification = [Pushwoosh.configure getLaunchNotification];","    if (launchNotification) {","        NSLog(@\"App launched from push: %@\", launchNotification);","    }","}"],"type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Returns push notification payload if the app was started in response to a push notification, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" otherwise."}],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/Pushwoo