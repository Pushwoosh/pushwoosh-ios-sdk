{"abstract":[{"type":"text","text":"Returns push notification payload if the app was started in response to a push notification, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" otherwise."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"kind":"typeIdentifier","text":"NSDictionary","preciseIdentifier":"c:objc(cs)NSDictionary"},{"text":" *) ","kind":"text"},{"text":"getLaunchNotification","kind":"identifier"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS"]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"type":"text","text":"The push notification payload dictionary, or "},{"type":"codeVoice","code":"nil"},{"text":" if the app was not launched from a push notification.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Use this method to retrieve the notification data that caused the app to launch from a terminated state.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"This is useful for handling deep links or navigation based on the push content."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The value is set when the app is cold-started by tapping a push notification and remains available"},{"text":" ","type":"text"},{"text":"for the lifetime of the process. If the app was already running (foreground or background),","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the value is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" — use "},{"type":"codeVoice","code":"PWMessagingDelegate"},{"text":" callbacks instead.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Must be called "},{"type":"strong","inlineContent":[{"type":"text","text":"after"}]},{"text":" the SDK has finished initialization (e.g., in ","type":"text"},{"code":"applicationDidBecomeActive:","type":"codeVoice"},{"text":" or later).","type":"text"}]},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"code":["func applicationDidBecomeActive(_ application: UIApplication) {","    if let launchNotification = Pushwoosh.configure.getLaunchNotification() {","        print(\"App launched from push: \\(launchNotification)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Objective-C:"}]},{"type":"codeListing","code":["- (void)applicationDidBecomeActive:(UIApplication *)application {","    NSDictionary *launchNotification = [Pushwoosh.configure getLaunchNotification];","    if (launchNotification) {","        NSLog(@\"App launched from push: %@\", launchNotification);","    }","}"],"syntax":"objc"}],"kind":"content"}],"metadata":{"externalID":"c:objc(pl)PWConfiguration(cm)getLaunchNotification","modules":[{"name":"PushwooshCore"}],"symbolKind":"method","fragments":[{"text":"+ ","kind":"text"},{"text":"getLaunchNotification","kind":"identifier"}],"navigatorTitle":[{"text":"getLaunchNotification","kind":"identifier"}],"roleHeading":"Type Method","title":"getLaunchNotification","role":"symbol"},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/getlaunchnotification"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getLaunchNotification","interfaceLanguage":"occ"},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/getLaunchNotification":{"role":"symbol","fragments":[{"kind":"text","text":"+ "},{"text":"getLaunchNo