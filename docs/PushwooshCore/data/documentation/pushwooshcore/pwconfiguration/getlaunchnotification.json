{"abstract":[{"text":"Returns push notification payload if the app was started in response to a push notification, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" otherwise."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getLaunchNotification"},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"symbolKind":"method","title":"getLaunchNotification","roleHeading":"Type Method","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"getLaunchNotification"}],"modules":[{"name":"PushwooshCore"}],"externalID":"c:objc(pl)PWConfiguration(cm)getLaunchNotification","role":"symbol","navigatorTitle":[{"text":"getLaunchNotification","kind":"identifier"}]},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/getlaunchnotification"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"text":"NSDictionary","preciseIdentifier":"c:objc(cs)NSDictionary","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"getLaunchNotification","kind":"identifier"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The push notification payload dictionary, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if the app was not launched from a push notification."}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to retrieve the notification data that caused the app to launch from a terminated state."},{"text":" ","type":"text"},{"text":"This is useful for handling deep links or navigation based on the push content.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The value is set when the app is cold-started by tapping a push notification and remains available","type":"text"},{"text":" ","type":"text"},{"text":"for the lifetime of the process. If the app was already running (foreground or background),","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the value is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" — use "},{"type":"codeVoice","code":"PWMessagingDelegate"},{"type":"text","text":" callbacks instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Must be called "},{"type":"strong","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" the SDK has finished initialization (e.g., in "},{"type":"codeVoice","code":"applicationDidBecomeActive:"},{"text":" or later).","type":"text"}]},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["func applicationDidBecomeActive(_ application: UIApplication) {","    if let launchNotification = Pushwoosh.configure.getLaunchNotification() {","        print(\"App launched from push: \\(launchNotification)\")","    }","}"]},{"inlineContent":[{"type":"text","text":"Objective-C:"}],"type":"paragraph"},{"type":"codeListing","syntax":"objc","code":["- (void)applicationDidBecomeActive:(UIApplication *)application {","    NSDictionary *launchNotification = [Pushwoosh.configure getLaunchNotification];","    if (launchNotification) {","        NSLog(@\"App launched from push: %@\", launchNotification);","    }","}"]}]}],"sections":[],"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshc