xt"}]},{"text":" the SDK has finished initialization (e.g., in ","type":"text"},{"code":"applicationDidBecomeActive:","type":"codeVoice"},{"text":" or later).","type":"text"}]},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"syntax":"swift","code":["func applicationDidBecomeActive(_ application: UIApplication) {","    if let launchNotification = Pushwoosh.configure.getLaunchNotification() {","        print(\"App launched from push: \\(launchNotification)\")","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Objective-C:","type":"text"}]},{"type":"codeListing","syntax":"objc","code":["- (void)applicationDidBecomeActive:(UIApplication *)application {","    NSDictionary *launchNotification = [Pushwoosh.configure getLaunchNotification];","    if (launchNotification) {","        NSLog(@\"App launched from push: %@\", launchNotification);","    }","}"]}]}],"sections":[],"metadata":{"roleHeading":"Type Method","role":"symbol","title":"getLaunchNotification","modules":[{"name":"PushwooshCore"}],"externalID":"c:objc(pl)PWConfiguration(cm)getLaunchNotification","fragments":[{"text":"+ ","kind":"text"},{"text":"getLaunchNotification","kind":"identifier"}],"navigatorTitle":[{"text":"getLaunchNotification","kind":"identifier"}],"symbolKind":"method"},"abstract":[{"type":"text","text":"Returns push notification payload if the app was started in response to a push notification, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" otherwise."}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/getlaunchnotification"]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getLaunchNotification","interfaceLanguage":"occ"},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","type":"topic","fragments":[{"text":"PWConfiguration","kind":"identifier"