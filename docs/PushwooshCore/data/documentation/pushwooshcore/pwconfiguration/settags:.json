{"kind":"symbol","identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setTags:","interfaceLanguage":"occ"},"metadata":{"modules":[{"name":"PushwooshCore"}],"symbolKind":"method","externalID":"c:objc(pl)PWConfiguration(cm)setTags:","navigatorTitle":[{"text":"setTags:","kind":"identifier"}],"role":"symbol","title":"setTags:","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"setTags:"}],"roleHeading":"Type Method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"setTags:"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSDictionary","text":"NSDictionary","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"tags","kind":"internalParam"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS"]}]},{"kind":"parameters","parameters":[{"name":"tags","content":[{"inlineContent":[{"text":"Dictionary of tag names and values to set for the current device","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tags are key-value pairs that enable targeted push notifications based on user attributes"},{"type":"text","text":" "},{"type":"text","text":"and behavior. Use tags to segment your audience and send personalized messages to specific"},{"type":"text","text":" "},{"text":"user groups.","type":"text"}]},{"type":"heading","anchor":"Supported-Tag-Types","level":2,"text":"Supported Tag Types"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"inlineContent":[{"type":"text","text":"Example"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"city\": \"New York\""}]}],[{"inlineContent":[{"text":"Text values","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Integer"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"\"age\": 25","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Numeric values","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"Boolean"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"isPremium\": true"}]}],[{"inlineContent":[{"text":"True\/false values","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"List","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"interests\": [\"sports\", \"music\"]"}]}],[{"inlineContent":[{"type":"text","text":"Arrays of strings"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Date"}],"type":"paragraph"}],[{"inlineContent":[{"code":"\"lastPurchase\": Date()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"NSDate objects","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"inlineContent":[{"text":"Update user profile tags after account changes:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["class UserProfileManager {","","    func updateUserTags(for user: User) {","        var tags: [String: Any] = [","            \"user_id\": user.id,","            \"email_verified\": user.isEmailVerified,","            \"account_type\": user.accountType.rawValue,","            \"signup_date\": user.createdAt,","            \"app_version\": Bundle.main.appVersion","        ]","","        \/\/ Add subscription info if premium","        if let subscription = user.subscription {","            tags[\"subscription_tier\"] = subscription.tier.rawValue","            tags[\"subscription_expiry\"] = subscription.expiryDate","            tags[\"is_premium\"] = true","        } else {","            tags[\"is_premium\"] = false","        }","","        \/\/ Add user preferences","        if !user.interests.isEmpty {","            tags[\"interests\"] = user.interests","        }","","        \/\/ Add location if available","        if let location = user.location {","            tags[\"country\"] = location.country","            tags[\"city\"] = location.city","            tags[\"timezone\"] = location.timezone","        }","","        Pushwoosh.configure.setTags(tags)","        Logger.debug(\"User tags updated: \\(tags.keys.joined(separator: \", \"))\")","    }","","    func trackPurchase(product: Product, amount: Decimal) {","        Pushwoosh.configure.setTags([","            \"last_purchase_date\": Date(),","            \"last_purchase_amount\": NSDecimalNumber(decimal: amount),","            \"last_purchase_category\": product.category,","            \"total_purchases\": incrementTag(\"total_purchases\")","        ])","    }","}"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/settags:"]}],"abstract":[{"type":"text","text":"Sets user tags for device segmentation."}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/setTags:":{"role":"symbol","type":"topic","kind":"symbol","title":"setTags:","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/setTags:","url":"\/documentation\/pushwooshcore\/pwconfiguration\/settags:","abstract":[{"type":"text","text":"Sets user tags for device segmentation."}],"fragments":[{"text":"+ ","kind":"text"},{"text":"setTags:","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"setTags:"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","abstract":[],"url":"\/documentation\/pushwooshcore\/pwconfiguration","role":"symbol","kind":"symbol","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"url":"\/documentation\/pushwooshcore","role":"collection","kind":"symbol","type":"topic","title":"PushwooshCore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore"}}}