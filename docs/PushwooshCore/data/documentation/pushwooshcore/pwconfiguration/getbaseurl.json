{"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getBaseUrl","interfaceLanguage":"occ"},"abstract":[{"type":"text","text":"Returns the API base URL the SDK currently sends requests to."}],"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"text":"+ (","kind":"text"},{"text":"NSString","preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier"},{"kind":"text","text":" *) "},{"kind":"identifier","text":"getBaseUrl"},{"kind":"text","text":";"}],"platforms":["iOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The current API base URL, or nil when it cannot be resolved yet."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Resolution order: the endpoint currently in effect — seeded by "},{"type":"codeVoice","code":"setAppCode:baseUrl:"},{"text":" and afterwards","type":"text"},{"text":" ","type":"text"},{"text":"movable by the server (shard rotation) —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"then the endpoint recorded by that call, then Info.plist "},{"type":"codeVoice","code":"Pushwoosh_BASEURL"},{"text":", then","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/<appCode>.api.pushwoosh.com\/json\/1.3\/"},{"type":"text","text":". So a server-side rotation is what this returns"},{"type":"text","text":" "},{"type":"text","text":"until the effective endpoint is cleared, at which point the recorded selection takes over again."},{"text":" ","type":"text"},{"text":"Returns nil when no Application Code is configured yet and no explicit URL was set.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A reverse proxy configured with "},{"code":"setReverseProxy:headers:","type":"codeVoice"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" reflected here — it is a"},{"type":"text","text":" "},{"type":"text","text":"transport-level override applied when the request is sent."}]},{"level":2,"text":"Example","type":"heading","anchor":"Example"},{"syntax":"swift","code":["let endpoint = Pushwoosh.configure.getBaseUrl() ?? \"not resolved yet\"","Logger.debug(\"Pushwoosh endpoint: \\(endpoint)\")"],"type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/getbaseurl"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"metadata":{"roleHeading":"Type Method","title":"getBaseUrl","externalID":"c:objc(pl)PWConfiguration(cm)getBaseUrl","modules":[{"name":"PushwooshCore"}],"fragments":[{"text":"+ ","kind":"text"},{"text":"getBaseUrl","kind":"identifier"}],"navigatorTitle":[{"text":"getBaseUrl","kind":"identifier"}],"role":"symbol","symbolKind":"method"},"sections":[],"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/getBaseUrl":{"title":"getBaseUrl","abstract":[{"text":"Returns the API base URL the SDK currently sends requests to.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"getBaseUrl"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/getBaseUrl","url":"\/documentation\/pushwooshcore\/pwconfiguration\/getbaseurl","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"getBaseUrl"}],"type":"topic","kind":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"abstract":[{"text":"Protocol defining SDK configuration methods."