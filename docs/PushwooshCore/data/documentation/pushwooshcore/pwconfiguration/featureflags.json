{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/featureFlags"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:objc(cs)PWFeatureFlags","text":"PWFeatureFlags","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWFeatureFlags","kind":"typeIdentifier"},{"kind":"text","text":" *) "},{"text":"featureFlags","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"inlineContent":[{"type":"text","text":"The shared "},{"type":"codeVoice","code":"PWFeatureFlags"},{"text":" instance. Available on iOS only.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"Pushwoosh evaluates rules, segments and rollout percentages on the server. The SDK fetches the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"result, keeps the last response on disk and answers "},{"code":"get","type":"codeVoice"},{"type":"text","text":" synchronously from it, without a request."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK refreshes the flags by itself: when a session starts (the first time the app becomes"},{"type":"text","text":" "},{"type":"text","text":"active and after 30 minutes in background), every hour while the app stays in foreground, after"},{"type":"text","text":" "},{"text":"the first push registration if the previous request went without it, and after a user id change.","type":"text"},{"text":" ","type":"text"},{"text":"Call ","type":"text"},{"code":"refresh","type":"codeVoice"},{"text":" to fetch on demand. While the cache is valid, a refresh within 5 minutes of the","type":"text"},{"type":"text","text":" "},{"text":"last request completes from the cache without a request.","type":"text"}]},{"inlineContent":[{"type":"codeVoice","code":"get"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" until the first response arrives, when the cache is older than 24 hours, and"},{"text":" ","type":"text"},{"type":"text","text":"while the cache belongs to another user id or application code. Call "},{"type":"codeVoice","code":"logImpression"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"user actually sees a branch of the feature, including the disabled one: that is the control group."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Flags are requested from "},{"code":"api\/v2\/device-api\/getFeatureFlags","type":"codeVoice"},{"type":"text","text":" in place of the "},{"type":"codeVoice","code":"json\/1.3\/"},{"text":" tail of","type":"text"},{"text":" ","type":"text"},{"text":"the reverse proxy URL or of the SDK base URL. A reverse proxy URL must end with ","type":"text"},{"code":"json\/1.3\/","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"otherwise "},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" fails without a request. A base URL without "},{"type":"codeVoice","code":"json\/1.3\/"},{"text":" (a custom gateway, an","type":"text"},{"text":" ","type":"text"},{"text":"on-premise server) is not used for flags: they go to ","type":"text"},{"code":"https:\/\/<APP-CODE>.api.pushwoosh.com\/","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and the SDK logs a warning. App extensions never request flags."}]},{"text":"Example","type":"heading","anchor":"Example","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read a flag and log what the user saw:"}]},{"code":["let flags = Pushwoosh.configure.featureFlags","if flags.isEnabled(\"new_checkout\", default: false) {","    showNewCheckout(color: flags.get(\"new_checkout\")?.string(forProperty: \"color\", default: nil))","} else {","    showOldCheckout()","}","flags.logImpression(\"new_checkout\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Refresh on demand; the error code is the HTTP status, ","type":"text"},{"code":"0","type":"codeVoice"},{"type":"text","text":" when no response was received:"}],"type":"paragraph"},{"code":["Pushwoosh.configure.featureFlags.refresh { error in","    if let error = error as NSError? {","        print(\"Feature flags refresh failed: \\(error.code)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"React to new values:"}]},{"type":"codeListing","syntax":"swift","code":["final class CheckoutModel: NSObject, PWFeatureFlagsUpdateListener {","    func featureFlagsDidUpdate() {","        reload()","    }","}","","Pushwoosh.configure.featureFlags.addUpdateListener(checkoutModel)"]},{"inlineContent":[{"code":"Pushwoosh_FEATURE_FLAGS_DISABLE_THROTTLE","type":"codeVoice"},{"type":"text","text":" (Boolean) to "},{"code":"YES","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"is released and never called."}]}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/featureflags"]}],"kind":"symbol","abstract":[{"type":"text","text":"Feature flags evaluated by Pushwoosh for this device and user."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"modules":[{"name":"PushwooshCore"}],"navigatorTitle":[{"text":"featureFlags","kind":"identifier"}],"symbolKind":"method","externalID":"c:objc(pl)PWConfiguration(cm)featureFlags","role":"symbol","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"featureFlags"}],"roleHeading":"Type Method","title":"featureFlags"},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWFeatureFlags":{"role":"symbol","url":"\/documentation\/pushwooshcore\/pwfeatureflags","kind":"symbol","abstract":[{"text":"Feature flags evaluated by Pushwoosh for this device and user, ","type":"text"},{"type":"codeVoice","code":"Pushwoosh.configure.featureFlags"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"Refresh triggers, cache lifetime and examples: ","type":"text"},{"type":"codeVoice","code":"+[PushwooshConfig featureFlags]"},{"text":". Available on iOS only.","type":"text"}],"type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWFeatureFlags","fragments":[{"kind":"identifier","text":"PWFeatureFlags"}],"title":"PWFeatureFlags"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"abstract":[{"text":"Protocol defining SDK configuration methods.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}]},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","url":"\/documentation\/pushwooshcore","kind":"symbol","title":"PushwooshCore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"role":"collection","type":"topic"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/featureFlags":{"role":"symbol","url":"\/documentation\/pushwooshcore\/pwconfiguration\/featureflags","kind":"symbol","abstract":[{"type":"text","text":"Feature flags evaluated by Pushwoosh for this device and user."}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/featureFlags","type":"topic","fragments":[{"text":"+ ","kind":"text"},{"text":"featureFlags","kind":"identifier"}],"title":"featureFlags","navigatorTitle":[{"text":"featureFlags","kind":"identifier"}]}}}