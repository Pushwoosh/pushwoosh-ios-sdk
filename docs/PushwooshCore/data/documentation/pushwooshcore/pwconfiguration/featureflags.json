{"sections":[],"abstract":[{"type":"text","text":"Feature flags evaluated by Pushwoosh for this device and user."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/featureFlags","interfaceLanguage":"occ"},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/featureflags"],"traits":[{"interfaceLanguage":"occ"}]}],"kind":"symbol","metadata":{"fragments":[{"text":"+ ","kind":"text"},{"text":"featureFlags","kind":"identifier"}],"modules":[{"name":"PushwooshCore"}],"role":"symbol","title":"featureFlags","externalID":"c:objc(pl)PWConfiguration(cm)featureFlags","roleHeading":"Type Method","navigatorTitle":[{"text":"featureFlags","kind":"identifier"}],"symbolKind":"method"},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"preciseIdentifier":"c:objc(cs)PWFeatureFlags","text":"PWFeatureFlags","kind":"typeIdentifier","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWFeatureFlags"},{"text":" *) ","kind":"text"},{"kind":"identifier","text":"featureFlags"},{"text":";","kind":"text"}],"languages":["occ"]}],"kind":"declarations"},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"The shared "},{"type":"codeVoice","code":"PWFeatureFlags"},{"type":"text","text":" instance. Available on iOS only."}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pushwoosh evaluates rules, segments and rollout percentages on the server. The SDK fetches the"},{"text":" ","type":"text"},{"text":"result, keeps the last response on disk and answers ","type":"text"},{"code":"get","type":"codeVoice"},{"text":" synchronously from it, without a request.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK refreshes the flags by itself: when a session starts (the first time the app becomes"},{"type":"text","text":" "},{"type":"text","text":"active and after 30 minutes in background), every hour while the app stays in foreground, after"},{"type":"text","text":" "},{"type":"text","text":"the first push registration if the previous request went without it, and after a user id change."},{"type":"text","text":" "},{"type":"text","text":"Call "},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" to fetch on demand. While the cache is valid, a refresh within 5 minutes of the"},{"type":"text","text":" "},{"text":"last request completes from the cache without a request.","type":"text"}]},{"inlineContent":[{"type":"codeVoice","code":"get"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" until the first response arrives, when the cache is older than 24 hours, and"},{"text":" ","type":"text"},{"type":"text","text":"while the cache belongs to another user id or application code. Call "},{"type":"codeVoice","code":"logImpression"},{"text":" when the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"user actually sees a branch of the feature, including the disabled one: that is the control group."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Flags are requested from "},{"type":"codeVoice","code":"api\/v2\/device-api\/getFeatureFlags"},{"text":" in place of the ","type":"text"},{"type":"codeVoice","code":"json\/1.3\/"},{"text":" tail of","type":"text"},{"text":" ","type":"text"},{"text":"the reverse proxy URL or of the SDK base URL. A reverse proxy URL must end with ","type":"text"},{"type":"codeVoice","code":"json\/1.3\/"},{"text":",","type":"text"},{"type":"text","text":" "},{"text":"otherwise ","type":"text"},{"type":"codeVoice","code":"refresh"},{"text":" fails without a request. A base URL without ","type":"text"},{"code":"json\/1.3\/","type":"codeVoice"},{"type":"text","text":" (a custom gateway, an"},{"type":"text","text":" "},{"text":"on-premise server) is not used for flags: they go to ","type":"text"},{"type":"codeVoice","code":"https:\/\/<APP-CODE>.api.pushwoosh.com\/"},{"type":"text","text":" "},{"text":"and the SDK logs a warning. App extensions never request flags.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Example","anchor":"Example","level":2},{"type":"paragraph","inlineContent":[{"text":"Read a flag and log what the user saw:","type":"text"}]},{"code":["let flags = Pushwoosh.configure.featureFlags","if flags.isEnabled(\"new_checkout\", default: false) {","    showNewCheckout(color: flags.get(\"new_checkout\")?.string(forProperty: \"color\", default: nil))","} else {","    showOldCheckout()","}","flags.logImpression(\"new_checkout\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Refresh on demand; the error code is the HTTP status, "},{"code":"0","type":"codeVoice"},{"type":"text","text":" when no response was received:"}]},{"syntax":"swift","type":"codeListing","code":["Pushwoosh.configure.featureFlags.refresh { error in","    if let error = error as NSError? {","        print(\"Feature flags refresh failed: \\(error.code)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"React to new values:"}]},{"syntax":"swift","type":"codeListing","code":["final class CheckoutModel: NSObject, PWFeatureFlagsUpdateListener {","    func featureFlagsDidUpdate() {","        reload()","    }","}","","Pushwoosh.configure.featureFlags.addUpdateListener(checkoutModel)"]},{"inlineContent":[{"code":"Pushwoosh_FEATURE_FLAGS_DISABLE_THROTTLE","type":"codeVoice"},{"type":"text","text":" (Boolean) to "},{"code":"YES","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"is released and never called.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"url":"\/documentation\/pushwooshcore","role":"collection","kind":"symbol","type":"topic","title":"PushwooshCore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","abstract":[],"url":"\/documentation\/pushwooshcore\/pwconfiguration","role":"symbol","kind":"symbol","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWFeatureFlags":{"abstract":[{"type":"text","text":"Feature flags evaluated by Pushwoosh for this device and user, "},{"type":"codeVoice","code":"Pushwoosh.configure.featureFlags"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"Refresh triggers, cache lifetime and examples: "},{"type":"codeVoice","code":"+[PushwooshConfig featureFlags]"},{"text":". Available on iOS only.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/pushwooshcore\/pwfeatureflags","fragments":[{"kind":"identifier","text":"PWFeatureFlags"}],"type":"topic","title":"PWFeatureFlags","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWFeatureFlags"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/featureFlags":{"title":"featureFlags","abstract":[{"text":"Feature flags evaluated by Pushwoosh for this device and user.","type":"text"}],"url":"\/documentation\/pushwooshcore\/pwconfiguration\/featureflags","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/featureFlags","kind":"symbol","role":"symbol","fragments":[{"text":"+ ","kind":"text"},{"text":"featureFlags","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"featureFlags"}],"type":"topic"}}}