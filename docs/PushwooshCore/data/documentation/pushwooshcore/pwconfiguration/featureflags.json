{"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWFeatureFlags","preciseIdentifier":"c:objc(cs)PWFeatureFlags","text":"PWFeatureFlags"},{"text":" *) ","kind":"text"},{"kind":"identifier","text":"featureFlags"},{"text":";","kind":"text"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"inlineContent":[{"text":"The shared ","type":"text"},{"type":"codeVoice","code":"PWFeatureFlags"},{"text":" instance. Available on iOS only.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Pushwoosh evaluates rules, segments and rollout percentages on the server. The SDK fetches the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"result, keeps the last response on disk and answers "},{"code":"get","type":"codeVoice"},{"type":"text","text":" synchronously from it, without a request."}],"type":"paragraph"},{"inlineContent":[{"text":"The SDK refreshes the flags by itself: when a session starts (the first time the app becomes","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"active and after 30 minutes in background), every hour while the app stays in foreground, after"},{"type":"text","text":" "},{"type":"text","text":"the first push registration if the previous request went without it, and after a user id change."},{"type":"text","text":" "},{"type":"text","text":"Call "},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" to fetch on demand. While the cache is valid, a refresh within 5 minutes of the"},{"type":"text","text":" "},{"type":"text","text":"last request completes from the cache without a request."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"get","type":"codeVoice"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"text":" until the first response arrives, when the cache is older than 24 hours, and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"while the cache belongs to another user id or application code. Call "},{"type":"codeVoice","code":"logImpression"},{"type":"text","text":" when the"},{"text":" ","type":"text"},{"text":"user actually sees a branch of the feature, including the disabled one: that is the control group.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Flags are requested from "},{"code":"api\/v2\/device-api\/getFeatureFlags","type":"codeVoice"},{"type":"text","text":" in place of the "},{"type":"codeVoice","code":"json\/1.3\/"},{"type":"text","text":" tail of"},{"type":"text","text":" "},{"type":"text","text":"the reverse proxy URL or of the SDK base URL. A reverse proxy URL must end with "},{"code":"json\/1.3\/","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"otherwise "},{"type":"codeVoice","code":"refresh"},{"type":"text","text":" fails without a request. A base URL without "},{"type":"codeVoice","code":"json\/1.3\/"},{"type":"text","text":" (a custom gateway, an"},{"text":" ","type":"text"},{"type":"text","text":"on-premise server) is not used for flags: they go to "},{"code":"https:\/\/<APP-CODE>.api.pushwoosh.com\/","type":"codeVoice"},{"type":"text","text":" "},{"text":"and the SDK logs a warning. App extensions never request flags.","type":"text"}]},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read a flag and log what the user saw:"}]},{"code":["let flags = Pushwoosh.configure.featureFlags","if flags.isEnabled(\"new_checkout\", default: false) {","    showNewCheckout(color: flags.get(\"new_checkout\")?.string(forProperty: \"color\", default: nil))","} else {","    showOldCheckout()","}","flags.logImpression(\"new_checkout\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Refresh on demand; the error code is the HTTP status, ","type":"text"},{"code":"0","type":"codeVoice"},{"type":"text","text":" when no response was received:"}]},{"code":["Pushwoosh.configure.featureFlags.refresh { error in","    if let error = error as NSError? {","        print(\"Feature flags refresh failed: \\(error.code)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"React to new values:"}]},{"syntax":"swift","code":["final class CheckoutModel: NSObject, PWFeatureFlagsUpdateListener {","    func featureFlagsDidUpdate() {","        reload()","    }","}","","Pushwoosh.configure.featureFlags.addUpdateListener(checkoutModel)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"Pushwoosh_FEATURE_FLAGS_DISABLE_THROTTLE","type":"codeVoice"},{"type":"text","text":" (Boolean) to "},{"type":"codeVoice","code":"YES"},{"type":"text","text":"."}]},{"inlineContent":[{"text":"is released and never called.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"text":"Feature flags evaluated by Pushwoosh for this device and user.","type":"text"}],"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/featureFlags"},"metadata":{"navigatorTitle":[{"text":"featureFlags","kind":"identifier"}],"symbolKind":"method","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"featureFlags"}],"modules":[{"name":"PushwooshCore"}],"roleHeading":"Type Method","externalID":"c:objc(pl)PWConfiguration(cm)featureFlags","role":"symbol","title":"featureFlags"},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/featureflags"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWFeatureFlags":{"url":"\/documentation\/pushwooshcore\/pwfeatureflags","kind":"symbol","role":"symbol","title":"PWFeatureFlags","type":"topic","fragments":[{"text":"PWFeatureFlags","kind":"identifier"}],"abstract":[{"text":"Feature flags evaluated by Pushwoosh for this device and user, ","type":"text"},{"code":"Pushwoosh.configure.featureFlags","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Refresh triggers, cache lifetime and examples: "},{"code":"+[PushwooshConfig featureFlags]","type":"codeVoice"},{"text":". Available on iOS only.","type":"text"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWFeatureFlags"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/featureFlags":{"navigatorTitle":[{"text":"featureFlags","kind":"identifier"}],"type":"topic","url":"\/documentation\/pushwooshcore\/pwconfiguration\/featureflags","abstract":[{"text":"Feature flags evaluated by Pushwoosh for this device and user.","type":"text"}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"featureFlags"}],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/featureFlags","role":"symbol","title":"featureFlags"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","kind":"symbol","title":"PushwooshCore","url":"\/documentation\/pushwooshcore","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"type":"topic","role":"collection"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"title":"PWConfiguration","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"abstract":[],"type":"topic","url":"\/documentation\/pushwooshcore\/pwconfiguration","kind":"symbol","role":"symbol"}}}