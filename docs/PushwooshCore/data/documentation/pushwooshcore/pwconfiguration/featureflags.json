{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"abstract":[{"type":"text","text":"Feature flags evaluated by Pushwoosh for this device and user."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)PWFeatureFlags","text":"PWFeatureFlags","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWFeatureFlags"},{"kind":"text","text":" *) "},{"kind":"identifier","text":"featureFlags"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS"]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The shared "},{"type":"codeVoice","code":"PWFeatureFlags"},{"type":"text","text":" instance. Available on iOS only."}]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Pushwoosh evaluates rules, segments and rollout percentages on the server. The SDK fetches the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"result, keeps the last response on disk and answers "},{"code":"get","type":"codeVoice"},{"text":" synchronously from it, without a request.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The SDK refreshes the flags by itself: when a session starts (the first time the app becomes","type":"text"},{"type":"text","text":" "},{"text":"active and after 30 minutes in background), every hour while the app stays in foreground, after","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the first push registration if the previous request went without it, and after a user id change."},{"type":"text","text":" "},{"text":"Call ","type":"text"},{"code":"refresh","type":"codeVoice"},{"text":" to fetch on demand. While the cache is valid, a refresh within 5 minutes of the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"last request completes from the cache without a request."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"get"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" until the first response arrives, when the cache is older than 24 hours, and"},{"type":"text","text":" "},{"text":"while the cache belongs to another user id or application code. Call ","type":"text"},{"type":"codeVoice","code":"logImpression"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"text":"user actually sees a branch of the feature, including the disabled one: that is the control group.","type":"text"}]},{"inlineContent":[{"text":"Flags are requested from ","type":"text"},{"type":"codeVoice","code":"api\/v2\/device-api\/getFeatureFlags"},{"text":" in place of the ","type":"text"},{"type":"codeVoice","code":"json\/1.3\/"},{"type":"text","text":" tail of"},{"type":"text","text":" "},{"type":"text","text":"the reverse proxy URL or of the SDK base URL. A reverse proxy URL must end with "},{"type":"codeVoice","code":"json\/1.3\/"},{"type":"text","text":","},{"text":" ","type":"text"},{"text":"otherwise ","type":"text"},{"code":"refresh","type":"codeVoice"},{"type":"text","text":" fails without a request. A base URL without "},{"code":"json\/1.3\/","type":"codeVoice"},{"type":"text","text":" (a custom gateway, an"},{"text":" ","type":"text"},{"text":"on-premise server) is not used for flags: they go to ","type":"text"},{"code":"https:\/\/<APP-CODE>.api.pushwoosh.com\/","type":"codeVoice"},{"type":"text","text":" "},{"text":"and the SDK logs a warning. App extensions never request flags.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Example","level":2,"text":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read a flag and log what the user saw:"}]},{"type":"codeListing","syntax":"swift","code":["let flags = Pushwoosh.configure.featureFlags","if flags.isEnabled(\"new_checkout\", default: false) {","    showNewCheckout(color: flags.get(\"new_checkout\")?.string(forProperty: \"color\", default: nil))","} else {","    showOldCheckout()","}","flags.logImpression(\"new_checkout\")"]},{"inlineContent":[{"text":"Refresh on demand; the error code is the HTTP status, ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" when no response was received:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.configure.featureFlags.refresh { error in","    if let error = error as NSError? {","        print(\"Feature flags refresh failed: \\(error.code)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"React to new values:","type":"text"}]},{"code":["final class CheckoutModel: NSObject, PWFeatureFlagsUpdateListener {","    func featureFlagsDidUpdate() {","        reload()","    }","}","","Pushwoosh.configure.featureFlags.addUpdateListener(checkoutModel)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Pushwoosh_FEATURE_FLAGS_DISABLE_THROTTLE"},{"type":"text","text":" (Boolean) to "},{"type":"codeVoice","code":"YES"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"is released and never called.","type":"text"}]}],"kind":"content"}],"metadata":{"fragments":[{"kind":"text","text":"+ "},{"text":"featureFlags","kind":"identifier"}],"symbolKind":"method","modules":[{"name":"PushwooshCore"}],"role":"symbol","roleHeading":"Type Method","externalID":"c:objc(pl)PWConfiguration(cm)featureFlags","title":"featureFlags","navigatorTitle":[{"text":"featureFlags","kind":"identifier"}]},"variants":[{"paths":["\/documentation\/pushwooshcore\/pwconfiguration\/featureflags"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/featureFlags"},"references":{"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration/featureFlags":{"abstract":[{"type":"text","text":"Feature flags evaluated by Pushwoosh for this device and user."}],"type":"topic","url":"\/documentation\/pushwooshcore\/pwconfiguration\/featureflags","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration\/featureFlags","fragments":[{"text":"+ ","kind":"text"},{"text":"featureFlags","kind":"identifier"}],"navigatorTitle":[{"text":"featureFlags","kind":"identifier"}],"title":"featureFlags","role":"symbol","kind":"symbol"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWFeatureFlags":{"identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWFeatureFlags","abstract":[{"text":"Feature flags evaluated by Pushwoosh for this device and user, ","type":"text"},{"type":"codeVoice","code":"Pushwoosh.configure.featureFlags"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"Refresh triggers, cache lifetime and examples: "},{"type":"codeVoice","code":"+[PushwooshConfig featureFlags]"},{"type":"text","text":". Available on iOS only."}],"type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"identifier","text":"PWFeatureFlags"}],"title":"PWFeatureFlags","url":"\/documentation\/pushwooshcore\/pwfeatureflags"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore":{"type":"topic","title":"PushwooshCore","role":"collection","abstract":[{"type":"text","text":"Core foundation module for Pushwoosh SDK."}],"kind":"symbol","url":"\/documentation\/pushwooshcore","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore"},"doc://com.pushwoosh.PushwooshCore/documentation/PushwooshCore/PWConfiguration":{"role":"symbol","title":"PWConfiguration","url":"\/documentation\/pushwooshcore\/pwconfiguration","fragments":[{"text":"PWConfiguration","kind":"identifier"}],"abstract":[],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration","type":"topic"}}}