,"type":"paragraph"}]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Convenience method for the common case of associating a user ID with a single","type":"text"},{"type":"text","text":" "},{"type":"text","text":"email address. Equivalent to calling "},{"type":"codeVoice","code":"setUser:emails:completion:"},{"text":" with a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"single-element array."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple login flow with single email:"}]},{"type":"codeListing","syntax":"swift","code":["class SimpleAuthManager {","","    func loginWithEmail(_ email: String, password: String,","                       completion: @escaping (Result<Void, Error>) -> Void) {","","        APIClient.shared.authenticate(email: email, password: password) { result in","            switch result {","            case .success(let authResponse):","                Pushwoosh.configure.setUser(authResponse.userId, email: email) { error in","                    if let error = error {","                        Logger.warning(\"Pushwoosh sync failed: \\(error)\")","                        \/\/ Don't fail login for Pushwoosh errors","                    }","","                    self.saveSession(authResponse)","                    completion(.success(()))","                }","","            case .failure(let error):","                completion(.failure(error))","            }","        }","    }","}"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWConfiguration"]]},"sections":[],"metadata":{"navigatorTitle":[{"text":"setUser:email:completion:","kind":"identifier"}],"role":"symbol","roleHeading":"Type Method","modules":[{"name":"PushwooshCore"}],