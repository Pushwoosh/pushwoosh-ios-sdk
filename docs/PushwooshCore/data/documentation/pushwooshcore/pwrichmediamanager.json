ice"},{"type":"text","text":" in the ZIP) are routed to the"},{"text":" ","type":"text"},{"code":"PushwooshInApp","type":"codeVoice"},{"text":" module at the top of ","type":"text"},{"code":"presentRichMedia:","type":"codeVoice"},{"type":"text","text":", BEFORE the gate, and are"},{"type":"text","text":" "},{"text":"intentionally NOT subject to ","type":"text"},{"type":"codeVoice","code":"shouldPresentRichMedia:"},{"type":"text","text":" — they carry their own lifecycle"},{"type":"text","text":" "},{"text":"callbacks (onShown\/onClicked\/onClosed). The gate governs HTML \/ modal rich media only.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshcore\/pwrichmediamanager"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore"]]},"topicSections":[{"title":"Instance Properties","identifiers":["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRichMediaManager\/delegate","doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRichMediaManager\/richMediaStyle"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRichMediaManager\/presentRichMedia:"],"title":"Instance Methods"},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshCore\/documentation\/PushwooshCore\/PWRichMediaManager\/sharedManager"],"title":"Type Methods"}],"metadata":{"roleHeading":"Class","symbolKind":"class","navigatorTitle":[{"kind":"identifier","text":"PWRichMediaManager"}],"fragments":[{"text":"PWRichMediaManager","kind":"identifier"}],"modules":[{"name":"PushwooshCore"}],"role":"symbol","externalID":"c:objc(cs)PWRichMediaManager","title":"PWRichMediaManager"},"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"title":"Inherits From","kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/com.pushwoosh.PushwooshCore\/objc(cs)NSObject"]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshC