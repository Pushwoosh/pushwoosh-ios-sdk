pe":"text","text":" "},{"type":"text","text":"and the closed banner does not come back before its "},{"code":"expireDate","type":"codeVoice"},{"type":"text","text":". A banner counts as shown once at"},{"type":"text","text":" "},{"text":"least half of its height stays on screen for 0.3 s; a control-group slot stays empty and counts the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"same way by its position."}],"url":"\/documentation\/pushwooshinapp\/pushwooshinlineview","identifier":"doc:\/\/com.pushwoosh.PushwooshInApp\/documentation\/PushwooshInApp\/PushwooshInlineView","kind":"symbol","type":"topic","navigatorTitle":[{"text":"PushwooshInlineView","kind":"identifier"}],"title":"PushwooshInlineView","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"PushwooshInlineView","kind":"identifier"}],"role":"symbol"}},"variantOverrides":[{"patch":[{"path":"\/identifier\/interfaceLanguage","value":"occ","op":"replace"},{"path":"\/metadata\/roleHeading","value":"Instance Method","op":"replace"},{"op":"replace","value":"traitCollectionDidChange:","path":"\/metadata\/title"},{"op":"replace","path":"\/metadata\/symbolKind","value":"method"},{"value":[{"text":"- ","kind":"text"},{"text":"traitCollectionDidChange:","kind":"identifier"}],"op":"replace","path":"\/metadata\/fragments"},{"value":null,"op":"add","path":"\/topicSections"},{"value":null,"op":"add","path":"\/relationshipsSections"},{"value":null,"op":"add","path":"\/seeAlsoSections"},{"path":"\/primaryContentSections\/0","value":{"declarations":[{"languages":["occ"],"tokens":[{"text":"- (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"traitCollectionDidChange:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UITraitCollection","preciseIdentifier":"c:objc(cs)UITraitCollection","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"previousTraitCollection","kind":"internalParam"},{"tex