.pushwoosh.PushwooshInApp\/documentation\/PushwooshInApp\/PushwooshInlineView","role":"symbol","abstract":[{"type":"text","text":"Inline banner slot. Place it anywhere in a UIKit layout and give it a slot id: it stays at zero"},{"type":"text","text":" "},{"text":"height until the slot gets a banner (","type":"text"},{"code":"Pushwoosh.inline.requestSlots(_:completion:)","type":"codeVoice"},{"text":"), then expands to","type":"text"},{"text":" ","type":"text"},{"text":"the banner’s height with a spring animation, so Auto Layout and stack-view neighbours move aside on","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"their own. An empty answer for the slot collapses it back. Received banners are kept on disk and shown"},{"text":" ","type":"text"},{"type":"text","text":"again after relaunch. A banner past its "},{"code":"expireDate","type":"codeVoice"},{"type":"text","text":" is not shown; the close button collapses the slot"},{"type":"text","text":" "},{"text":"and the closed banner does not come back before its ","type":"text"},{"type":"codeVoice","code":"expireDate"},{"text":". A banner counts as shown once at","type":"text"},{"text":" ","type":"text"},{"text":"least half of its height stays on screen for 0.3 s; a control-group slot stays empty and counts the","type":"text"},{"type":"text","text":" "},{"text":"same way by its position.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"PushwooshInlineView"}],"type":"topic"},"doc://com.pushwoosh.PushwooshInApp/documentation/PushwooshInApp":{"kind":"symbol","title":"PushwooshInApp","url":"\/documentation\/pushwooshinapp","identifier":"doc:\/\/com.pushwoosh.PushwooshInApp\/documentation\/PushwooshInApp","role":"collection","abstract":[{"type":"text","text":"Native in-app messages rendered on-device, without a web view."}],"type":"topic"},"doc://com.pushwoosh.PushwooshInApp/documentation/PushwooshInApp/PushwooshInlineView/init(coder:)":{"kind":"symbol","fragments":[{"kind":"identifier","text