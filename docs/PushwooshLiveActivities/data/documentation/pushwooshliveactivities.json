{"sections":[],"abstract":[{"text":"Real-time iOS Live Activities powered by push notifications.","type":"text"}],"metadata":{"role":"collection","modules":[{"name":"PushwooshLiveActivities"}],"title":"PushwooshLiveActivities","externalID":"PushwooshLiveActivities","symbolKind":"module","roleHeading":"Framework"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshliveactivities"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshliveactivities"]}],"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities"},"topicSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/GettingStarted","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/Examples"],"title":"Getting Started"},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup"],"title":"Classes"},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentState"],"title":"Protocols"},{"title":"Structures","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/AnyCodable","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/DefaultLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributeData","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentStateData"]},{"title":"Extended Modules","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge"]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"PushwooshLiveActivities integrates Apple’s ActivityKit framework to deliver real-time updates to Live Activities on the Lock Screen and Dynamic Island. Live Activities provide persistent, glanceable information that users can track without opening your app.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The module handles token registration, activity lifecycle management, and push notification delivery automatically. It supports both custom activity attributes and a default configuration for cross-platform scenarios.","type":"text"}],"type":"paragraph"},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)"},{"text":" for every attributes type your app uses ","type":"text"},{"type":"strong","inlineContent":[{"text":"at launch","type":"text"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":" or the SwiftUI "},{"type":"codeVoice","code":"App.init"},{"type":"text","text":"), not lazily when a screen appears. Only a type registered in the current session is reconnected to its already-running activities so their push token can be re-uploaded after a cold start — for example an activity that started, or was scheduled to start, while the app was terminated. A type registered later (e.g. in a view’s "},{"code":"onAppear","type":"codeVoice"},{"type":"text","text":") can’t receive remote updates until that screen is opened. ActivityKit exposes running activities only through the concrete "},{"code":"Activity<Attributes>","type":"codeVoice"},{"text":" generic and does not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been told about this session. The call is idempotent — registering at launch and again per-screen is safe.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/Examples":{"role":"article","title":"Code Examples","abstract":[{"type":"text","text":"Practical examples for common Live Activities integration scenarios."}],"kind":"article","type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/Examples","url":"\/documentation\/pushwooshliveactivities\/examples"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/AnyCodable":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"AnyCodable","kind":"identifier"}],"kind":"symbol","abstract":[],"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/AnyCodable","navigatorTitle":[{"text":"AnyCodable","kind":"identifier"}],"title":"AnyCodable","role":"symbol","url":"\/documentation\/pushwooshliveactivities\/anycodable"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivityAttributeData":{"title":"PushwooshLiveActivityAttributeData","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"PushwooshLiveActivityAttributeData","kind":"identifier"}],"url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivityattributedata","role":"symbol","abstract":[{"type":"text","text":"Pushwoosh-specific metadata required for Live Activity tracking."}],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAtt