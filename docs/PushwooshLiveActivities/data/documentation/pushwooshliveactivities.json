{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshliveactivities"]},{"paths":["\/documentation\/pushwooshliveactivities"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"text":"Real-time iOS Live Activities powered by push notifications.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/GettingStarted","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/Examples"],"title":"Getting Started"},{"title":"Classes","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup"]},{"title":"Protocols","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentState"]},{"title":"Structures","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/AnyCodable","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/DefaultLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributeData","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentStateData"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge"],"title":"Extended Modules"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities"},"metadata":{"role":"collection","roleHeading":"Framework","title":"PushwooshLiveActivities","symbolKind":"module","externalID":"PushwooshLiveActivities","modules":[{"name":"PushwooshLiveActivities"}]},"kind":"symbol","hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"PushwooshLiveActivities integrates Apple’s ActivityKit framework to deliver real-time updates to Live Activities on the Lock Screen and Dynamic Island. Live Activities provide persistent, glanceable information that users can track without opening your app."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module handles token registration, activity lifecycle management, and push notification delivery automatically. It supports both custom activity attributes and a default configuration for cross-platform scenarios."}]},{"style":"important","content":[{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)","isActive":true},{"type":"text","text":" for every attributes type your app uses "},{"type":"strong","inlineContent":[{"text":"at launch","type":"text"}]},{"text":" (in ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" or the SwiftUI "},{"type":"codeVoice","code":"App.init"},{"type":"text","text":"), not lazily when a screen appears. Only a type registered in the current session is reconnected to its already-running activities so their push token can be re-uploaded after a cold start — for example an activity that started, or was scheduled to start, while the app was terminated. A type registered later (e.g. in a view’s "},{"code":"onAppear","type":"codeVoice"},{"text":") can’t receive remote updates until that screen is opened. ActivityKit exposes running activities only through the concrete ","type":"text"},{"code":"Activity<Attributes>","type":"codeVoice"},{"type":"text","text":" generic and does not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been told about this session. The call is idempotent — registering at launch and again per-screen is safe."}],"type":"paragraph"}],"type":"aside","name":"Important"}]}],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivityAttributes":{"role":"symbol","abstract":[{"text":"Protocol for defining custom Live Activity attributes.","type":"text"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PushwooshLiveActivityAttributes"}],"navigatorTitle":[{"text":"PushwooshLiveActivityAttributes","kind":"identifier"}],"url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivityattributes","title":"PushwooshLiveActivityAttributes","type":"topic","kind":"symbol"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshBridge":{"title":"PushwooshBridge","abstract":[],"url":"\/documentation\/pushwooshliveactivities\/pushwooshbridge","kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesImplementationSetup/setup(_:)":{"role":"symbol","abstract":[{"text":"Configures Live Activities with custom attributes.","type":"text"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"t