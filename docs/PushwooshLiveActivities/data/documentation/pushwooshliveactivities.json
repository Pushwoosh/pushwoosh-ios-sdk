{"topicSections":[{"title":"Getting Started","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/GettingStarted","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/Examples"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup"],"title":"Classes"},{"title":"Protocols","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentState"]},{"title":"Structures","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/AnyCodable","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/DefaultLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributeData","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentStateData"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge"],"title":"Extended Modules"}],"variants":[{"paths":["\/documentation\/pushwooshliveactivities"],"traits":[{"interfaceLanguage":"swift"}]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshliveactivities"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities"},"abstract":[{"text":"Real-time iOS Live Activities powered by push notifications.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"PushwooshLiveActivities integrates Apple’s ActivityKit framework to deliver real-time updates to Live Activities on the Lock Screen and Dynamic Island. Live Activities provide persistent, glanceable information that users can track without opening your app."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module handles token registration, activity lifecycle management, and push notification delivery automatically. It supports both custom activity attributes and a default configuration for cross-platform scenarios."}]},{"type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Call "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)","isActive":true,"type":"reference"},{"text":" for every attributes type your app uses ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"at launch"}]},{"type":"text","text":" (in "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":" or the SwiftUI "},{"type":"codeVoice","code":"App.init"},{"type":"text","text":"), not lazily when a screen appears. Only a type registered in the current session is reconnected to its already-running activities so their push token can be re-uploaded after a cold start — for example an activity that started, or was scheduled to start, while the app was terminated. A type registered later (e.g. in a view’s "},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":") can’t receive remote updates until that screen is opened. ActivityKit exposes running activities only through the concrete "},{"type":"codeVoice","code":"Activity<Attributes>"},{"type":"text","text":" generic and does not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been told about this session. The call is idempotent — registering at launch and again per-screen is safe."}],"type":"paragraph"}],"style":"important"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[[]]},"metadata":{"externalID":"PushwooshLiveActivities","symbolKind":"module","roleHeading":"Framework","role":"collection","modules":[{"name":"PushwooshLiveActivities"}],"title":"PushwooshLiveActivities"},"kind":"symbol","sections":[],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/AnyCodable":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyCodable","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/pushwooshliveactivities\/anycodable","abstract":[],"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/AnyCodable","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AnyCodable"}],"title":"AnyCodable"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesVersionString":{"fragments":[{"text":"PushwooshLiveActivitiesVersionString","kind":"identifier"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesVersionString","role":"symbol","abstract":[{"text":"Project version string for PushwooshLiveActivities.","type":"text"}],"title":"PushwooshLiveActivitiesVersionString","kind":"symbol","url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesversionstring","type":"topic"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/Examples":{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/Examples","url":"\/documentation\/pushwooshliveactivities\/examples","type":"topic","title":"Code Examples","abstract":[{"type":"text","text":"Practical examples for common Live Activities integration scenarios."}],"role":"article","kind":"article"},"doc://com.pushwoosh.PushwooshLiveActivities/documen