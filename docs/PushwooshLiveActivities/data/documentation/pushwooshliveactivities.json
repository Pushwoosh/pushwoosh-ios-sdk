{"hierarchy":{"paths":[[]]},"kind":"symbol","topicSections":[{"title":"Getting Started","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/GettingStarted","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/Examples"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup"],"title":"Classes"},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentState"],"title":"Protocols"},{"title":"Structures","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/AnyCodable","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/DefaultLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributeData","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentStateData"]},{"title":"Extended Modules","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshliveactivities"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshliveactivities"]}],"metadata":{"role":"collection","externalID":"PushwooshLiveActivities","modules":[{"name":"PushwooshLiveActivities"}],"roleHeading":"Framework","title":"PushwooshLiveActivities","symbolKind":"module"},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"PushwooshLiveActivities integrates Apple’s ActivityKit framework to deliver real-time updates to Live Activities on the Lock Screen and Dynamic Island. Live Activities provide persistent, glanceable information that users can track without opening your app.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module handles token registration, activity lifecycle management, and push notification delivery automatically. It supports both custom activity attributes and a default configuration for cross-platform scenarios."}]},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"Call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)"},{"type":"text","text":" for every attributes type your app uses "},{"type":"strong","inlineContent":[{"text":"at launch","type":"text"}]},{"type":"text","text":" (in "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" or the SwiftUI "},{"type":"codeVoice","code":"App.init"},{"type":"text","text":"), not lazily when a screen appears. Only a type registered in the current session is reconnected to its already-running activities so their push token can be re-uploaded after a cold start — for example an activity that started, or was scheduled to start, while the app was terminated. A type registered later (e.g. in a view’s "},{"code":"onAppear","type":"codeVoice"},{"type":"text","text":") can’t receive remote updates until that screen is opened. ActivityKit exposes running activities only through the concrete "},{"type":"codeVoice","code":"Activity<Attributes>"},{"text":" generic and does not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been told about this session. The call is idempotent — registering at launch and again per-screen is safe.","type":"text"}],"type":"paragraph"}]}]}],"abstract":[{"type":"text","text":"Real-time iOS Live Activities powered by push notifications."}],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/Examples":{"kind":"article","role":"article","url":"\/documentation\/pushwooshliveactivities\/examples","title":"Code Examples","type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/Examples","abstract":[{"type":"text","text":"Practical examples for common Live Activities integration scenarios."}]},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesVersionNumber":{"kind":"symbol","role":"symbol","fragments":[{"text":"PushwooshLiveActivitiesVersionNumber","kind":"identifier"}],"url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesversionnumber","title":"PushwooshLiveActivitiesVersionNumber","type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesVersionNumber","abstract":[{"type":"text","text":"Project version number for PushwooshLiveActivities."}]},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivityContentStateData":{"abstract":[{"type":"text","text":"Pushwoosh-specific metadata for Live Activity content state updates."}],"navigatorTitle":[{"kind":"identifier","text":"PushwooshLiveActivityContentStateData"}],"url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitycontentstatedata","role":"symbol","kind":"symbol","title":"PushwooshLiveActivityContentStateData","type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/Pushwoo