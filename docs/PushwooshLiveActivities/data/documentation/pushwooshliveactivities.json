{"topicSections":[{"title":"Getting Started","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/GettingStarted","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/Examples"]},{"title":"Classes","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentState"],"title":"Protocols"},{"title":"Structures","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/AnyCodable","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/DefaultLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributeData","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentStateData"]},{"title":"Extended Modules","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge"]}],"variants":[{"paths":["\/documentation\/pushwooshliveactivities"],"traits":[{"interfaceLanguage":"swift"}]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshliveactivities"]}],"abstract":[{"type":"text","text":"Real-time iOS Live Activities powered by push notifications."}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"PushwooshLiveActivities integrates Apple’s ActivityKit framework to deliver real-time updates to Live Activities on the Lock Screen and Dynamic Island. Live Activities provide persistent, glanceable information that users can track without opening your app."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module handles token registration, activity lifecycle management, and push notification delivery automatically. It supports both custom activity attributes and a default configuration for cross-platform scenarios."}]},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)","type":"reference"},{"text":" for every attributes type your app uses ","type":"text"},{"type":"strong","inlineContent":[{"text":"at launch","type":"text"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"text":" or the SwiftUI ","type":"text"},{"code":"App.init","type":"codeVoice"},{"text":"), not lazily when a screen appears. Only a type registered in the current session is reconnected to its already-running activities so their push token can be re-uploaded after a cold start — for example an activity that started, or was scheduled to start, while the app was terminated. A type registered later (e.g. in a view’s ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":") can’t receive remote updates until that screen is opened. ActivityKit exposes running activities only through the concrete ","type":"text"},{"code":"Activity<Attributes>","type":"codeVoice"},{"type":"text","text":" generic and does not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been told about this session. The call is idempotent — registering at launch and again per-screen is safe."}]}],"type":"aside"}],"kind":"content"}],"kind":"symbol","metadata":{"role":"collection","modules":[{"name":"PushwooshLiveActivities"}],"title":"PushwooshLiveActivities","symbolKind":"module","externalID":"PushwooshLiveActivities","roleHeading":"Framework"},"sections":[],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesImplementationSetup/setup(_:)":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)","title":"setup(_:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"setup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Attributes","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"Attributes","kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp"},{"text":".Type)","kind":"text"}],"url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesimplementationsetup\/setup(_:)","abstract":[{"type":"text","text":"Configures Live Activities with custom attributes."}],"role":"symbol"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshBridge":{"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge","type":"topic","url":"\/documentation\/pushwooshliveactivities\/pushwooshbridge","title":"PushwooshBridge","abstract":[],"role":"collection"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/Examples":{"type":"topic","role":"article","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/Exa