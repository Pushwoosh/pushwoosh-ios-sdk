{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/pushwooshliveactivities"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/pushwooshliveactivities"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Getting Started","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/GettingStarted","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/Examples"]},{"title":"Classes","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentState"],"title":"Protocols"},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/AnyCodable","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/DefaultLiveActivityAttributes","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributeData","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityContentStateData"],"title":"Structures"},{"title":"Extended Modules","identifiers":["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge"]}],"abstract":[{"type":"text","text":"Real-time iOS Live Activities powered by push notifications."}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"PushwooshLiveActivities integrates Apple’s ActivityKit framework to deliver real-time updates to Live Activities on the Lock Screen and Dynamic Island. Live Activities provide persistent, glanceable information that users can track without opening your app."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The module handles token registration, activity lifecycle management, and push notification delivery automatically. It supports both custom activity attributes and a default configuration for cross-platform scenarios.","type":"text"}]},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Call "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)","isActive":true,"type":"reference"},{"type":"text","text":" for every attributes type your app uses "},{"type":"strong","inlineContent":[{"type":"text","text":"at launch"}]},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"text":" or the SwiftUI ","type":"text"},{"type":"codeVoice","code":"App.init"},{"type":"text","text":"), not lazily when a screen appears. Only a type registered in the current session is reconnected to its already-running activities so their push token can be re-uploaded after a cold start — for example an activity that started, or was scheduled to start, while the app was terminated. A type registered later (e.g. in a view’s "},{"type":"codeVoice","code":"onAppear"},{"text":") can’t receive remote updates until that screen is opened. ActivityKit exposes running activities only through the concrete ","type":"text"},{"type":"codeVoice","code":"Activity<Attributes>"},{"type":"text","text":" generic and does not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been told about this session. The call is idempotent — registering at launch and again per-screen is safe."}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"symbolKind":"module","roleHeading":"Framework","title":"PushwooshLiveActivities","externalID":"PushwooshLiveActivities","modules":[{"name":"PushwooshLiveActivities"}],"role":"collection"},"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesVersionString":{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesVersionString","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Project version string for PushwooshLiveActivities."}],"title":"PushwooshLiveActivitiesVersionString","fragments":[{"kind":"identifier","text":"PushwooshLiveActivitiesVersionString"}],"url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesversionstring","type":"topic"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivityAttributeData":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PushwooshLiveActivityAttributeData"}],"type":"topic","kind":"symbol","title":"PushwooshLiveActivityAttributeData","url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivityattributedata","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributeData","abstract":[{"type":"text","text":"Pushwoosh-specific metadata required for Live Activity tracking."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PushwooshLiveActivityAttributeData"}]},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesImplementationSetup/setup(_:)":{"url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesimplementationsetup\/setup(_:)","identifier":"doc:\/\/