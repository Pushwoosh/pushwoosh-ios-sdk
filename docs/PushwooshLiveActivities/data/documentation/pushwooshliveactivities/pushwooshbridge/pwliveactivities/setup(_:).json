ext","text":" : "},{"text":"PushwooshLiveActivityAttributes","kind":"typeIdentifier","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your custom attributes type conforming to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"text":".","type":"text"}]}],"name":"activityType"}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method sets up automatic token registration and activity lifecycle management"},{"text":" ","type":"text"},{"type":"text","text":"for your custom "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"text":" type.","type":"text"}]},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Call this for ","type":"text"},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"text":" attributes type you use, at app launch — in","type":"text"},{"text":" ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" (or the "},{"code":"App.init","type":"codeVoice"},{"text":" for SwiftUI apps).","type":"text"},{"text":" ","type":"text"},{"text":"This is what re-attaches the SDK to activities that are ","type":"text"},{"inlineContent":[{"text":"already running","type":"text"}],"type":"strong"},{"type":"text","text":" at launch and"},{"text":" ","type":"text"},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"text":" ","type":"text"},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"text":" ","type":"text"},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"type":"text","text":" "},{"type":"text","text":"exposes running activities only through the concrete "},{"type":"codeVoice","code":"Activity<Attributes>"},{"text":" generic and does","type":"text"},{"type":"text","text":" "},{"text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been","type":"text"},{"type":"text","text":" "},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"type":"text","text":")"},{"text":" ","type":"text"},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"type":"text","text":" "},{"text":"so registering at launch and again per-screen is safe.","type":"text"}]}],"type":"aside","name":"Important"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshliveactivities\/pushwooshbridge\/pwliveactivities\/setup(_:)"]}],"abstract":[{"text":"Configures Live Activities with custom attributes.","type":"text"}],"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshBridge/PWLiveActivities/setup(_:)":{"abstract":[{"type":"text","text":"Configures Live Activities with custom attributes.