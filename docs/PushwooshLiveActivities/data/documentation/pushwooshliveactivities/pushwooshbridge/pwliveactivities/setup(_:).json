"text":"activityType"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","text":"Attributes","kind":"typeIdentifier"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"where"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","text":"PushwooshLiveActivityAttributes","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"activityType","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your custom attributes type conforming to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"type":"text","text":"."}]}]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method sets up automatic token registration and activity lifecycle management"},{"type":"text","text":" "},{"text":"for your custom ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true},{"text":" type.","type":"text"}]},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Call this for "},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"text":" attributes type you use, at app launch — in","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"text":" (or the ","type":"text"},{"type":"codeVoice","code":"App.init"},{"text":" for SwiftUI apps).","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"This is what re-attaches the SDK to activities that are "},{"type":"strong","inlineContent":[{"text":"already running","type":"text"}]},{"text":" at launch and","type":"text"},{"type":"text","text":" "},{"text":"re-uploads their per-activity push token to the server, so remote updates keep working after","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"type":"text","text":" "},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"type":"text","text":" "},{"type":"text","text":"exposes running activities only through the concrete "},{"type":"codeVoice","code":"Activity<Attributes>"},{"type":"text","text":" generic and does"},{"type":"text","text":" "},{"text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been","type":"text"},{"type":"text","text":" "},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":")","type":"text"},{"type":"text","text":" "},{"text":"means the server can’t update that activity until that screen is opened. The call is idempotent,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"so registering at launch and again per-screen is safe."}],"type":"paragraph"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities\/setup(_:)","interfaceLanguage":"swift"},"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshBridge/PWLiveActivities/setup(_:)":{"abstract":[{"text":"Configures Live Activities with custom attributes.","type":"text