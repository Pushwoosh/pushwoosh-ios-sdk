butes","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"activityType"},{"kind":"text","text":": "},{"preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","kind":"typeIdentifier","text":"Attributes"},{"text":".Type) ","kind":"text"},{"kind":"keyword","text":"where"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"Attributes"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","text":"PushwooshLiveActivityAttributes","kind":"typeIdentifier"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"activityType","content":[{"inlineContent":[{"type":"text","text":"Your custom attributes type conforming to "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method sets up automatic token registration and activity lifecycle management"},{"type":"text","text":" "},{"type":"text","text":"for your custom "},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true},{"text":" type.","type":"text"}]},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Call this for "},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"text":" attributes type you use, at app launch — in","type":"text"},{"text":" ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":" (or the ","type":"text"},{"code":"App.init","type":"codeVoice"},{"text":" for SwiftUI apps).","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"This is what re-attaches the SDK to activities that are "},{"type":"strong","inlineContent":[{"type":"text","text":"already running"}]},{"text":" at launch and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"type":"text","text":" "},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"text":" ","type":"text"},{"type":"text","text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit"},{"type":"text","text":" "},{"type":"text","text":"exposes running activities only through the concrete "},{"code":"Activity<Attributes>","type":"codeVoice"},{"type":"text","text":" generic and does"},{"text":" ","type":"text"},{"type":"text","text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been"},{"text":" ","type":"text"},{"type":"text","text":"told about in the current session. Registering a type lazily (e.g. in a view’s "},{"type":"codeVoice","code":"onAppear"},{"text":")","type":"text"},{"type":"text","text":" "},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"type":"text","text":" "},{"type":"text","text":"so registering at launch and again per-screen is safe."}],"type":"paragraph"}]}]}],"sections":[],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshBridge":{"kind":"symbol","role":"collection","url":"\/documentation\/pushwooshliveactivities\/pushwooshbridge","title":"P