{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities\/setup(_:)"},"abstract":[{"type":"text","text":"Configures Live Activities with custom attributes."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"setup","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"Attributes"},{"kind":"text","text":">("},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"activityType","kind":"internalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Attributes","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"where"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP","text":"PushwooshLiveActivityAttributes","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","kind":"typeIdentifier"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Your custom attributes type conforming to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"activityType"}],"kind":"parameters"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method sets up automatic token registration and activity lifecycle management"},{"type":"text","text":" "},{"text":"for your custom ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","type":"reference","isActive":true},{"type":"text","text":" type."}]},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Call this for ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"type":"text","text":" attributes type you use, at app launch — in"},{"text":" ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":" (or the ","type":"text"},{"code":"App.init","type":"codeVoice"},{"type":"text","text":" for SwiftUI apps)."},{"text":" ","type":"text"},{"type":"text","text":"This is what re-attaches the SDK to activities that are "},{"type":"strong","inlineContent":[{"type":"text","text":"already running"}]},{"text":" at launch and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"text":" ","type":"text"},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"type":"text","text":" "},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"exposes running activities only through the concrete "},{"type":"codeVoice","code":"Activity<Attributes>"},{"text":" generic and does","type":"text"},{"type":"text","text":" "},{"type":"text","text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been"},{"type":"text","text":" "},{"type":"text","text":"told about in the current session. Registering a type lazily (e.g. in a view’s "},{"code":"onAppear","type":"codeVoice"},{"type":"text","text":")"},{"type":"text","text":" "},{"text":"means the server can’t update that activity until that screen is opened. The call is idempotent,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"so registering at launch and again per-screen is safe."}]}],"type":"aside","name":"Important"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/pushwooshliveactivities\/pushwooshbridge\/pwliveactivities\/setup(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"modules":[{"name":"PushwooshLiveActivities","relatedModules":["PushwooshBridge"]}],"role":"symbol","extendedModule":"PushwooshBridge","title":"setup(_:)","externalID":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ","roleHeading":"Type Method","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"setup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Attributes","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"Attributes","kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp"},{"text":".Type)","kind":"text"}],"platforms":[{"name":"iOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"16.1"}],"symbolKind":"method"},"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshBridge":{"url":"\/documentation\/pushwooshliveactivities\/pushwooshbridge","identifier":"doc:\/\/com.pushwoosh.PushwooshL