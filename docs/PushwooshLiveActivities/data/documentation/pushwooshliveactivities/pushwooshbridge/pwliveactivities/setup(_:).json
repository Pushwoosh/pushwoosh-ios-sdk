{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities"]]},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities\/setup(_:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Configures Live Activities with custom attributes."}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"setup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Attributes","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"activityType"},{"kind":"text","text":": "},{"text":"Attributes","kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp"},{"text":".Type) ","kind":"text"},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Attributes"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","kind":"typeIdentifier","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP","text":"PushwooshLiveActivityAttributes"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"activityType","content":[{"inlineContent":[{"text":"Your custom attributes type conforming to ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"This method sets up automatic token registration and activity lifecycle management","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"for your custom "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"text":" type.","type":"text"}],"type":"paragraph"},{"style":"important","content":[{"inlineContent":[{"text":"Call this for ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"strong"},{"text":" attributes type you use, at app launch — in","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":" (or the "},{"code":"App.init","type":"codeVoice"},{"text":" for SwiftUI apps).","type":"text"},{"text":" ","type":"text"},{"text":"This is what re-attaches the SDK to activities that are ","type":"text"},{"type":"strong","inlineContent":[{"text":"already running","type":"text"}]},{"text":" at launch and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"text":" ","type":"text"},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"text":" ","type":"text"},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"exposes running activities only through the concrete "},{"type":"codeVoice","code":"Activity<Attributes>"},{"type":"text","text":" generic and does"},{"type":"text","text":" "},{"type":"text","text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been"},{"text":" ","type":"text"},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"type":"text","text":")"},{"text":" ","type":"text"},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"text":" ","type":"text"},{"text":"so registering at launch and again per-screen is safe.","type":"text"}],"type":"paragraph"}],"name":"Important","type":"aside"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"title":"setup(_:)","platforms":[{"beta":false,"introducedAt":"16.1","name":"iOS","unavailable":false,"deprecated":false}],"roleHeading":"Type Method","symbolKind":"method","role":"symbol","externalID":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"setup","kind":"identifier"},{"kind":"text","text":"<"},{"text":"Attributes","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"Attributes","kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp"},{"kind":"text","text":".Type)"}],"extendedModule":"PushwooshBridge","modules":[{"relatedModules":["PushwooshBridge"],"name":"PushwooshLiveActivities"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshliveactivities\/pushwooshbridge\/pwliveactivities\/setup(_:)"]}],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities":{"url":"\/documentation\/pushwooshliveactivities","title":"PushwooshLiveActivities","identifier":"doc:\/\/com.pushwoosh.Pushwoosh