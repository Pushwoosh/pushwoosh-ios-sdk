qd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"where"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","kind":"typeIdentifier","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP","text":"PushwooshLiveActivityAttributes"}]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"Your custom attributes type conforming to ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"name":"activityType"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This method sets up automatic token registration and activity lifecycle management"},{"type":"text","text":" "},{"type":"text","text":"for your custom "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true,"type":"reference"},{"type":"text","text":" type."}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this for "},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"type":"text","text":" attributes type you use, at app launch — in"},{"type":"text","text":" "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" (or the "},{"type":"codeVoice","code":"App.init"},{"text":" for SwiftUI apps).","type":"text"},{"type":"text","text":" "},{"text":"This is what re-attaches the SDK to activities that are ","type":"text"},{"type":"strong","inlineContent":[{"text":"already running","type":"text"}]},{"type":"text","text":" at launch and"},{"type":"text","text":" "},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"type":"text","text":" "},{"text":"a cold start — including an activity that started (or was scheduled to start) while the app was","type":"text"},{"type":"text","text":" "},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"type":"text","text":" "},{"text":"exposes running activities only through the concrete ","type":"text"},{"type":"codeVoice","code":"Activity<Attributes>"},{"type":"text","text":" generic and does"},{"text":" ","type":"text"},{"type":"text","text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been"},{"type":"text","text":" "},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":")"},{"type":"text","text":" "},{"text":"means the server can’t update that activity until that screen is opened. The call is idempotent,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"so registering at launch and again per-screen is safe."}]}],"type":"aside"}]}],"sections":[],"variants":[{"paths":["\/documentation\/pushwooshliveactivities\/pushwooshbridge\/pwliveactivities\/setup(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities\/setup(_:)"},"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivityAttributes":{"role":"symbol","abstract":[{"text":"Protocol for defining custom Live Activity attributes.","ty