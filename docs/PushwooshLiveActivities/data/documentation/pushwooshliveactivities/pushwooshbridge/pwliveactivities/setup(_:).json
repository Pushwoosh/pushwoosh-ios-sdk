":"text","text":"."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method sets up automatic token registration and activity lifecycle management"},{"type":"text","text":" "},{"type":"text","text":"for your custom "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"text":" type.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this for "},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"type":"text","text":" attributes type you use, at app launch — in"},{"type":"text","text":" "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" (or the "},{"type":"codeVoice","code":"App.init"},{"type":"text","text":" for SwiftUI apps)."},{"type":"text","text":" "},{"type":"text","text":"This is what re-attaches the SDK to activities that are "},{"type":"strong","inlineContent":[{"type":"text","text":"already running"}]},{"text":" at launch and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"text":" ","type":"text"},{"text":"a cold start — including an activity that started (or was scheduled to start) while the app was","type":"text"},{"type":"text","text":" "},{"type":"text","text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit"},{"type":"text","text":" "},{"text":"exposes running activities only through the concrete ","type":"text"},{"type":"codeVoice","code":"Activity<Attributes>"},{"type":"text","text":" generic and does"},{"type":"text","text":" "},{"type":"text","text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been"},{"type":"text","text":" "},{"type":"text","text":"told about in the current session. Registering a type lazily (e.g. in a view’s "},{"code":"onAppear","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"text":" ","type":"text"},{"type":"text","text":"so registering at launch and again per-screen is safe."}]}],"name":"Important","type":"aside","style":"important"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities\/setup(_:)"},"metadata":{"symbolKind":"method","roleHeading":"Type Method","externalID":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ","title":"setup(_:)","modules":[{"relatedModules":["PushwooshBridge"],"name":"PushwooshLiveActivities"}],"fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setup"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Attributes"},{"kind":"text","text":">("},{"text":"Attributes","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","kind":"typeIdentifier"},{"kind":"text","text":".Type)"}],"extendedModule":"PushwooshBridge","platforms":[{"deprecated":false,"name":"iOS","unavailable":false,"beta":false,"introducedAt":"16.1"}],"role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Configures Live Activities with custom attributes."}],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities":{"type":"topic","abstract":[{"type":"text","text":"Real-time iOS Live Activities powered by push notifications."}],"url":"\/docum