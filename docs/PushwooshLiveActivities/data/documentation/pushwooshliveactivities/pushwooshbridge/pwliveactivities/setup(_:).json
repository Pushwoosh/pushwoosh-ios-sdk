t":"<","kind":"text"},{"kind":"genericParameter","text":"Attributes"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"activityType"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","text":"Attributes","kind":"typeIdentifier"},{"kind":"text","text":".Type) "},{"text":"where","kind":"keyword"},{"kind":"text","text":" "},{"text":"Attributes","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","text":"PushwooshLiveActivityAttributes","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"parameters","parameters":[{"name":"activityType","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your custom attributes type conforming to "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","type":"reference","isActive":true},{"type":"text","text":"."}]}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method sets up automatic token registration and activity lifecycle management"},{"type":"text","text":" "},{"text":"for your custom ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"text":" type.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this for "},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" attributes type you use, at app launch — in"},{"text":" ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" (or the "},{"type":"codeVoice","code":"App.init"},{"type":"text","text":" for SwiftUI apps)."},{"type":"text","text":" "},{"text":"This is what re-attaches the SDK to activities that are ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"already running"}]},{"type":"text","text":" at launch and"},{"text":" ","type":"text"},{"text":"re-uploads their per-activity push token to the server, so remote updates keep working after","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"text":" ","type":"text"},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"text":" ","type":"text"},{"text":"exposes running activities only through the concrete ","type":"text"},{"type":"codeVoice","code":"Activity<Attributes>"},{"type":"text","text":" generic and does"},{"text":" ","type":"text"},{"text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been","type":"text"},{"text":" ","type":"text"},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"type":"codeVoice","code":"onAppear"},{"text":")","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"type":"text","text":" "},{"type":"text","text":"so registering at launch and again per-screen is safe."}]}],"type":"aside","name":"Important","style":"important"}]}],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities":{"abstract":[{"text":"Real-time iOS Live Activities powered by push notifications.","type":"text"}],"kind":"symbol","type":"topic