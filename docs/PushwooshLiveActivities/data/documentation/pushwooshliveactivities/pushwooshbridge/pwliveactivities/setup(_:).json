eActivityAttributes"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This method sets up automatic token registration and activity lifecycle management","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"for your custom "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"type":"text","text":" type."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Call this for ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"type":"text","text":" attributes type you use, at app launch — in"},{"text":" ","type":"text"},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":" (or the "},{"code":"App.init","type":"codeVoice"},{"type":"text","text":" for SwiftUI apps)."},{"text":" ","type":"text"},{"text":"This is what re-attaches the SDK to activities that are ","type":"text"},{"inlineContent":[{"type":"text","text":"already running"}],"type":"strong"},{"type":"text","text":" at launch and"},{"type":"text","text":" "},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"type":"text","text":" "},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"text":" ","type":"text"},{"type":"text","text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit"},{"text":" ","type":"text"},{"text":"exposes running activities only through the concrete ","type":"text"},{"type":"codeVoice","code":"Activity<Attributes>"},{"text":" generic and does","type":"text"},{"type":"text","text":" "},{"type":"text","text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been"},{"type":"text","text":" "},{"type":"text","text":"told about in the current session. Registering a type lazily (e.g. in a view’s "},{"type":"codeVoice","code":"onAppear"},{"text":")","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"text":" ","type":"text"},{"type":"text","text":"so registering at launch and again per-screen is safe."}]}],"style":"important","name":"Important"}]}],"metadata":{"extendedModule":"PushwooshBridge","role":"symbol","externalID":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ","symbolKind":"method","platforms":[{"introducedAt":"16.1","name":"iOS","beta":false,"unavailable":false,"deprecated":false}],"fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setup","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"Attributes"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"Attributes","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp"},{"text":".Type)","kind":"text"}],"modules":[{"name":"PushwooshLiveActivities","relatedModules":["PushwooshBridge"]}],"roleHeading":"Type Method","title":"setup(_:)"},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities\/setup(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Configures Live Activities with custom attributes."}],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshBridge":{"abstract":[],"title":"PushwooshBridge","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentati