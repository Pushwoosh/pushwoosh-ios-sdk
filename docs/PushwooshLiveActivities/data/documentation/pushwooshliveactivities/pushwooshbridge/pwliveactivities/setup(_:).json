","text":" type."}]},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Call this for "},{"type":"strong","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" attributes type you use, at app launch — in"},{"text":" ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":" (or the ","type":"text"},{"code":"App.init","type":"codeVoice"},{"type":"text","text":" for SwiftUI apps)."},{"type":"text","text":" "},{"type":"text","text":"This is what re-attaches the SDK to activities that are "},{"inlineContent":[{"text":"already running","type":"text"}],"type":"strong"},{"type":"text","text":" at launch and"},{"type":"text","text":" "},{"text":"re-uploads their per-activity push token to the server, so remote updates keep working after","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"type":"text","text":" "},{"type":"text","text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit"},{"type":"text","text":" "},{"text":"exposes running activities only through the concrete ","type":"text"},{"type":"codeVoice","code":"Activity<Attributes>"},{"type":"text","text":" generic and does"},{"text":" ","type":"text"},{"type":"text","text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been"},{"text":" ","type":"text"},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":")","type":"text"},{"type":"text","text":" "},{"text":"means the server can’t update that activity until that screen is opened. The call is idempotent,","type":"text"},{"text":" ","type":"text"},{"text":"so registering at launch and again per-screen is safe.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"Configures Live Activities with custom attributes."}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities"]]},"metadata":{"modules":[{"relatedModules":["PushwooshBridge"],"name":"PushwooshLiveActivities"}],"roleHeading":"Type Method","title":"setup(_:)","extendedModule":"PushwooshBridge","platforms":[{"name":"iOS","deprecated":false,"introducedAt":"16.1","unavailable":false,"beta":false}],"role":"symbol","symbolKind":"method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"setup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Attributes","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","kind":"typeIdentifier","text":"Attributes"},{"kind":"text","text":".Type)"}],"externalID":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshliveactivities\/pushwooshbridge\/pwliveactivities\/setup(_:)"]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities\/setup(_:)","interfaceLanguage":"swift"},"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities":{"title":"PushwooshLiveActivities","abstract":[{"type":"text","text":"Real-time iOS Live Activities powered by push notifications