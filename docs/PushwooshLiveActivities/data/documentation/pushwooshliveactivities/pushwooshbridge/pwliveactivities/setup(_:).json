ivityAttributes","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"}]}]},{"parameters":[{"name":"activityType","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your custom attributes type conforming to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"type":"text","text":"."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"text":"This method sets up automatic token registration and activity lifecycle management","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for your custom "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"text":" type.","type":"text"}],"type":"paragraph"},{"name":"Important","style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Call this for ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"every"}]},{"text":" attributes type you use, at app launch — in","type":"text"},{"type":"text","text":" "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" (or the "},{"type":"codeVoice","code":"App.init"},{"text":" for SwiftUI apps).","type":"text"},{"type":"text","text":" "},{"text":"This is what re-attaches the SDK to activities that are ","type":"text"},{"inlineContent":[{"text":"already running","type":"text"}],"type":"strong"},{"text":" at launch and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"type":"text","text":" "},{"text":"a cold start — including an activity that started (or was scheduled to start) while the app was","type":"text"},{"type":"text","text":" "},{"type":"text","text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit"},{"text":" ","type":"text"},{"text":"exposes running activities only through the concrete ","type":"text"},{"type":"codeVoice","code":"Activity<Attributes>"},{"type":"text","text":" generic and does"},{"text":" ","type":"text"},{"type":"text","text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been"},{"type":"text","text":" "},{"type":"text","text":"told about in the current session. Registering a type lazily (e.g. in a view’s "},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"type":"text","text":" "},{"type":"text","text":"so registering at launch and again per-screen is safe."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshliveactivities\/pushwooshbridge\/pwliveactivities\/setup(_:)"]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities"]]},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshBridge\/PWLiveActivities\/setup(_:)","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivityAttributes":{"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier