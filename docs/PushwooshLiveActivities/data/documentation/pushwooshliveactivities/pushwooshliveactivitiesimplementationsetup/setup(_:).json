swift"],"platforms":["iOS"],"tokens":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"setup","kind":"identifier"},{"kind":"text","text":"<"},{"text":"Attributes","kind":"genericParameter"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"activityType"},{"kind":"text","text":": "},{"preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","text":"Attributes","kind":"typeIdentifier"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"text":"Attributes","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP","text":"PushwooshLiveActivityAttributes"}]}],"kind":"declarations"},{"parameters":[{"name":"activityType","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your custom attributes type conforming to "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"text":"This method sets up automatic token registration and activity lifecycle management","type":"text"},{"text":" ","type":"text"},{"text":"for your custom ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"type":"text","text":" type."}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this for "},{"inlineContent":[{"text":"every","type":"text"}],"type":"strong"},{"text":" attributes type you use, at app launch — in","type":"text"},{"text":" ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" (or the "},{"code":"App.init","type":"codeVoice"},{"type":"text","text":" for SwiftUI apps)."},{"type":"text","text":" "},{"text":"This is what re-attaches the SDK to activities that are ","type":"text"},{"type":"strong","inlineContent":[{"text":"already running","type":"text"}]},{"type":"text","text":" at launch and"},{"type":"text","text":" "},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"type":"text","text":" "},{"text":"a cold start — including an activity that started (or was scheduled to start) while the app was","type":"text"},{"text":" ","type":"text"},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"exposes running activities only through the concrete "},{"type":"codeVoice","code":"Activity<Attributes>"},{"text":" generic and does","type":"text"},{"type":"text","text":" "},{"text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been","type":"text"},{"text":" ","type":"text"},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"type":"codeVoice","code":"onAppear"},{"text":")","type":"text"},{"type":"text","text":" "},{"text":"means the server can’t update that activity until that screen is opened. The call is idempotent,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"so registering at launch and again per-screen is safe."}]}],"type":"aside","name":"Important"}]}],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesImplementationSetup/PWLiveActivities-Implementations":{"title":"PWLiveActivities Implementations","url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesimplementationsetup\/pwliveactivities-implementations","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/PWLiveActivities-Implementations","kind":"article","type":"topic","abstract":[],"role":"collectionGroup"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivityAttributes":{"url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivityattributes","abstract":[{"type":"text","text":"Protocol for defining custom Live Activity attributes."}],"navigatorTitle":[{"text":"PushwooshLiveActivityAttributes","kind":"identifier"}],"title":"PushwooshLiveActivityAttributes","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PushwooshLiveActivityAttributes"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","type":"topic","kind":"symbol","role":"symbol"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities":{"url":"\/documentation\/pushwooshliveactivities","abstract":[{"text":"Real-time iOS Live Activities powered by push notifications.","type":"text"}],"title":"PushwooshLiveActivities","type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","kind":"symbol","role":"collection"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesImplementationSetup":{"url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesimplementationsetup","abstract":[{"type":"text","text":"Orchestrates iOS Live Activities i