ions":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setup","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"Attributes"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"activityType","kind":"internalParam"},{"kind":"text","text":": "},{"text":"Attributes","kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp"},{"kind":"text","text":".Type) "},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"text":"PushwooshLiveActivityAttributes","kind":"typeIdentifier","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP"}]}]},{"kind":"parameters","parameters":[{"name":"activityType","content":[{"inlineContent":[{"type":"text","text":"Your custom attributes type conforming to "},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"This method sets up automatic token registration and activity lifecycle management","type":"text"},{"type":"text","text":" "},{"text":"for your custom ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"type":"text","text":" type."}],"type":"paragraph"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Call this for ","type":"text"},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"text":" attributes type you use, at app launch — in","type":"text"},{"text":" ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" (or the "},{"type":"codeVoice","code":"App.init"},{"type":"text","text":" for SwiftUI apps)."},{"type":"text","text":" "},{"text":"This is what re-attaches the SDK to activities that are ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"already running"}]},{"text":" at launch and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"type":"text","text":" "},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"text":" ","type":"text"},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"text":" ","type":"text"},{"text":"exposes running activities only through the concrete ","type":"text"},{"code":"Activity<Attributes>","type":"codeVoice"},{"type":"text","text":" generic and does"},{"text":" ","type":"text"},{"text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been","type":"text"},{"text":" ","type":"text"},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":")"},{"text":" ","type":"text"},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"text":" ","type":"text"},{"text":"so registering at launch and again per-screen is safe.","type":"text"}]}]}],"kind":"content"}],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesImplementationSetup/setup(_:)":{"type":"topic","url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesimplementationsetup\/setup(_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setup","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"Attributes"},{"kind":"text","text":">("},{"preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","text":"Attributes","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)","kind":"symbol","role":"symbol","title":"setup(_:)","abstract":[{"text":"Configures Live Activities with custom attributes.","type":"text"}]},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities":{"url":"\/documentation\/pushwooshliveactivities","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","title":"PushwooshLiveActivities","kind":"symbol","role":"collection","abstract":[{"text":"Real-time iOS Live Activities powered by push notifications.","type":"text"}],"type":"topic"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesImplementationSetup":{"abstract":[{"type":"text","text":"Orchestrates iOS Live Activities integration with Pushwoosh push notifications."}],"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup","kind":"symbol","url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesimplementationsetup","role":"symbol","type":"topic","title":"PushwooshLiveActivitiesImplementat