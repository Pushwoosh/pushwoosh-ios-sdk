ions":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"setup"},{"text":"<","kind":"text"},{"text":"Attributes","kind":"genericParameter"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"activityType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","text":"Attributes"},{"text":".Type) ","kind":"text"},{"text":"where","kind":"keyword"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Attributes"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP","kind":"typeIdentifier","text":"PushwooshLiveActivityAttributes"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your custom attributes type conforming to "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","type":"reference","isActive":true},{"type":"text","text":"."}]}],"name":"activityType"}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This method sets up automatic token registration and activity lifecycle management"},{"type":"text","text":" "},{"text":"for your custom ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"text":" type.","type":"text"}],"type":"paragraph"},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Call this for ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"strong"},{"type":"text","text":" attributes type you use, at app launch — in"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":" (or the "},{"type":"codeVoice","code":"App.init"},{"type":"text","text":" for SwiftUI apps)."},{"text":" ","type":"text"},{"text":"This is what re-attaches the SDK to activities that are ","type":"text"},{"inlineContent":[{"text":"already running","type":"text"}],"type":"strong"},{"text":" at launch and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"type":"text","text":" "},{"text":"a cold start — including an activity that started (or was scheduled to start) while the app was","type":"text"},{"type":"text","text":" "},{"type":"text","text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit"},{"type":"text","text":" "},{"text":"exposes running activities only through the concrete ","type":"text"},{"type":"codeVoice","code":"Activity<Attributes>"},{"text":" generic and does","type":"text"},{"type":"text","text":" "},{"text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"told about in the current session. Registering a type lazily (e.g. in a view’s "},{"code":"onAppear","type":"codeVoice"},{"text":")","type":"text"},{"type":"text","text":" "},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"type":"text","text":" "},{"text":"so registering at launch and again per-screen is safe.","type":"text"}]}],"style":"important"}],"kind":"content"}],"references":{"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivityAttributes":{"title":"PushwooshLiveActivityAttributes","navigatorTitle":[{"text":"PushwooshLiveActivityAttributes","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivityattributes","abstract":[{"type":"text","text":"Protocol for defining custom Live Activity attributes."}],"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PushwooshLiveActivityAttributes"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","type":"topic"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities/PushwooshLiveActivitiesImplementationSetup":{"url":"\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesimplementationsetup","role":"symbol","type":"topic","title":"PushwooshLiveActivitiesImplementationSetup","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PushwooshLiveActivitiesImplementationSetup"}],"navigatorTitle":[{"text":"PushwooshLiveActivitiesImplementationSetup","kind":"identifier"}],"abstract":[{"type":"text","text":"Orchestrates iOS Live Activities integration with Pushwoosh push notifications."}],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup"},"doc://com.pushwoosh.PushwooshLiveActivities/documentation/PushwooshLiveActivities":{"url":"\/documentation\/pushwooshliveactivities","role":"collection","type":"topic","title":"PushwooshLiveActivities","abstract":[{"type":"text","text":"Real-time iOS Live Activities powered by push notifications."}],"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities"},"doc://com.pushwoosh.PushwooshLiveActivities/