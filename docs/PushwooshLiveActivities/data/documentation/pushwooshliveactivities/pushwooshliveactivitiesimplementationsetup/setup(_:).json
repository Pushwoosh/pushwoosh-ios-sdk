ext":"<","kind":"text"},{"text":"Attributes","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"_"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"activityType"},{"kind":"text","text":": "},{"preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","kind":"typeIdentifier","text":"Attributes"},{"text":".Type) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"PushwooshLiveActivityAttributes","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"Your custom attributes type conforming to ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"name":"activityType"}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method sets up automatic token registration and activity lifecycle management"},{"text":" ","type":"text"},{"text":"for your custom ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"type":"text","text":" type."}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Call this for ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"strong"},{"text":" attributes type you use, at app launch — in","type":"text"},{"type":"text","text":" "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" (or the "},{"code":"App.init","type":"codeVoice"},{"type":"text","text":" for SwiftUI apps)."},{"type":"text","text":" "},{"type":"text","text":"This is what re-attaches the SDK to activities that are "},{"inlineContent":[{"type":"text","text":"already running"}],"type":"strong"},{"text":" at launch and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"re-uploads their per-activity push token to the server, so remote updates keep working after"},{"type":"text","text":" "},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"type":"text","text":" "},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"type":"text","text":" "},{"type":"text","text":"exposes running activities only through the concrete "},{"type":"codeVoice","code":"Activity<Attributes>"},{"type":"text","text":" generic and does"},{"type":"text","text":" "},{"text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been","type":"text"},{"type":"text","text":" "},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"type":"codeVoice","code":"onAppear"},{"text":")","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"type":"text","text":" "},{"type":"text","text":"so registering at launch and again per-screen is safe."}]}],"style":"important"}]}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)","interfaceLanguage":"swift"},"references":{"doc://com.pushwoosh.PushwooshL