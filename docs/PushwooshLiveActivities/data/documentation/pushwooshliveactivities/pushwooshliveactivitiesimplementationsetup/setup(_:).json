ext":"<"},{"text":"Attributes","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"activityType"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","text":"Attributes"},{"text":".Type) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","text":"PushwooshLiveActivityAttributes","kind":"typeIdentifier","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"activityType","content":[{"inlineContent":[{"text":"Your custom attributes type conforming to ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"This method sets up automatic token registration and activity lifecycle management","type":"text"},{"type":"text","text":" "},{"text":"for your custom ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true,"type":"reference"},{"text":" type.","type":"text"}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this for "},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"text":" attributes type you use, at app launch — in","type":"text"},{"type":"text","text":" "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" (or the "},{"type":"codeVoice","code":"App.init"},{"type":"text","text":" for SwiftUI apps)."},{"text":" ","type":"text"},{"text":"This is what re-attaches the SDK to activities that are ","type":"text"},{"inlineContent":[{"text":"already running","type":"text"}],"type":"strong"},{"type":"text","text":" at launch and"},{"text":" ","type":"text"},{"text":"re-uploads their per-activity push token to the server, so remote updates keep working after","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"type":"text","text":" "},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"exposes running activities only through the concrete "},{"type":"codeVoice","code":"Activity<Attributes>"},{"text":" generic and does","type":"text"},{"type":"text","text":" "},{"type":"text","text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been"},{"type":"text","text":" "},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":")","type":"text"},{"type":"text","text":" "},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"text":" ","type":"text"},{"text":"so registering at launch and again per-screen is safe.","type":"text"}]}],"type":"aside","name":"Important"}]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)","interfaceLanguage":"swift"},"references":{"doc://com.pushwoosh.PushwooshL