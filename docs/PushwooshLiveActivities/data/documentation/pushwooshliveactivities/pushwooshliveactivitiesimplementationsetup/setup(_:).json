{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/PWLiveActivities-Implementations"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"setup"},{"text":"<","kind":"text"},{"text":"Attributes","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"activityType","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","text":"Attributes"},{"text":".Type) ","kind":"text"},{"kind":"keyword","text":"where"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"PushwooshLiveActivityAttributes","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","kind":"typeIdentifier","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP"}],"languages":["swift"],"platforms":["iOS"]}],"kind":"declarations"},{"parameters":[{"name":"activityType","content":[{"inlineContent":[{"type":"text","text":"Your custom attributes type conforming to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"This method sets up automatic token registration and activity lifecycle management"},{"text":" ","type":"text"},{"text":"for your custom ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true},{"text":" type.","type":"text"}],"type":"paragraph"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call this for "},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"type":"text","text":" attributes type you use, at app launch — in"},{"type":"text","text":" "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"text":" (or the ","type":"text"},{"code":"App.init","type":"codeVoice"},{"type":"text","text":" for SwiftUI apps)."},{"text":" ","type":"text"},{"type":"text","text":"This is what re-attaches the SDK to activities that are "},{"type":"strong","inlineContent":[{"text":"already running","type":"text"}]},{"text":" at launch and","type":"text"},{"type":"text","text":" "},{"text":"re-uploads their per-activity push token to the server, so remote updates keep working after","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"text":" ","type":"text"},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"text":" ","type":"text"},{"text":"exposes running activities only through the concrete ","type":"text"},{"code":"Activity<Attributes>","type":"codeVoice"},{"type":"text","text":" generic and does"},{"type":"text","text":" "},{"type":"text","text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been"},{"type":"text","text":" "},{"type":"text","text":"told about in the current session. Registering a type lazily (e.g. in a view’s "},{"code":"onAppear","type":"codeVoice"},{"type":"text","text":")"},{"type":"text","text":" "},{"text":"means the server can’t update that activity until that screen is opened. The call is idempotent,","type":"text"},{"text":" ","type":"text"},{"text":"so registering at launch and again per-screen is safe.","type":"text"}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Configures Live Activities with custom attributes."}],"metadata":{"extendedModule":"PushwooshBridge","roleHeading":"Type Method","modules":[{"relatedModules":["PushwooshBridge"],"name":"PushwooshLiveActivities"}],"title":"setup(_:)","fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"setup","kind":"identifier"},{"kind":"text","text":"<"},{"text":"Attributes","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"Attributes","kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp"},{"kind":"text","text":".Type)"}],"role":"symbol","externalID":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ::SYNTHESIZED::c:@M@PushwooshLiveActivities@objc(cs)PushwooshLiveActivitiesImplementationSetup","platforms":[{"deprecated":false,"beta":false,"name":"iOS","unavailable":false,"introducedAt":"16.1"}],"symbolKind":"method"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesimplementationsetup\/setup(_:)"]}],"references":{"doc://com.pushwoosh.PushwooshL