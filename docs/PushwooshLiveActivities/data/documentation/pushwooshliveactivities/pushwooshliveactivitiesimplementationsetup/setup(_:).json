{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"setup"},{"text":"<","kind":"text"},{"text":"Attributes","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"kind":"text","text":" "},{"text":"activityType","kind":"internalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","text":"Attributes","kind":"typeIdentifier"},{"text":".Type) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Attributes","kind":"typeIdentifier"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","preciseIdentifier":"s:23PushwooshLiveActivities0aB18ActivityAttributesP","kind":"typeIdentifier","text":"PushwooshLiveActivityAttributes"}]}]},{"parameters":[{"name":"activityType","content":[{"inlineContent":[{"text":"Your custom attributes type conforming to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"This method sets up automatic token registration and activity lifecycle management","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for your custom "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes","isActive":true,"type":"reference"},{"type":"text","text":" type."}],"type":"paragraph"},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"text":"Call this for ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"text":" attributes type you use, at app launch — in","type":"text"},{"type":"text","text":" "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":" (or the "},{"type":"codeVoice","code":"App.init"},{"text":" for SwiftUI apps).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This is what re-attaches the SDK to activities that are "},{"inlineContent":[{"text":"already running","type":"text"}],"type":"strong"},{"text":" at launch and","type":"text"},{"type":"text","text":" "},{"text":"re-uploads their per-activity push token to the server, so remote updates keep working after","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a cold start — including an activity that started (or was scheduled to start) while the app was"},{"type":"text","text":" "},{"text":"terminated. This is a required, one-time-per-launch call, not tied to any screen: ActivityKit","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"exposes running activities only through the concrete "},{"type":"codeVoice","code":"Activity<Attributes>"},{"text":" generic and does","type":"text"},{"type":"text","text":" "},{"text":"not persist the set of types across launches, so the SDK cannot reconnect a type it hasn’t been","type":"text"},{"text":" ","type":"text"},{"text":"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"type":"codeVoice","code":"onAppear"},{"text":")","type":"text"},{"type":"text","text":" "},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"type":"text","text":" "},{"type":"text","text":"so registering at launch and again per-screen is safe."}],"type":"paragraph"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/PWLiveActivities-Implementations"]]},"sections":[],"metadata":{"symbolKind":"method","modules":[{"relatedModules":["PushwooshBridge"],"name":"PushwooshLiveActivities"}],"platforms":[{"introducedAt":"16.1","beta":false,"deprecated":false,"name":"iOS","unavailable":false}],"externalID":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ::SYNTHESIZED::c:@M@PushwooshLiveActivities@objc(cs)PushwooshLiveActivitiesImplementationSetup","role":"symbol","roleHeading":"Type Method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"setup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Attributes","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","text":"Attributes"},{"text":".Type)","kind":"text"}],"extendedModule":"PushwooshBridge","title":"setup(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesimplementationsetup\/setup(_:)"]}],"abstract":[{"text":"Configures Live Activities with custom attributes.","type":"text"}],"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshL