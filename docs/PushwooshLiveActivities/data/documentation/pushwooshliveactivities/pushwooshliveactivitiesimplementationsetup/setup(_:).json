 in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":")"},{"text":" ","type":"text"},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"type":"text","text":" "},{"text":"so registering at launch and again per-screen is safe.","type":"text"}],"type":"paragraph"}]}]}],"sections":[],"metadata":{"extendedModule":"PushwooshBridge","platforms":[{"introducedAt":"16.1","name":"iOS","unavailable":false,"deprecated":false,"beta":false}],"fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"setup","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Attributes"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp","text":"Attributes"},{"text":".Type)","kind":"text"}],"role":"symbol","title":"setup(_:)","externalID":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ::SYNTHESIZED::c:@M@PushwooshLiveActivities@objc(cs)PushwooshLiveActivitiesImplementationSetup","modules":[{"name":"PushwooshLiveActivities","relatedModules":["PushwooshBridge"]}],"symbolKind":"method","roleHeading":"Type Method"},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup","doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/PWLiveActivities-Implementations"]]},"abstract":[{"text":"Configures Live Activities with custom attributes.","type":"text"}],"references":{"doc://com.pushwoosh.PushwooshL