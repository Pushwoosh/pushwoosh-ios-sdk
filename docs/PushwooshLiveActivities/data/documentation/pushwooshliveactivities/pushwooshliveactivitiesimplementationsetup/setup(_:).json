"told about in the current session. Registering a type lazily (e.g. in a view’s ","type":"text"},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"means the server can’t update that activity until that screen is opened. The call is idempotent,"},{"type":"text","text":" "},{"text":"so registering at launch and again per-screen is safe.","type":"text"}]}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivitiesImplementationSetup\/setup(_:)"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshliveactivities\/pushwooshliveactivitiesimplementationsetup\/setup(_:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"extendedModule":"PushwooshBridge","role":"symbol","title":"setup(_:)","roleHeading":"Type Method","platforms":[{"introducedAt":"16.1","name":"iOS","deprecated":false,"beta":false,"unavailable":false}],"modules":[{"relatedModules":["PushwooshBridge"],"name":"PushwooshLiveActivities"}],"symbolKind":"method","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"setup"},{"text":"<","kind":"text"},{"text":"Attributes","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"Attributes","preciseIdentifier":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ0H0L_qd__mfp"},{"text":".Type)","kind":"text"}],"externalID":"s:15PushwooshBridge16PWLiveActivitiesP0a4LiveD0E5setupyyqd__mAD0aE18ActivityAttributesRd__lFZ::SYNTHESIZED::c:@M@PushwooshLiveActivities@objc(cs)PushwooshLiveActivitiesImplementationSetup"},"abstract":[{"type":"text","text":"Configures Live Activities with custom attributes."}],"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshL