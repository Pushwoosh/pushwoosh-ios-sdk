DE\",","    \"auth\": \"YOUR-API-TOKEN\",","    \"notifications\": [","      {","        \"live_activity\": {","          \"event\": \"update\",","          \"content-state\": {","            \"status\": \"On the way\",","            \"estimatedTime\": \"10 min\",","            \"emoji\": \"🚚\"","          },","          \"stale-date\": 1234567890","        },","        \"live_activity_id\": \"order_123\"","      }","    ]","  }","}"],"syntax":"json"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Optional Parameters:"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"stale-date","type":"codeVoice"},{"type":"text","text":": Unix timestamp when content becomes stale"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"dismissal-date","type":"codeVoice"},{"type":"text","text":": Unix timestamp when to dismiss (use with “end” event)"}]}]}]},{"anchor":"End-Live-Activity","type":"heading","text":"End Live Activity","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"POST https:\/\/api.pushwoosh.com\/json\/1.3\/updateLiveActivity"}]},{"code":["{","  \"request\": {","    \"application\": \"YOUR-APP-CODE\",","    \"auth\": \"YOUR-API-TOKEN\",","    \"notifications\": [","      {","        \"live_activity\": {","          \"event\": \"end\",","          \"dismissal-date\": 1234567890","        },","        \"live_activity_id\": \"order_123\"","      }","    ]","  }","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Note:"}],"type":"strong"},{"type":"text","text":" For push-to-start functionality (iOS 17.2+), the "},{"type":"codeVoice","code":"setup()"},{"type":"text","text":" method automatically handles token registration. No additional code is needed in the app."}]},{"text":"Available SDK Methods","type":"heading","level":2,"anchor":"Available-SDK-Methods"},{"type":"paragraph",