p-2-Configure-Infoplist","text":"Step 2: Configure Info.plist","type":"heading"},{"inlineContent":[{"text":"Add Live Activities support to your app’s Info.plist:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["<key>NSSupportsLiveActivities<\/key>","<true\/>"],"syntax":"xml"},{"text":"Step 3: Create Widget Extension","level":2,"type":"heading","anchor":"Step-3-Create-Widget-Extension"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t have a Widget Extension:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode: "},{"inlineContent":[{"text":"File → New → Target","type":"text"}],"type":"strong"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Select "},{"type":"strong","inlineContent":[{"text":"Widget Extension","type":"text"}]}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enable ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Include Live Activity"}]},{"text":" checkbox","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Name it (e.g., “MyAppWidgets”)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add PushwooshLiveActivities to your Widget Extension target dependencies"}]}]}],"type":"orderedList"},{"anchor":"Step-4-Define-Activity-Attributes","type":"heading","level":2,"text":"Step 4: Define Activity Attributes"},{"inlineContent":[{"type":"text","text":"Create a struct conforming to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshLiveActivities\/documentation\/PushwooshLiveActivities\/PushwooshLiveActivityAttributes"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import WidgetKit","import SwiftUI","import ActivityKit","import PushwooshFramework","import PushwooshLiveActivities","","struct FoodDeliveryAttributes: PushwooshLiveActivityAttributes {","    public struct ContentState: PushwooshLiveActivityContentState {","        var status: String","        var estimatedTime: String","        var emoji: String","        var pushwoosh: PushwooshLiveActivityContentStateData?","    }","","    var orderNumber: String","    var pushwoosh: PushwooshLiveActivityAttributeData","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Step-5-Create-Widget","type":"heading","text":"Step 5: Create Widget"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In your Widget Extension:"}]},{"code":["import WidgetKit","import SwiftUI","import ActivityKit","","@main","struct FoodDeliveryWidget: Widget {","    var body: some WidgetConfiguration {","        ActivityConfiguration(for: FoodDeliveryAttributes.self) { context in","            VStack(alignment: .leading, spacing: 8) {","                HStack {","                    Text(\"Order #\\(context.attributes.orderNumber)\")","                        .font(.headline)","                    Spacer()","                    Text(context.state.emoji)","                        .font(.title)","                }","","                Text(context.state.status)","                    .font(.subheadline)","","                HStack {","                    Image(systemName: \"clock\")","                    Text(context.state.estimatedTime)","                }","                .font(.caption)","            }","            .padding()","        } dynamicIsland: { context in","            DynamicIsland {","                DynamicIslandExpandedRegion(.leading) {","                    Text(context.state.emoji)","                        .font(.title)","                }","                DynamicIslandExpandedRegion(.trailing) {","                    Text(context.state.estimatedTime)","                        .font(.caption)","                }","                DynamicIslandExpandedRegion(.center) {","                    Text(context.state.status)","                        .font(.caption)","                }","            } compactLeading: {","                Text(context.state.emoji)","            } compactTrailing: {","                Text(context.state.estimatedTime)","                    .font(.caption2)","            } minimal: {","                Text(context.state.emoji)","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Step 6: Initialize in AppDelegate","anchor":"Step-6-Initialize-in-AppDelegate","level":2,"type":"heading"},{"type":"codeListing","syntax":"swift","code":["import UIKit","import PushwooshFramework","import PushwooshLiveActivities","","@main","class AppDelegate: UIResponder, UIApplicationDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        if #available(iOS 16.1, *) {","            Pushwoosh.LiveActivities.setup(FoodDeliveryAttributes.self)","        }","","        return true","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"setup()"},{"text":" method handles the entire lifecycle of Live Activities:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Automatically listens for push-to-start token updates (iOS 17.2+)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Automatically listens for activity token updates","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Registers tokens with Pushwoosh server","type":"text"}]}]}],"type":"unorderedList"},{"text":"Step 7: Create Live Activity Manager","anchor":"Step-7-Create-Live-Activity-Manager","type":"heading","level":2},{"code":["import Foundation","import ActivityKit","import UIKit","import PushwooshFramework","import PushwooshLiveActivities","","class LiveActivityManager: NSObject, ObservableObject {","    public static let shared = LiveActivityManager()","    private var currentActivity: Activity<FoodDeliveryAttributes>?","","    func startActivity() {","        guard ActivityAuthorizationInfo().areActivitiesEnabled else {","            print(\"Live Activities are not enabled\")","            return","        }","","        do {","            let pushwooshData = PushwooshLiveActivityAttributeData(","                activityId: \"order_123\"","            )","","            let attribute = FoodDeliveryAttributes(","                orderNumber: \"1234567\",","                pushwoosh: pushwooshData","            )","","            let initialState = FoodDeliveryAttributes.ContentState(","                status: \"Preparing your meal\",","                estimatedTime: \"25 min\",","                emoji: \"👨‍🍳\",","                pushwoosh: nil","            )","","            let activity = try Activity<FoodDeliveryAttributes>.request(","                attributes: attribute,","                content: .init(state: initialState, staleDate: nil),","                pushType: .token","            )","","            self.currentActivity = activity","","            Task {","                for await pushToken in activity.pushTokenUpdates {","                    let pushTokenString = pushToken.reduce(\"\") {","                        $0 + String(format: \"%02x\", $1)","                    }","","                    print(\"Activity push token: \\(pushTokenString)\")","","                    Pushwoosh.LiveActivities.startLiveActivity(","                        token: pushTokenString,","                        activityId: \"order_123\"","                    )","                }","            }","        } catch {","            print(\"Start Activity Error: \\(error.localizedDescription)\")","        }","    }","","    func endActivity() async {","        guard let activity = currentActivity else { return }","","        await activity.end(nil, dismissalPolicy: .immediate)","","        Pushwoosh.LiveActivities.stopLiveActivity(activityId: \"order_123\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Step 8: Start Activity from UI","level":2,"anchor":"Step-8-Start-Activity-from-UI"},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","","struct ContentView: View {","    var body: some View {","        VStack(spacing: 20) {","            Button(action: {","                LiveActivityManager.shared.startActivity()","            }) {","                Text(\"Start Live Activity\")","                    .foregroundColor(.white)","                    .padding()","                    .background(Color.blue)","                    .cornerRadius(10)","            }","","            Button(action: {","                Task {","                    await LiveActivityManager.shared.endActivity()","                }","            }) {","                Text(\"End Live Activity\")","                    .foregroundColor(.white)","                    .padding()","                    .background(Color.red)","                    .cornerRadius(10)","            }","        }","        .padding()","    }","}"]},{"level":2,"type":"heading","text":"Step 9: Send Push Notifications via Pushwoosh API","anchor":"Step-9-Send-Push-Notifications-via-Pushwoosh-API"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use Pushwoosh REST API to send Live Activity updates from your server."}]},{"text":"Start Live Activity (Push-to-Start for iOS 17.2+)","anchor":"Start-Live-Activity-Push-to-Start-for-iOS-172+","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"POST https:\/\/api.pushwoosh.com\/json\/1.3\/startLiveActivity"}]},{"type":"codeListing","code":["{","  \"request\": {","    \"application\": \"YOUR-APP-CODE\",","    \"auth\": \"YOUR-API-TOKEN\",","    \"notifications\": [","      {","        \"content\": \"Your order is being prepared!\",","        \"live_activity\": {","          \"event\": \"start\",","          \"content-state\": {","            \"status\": \"Preparing your meal\",","            \"estimatedTime\": \"25 min\",","            \"emoji\": \"👨‍🍳\"","          },","          \"attributes-type\": \"FoodDeliveryAttributes\",","          \"attributes\": {","            \"orderNumber\": \"1234567\"","          }","        },","        \"live_activity_id\": \"order_123\",","        \"filter_code\": \"user_segment_code\"","      }","    ]","  }","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Targeting Options:","type":"text"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"filter_code"},{"text":": Target specific user segment","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"devices","type":"codeVoice"},{"text":": Array of push tokens or HWIDs (max 1000)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"users","type":"codeVoice"},{"text":": Array of User IDs (max 1000)","type":"text"}]}]}]},{"anchor":"Update-Live-Activity","type":"heading","level":3,"text":"Update Live Activity"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"POST https:\/\/api.pushwoosh.com\/json\/1.3\/updateLiveActivity"}]},{"type":"codeListing","syntax":"json","code":["{","  \"request\": {","    \"application\": \"YOUR-APP-CODE\",","    \"auth\": \"YOUR-API-TOKEN\",","    \"notifications\": [","      {","        \"live_activity\": {","          \"event\": \"update\",","          \"content-state\": {","            \"status\": \"On the way\",","            \"estimatedTime\": \"10 min\",","            \"emoji\": \"🚚\"","          },","          \"stale-date\": 1234567890","        },","        \"live_activity_id\": \"order_123\"","      }","    ]","  }","}"]},{"inlineContent":[{"inlineContent":[{"text":"Optional Parameters:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineCon