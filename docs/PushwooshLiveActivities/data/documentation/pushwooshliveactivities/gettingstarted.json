ations\": [","      {","        \"live_activity\": {","          \"event\": \"update\",","          \"content-state\": {","            \"status\": \"On the way\",","            \"estimatedTime\": \"10 min\",","            \"emoji\": \"🚚\"","          },","          \"stale-date\": 1234567890","        },","        \"live_activity_id\": \"order_123\"","      }","    ]","  }","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Optional Parameters:","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stale-date"},{"type":"text","text":": Unix timestamp when content becomes stale"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"dismissal-date","type":"codeVoice"},{"text":": Unix timestamp when to dismiss (use with “end” event)","type":"text"}]}]}]},{"type":"heading","level":3,"anchor":"End-Live-Activity","text":"End Live Activity"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"POST https:\/\/api.pushwoosh.com\/json\/1.3\/updateLiveActivity"}]},{"syntax":"json","type":"codeListing","code":["{","  \"request\": {","    \"application\": \"YOUR-APP-CODE\",","    \"auth\": \"YOUR-API-TOKEN\",","    \"notifications\": [","      {","        \"live_activity\": {","          \"event\": \"end\",","          \"dismissal-date\": 1234567890","        },","        \"live_activity_id\": \"order_123\"","      }","    ]","  }","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note:","type":"text"}]},{"type":"text","text":" For push-to-start functionality (iOS 17.2+), the "},{"code":"setup()","type":"codeVoice"},{"type":"text","text":" method automatically handles token registration. No additional code is needed in the app."}],"type":"paragraph"},{"type":"heading","anchor":"Available-SDK-Methods","level":2,"text":"Available SDK Methods"},{"inlineContent":[{"text":"The PushwooshLiveActivities module provides the following methods: