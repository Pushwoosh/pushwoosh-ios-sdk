{"kind":"symbol","topicSections":[{"title":"Stories UI","identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController"]},{"title":"Payload model","identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/StoryPage"]},{"title":"Analytics","identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesDelegate"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher"],"title":"Media pre-cache"}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"PushwooshNotificationUI provides ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController","isActive":true},{"text":" — a drop-in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UNNotificationContentExtension"},{"text":" view controller that renders an Instagram-style","type":"text"},{"type":"text","text":" "},{"text":"stories experience: full-bleed images, top progress bars, auto-advance, tap-zone","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"navigation, per-frame title\/subtitle, and an optional deep-link button."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The module links only UIKit, UserNotifications, and UserNotificationsUI (plus"},{"text":" ","type":"text"},{"type":"text","text":"CryptoKit for a stable cache key), so it adds no Pushwoosh Core\/Framework weight"},{"type":"text","text":" "},{"type":"text","text":"to your memory-constrained extension process."}],"type":"paragraph"},{"level":2,"anchor":"Usage","type":"heading","text":"Usage"},{"inlineContent":[{"text":"In your Notification Content Extension:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import PushwooshNotificationUI","","class NotificationViewController: PushwooshStoriesViewController {}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then set these keys in the extension’s Info.plist:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionCategory"},{"type":"text","text":" = "},{"type":"codeVoice","code":"PW_STORIES"},{"type":"text","text":" (must match "},{"type":"codeVoice","code":"aps.category"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"UNNotificationExtensionUserInteractionEnabled","type":"codeVoice"},{"type":"text","text":" = "},{"type":"codeVoice","code":"YES"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"UNNotificationExtensionDefaultContentHidden","type":"codeVoice"},{"type":"text","text":" = "},{"type":"codeVoice","code":"YES"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionInitialContentSizeRatio"},{"type":"text","text":" = e.g. "},{"code":"1.5","type":"codeVoice"},{"type":"text","text":" (keep in sync with "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storyAspectRatio","isActive":true,"type":"reference"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" = "},{"code":"$(PRODUCT_MODULE_NAME).NotificationViewController","type":"codeVoice"},{"type":"text","text":" (code-only, no storyboard)"}]}]}]},{"text":"Payload","type":"heading","level":2,"anchor":"Payload"},{"inlineContent":[{"text":"The stories are described by a ","type":"text"},{"code":"pw_stories","type":"codeVoice"},{"type":"text","text":" block, alongside an "},{"type":"codeVoice","code":"aps.category"},{"text":" ","type":"text"},{"text":"matching ","type":"text"},{"type":"codeVoice","code":"UNNotificationExtensionCategory"},{"text":". The parser accepts the block either at","type":"text"},{"type":"text","text":" "},{"text":"the ","type":"text"},{"inlineContent":[{"type":"text","text":"payload root"}],"type":"strong"},{"type":"text","text":" (e.g. via the Pushwoosh API "},{"type":"codeVoice","code":"ios_root_params"},{"type":"text","text":") or inside the"},{"text":" ","type":"text"},{"text":"custom-data container ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"userdata"},{"type":"text","text":" (the Pushwoosh API "},{"type":"codeVoice","code":"data"},{"type":"text","text":" field — delivered as"},{"type":"text","text":" "},{"text":"a dictionary or a JSON-encoded string). The root form on the device looks like this:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","  \"aps\": { \"category\": \"PW_STORIES\" },","  \"pw_stories\": { \"pages\": [","    { \"image\": \"https:\/\/...\/1.jpg\", \"duration\": 5.0,","      \"link\": \"myapp:\/\/sale\", \"button_title\": \"Buy\",","      \"title\": \"Summer Sale\", \"subtitle\": \"Up to 70% off\" },","    { \"image\": \"https:\/\/...\/2.jpg\" }","  ]}","}"]},{"inlineContent":[{"text":"Sent through the ","type":"text"},{"type":"codeVoice","code":"data"},{"text":" API field instead (recommended, since it does not depend on","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"ios_root_params"},{"type":"text","text":"), the same block arrives nested under "},{"type":"codeVoice","code":"u"},{"type":"text","text":" — while "},{"code":"aps.category","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(and ","type":"text"},{"code":"mutable-content","type":"codeVoice"},{"type":"text","text":" for the pre-cache path) still go through "},{"code":"ios_root_params.aps","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"as there is no dedicated request field for them. The relevant createMessage fields:"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"ios_root_params\": { \"aps\": { \"category\": \"PW_STORIES\", \"mutable-content\": 1 } },","  \"data\": { \"pw_stories\": { \"pages\": [ { \"image\": \"https:\/\/...\/1.jpg\" } ] } }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The parser tries the root first, then ","type":"text"},{"code":"u","type":"codeVoice"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"userdata"},{"type":"text","text":", so both delivery styles work"},{"type":"text","text":" "},{"type":"text","text":"and old pushes keep rendering."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every field except "},{"code":"image","type":"codeVoice"},{"type":"text","text":" is optional. "},{"code":"link","type":"codeVoice"},{"type":"text","text":" (like "},{"type":"codeVoice","code":"image"},{"type":"text","text":") must include a URL"},{"type":"text","text":" "},{"type":"text","text":"scheme. A missing, empty, or malformed payload falls back to the default content"},{"type":"text","text":" "},{"text":"(the alert body) without crashing — override ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/showDefaultContent(for:)"},{"text":".","type":"text"}]},{"anchor":"Analytics","type":"heading","level":2,"text":"Analytics"},{"inlineContent":[{"text":"Set ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storiesDelegate"},{"type":"text","text":" to observe lifecycle and"},{"type":"text","text":" "},{"type":"text","text":"engagement and forward it to your analytics (the module itself sends nothing):"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class NotificationViewController: PushwooshStoriesViewController, PushwooshStoriesDelegate {","    override func viewDidLoad() {","        super.viewDidLoad()","        storiesDelegate = self","    }","    func storiesViewController(_ c: PushwooshStoriesViewController, didTapActionFor page: StoryPage, at index: Int) {","        \/\/ forward the per-page click to your backend","    }","}"]},{"text":"Instant \/ offline first frame (App Group pre-cache)","anchor":"Instant--offline-first-frame-App-Group-pre-cache","type":"heading","level":2},{"inlineContent":[{"text":"To make the first frame appear instantly (and offline), pre-download the media in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a Notification "},{"type":"strong","inlineContent":[{"type":"text","text":"Service"}]},{"type":"text","text":" Extension into a shared App Group container that the"},{"type":"text","text":" "},{"type":"text","text":"Content Extension reads from:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"inlineContent":[{"text":"App Groups","type":"text"}],"type":"strong"},{"text":" capability (same id) on both the Service and Content","type":"text"},{"type":"text","text":" "},{"text":"extensions, and override ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/appGroupIdentifier","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"From the Service Extension’s "},{"code":"didReceive(_:withContentHandler:)","type":"codeVoice"},{"text":", call","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher\/prefetch(userInfo:appGroupIdentifier:completion:)","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Send the push with "},{"type":"codeVoice","code":"mutable-content: 1"},{"type":"text","text":" so the Service Extension runs."}]}]}]},{"inlineContent":[{"type":"text","text":"Without this, the module still works — images download on display instead."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"A ready-made full-screen “stories” UI for an expanded push notification."}],"variants":[{"paths":["\/documentation\/pushwooshnotificationui"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/pushwooshnotificationui"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"externalID":"PushwooshNotificationUI","symbolKind":"module","title":"PushwooshNotificationUI","modules":[{"name":"PushwooshNotificationUI"}],"role":"collection","roleHeading":"Framework"},"references":{"doc://com.pushwoosh.PushwooshNotificationUI/documentation/PushwooshNotificationUI/PushwooshNotificationUIVersionString":{"title":"PushwooshNotificationUIVersionString","abstract":[{"text":"Project version string for PushwooshNotificationUI.","type":"text"}],"fragments":[{"kind":"identifier","text":"PushwooshNotificationUIVersionString"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshNotificationUIVersionString","url":"\/documentation\/pushwooshnotificationui\/pushwooshnotificationuiversionstring"},"doc://com.pushwoosh.PushwooshNotificationUI/documentation/PushwooshNotificationUI/PushwooshStoriesDelegate":{"url":"\/documentation\/pushwooshnotificationui\/pushwoos