":"symbol"},"doc://com.pushwoosh.PushwooshNotificationUI/documentation/PushwooshNotificationUI/PushwooshStoriesMediaPrefetcher":{"url":"\/documentation\/pushwooshnotificationui\/pushwooshstoriesmediaprefetcher","title":"PushwooshStoriesMediaPrefetcher","abstract":[{"text":"Entry point for a Notification ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Service"}]},{"type":"text","text":" Extension: pre-downloads the story media referenced"},{"type":"text","text":" "},{"type":"text","text":"by a "},{"code":"pw_stories","type":"codeVoice"},{"type":"text","text":" payload into the shared App Group container, so the Content Extension can"},{"text":" ","type":"text"},{"text":"render the first frame instantly and offline. Call from ","type":"text"},{"type":"codeVoice","code":"didReceive(_:withContentHandler:)"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"PushwooshStoriesMediaPrefetcher","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher","navigatorTitle":[{"kind":"identifier","text":"PushwooshStoriesMediaPrefetcher"}]},"doc://com.pushwoosh.PushwooshNotificationUI/documentation/PushwooshNotificationUI/PushwooshNotificationUIVersionNumber":{"url":"\/documentation\/pushwooshnotificationui\/pushwooshnotificationuiversionnumber","title":"PushwooshNotificationUIVersionNumber","abstract":[{"text":"Project version number for PushwooshNotificationUI.","type":"text"}],"fragments":[{"text":"PushwooshNotificationUIVersionNumber","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshNotificationUIVersionNumber"},"doc://com.pushwoosh.PushwooshNotificationUI/documentation/PushwooshNotificationUI/PushwooshStoriesMediaPrefetcher/