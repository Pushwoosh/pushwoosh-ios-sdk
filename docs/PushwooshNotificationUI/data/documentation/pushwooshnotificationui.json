:"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"From the Service Extension’s ","type":"text"},{"code":"didReceive(_:withContentHandler:)","type":"codeVoice"},{"type":"text","text":", call"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher\/prefetch(userInfo:appGroupIdentifier:completion:)","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Send the push with "},{"type":"codeVoice","code":"mutable-content: 1"},{"type":"text","text":" so the Service Extension runs."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Without this, the module still works — images download on display instead."}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"PushwooshNotificationUI"}],"role":"collection","symbolKind":"module","externalID":"PushwooshNotificationUI","roleHeading":"Framework","title":"PushwooshNotificationUI"},"abstract":[{"type":"text","text":"A ready-made full-screen “stories” UI for an expanded push notification."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.pushwoosh.PushwooshNotificationUI/documentation/PushwooshNotificationUI/PushwooshNotificationUIVersionString":{"kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshNotificationUIVersionString","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Project version string for PushwooshNotificationUI."}],"url":"\/documentation\/pushwooshnotificationui\/pushwooshnotificationuiversionstring","title":"PushwooshNotificationUIVersionString","fragments":[{"kind":"identifier","text":"PushwooshNotificationUIVersionString"}]},"doc://com.pushwoosh.PushwooshNotificationUI/documentation/PushwooshNotificationUI/StoryPage":{"navigatorTitle":[{"kind":"identifier","text":"StoryPage"}],"fragments":