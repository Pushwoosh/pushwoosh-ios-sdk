{"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"PushwooshNotificationUI provides ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController","isActive":true,"type":"reference"},{"type":"text","text":" — a drop-in"},{"type":"text","text":" "},{"code":"UNNotificationContentExtension","type":"codeVoice"},{"type":"text","text":" view controller that renders an Instagram-style"},{"type":"text","text":" "},{"type":"text","text":"stories experience: full-bleed images, top progress bars, auto-advance, tap-zone"},{"type":"text","text":" "},{"type":"text","text":"navigation, per-frame title\/subtitle, and an optional deep-link button."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The module links only UIKit, UserNotifications, and UserNotificationsUI (plus","type":"text"},{"text":" ","type":"text"},{"text":"CryptoKit for a stable cache key), so it adds no Pushwoosh Core\/Framework weight","type":"text"},{"type":"text","text":" "},{"type":"text","text":"to your memory-constrained extension process."}]},{"type":"heading","level":2,"anchor":"Usage","text":"Usage"},{"inlineContent":[{"type":"text","text":"In your Notification Content Extension:"}],"type":"paragraph"},{"syntax":"swift","code":["import PushwooshNotificationUI","","class NotificationViewController: PushwooshStoriesViewController {}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then set these keys in the extension’s Info.plist:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionCategory"},{"type":"text","text":" = "},{"code":"PW_STORIES","type":"codeVoice"},{"text":" (must match ","type":"text"},{"code":"aps.category","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionUserInteractionEnabled"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"YES"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionDefaultContentHidden"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"YES"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UNNotificationExtensionInitialContentSizeRatio","type":"codeVoice"},{"type":"text","text":" = e.g. "},{"type":"codeVoice","code":"1.5"},{"text":" (keep in sync with ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storyAspectRatio","isActive":true,"type":"reference"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).NotificationViewController"},{"type":"text","text":" (code-only, no storyboard)"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Payload","anchor":"Payload"},{"type":"paragraph","inlineContent":[{"text":"The stories are described by a ","type":"text"},{"code":"pw_stories","type":"codeVoice"},{"type":"text","text":" block, alongside an "},{"type":"codeVoice","code":"aps.category"},{"text":" ","type":"text"},{"text":"matching ","type":"text"},{"code":"UNNotificationExtensionCategory","type":"codeVoice"},{"text":". The parser accepts the block either at","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the "},{"inlineContent":[{"type":"text","text":"payload root"}],"type":"strong"},{"text":" (e.g. via the Pushwoosh API ","type":"text"},{"code":"ios_root_params","type":"codeVoice"},{"text":") or inside the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"custom-data container "},{"type":"codeVoice","code":"u"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"userdata"},{"text":" (the Pushwoosh API ","type":"text"},{"code":"data","type":"codeVoice"},{"type":"text","text":" field — delivered as"},{"text":" ","type":"text"},{"text":"a dictionary or a JSON-encoded string). The root form on the device looks like this:","type":"text"}]},{"type":"codeListing","code":["{","  \"aps\": { \"category\": \"PW_STORIES\" },","  \"pw_stories\": { \"pages\": [","    { \"image\": \"https:\/\/...\/1.jpg\", \"duration\": 5.0,","      \"link\": \"myapp:\/\/sale\", \"button_title\": \"Buy\",","      \"title\": \"Summer Sale\", \"subtitle\": \"Up to 70% off\" },","    { \"image\": \"https:\/\/...\/2.jpg\" }","  ]}","}"],"syntax":"json"},{"inlineContent":[{"text":"Sent through the ","type":"text"},{"type":"codeVoice","code":"data"},{"text":" API field instead (recommended, since it does not depend on","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"ios_root_params"},{"text":"), the same block arrives nested under ","type":"text"},{"code":"u","type":"codeVoice"},{"type":"text","text":" — while "},{"type":"codeVoice","code":"aps.category"},{"type":"text","text":" "},{"text":"(and ","type":"text"},{"code":"mutable-content","type":"codeVoice"},{"type":"text","text":" for the pre-cache path) still go through "},{"type":"codeVoice","code":"ios_root_params.aps"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"as there is no dedicated request field for them. The relevant createMessage fields:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","  \"ios_root_params\": { \"aps\": { \"category\": \"PW_STORIES\", \"mutable-content\": 1 } },","  \"data\": { \"pw_stories\": { \"pages\": [ { \"image\": \"https:\/\/...\/1.jpg\" } ] } }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parser tries the root first, then "},{"type":"codeVoice","code":"u"},{"text":" \/ ","type":"text"},{"code":"userdata","type":"codeVoice"},{"text":", so both delivery styles work","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and old pushes keep rendering."}]},{"inlineContent":[{"text":"Every field except ","type":"text"},{"type":"codeVoice","code":"image"},{"text":" is optional. ","type":"text"},{"code":"link","type":"codeVoice"},{"type":"text","text":" (like "},{"code":"image","type":"codeVoice"},{"text":") must include a URL","type":"text"},{"type":"text","text":" "},{"text":"scheme. A missing, empty, or malformed payload falls back to the default content","type":"text"},{"text":" ","type":"text"},{"text":"(the alert body) without crashing — override ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/showDefaultContent(for:)"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Analytics","level":2,"type":"heading","anchor":"Analytics"},{"inlineContent":[{"text":"Set ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storiesDelegate","isActive":true},{"text":" to observe lifecycle and","type":"text"},{"text":" ","type":"text"},{"text":"engagement and forward it to your analytics (the module itself sends nothing):","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class NotificationViewController: PushwooshStoriesViewController, PushwooshStoriesDelegate {","    override func viewDidLoad() {","        super.viewDidLoad()","        storiesDelegate = self","    }","    func storiesViewController(_ c: PushwooshStoriesViewController, didTapActionFor page: StoryPage, at index: Int) {","        \/\/ forward the per-page click to your backend","    }","}"]},{"level":2,"type":"heading","anchor":"Instant--offline-first-frame-App-Group-pre-cache","text":"Instant \/ offline first frame (App Group pre-cache)"},{"type":"paragraph","inlineContent":[{"text":"To make the first frame appear instantly (and offline), pre-download the media in","type":"text"},{"text":" ","type":"text"},{"text":"a Notification ","type":"text"},{"type":"strong","inlineContent":[{"text":"Service","type":"text"}]},{"type":"text","text":" Extension into a shared App Group container that the"},{"type":"text","text":" "},{"text":"Content Extension reads from:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Enable the ","type":"text"},{"inlineContent":[{"text":"App Groups","type":"text"}],"type":"strong"},{"text":" capability (same id) on both the Service and Content","type":"text"},{"type":"text","text":" "},{"text":"extensions, and override ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/appGroupIdentifier"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"From the Service Extension’s "},{"type":"codeVoice","code":"didReceive(_:withContentHandler:)"},{"type":"text","text":", call"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher\/prefetch(userInfo:appGroupIdentifier:completion:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Send the push with ","type":"text"},{"code":"mutable-content: 1","type":"codeVoice"},{"type":"text","text":" so the Service Extension runs."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Without this, the module still works — images download on display instead."}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"topicSections":[{"title