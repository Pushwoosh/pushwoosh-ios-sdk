{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI"},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"A ready-made full-screen “stories” UI for an expanded push notification."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController"],"title":"Stories UI"},{"title":"Payload model","identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/StoryPage"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesDelegate"],"title":"Analytics"},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher"],"title":"Media pre-cache"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"PushwooshNotificationUI provides ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController","isActive":true},{"type":"text","text":" — a drop-in"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UNNotificationContentExtension"},{"text":" view controller that renders an Instagram-style","type":"text"},{"text":" ","type":"text"},{"text":"stories experience: full-bleed images, top progress bars, auto-advance, tap-zone","type":"text"},{"text":" ","type":"text"},{"text":"navigation, per-frame title\/subtitle, and an optional deep-link button.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The module links only UIKit, UserNotifications, and UserNotificationsUI (plus","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"CryptoKit for a stable cache key), so it adds no Pushwoosh Core\/Framework weight"},{"text":" ","type":"text"},{"type":"text","text":"to your memory-constrained extension process."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Usage","anchor":"Usage"},{"type":"paragraph","inlineContent":[{"text":"In your Notification Content Extension:","type":"text"}]},{"syntax":"swift","code":["import PushwooshNotificationUI","","class NotificationViewController: PushwooshStoriesViewController {}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then set these keys in the extension’s Info.plist:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"UNNotificationExtensionCategory","type":"codeVoice"},{"type":"text","text":" = "},{"type":"codeVoice","code":"PW_STORIES"},{"type":"text","text":" (must match "},{"type":"codeVoice","code":"aps.category"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionUserInteractionEnabled"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"YES"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionDefaultContentHidden"},{"text":" = ","type":"text"},{"code":"YES","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UNNotificationExtensionInitialContentSizeRatio","type":"codeVoice"},{"text":" = e.g. ","type":"text"},{"type":"codeVoice","code":"1.5"},{"type":"text","text":" (keep in sync with "},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storyAspectRatio","isActive":true},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).NotificationViewController"},{"text":" (code-only, no storyboard)","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Payload","text":"Payload","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The stories are described by a "},{"code":"pw_stories","type":"codeVoice"},{"text":" block, alongside an ","type":"text"},{"type":"codeVoice","code":"aps.category"},{"type":"text","text":" "},{"text":"matching ","type":"text"},{"code":"UNNotificationExtensionCategory","type":"codeVoice"},{"text":". The parser accepts the block either at","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"strong","inlineContent":[{"text":"payload root","type":"text"}]},{"text":" (e.g. via the Pushwoosh API ","type":"text"},{"code":"ios_root_params","type":"codeVoice"},{"type":"text","text":") or inside the"},{"text":" ","type":"text"},{"text":"custom-data container ","type":"text"},{"code":"u","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"userdata"},{"type":"text","text":" (the Pushwoosh API "},{"code":"data","type":"codeVoice"},{"text":" field — delivered as","type":"text"},{"text":" ","type":"text"},{"text":"a dictionary or a JSON-encoded string). The root form on the device looks like this:","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"aps\": { \"category\": \"PW_STORIES\" },","  \"pw_stories\": { \"pages\": [","    { \"image\": \"https:\/\/...\/1.jpg\", \"duration\": 5.0,","      \"link\": \"myapp:\/\/sale\", \"button_title\": \"Buy\",","      \"title\": \"Summer Sale\", \"subtitle\": \"Up to 70% off\" },","    { \"image\": \"https:\/\/...\/2.jpg\" }","  ]}","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Sent through the "},{"type":"codeVoice","code":"data"},{"type":"text","text":" API field instead (recommended, since it does not depend on"},{"type":"text","text":" "},{"type":"codeVoice","code":"ios_root_params"},{"type":"text","text":"), the same block arrives nested under "},{"code":"u","type":"codeVoice"},{"type":"text","text":" — while "},{"code":"aps.category","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(and ","type":"text"},{"type":"codeVoice","code":"mutable-content"},{"type":"text","text":" for the pre-cache path) still go through "},{"type":"codeVoice","code":"ios_root_params.aps"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as there is no dedicated request field for them. The relevant createMessage fields:","type":"text"}],"type":"paragraph"},{"code":["{","  \"ios_root_params\": { \"aps\": { \"category\": \"PW_STORIES\", \"mutable-content\": 1 } },","  \"data\": { \"pw_stories\": { \"pages\": [ { \"image\": \"https:\/\/...\/1.jpg\" } ] } }","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"The parser tries the root first, then ","type":"text"},{"type":"codeVoice","code":"u"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"userdata"},{"text":", so both delivery styles work","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and old pushes keep rendering."}]},{"inlineContent":[{"type":"text","text":"Every field except "},{"type":"codeVoice","code":"image"},{"type":"text","text":" is optional. "},{"type":"codeVoice","code":"link"},{"text":" (like ","type":"text"},{"type":"codeVoice","code":"image"},{"text":") must include a URL","type":"text"},{"type":"text","text":" "},{"type":"text","text":"scheme. A missing, empty, or malformed payload falls back to the default content"},{"text":" ","type":"text"},{"type":"text","text":"(the alert body) without crashing — override "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/showDefaultContent(for:)"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Analytics","level":2,"type":"heading","anchor":"Analytics"},{"type":"paragraph","inlineContent":[{"text":"Set ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storiesDelegate","type":"reference","isActive":true},{"text":" to observe lifecycle and","type":"text"},{"text":" ","type":"text"},{"text":"engagement and forward it to your analytics (the module itself sends nothing):","type":"text"}]},{"code":["class NotificationViewController: PushwooshStoriesViewController, PushwooshStoriesDelegate {","    override func viewDidLoad() {","        super.viewDidLoad()","        storiesDelegate = self","    }","    func storiesViewController(_ c: PushwooshStoriesViewController, didTapActionFor page: StoryPage, at index: Int) {","        \/\/ forward the per-page click to your backend","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Instant--offline-first-frame-App-Group-pre-cache","type":"heading","text":"Instant \/ offline first frame (App Group pre-cache)","level":2},{"inlineContent":[{"type":"text","text":"To make the first frame appear instantly (and offline), pre-download the media in"},{"text":" ","type":"text"},{"type":"text","text":"a Notification "},{"type":"strong","inlineContent":[{"type":"text","text":"Service"}]},{"text":" Extension into a shared App Group container that the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Content Extension reads from:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"type":"text","text":"App Groups"}]},{"text":" capability (same id) on both the Service and Content","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"extensions, and override "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/appGroupIdentifier"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"From the Service Extension’s ","type":"text"},{"type":"codeVoice","code":"didReceive(_:withContentHandler:)"},{"text":", call","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher\/prefetch(userInfo:appGroupIdentifier:completion:)","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Send the push with "},{"type":"codeVoice","code":"mutable-content: 1"},{"type":"text","text":" so the Service Extension runs."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without this, the module still works — images download on display instead."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshnotificationui"]},{"paths":["\/documentation\/pushwooshnotificationui"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"modules":[{"name":"PushwooshNotificationUI"}],"title":"PushwooshNotificationUI","roleHeading":"Framework","role":"collection","symbolKind":"module","externalID":"PushwooshNotificationUI"},"sections":[],"references":{"doc://com.pushwoosh.PushwooshNotificationUI/documentation/PushwooshNotificationUI/PushwooshStoriesViewController/appGroupIdentifier":{"abstract":[{"type":"text","text":"App Group identifier shared with your Notification Service Extension. When set (and the"},{"type":"text","text":" "},{"text":"capability is enabled on both targets), the first frame is read from the shared container","type":"text"},{"type":"text","text":" "},{"text":"that the Service Extension pre-warmed — instant and offline. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" (uses ","type":"text"},{"type":"codeVoice","code":"tmp"},{"text":").","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","title":"appGroupIdentifier","fragments":[{"text":"var","kind":"keyword"},{"t