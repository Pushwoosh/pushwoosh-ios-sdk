{"topicSections":[{"title":"Stories UI","identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController"]},{"title":"Payload model","identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/StoryPage"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesDelegate"],"title":"Analytics"},{"title":"Media pre-cache","identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher"]}],"kind":"symbol","hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"PushwooshNotificationUI provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController"},{"text":" — a drop-in","type":"text"},{"text":" ","type":"text"},{"code":"UNNotificationContentExtension","type":"codeVoice"},{"type":"text","text":" view controller that renders an Instagram-style"},{"text":" ","type":"text"},{"type":"text","text":"stories experience: full-bleed images, top progress bars, auto-advance, tap-zone"},{"type":"text","text":" "},{"type":"text","text":"navigation, per-frame title\/subtitle, and an optional deep-link button."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module links only UIKit, UserNotifications, and UserNotificationsUI (plus"},{"type":"text","text":" "},{"type":"text","text":"CryptoKit for a stable cache key), so it adds no Pushwoosh Core\/Framework weight"},{"text":" ","type":"text"},{"type":"text","text":"to your memory-constrained extension process."}]},{"anchor":"Usage","level":2,"type":"heading","text":"Usage"},{"inlineContent":[{"text":"In your Notification Content Extension:","type":"text"}],"type":"paragraph"},{"code":["import PushwooshNotificationUI","","class NotificationViewController: PushwooshStoriesViewController {}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then set these keys in the extension’s Info.plist:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionCategory"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"PW_STORIES"},{"text":" (must match ","type":"text"},{"type":"codeVoice","code":"aps.category"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionUserInteractionEnabled"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"YES"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionDefaultContentHidden"},{"type":"text","text":" = "},{"type":"codeVoice","code":"YES"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UNNotificationExtensionInitialContentSizeRatio","type":"codeVoice"},{"type":"text","text":" = e.g. "},{"code":"1.5","type":"codeVoice"},{"type":"text","text":" (keep in sync with "},{"isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storyAspectRatio","type":"reference"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).NotificationViewController"},{"text":" (code-only, no storyboard)","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Payload","text":"Payload"},{"inlineContent":[{"text":"The stories are described by a ","type":"text"},{"type":"codeVoice","code":"pw_stories"},{"type":"text","text":" block, alongside an "},{"code":"aps.category","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"matching "},{"type":"codeVoice","code":"UNNotificationExtensionCategory"},{"type":"text","text":". The parser accepts the block either at"},{"type":"text","text":" "},{"text":"the ","type":"text"},{"inlineContent":[{"text":"payload root","type":"text"}],"type":"strong"},{"type":"text","text":" (e.g. via the Pushwoosh API "},{"type":"codeVoice","code":"ios_root_params"},{"type":"text","text":") or inside the"},{"type":"text","text":" "},{"text":"custom-data container ","type":"text"},{"type":"codeVoice","code":"u"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"userdata"},{"text":" (the Pushwoosh API ","type":"text"},{"type":"codeVoice","code":"data"},{"text":" field — delivered as","type":"text"},{"text":" ","type":"text"},{"text":"a dictionary or a JSON-encoded string). The root form on the device looks like this:","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"aps\": { \"category\": \"PW_STORIES\" },","  \"pw_stories\": { \"pages\": [","    { \"image\": \"https:\/\/...\/1.jpg\", \"duration\": 5.0,","      \"link\": \"myapp:\/\/sale\", \"button_title\": \"Buy\",","      \"title\": \"Summer Sale\", \"subtitle\": \"Up to 70% off\" },","    { \"image\": \"https:\/\/...\/2.jpg\" }","  ]}","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sent through the "},{"code":"data","type":"codeVoice"},{"type":"text","text":" API field instead (recommended, since it does not depend on"},{"type":"text","text":" "},{"type":"codeVoice","code":"ios_root_params"},{"type":"text","text":"), the same block arrives nested under "},{"code":"u","type":"codeVoice"},{"text":" — while ","type":"text"},{"code":"aps.category","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"(and "},{"code":"mutable-content","type":"codeVoice"},{"text":" for the pre-cache path) still go through ","type":"text"},{"type":"codeVoice","code":"ios_root_params.aps"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"as there is no dedicated request field for them. The relevant createMessage fields:"}]},{"code":["{","  \"ios_root_params\": { \"aps\": { \"category\": \"PW_STORIES\", \"mutable-content\": 1 } },","  \"data\": { \"pw_stories\": { \"pages\": [ { \"image\": \"https:\/\/...\/1.jpg\" } ] } }","}"],"syntax":"json","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parser tries the root first, then "},{"type":"codeVoice","code":"u"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"userdata"},{"text":", so both delivery styles work","type":"text"},{"type":"text","text":" "},{"text":"and old pushes keep rendering.","type":"text"}]},{"inlineContent":[{"text":"Every field except ","type":"text"},{"code":"image","type":"codeVoice"},{"text":" is optional. ","type":"text"},{"code":"link","type":"codeVoice"},{"type":"text","text":" (like "},{"code":"image","type":"codeVoice"},{"text":") must include a URL","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"scheme. A missing, empty, or malformed payload falls back to the default content"},{"type":"text","text":" "},{"type":"text","text":"(the alert body) without crashing — override "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/showDefaultContent(for:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Analytics","anchor":"Analytics","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Set ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storiesDelegate","type":"reference"},{"type":"text","text":" to observe lifecycle and"},{"type":"text","text":" "},{"text":"engagement and forward it to your analytics (the module itself sends nothing):","type":"text"}]},{"code":["class NotificationViewController: PushwooshStoriesViewController, PushwooshStoriesDelegate {","    override func viewDidLoad() {","        super.viewDidLoad()","        storiesDelegate = self","    }","    func storiesViewController(_ c: PushwooshStoriesViewController, didTapActionFor page: StoryPage, at index: Int) {","        \/\/ forward the per-page click to your backend","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Instant--offline-first-frame-App-Group-pre-cache","type":"heading","text":"Instant \/ offline first frame (App Group pre-cache)","level":2},{"type":"paragraph","inlineContent":[{"text":"To make the first frame appear instantly (and offline), pre-download the media in","type":"text"},{"type":"text","text":" "},{"text":"a Notification ","type":"text"},{"inlineContent":[{"text":"Service","type":"text"}],"type":"strong"},{"text":" Extension into a shared App Group container that the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Content Extension reads from:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"type":"text","text":"App Groups"}]},{"text":" capability (same id) on both the Service and Content","type":"text"},{"type":"text","text":" "},{"text":"extensions, and override ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/appGroupIdentifier"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"From the Service Extension’s ","type":"text"},{"code":"didReceive(_:withContentHandler:)","type":"codeVoice"},{"text":", call","type":"text"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher\/prefetch(userInfo:appGroupIdentifier:completion:)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Send the push with "},{"type":"codeVoice","code":"mutable-content: 1"},{"text":" so the Service Extension runs.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Without this, the module still works — images download on display instead.","type":"text"}]}]}],"abstract":[{"text":"A ready-made full-screen “stories” UI for an expanded push notification.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshnotificationui"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshnotificationui"]}],"metadata":{"title":"PushwooshNotificationUI","externalID":"PushwooshNotificationUI","role":"collection","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"PushwooshNotificationUI"}]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://com.pushwoosh.PushwooshNotificationUI/documentation/PushwooshNotificationUI/PushwooshStoriesViewController/storyAspectRatio":{"url":"\/documentation\/pushwooshnotificationui\/pushwooshstoriesviewcontroller\/storyaspectratio","kind":"symbol","type":"topic","role":"symbol","title":"storyAspectRatio","abstract":[{"type":"text","text":"Aspect ratio (height ÷ width) of the stories area. Keep this in sync with the extension’s"},{"type":"text","text":" "},{"code":"UNNotificationExtensionInitialContentSizeRatio","type":"codeVoice"},{"text":" so the notification doesn’t resize after the","type":"text"},{"type":"text","text":" "},{"text":"image loads. Override in a subclass to change the story proportions.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"text"