{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshnotificationui"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshnotificationui"]}],"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"A ready-made full-screen “stories” UI for an expanded push notification.","type":"text"}],"topicSections":[{"title":"Stories UI","identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/StoryPage"],"title":"Payload model"},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesDelegate"],"title":"Analytics"},{"title":"Media pre-cache","identifiers":["doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"PushwooshNotificationUI provides ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController","isActive":true},{"text":" — a drop-in","type":"text"},{"text":" ","type":"text"},{"code":"UNNotificationContentExtension","type":"codeVoice"},{"text":" view controller that renders an Instagram-style","type":"text"},{"type":"text","text":" "},{"text":"stories experience: full-bleed images, top progress bars, auto-advance, tap-zone","type":"text"},{"text":" ","type":"text"},{"text":"navigation, per-frame title\/subtitle, and an optional deep-link button.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The module links only UIKit, UserNotifications, and UserNotificationsUI (plus"},{"text":" ","type":"text"},{"type":"text","text":"CryptoKit for a stable cache key), so it adds no Pushwoosh Core\/Framework weight"},{"text":" ","type":"text"},{"text":"to your memory-constrained extension process.","type":"text"}],"type":"paragraph"},{"text":"Usage","type":"heading","level":2,"anchor":"Usage"},{"inlineContent":[{"type":"text","text":"In your Notification Content Extension:"}],"type":"paragraph"},{"syntax":"swift","code":["import PushwooshNotificationUI","","class NotificationViewController: PushwooshStoriesViewController {}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then set these keys in the extension’s Info.plist:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionCategory"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"PW_STORIES"},{"type":"text","text":" (must match "},{"code":"aps.category","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"UNNotificationExtensionUserInteractionEnabled","type":"codeVoice"},{"type":"text","text":" = "},{"type":"codeVoice","code":"YES"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UNNotificationExtensionDefaultContentHidden"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"YES"}]}]},{"content":[{"inlineContent":[{"code":"UNNotificationExtensionInitialContentSizeRatio","type":"codeVoice"},{"text":" = e.g. ","type":"text"},{"type":"codeVoice","code":"1.5"},{"type":"text","text":" (keep in sync with "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storyAspectRatio","type":"reference","isActive":true},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" = ","type":"text"},{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).NotificationViewController"},{"type":"text","text":" (code-only, no storyboard)"}]}]}],"type":"unorderedList"},{"text":"Payload","type":"heading","level":2,"anchor":"Payload"},{"inlineContent":[{"text":"The stories are described by a ","type":"text"},{"type":"codeVoice","code":"pw_stories"},{"type":"text","text":" block, alongside an "},{"type":"codeVoice","code":"aps.category"},{"text":" ","type":"text"},{"type":"text","text":"matching "},{"code":"UNNotificationExtensionCategory","type":"codeVoice"},{"type":"text","text":". The parser accepts the block either at"},{"type":"text","text":" "},{"type":"text","text":"the "},{"inlineContent":[{"type":"text","text":"payload root"}],"type":"strong"},{"type":"text","text":" (e.g. via the Pushwoosh API "},{"code":"ios_root_params","type":"codeVoice"},{"text":") or inside the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"custom-data container "},{"type":"codeVoice","code":"u"},{"text":" \/ ","type":"text"},{"code":"userdata","type":"codeVoice"},{"text":" (the Pushwoosh API ","type":"text"},{"type":"codeVoice","code":"data"},{"text":" field — delivered as","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a dictionary or a JSON-encoded string). The root form on the device looks like this:"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"aps\": { \"category\": \"PW_STORIES\" },","  \"pw_stories\": { \"pages\": [","    { \"image\": \"https:\/\/...\/1.jpg\", \"duration\": 5.0,","      \"link\": \"myapp:\/\/sale\", \"button_title\": \"Buy\",","      \"title\": \"Summer Sale\", \"subtitle\": \"Up to 70% off\" },","    { \"image\": \"https:\/\/...\/2.jpg\" }","  ]}","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sent through the "},{"type":"codeVoice","code":"data"},{"text":" API field instead (recommended, since it does not depend on","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"ios_root_params"},{"text":"), the same block arrives nested under ","type":"text"},{"type":"codeVoice","code":"u"},{"text":" — while ","type":"text"},{"type":"codeVoice","code":"aps.category"},{"type":"text","text":" "},{"type":"text","text":"(and "},{"type":"codeVoice","code":"mutable-content"},{"type":"text","text":" for the pre-cache path) still go through "},{"code":"ios_root_params.aps","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as there is no dedicated request field for them. The relevant createMessage fields:","type":"text"}]},{"syntax":"json","code":["{","  \"ios_root_params\": { \"aps\": { \"category\": \"PW_STORIES\", \"mutable-content\": 1 } },","  \"data\": { \"pw_stories\": { \"pages\": [ { \"image\": \"https:\/\/...\/1.jpg\" } ] } }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parser tries the root first, then "},{"type":"codeVoice","code":"u"},{"text":" \/ ","type":"text"},{"code":"userdata","type":"codeVoice"},{"type":"text","text":", so both delivery styles work"},{"text":" ","type":"text"},{"type":"text","text":"and old pushes keep rendering."}]},{"type":"paragraph","inlineContent":[{"text":"Every field except ","type":"text"},{"code":"image","type":"codeVoice"},{"text":" is optional. ","type":"text"},{"type":"codeVoice","code":"link"},{"text":" (like ","type":"text"},{"type":"codeVoice","code":"image"},{"text":") must include a URL","type":"text"},{"type":"text","text":" "},{"type":"text","text":"scheme. A missing, empty, or malformed payload falls back to the default content"},{"text":" ","type":"text"},{"type":"text","text":"(the alert body) without crashing — override "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/showDefaultContent(for:)"},{"type":"text","text":"."}]},{"text":"Analytics","type":"heading","level":2,"anchor":"Analytics"},{"inlineContent":[{"type":"text","text":"Set "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storiesDelegate","type":"reference","isActive":true},{"type":"text","text":" to observe lifecycle and"},{"type":"text","text":" "},{"type":"text","text":"engagement and forward it to your analytics (the module itself sends nothing):"}],"type":"paragraph"},{"type":"codeListing","code":["class NotificationViewController: PushwooshStoriesViewController, PushwooshStoriesDelegate {","    override func viewDidLoad() {","        super.viewDidLoad()","        storiesDelegate = self","    }","    func storiesViewController(_ c: PushwooshStoriesViewController, didTapActionFor page: StoryPage, at index: Int) {","        \/\/ forward the per-page click to your backend","    }","}"],"syntax":"swift"},{"text":"Instant \/ offline first frame (App Group pre-cache)","level":2,"type":"heading","anchor":"Instant--offline-first-frame-App-Group-pre-cache"},{"inlineContent":[{"text":"To make the first frame appear instantly (and offline), pre-download the media in","type":"text"},{"type":"text","text":" "},{"type":"text","text":"a Notification "},{"inlineContent":[{"type":"text","text":"Service"}],"type":"strong"},{"type":"text","text":" Extension into a shared App Group container that the"},{"type":"text","text":" "},{"type":"text","text":"Content Extension reads from:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable the "},{"type":"strong","inlineContent":[{"type":"text","text":"App Groups"}]},{"text":" capability (same id) on both the Service and Content","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"extensions, and override "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/appGroupIdentifier","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"From the Service Extension’s ","type":"text"},{"type":"codeVoice","code":"didReceive(_:withContentHandler:)"},{"type":"text","text":", call"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesMediaPrefetcher\/prefetch(userInfo:appGroupIdentifier:completion:)","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Send the push with ","type":"text"},{"type":"codeVoice","code":"mutable-content: 1"},{"type":"text","text":" so the Service Extension runs."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without this, the module still works — images download on display instead."}]}]}],"metadata":{"externalID":"PushwooshNotificationUI","symbolKind":"module","role":"collection","roleHeading":"Framework","modules":[{"name":"PushwooshNotificationUI"}],"title":"PushwooshNotificationUI"},"sections":[],"references":{"doc://com.pushwoosh.PushwooshNotificationUI/documentation/PushwooshNotificationUI/PushwooshStoriesViewController/storyAspectRatio":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshNotificationUI\/documentation\/PushwooshNotificationUI\/PushwooshStoriesViewController\/storyAspectRatio","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"storyAspectRatio"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14CoreFoundation7CGFloatV","kind":"typeIdentifier","text":"CGFloat"}],"abstract":[{"type":"text","text":"Aspect ratio (height ÷ width) of the stories area. Keep this in sync with the extension’s"},{"text":" ","type":"text"},{"code":"UNNotificationExtensionInitialContentSizeRatio","type":"codeVo