{"kind":"article","sections":[],"metadata":{"title":"Code Examples","role":"article","roleHeading":"Article","modules":[{"name":"PushwooshVoIP"}]},"abstract":[{"type":"text","text":"Practical examples for common VoIP integration scenarios."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"This guide provides working code examples for typical use cases with PushwooshVoIP module.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Basic Setup","anchor":"Basic-Setup","level":2},{"text":"Minimal Configuration","type":"heading","anchor":"Minimal-Configuration","level":3},{"code":["import UIKit","import PushwooshFramework","import PushwooshVoIP","import CallKit","import PushKit","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, PWVoIPCallDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        Pushwoosh.VoIP.delegate = self","","        return true","    }","","    func voipDidReceiveIncomingCall(payload: PushwooshVoIP.PWVoIPMessage) {","        print(\"Incoming call: \\(payload.callerName)\")","    }","","    func pwProviderDidReset(_ provider: CXProvider) {","        print(\"Provider reset\")","    }","","    func pwProviderDidBegin(_ provider: CXProvider) {","        print(\"Provider ready\")","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Handling Incoming Calls","anchor":"Handling-Incoming-Calls","type":"heading","level":2},{"type":"heading","anchor":"Store-Call-Information","level":3,"text":"Store Call Information"},{"code":["class CallManager {","    static let shared = CallManager()","","    private var activeCalls: [UUID: CallInfo] = [:]","","    struct CallInfo {","        let uuid: UUID","        let callerName: String","        let hasVideo: Bool","        let timestamp: Date","    }","","    func storeCall(_ payload: PWVoIPMessage) {","        guard let uuid = UUID(uuidString: payload.uuid) else {","            return","        }","","        let callInfo = CallInfo(","            uuid: uuid,","            callerName: payload.callerName,","            hasVideo: payload.hasVideo,","            timestamp: Date()","        )","","        activeCalls[uuid] = callInfo","    }","","    func getCall(uuid: UUID) -> CallInfo? {","        return activeCalls[uuid]","    }","","    func removeCall(uuid: UUID) {","        activeCalls.removeValue(forKey: uuid)","    }","","    func getAllCallUUIDs() -> [UUID] {","        return Array(activeCalls.keys)","    }","}","","extension AppDelegate: PWVoIPCallDelegate {","","    func voipDidReceiveIncomingCall(payload: PushwooshVoIP.PWVoIPMessage) {","        CallManager.shared.storeCall(payload)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Answer Call","type":"heading","anchor":"Answer-Call"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK fulfills the CallKit action after the delegate returns, so the delegate only starts the call. Configure audio when CallKit activates the audio session:"}]},{"syntax":"swift","code":["extension AppDelegate: PWVoIPCallDelegate {","","    func answerCall(_ provider: CXProvider, perform action: CXAnswerCallAction, voipMessage: PWVoIPMessage?) {","        guard let callInfo = CallManager.shared.getCall(uuid: action.callUUID) else {","            return","        }","","        startCallWithPeer(callInfo.callerName)","    }","","    func activatedAudioSession(_ provider: CXProvider, didActivate audioSession: AVAudioSession) {","        try? audioSession.setCategory(.playAndRecord, mode: .voiceChat)","        startAudio()","    }","","    private func startCallWithPeer(_ peerName: String) {","        print(\"Starting call with \\(peerName)\")","    }","","    private func startAudio() {","        print(\"Audio started\")","    }","}"],"type":"codeListing"},{"text":"End Call","level":3,"type":"heading","anchor":"End-Call"},{"code":["extension AppDelegate: PWVoIPCallDelegate {","","    func endCall(_ provider: CXProvider, perform action: CXEndCallAction, voipMessage: PWVoIPMessage?) {","        endCallSession(action.callUUID)","        CallManager.shared.removeCall(uuid: action.callUUID)","    }","","    func deactivatedAudioSession(_ provider: CXProvider, didDeactivate audioSession: AVAudioSession) {","        stopAudio()","    }","","    private func endCallSession(_ uuid: UUID) {","        print(\"Ending call: \\(uuid)\")","    }","","    private func stopAudio() {","        print(\"Audio stopped\")","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Call Controls","type":"heading","anchor":"Call-Controls"},{"text":"Mute\/Unmute","type":"heading","level":3,"anchor":"MuteUnmute"},{"syntax":"swift","code":["extension AppDelegate: PWVoIPCallDelegate {","","    func mutedCall(_ provider: CXProvider, perform action: CXSetMutedCallAction) {","        if action.isMuted {","            disableMicrophone()","        } else {","            enableMicrophone()","        }","    }","","    private func disableMicrophone() {","        print(\"Microphone disabled\")","    }","","    private func enableMicrophone() {","        print(\"Microphone enabled\")","    }","}"],"type":"codeListing"},{"level":3,"text":"Hold\/Resume","anchor":"HoldResume","type":"heading"},{"type":"codeListing","syntax":"swift","code":["extension AppDelegate: PWVoIPCallDelegate {","","    func heldCall(_ provider: CXProvider, perform action: CXSetHeldCallAction) {","        if action.isOnHold {","            pauseCall(action.callUUID)","        } else {","            resumeCall(action.callUUID)","        }","    }","","    private func pauseCall(_ uuid: UUID) {","        print(\"Call paused: \\(uuid)\")","    }","","    private func resumeCall(_ uuid: UUID) {","        print(\"Call resumed: \\(uuid)\")","    }","}"]},{"type":"heading","level":2,"anchor":"Token-Management","text":"Token Management"},{"level":3,"anchor":"Monitor-Token-Registration","type":"heading","text":"Monitor Token Registration"},{"inlineContent":[{"type":"text","text":"The SDK gets the VoIP token from PushKit and registers it with Pushwoosh under your main Application Code. Both callbacks are optional:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension AppDelegate: PWVoIPCallDelegate {","","    func voipDidRegisterTokenSuccessfully() {","        print(\"VoIP token registered\")","    }","","    func voipDidFailToRegisterToken(error: Error) {","        print(\"VoIP token registration failed: \\(error.localizedDescription)\")","    }","}"]},{"type":"heading","anchor":"Video-Calls","level":2,"text":"Video Calls"},{"anchor":"Enable-Video-Support","text":"Enable Video Support","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A call is shown as a video call when the push payload has "},{"type":"codeVoice","code":"\"video\": true"},{"type":"text","text":". Check it in the delegate:"}]},{"code":["extension AppDelegate: PWVoIPCallDelegate {","","    func voipDidReceiveIncomingCall(payload: PushwooshVoIP.PWVoIPMessage) {","        if payload.hasVideo {","            print(\"Incoming VIDEO call\")","            prepareVideoCallUI()","        } else {","            print(\"Incoming AUDIO call\")","            prepareAudioCallUI()","        }","","        CallManager.shared.storeCall(payload)","    }","","    private func prepareVideoCallUI() {","        print(\"Preparing video call UI\")","    }","","    private func prepareAudioCallUI() {","        print(\"Preparing audio call UI\")","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Handle-Types","text":"Handle Types","type":"heading"},{"inlineContent":[{"type":"text","text":"The caller ID format comes from the "},{"type":"codeVoice","code":"handleType"},{"type":"text","text":" field of the push payload and is available as "},{"type":"codeVoice","code":"payload.handleType"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"handleType"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPHandleType","type":"reference"}]}],[{"inlineContent":[{"type":"text","text":"Format"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"1"},{"text":" (default)","type":"text"}]}],[{"inlineContent":[{"code":".generic","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Usernames, custom IDs","type":"text"}]}]],[[{"inlineContent":[{"code":"2","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".phoneNumber"}]}],[{"inlineContent":[{"text":"Phone numbers","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"3","type":"codeVoice"}]}],[{"inlineContent":[{"code":".email","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Email addresses"}]}]]]},{"type":"heading","level":2,"text":"Error Handling","anchor":"Error-Handling"},{"level":3,"text":"Handle Provider Reset","anchor":"Handle-Provider-Reset","type":"heading"},{"inlineContent":[{"type":"text","text":"CallKit ends every call and deactivates the audio session on reset; release your own call state:"}],"type":"paragraph"},{"code":["extension AppDelegate: PWVoIPCallDelegate {","","    func pwProviderDidReset(_ provider: CXProvider) {","        print(\"CallKit provider reset\")","","        for uuid in CallManager.shared.getAllCallUUIDs() {","            endCallSession(uuid)","            CallManager.shared.removeCall(uuid: uuid)","        }","","        print(\"All calls terminated\")","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Next Steps","type":"heading","anchor":"Next-Steps"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/GettingStarted","type":"reference","isActive":true},{"text":" - Quick start guide","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPCallDelegate"},{"type":"text","text":" - Full delegate reference"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"seeAlsoSections":[{"title":"Getting Started","identifiers":["doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/GettingStarted"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshvoip\/examples"]},{"paths":["\/documentation\/pushwooshvoip\/examples"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/Examples"},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP"]]},"references":{"doc://com.pushwoosh.PushwooshVoIP/documentation/PushwooshVoIP/PWVoIPHandleType":{"url":"\/documentation\/pushwooshvoip\/pwvoiphandletype","type":"topic","navigatorTitle":[{"kind":"identifier","text":"PWVoIPHandleType"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPHandleType","abstract":[{"text":"Display format for caller information in CallKit UI.","type":"text"}],"title":"PWVoIPHandleType","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PWVoIPHandleType"}],"role":"symbol"},"doc://com.pushwoosh.PushwooshVoIP/documentation/PushwooshVoIP/PWVoIPCallDelegate":{"url":"\/documentation\/pushwooshvoip\/pwvoipcalldelega