{"metadata":{"roleHeading":"Instance Method","modules":[{"name":"PushwooshVoIP"}],"required":true,"role":"symbol","title":"voipDidCancelCall(voipMessage:)","externalID":"c:@M@PushwooshVoIP@objc(pl)PWVoIPCallDelegate(im)voipDidCancelCallWithVoipMessage:","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"voipDidCancelCall","kind":"identifier"},{"text":"(","kind":"text"},{"text":"voipMessage","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@M@PushwooshVoIP@objc(cs)PWVoIPMessage","text":"PWVoIPMessage","kind":"typeIdentifier"},{"text":")","kind":"text"}],"navigatorTitle":[{"text":"voipDidCancelCallWithVoipMessage:","kind":"identifier"}]},"abstract":[{"type":"text","text":"Called when a call is remotely cancelled via VoIP push before the user answers."}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP","doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPCallDelegate"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPCallDelegate\/voipDidCancelCall(voipMessage:)"},"variants":[{"paths":["\/documentation\/pushwooshvoip\/pwvoipcalldelegate\/voipdidcancelcall(voipmessage:)"],"traits":[{"interfaceLanguage":"swift"}]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshvoip\/pwvoipcalldelegate\/voipdidcancelcall(voipmessage:)"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"optional"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"voipDidCancelCall","kind":"identifier"},{"text":"(","kind":"text"},{"text":"voipMessage","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PWVoIPMessa