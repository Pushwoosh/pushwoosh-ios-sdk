 optional delegate method. If not implemented, the SDK will still automatically dismiss the CallKit UI."}]}],"type":"aside","name":"Note","style":"note"},{"type":"aside","style":"important","content":[{"inlineContent":[{"text":"Cancellation only works for calls that haven’t been answered yet. Once answered, cancellation requests are ignored.","type":"text"}],"type":"paragraph"}],"name":"Important"}],"kind":"content"}],"sections":[],"references":{"doc://com.pushwoosh.PushwooshVoIP/documentation/PushwooshVoIP":{"type":"topic","title":"PushwooshVoIP","abstract":[{"type":"text","text":"VoIP push notifications with native call UI for iOS applications."}],"role":"collection","identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP","kind":"symbol","url":"\/documentation\/pushwooshvoip"},"doc://com.pushwoosh.PushwooshVoIP/documentation/PushwooshVoIP/PWVoIPCallDelegate":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PWVoIPCallDelegate"}],"type":"topic","navigatorTitle":[{"text":"PWVoIPCallDelegate","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPCallDelegate","title":"PWVoIPCallDelegate","url":"\/documentation\/pushwooshvoip\/pwvoipcalldelegate","abstract":[{"type":"text","text":"Delegate protocol for receiving VoIP call events and CallKit callbacks."}]},"doc://com.pushwoosh.PushwooshVoIP/documentation/PushwooshVoIP/PWVoIPCallDelegate/voipDidCancelCall(voipMessage:)":{"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"voipDidCancelCall"},{"kind":"text","text":"("},{"text":"voipMessage","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"PWVoIPMessage","preciseIdentifier":"c:@M@PushwooshVoIP@objc(cs)PWVoIPMessage"},{"kind":"text","text":")"}],"navigatorTitle":[{"kind":"iden