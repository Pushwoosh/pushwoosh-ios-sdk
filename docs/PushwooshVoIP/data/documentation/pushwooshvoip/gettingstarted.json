{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Installation","text":"Installation","type":"heading"},{"type":"tabNavigator","tabs":[{"title":"Swift Package Manager","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, use the following URL to add the Pushwoosh dependency:"}]},{"code":["https:\/\/github.com\/Pushwoosh\/Pushwoosh-XCFramework"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"Select the required modules in your target:"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-voip-1.png"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Important","type":"text"}]},{"text":": The modules PushwooshFramework, PushwooshCore, PushwooshBridge, and PushwooshVoIP are required.","type":"text"}],"type":"paragraph"}]}]},{"title":"CocoaPods","content":[{"type":"paragraph","inlineContent":[{"text":"Add to your Podfile:","type":"text"}]},{"syntax":"ruby","type":"codeListing","code":["pod 'PushwooshXCFramework'","pod 'PushwooshXCFramework\/PushwooshVoIP'"]},{"inlineContent":[{"text":"Then run:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["pod install"],"syntax":"bash"}]}]},{"type":"heading","level":2,"anchor":"Prerequisites","text":"Prerequisites"},{"inlineContent":[{"text":"Before you begin, ensure you have:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A Pushwoosh account","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A Pushwoosh project set up in your account"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"An iOS platform configured in your Pushwoosh project. We recommend using the Token-Based Authentication configuration as the simplest approach","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Your Pushwoosh Application Code from the Control Panel","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"VoIP Services Certificate (.p12) created in Apple Developer Portal"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"iOS 15.0+ deployment target","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"PushwooshFramework, PushwooshCore, and PushwooshBridge frameworks integrated in your project"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The base Pushwoosh SDK set up with the same Application Code: "},{"type":"codeVoice","code":"Pushwoosh_APPID"},{"type":"text","text":" in "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" and a call to "},{"code":"Pushwoosh.configure.registerForPushNotifications()","type":"codeVoice"},{"text":". The VoIP token is attached to the device registered by the base SDK","type":"text"}],"type":"paragraph"}]}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note","type":"text"}]},{"text":": VoIP pushes use the same Pushwoosh application and Application Code as regular pushes. No separate VoIP application is needed.","type":"text"}],"type":"paragraph"}],"name":"Note"},{"level":2,"type":"heading","text":"Step 1: Add Required Capabilities","anchor":"Step-1-Add-Required-Capabilities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your target","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Go to "},{"type":"strong","inlineContent":[{"text":"Signing & Capabilities","type":"text"}]}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Click "},{"inlineContent":[{"type":"text","text":"+ Capability"}],"type":"strong"},{"type":"text","text":" and add "},{"inlineContent":[{"type":"text","text":"Push Notifications"}],"type":"strong"}]}]},{"content":[{"inlineContent":[{"text":"Click ","type":"text"},{"type":"strong","inlineContent":[{"text":"+ Capability","type":"text"}]},{"type":"text","text":" and add "},{"type":"strong","inlineContent":[{"text":"Background Modes","type":"text"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In Background Modes, enable "},{"type":"strong","inlineContent":[{"type":"text","text":"Remote notifications"}]},{"type":"text","text":" checkbox"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In Background Modes, enable ","type":"text"},{"type":"strong","inlineContent":[{"text":"Voice over IP","type":"text"}]},{"type":"text","text":" checkbox"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-voip-2.png"}]},{"level":2,"text":"Step 2: Set the Delegate","anchor":"Step-2-Set-the-Delegate","type":"heading"},{"inlineContent":[{"text":"The SDK sets up CallKit and PushKit and registers the VoIP token on its own at app launch. Set the delegate in ","type":"text"},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import UIKit","import PushwooshFramework","import PushwooshVoIP","import CallKit","import PushKit","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, PWVoIPCallDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        Pushwoosh.VoIP.delegate = self","        Pushwoosh.VoIP.setRingtone(\"mySound.caf\")","","        return true","    }","","    \/\/ MARK: - Required PWVoIPCallDelegate Callbacks","","    func voipDidReceiveIncomingCall(payload: PushwooshVoIP.PWVoIPMessage) {","        \/\/ Handle incoming VoIP push","    }","","    func pwProviderDidReset(_ provider: CXProvider) {","        \/\/ Handle provider reset","    }","","    func pwProviderDidBegin(_ provider: CXProvider) {","        \/\/ Handle provider activation","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"setRingtone(_:)"},{"type":"text","text":" is optional: it takes a sound file name from the app bundle and is saved across launches. Without it, CallKit plays the system ringtone."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Video support and the caller ID format are set per call in the push payload: "},{"code":"video","type":"codeVoice"},{"text":" (","type":"text"},{"type":"codeVoice","code":"true"},{"text":" for a video call) and ","type":"text"},{"type":"codeVoice","code":"handleType"},{"text":" (","type":"text"},{"type":"codeVoice","code":"1"},{"text":" – generic, ","type":"text"},{"code":"2","type":"codeVoice"},{"type":"text","text":" – phone number, "},{"code":"3","type":"codeVoice"},{"text":" – email; generic by default).","type":"text"}],"type":"paragraph"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"inlineContent":[{"text":"Note","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"type":"codeVoice","code":"initializeVoIP(_:ringtoneSound:handleTypes:)"},{"text":" is deprecated. It only sets the ringtone, and its ","type":"text"},{"type":"codeVoice","code":"supportVideo"},{"type":"text","text":" and "},{"code":"handleTypes","type":"codeVoice"},{"type":"text","text":" parameters are ignored. Use "},{"code":"setRingtone(_:)","type":"codeVoice"},{"type":"text","text":" instead."}],"type":"paragraph"}]},{"level":2,"text":"Step 3: Delegate Methods","type":"heading","anchor":"Step-3-Delegate-Methods"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPCallDelegate","isActive":true,"type":"reference"},{"type":"text","text":" protocol provides callbacks for VoIP events:"}]},{"header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"voipDidReceiveIncomingCall(payload:)"}]}],[{"inlineContent":[{"text":"Called when VoIP push arrives with call information","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"pwProviderDidReset(_:)","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Called when CallKit provider resets (end all active calls here)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"pwProviderDidBegin(_:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Called when CallKit provider is ready"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"voipDidRegisterTokenSuccessfully()"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optional. Called when the VoIP token is registered with Pushwoosh","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"voipDidFailToRegisterToken(error:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Optional. Called when VoIP token registration fails. This is the only place the registration error is reported"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"Step-4-Upload-VoIP-Certificate","type":"heading","text":"Step 4: Upload VoIP Certificate","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Create VoIP Services Certificate in Apple Developer Portal"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Export as .p12 file"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"In Pushwoosh Control Panel, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"Settings → Configure platforms"}]},{"text":", find ","type":"text"},{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"type":"text","text":", and select "},{"inlineContent":[{"text":"VoIP push notifications","type":"text"}],"type":"strong"},{"text":" in the dropdown","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Upload the .p12 certificate and enter its private key password"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Under ","type":"text"},{"inlineContent":[{"type":"text","text":"Gateway"}],"type":"strong"},{"type":"text","text":", select "},{"inlineContent":[{"text":"Sandbox","type":"text"}],"type":"strong"},{"type":"text","text":" for development builds or "},{"inlineContent":[{"type":"text","text":"Production"}],"type":"strong"},{"text":" for App Store and TestFlight builds","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"inlineContent":[{"type":"text","text":"VoIP pushes only work on physical devices. Simulator is not supported."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Build and run your app on a physical device, then send a test VoIP push from the Pushwoosh Control Panel."}],"type":"paragraph"},{"anchor":"Next-Steps","level":2,"text":"Next Steps","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/Examples","isActive":true,"type":"reference"},{"text":" - Code examples for common use cases","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPCallDelegate","type":"reference","isActive":true},{"text":" - Full protocol reference","type":"text"}]}]}]}]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/GettingStarted","interfaceLanguage":"swift"},"metadata":{"title":"Getting Started","roleHeading":"Article","modules":[{"name":"Pushw