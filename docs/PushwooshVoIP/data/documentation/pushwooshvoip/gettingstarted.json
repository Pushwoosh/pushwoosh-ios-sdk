{"primaryContentSections":[{"content":[{"text":"Installation","level":2,"type":"heading","anchor":"Installation"},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, use the following URL to add the Pushwoosh dependency:"}],"type":"paragraph"},{"syntax":null,"code":["https:\/\/github.com\/Pushwoosh\/Pushwoosh-XCFramework"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Select the required modules in your target:"}],"type":"paragraph"},{"inlineContent":[{"identifier":"ios-voip-1.png","type":"image"}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Important"}],"type":"strong"},{"type":"text","text":": The modules PushwooshFramework, PushwooshCore, PushwooshBridge, and PushwooshVoIP are required."}]}],"type":"aside"}],"title":"Swift Package Manager"},{"content":[{"inlineContent":[{"text":"Add to your Podfile:","type":"text"}],"type":"paragraph"},{"syntax":"ruby","code":["pod 'PushwooshXCFramework'","pod 'PushwooshXCFramework\/PushwooshVoIP'"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then run:"}]},{"code":["pod install"],"type":"codeListing","syntax":"bash"}],"title":"CocoaPods"}]},{"anchor":"Prerequisites","text":"Prerequisites","type":"heading","level":2},{"inlineContent":[{"text":"Before you begin, ensure you have:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Pushwoosh account"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Pushwoosh project set up in your account"}]}]},{"content":[{"inlineContent":[{"text":"An iOS platform configured in your Pushwoosh project. We recommend using the Token-Based Authentication configuration as the simplest approach","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your Pushwoosh Application Code from the Control Panel"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"VoIP Services Certificate (.p12) created in Apple Developer Portal","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"iOS 15.0+ deployment target","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"PushwooshFramework, PushwooshCore, and PushwooshBridge frameworks integrated in your project","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The base Pushwoosh SDK set up with the same Application Code: ","type":"text"},{"code":"Pushwoosh_APPID","type":"codeVoice"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" and a call to "},{"type":"codeVoice","code":"Pushwoosh.configure.registerForPushNotifications()"},{"text":". The VoIP token is attached to the device registered by the base SDK","type":"text"}]}]}],"type":"unorderedList"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Note","type":"text"}],"type":"strong"},{"type":"text","text":": VoIP pushes use the same Pushwoosh application and Application Code as regular pushes. No separate VoIP application is needed."}]}]},{"text":"Step 1: Add Required Capabilities","type":"heading","anchor":"Step-1-Add-Required-Capabilities","level":2},{"inlineContent":[{"text":"In Xcode:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your target"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to "},{"inlineContent":[{"type":"text","text":"Signing & Capabilities"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click ","type":"text"},{"type":"strong","inlineContent":[{"text":"+ Capability","type":"text"}]},{"type":"text","text":" and add "},{"inlineContent":[{"text":"Push Notifications","type":"text"}],"type":"strong"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Click "},{"type":"strong","inlineContent":[{"text":"+ Capability","type":"text"}]},{"type":"text","text":" and add "},{"type":"strong","inlineContent":[{"text":"Background Modes","type":"text"}]}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In Background Modes, enable ","type":"text"},{"type":"strong","inlineContent":[{"text":"Remote notifications","type":"text"}]},{"text":" checkbox","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Background Modes, enable "},{"inlineContent":[{"type":"text","text":"Voice over IP"}],"type":"strong"},{"type":"text","text":" checkbox"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-voip-2.png"}]},{"type":"heading","text":"Step 2: Set the Delegate","level":2,"anchor":"Step-2-Set-the-Delegate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK sets up CallKit and PushKit and registers the VoIP token on its own at app launch. Set the delegate in "},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["import UIKit","import PushwooshFramework","import PushwooshVoIP","import CallKit","import PushKit","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, PWVoIPCallDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        Pushwoosh.VoIP.delegate = self","        Pushwoosh.VoIP.setRingtone(\"mySound.caf\")","","        return true","    }","","    \/\/ MARK: - Required PWVoIPCallDelegate Callbacks","","    func voipDidReceiveIncomingCall(payload: PushwooshVoIP.PWVoIPMessage) {","        \/\/ Handle incoming VoIP push","    }","","    func pwProviderDidReset(_ provider: CXProvider) {","        \/\/ Handle provider reset","    }","","    func pwProviderDidBegin(_ provider: CXProvider) {","        \/\/ Handle provider activation","    }","}"],"syntax":"swift"},{"inlineContent":[{"code":"setRingtone(_:)","type":"codeVoice"},{"type":"text","text":" is optional: it takes a sound file name from the app bundle and is saved across launches. Without it, CallKit plays the system ringtone."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Video support and the caller ID format are set per call in the push payload: "},{"type":"codeVoice","code":"video"},{"text":" (","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":" for a video call) and "},{"code":"handleType","type":"codeVoice"},{"text":" (","type":"text"},{"type":"codeVoice","code":"1"},{"text":" – generic, ","type":"text"},{"type":"codeVoice","code":"2"},{"type":"text","text":" – phone number, "},{"type":"codeVoice","code":"3"},{"type":"text","text":" – email; generic by default)."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Note","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"initializeVoIP(_:ringtoneSound:handleTypes:)","type":"codeVoice"},{"text":" is deprecated. It only sets the ringtone, and its ","type":"text"},{"type":"codeVoice","code":"supportVideo"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"handleTypes"},{"type":"text","text":" parameters are ignored. Use "},{"code":"setRingtone(_:)","type":"codeVoice"},{"text":" instead.","type":"text"}]}],"name":"Note","style":"note"},{"type":"heading","anchor":"Step-3-Delegate-Methods","text":"Step 3: Delegate Methods","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPCallDelegate","isActive":true},{"text":" protocol provides callbacks for VoIP events:","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"voipDidReceiveIncomingCall(payload:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Called when VoIP push arrives with call information"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pwProviderDidReset(_:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Called when CallKit provider resets (end all active calls here)","type":"text"}]}]],[[{"inlineContent":[{"code":"pwProviderDidBegin(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Called when CallKit provider is ready","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"voipDidRegisterTokenSuccessfully()"}]}],[{"inlineContent":[{"text":"Optional. Called when the VoIP token is registered with Pushwoosh","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"voipDidFailToRegisterToken(error:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional. Called when VoIP token registration fails. This is the only place the registration error is reported"}]}]]],"header":"row"},{"level":2,"text":"Step 4: Upload VoIP Certificate","type":"heading","anchor":"Step-4-Upload-VoIP-Certificate"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Create VoIP Services Certificate in Apple Developer Portal","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Export as .p12 file"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In Pushwoosh Control Panel, go to ","type":"text"},{"inlineContent":[{"type":"text","text":"Settings → Configure platforms"}],"type":"strong"},{"text":", find ","type":"text"},{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"type":"text","text":", and select "},{"inlineContent":[{"text":"VoIP push notifications","type":"text"}],"type":"strong"},{"text":" in the dropdown","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Upload the .p12 certificate and enter its private key password"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Under "},{"type":"strong","inlineContent":[{"text":"Gateway","type":"text"}]},{"type":"text","text":", select "},{"type":"strong","inlineContent":[{"text":"Sandbox","type":"text"}]},{"type":"text","text":" for development builds or "},{"type":"strong","inlineContent":[{"text":"Production","type":"text"}]},{"type":"text","text":" for App Store and TestFlight builds"}]}]}]},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"VoIP pushes only work on physical devices. Simulator is not supported."}]},{"inlineContent":[{"text":"Build and run your app on a physical device, then send a test VoIP push from the Pushwoosh Control Panel.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Next Steps","anchor":"Next-Steps","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/Examples","type":"reference","isActive":true},{"text":" - Code examples for common use cases","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPCallDelegate","isActive":true},{"text":" - Full protocol reference","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Getting Started","role":"article","modules":[{"name":"PushwooshVoIP"}]},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP"]]},"sections