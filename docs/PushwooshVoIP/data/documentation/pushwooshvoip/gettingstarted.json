unchingWithOptions:)","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import UIKit","import PushwooshFramework","import PushwooshVoIP","import CallKit","import PushKit","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, PWVoIPCallDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        Pushwoosh.VoIP.delegate = self","        Pushwoosh.VoIP.setRingtone(\"mySound.caf\")","","        return true","    }","","    \/\/ MARK: - Required PWVoIPCallDelegate Callbacks","","    func voipDidReceiveIncomingCall(payload: PushwooshVoIP.PWVoIPMessage) {","        \/\/ Handle incoming VoIP push","    }","","    func pwProviderDidReset(_ provider: CXProvider) {","        \/\/ Handle provider reset","    }","","    func pwProviderDidBegin(_ provider: CXProvider) {","        \/\/ Handle provider activation","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setRingtone(_:)"},{"type":"text","text":" is optional: it takes a sound file name from the app bundle and is saved across launches. Without it, CallKit plays the system ringtone."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Video support and the caller ID format are set per call in the push payload: "},{"code":"video","type":"codeVoice"},{"type":"text","text":" ("},{"code":"true","type":"codeVoice"},{"text":" for a video call) and ","type":"text"},{"type":"codeVoice","code":"handleType"},{"text":" (","type":"text"},{"code":"1","type":"codeVoice"},{"text":" – generic, ","type":"text"},{"code":"2","type":"codeVoice"},{"text":" – phone number, ","type":"text"},{"type":"codeVoice","code":"3"},{"type":"text","text":" – email; generic by default)."}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note","type":"text"}]},{"text":": ","type":"text"},{"code":"initializeVoIP(_:ringtoneSound:handleTypes:)","type":"codeVoice"},{"text":" is deprecated. It only sets the ringtone, and its ","type":"text"},{"type":"codeVoice","code":"supportVideo"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleTypes"},{"type":"text","text":" parameters are ignored. Use "},{"type":"codeVoice","code":"setRingtone(_:)"},{"text":" instead.","type":"text"}],"type":"paragraph"}],"style":"note"},{"level":2,"text":"Step 3: Delegate Methods","type":"heading","anchor":"Step-3-Delegate-Methods"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshVoIP\/documentation\/PushwooshVoIP\/PWVoIPCallDelegate","type":"reference","isActive":true},{"text":" protocol provides callbacks for VoIP events:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"inlineContent":[{"code":"voipDidReceiveIncomingCall(payload:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Called when VoIP push arrives with call information","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"pwProviderDidReset(_:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Called when CallKit provider resets (end all active calls here)","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"pwProviderDidBegin(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Called when CallKit provider is ready"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"voipDidRegisterTokenSuccessfully()"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optional. Called when the VoIP token is registered with Pushwoosh","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"voipDidFailToRegisterToken(er