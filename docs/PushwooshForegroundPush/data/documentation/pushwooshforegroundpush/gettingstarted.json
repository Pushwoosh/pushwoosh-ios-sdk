        _ application: UIApplication,","        didFailToRegisterForRemoteNotificationsWithError error: Error","    ) {","        print(\"Failed to register for remote notifications: \\(error)\")","    }","","    \/\/ MARK: - PWForegroundPushDelegate","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push tapped: \\(userInfo)\")","    }","}"]},{"anchor":"Configuration-Parameters","level":3,"type":"heading","text":"Configuration Parameters"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Parameter","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"style"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PWForegroundPushStyle"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Visual template for the notification. Currently only "},{"type":"codeVoice","code":".style1"},{"type":"text","text":" is available"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"duration"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int"}]}],[{"inlineContent":[{"type":"text","text":"Display time in seconds"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"vibration","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"PWForegroundPushHapticFeedback","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Haptic feedback type:"},{"type":"text","text":"• "},{"type":"codeVoice","code":".none"},{"type":"text","text":" – No vibration"},{"type":"text","text":"• "},{"type":"codeVoice","code":".light"},{"type":"text","text":" – Subtle feedback"},{"text":"• ","type":"text"},{"code":".medium","type":"codeVoice"},{"type":"text","text":" – Standard feedback"},{"text":"• ","type":"text"},{"code":".heavy","type":"codeVoice"},{"type":"text","text":" – Strong feedback"},{"text":"• ","type":"text"},{"code":".soft","type":"codeVoice"},{"text":" – Gentle feedback","type":"text"},{"type":"text","text":"• "},{"type":"codeVoice","code":".rigid"},{"text":" – Sharp feedback","type":"text"},{"type":"text","text":"• "},{"type":"codeVoice","code":".notification"},{"type":"text","text":" – System notification feedback"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"disappearedPushAnimation","type":"codeVoice"}]}],[{"inlineContent":[{"type":"codeVoice","code":"PWForegroundPushDisappearedAnimation"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Exit animation:","type":"text"},{"text":"• ","type":"text"},{"code":".balls","type":"codeVoice"},{"text":" – Explodes into particles","type":"text"},{"text":"• ","type":"text"},{"type":"codeVoice","code":".regularPush"},{"type":"text","text":" – Slides up and fades"}]}]]]},{"text":"Delegate Methods","anchor":"Delegate-Methods","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPush\/PWForegroundPushDelegate","isActive":true},{"text":" protocol provides callbacks for foreground push events:","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"didTapForegroundPush(_:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Called when user taps on the foreground push notification"}]}]]],"type":"table"},{"type":"heading","anchor":"Customization","level":2,"text":"Customization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure appearance globally using static properties:"}]},{"code":["Pushwoosh.Foreground