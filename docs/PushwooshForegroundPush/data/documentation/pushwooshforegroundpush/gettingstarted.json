{"primaryContentSections":[{"content":[{"text":"Prerequisites","anchor":"Prerequisites","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Before you begin, ensure you have:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A Pushwoosh account","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"A Pushwoosh project set up in your account","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An iOS platform configured in your Pushwoosh project. We recommend using the Token-Based Authentication configuration as the simplest approach","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Your Pushwoosh Application Code from the Control Panel","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"iOS 15.0+ deployment target","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pushwoosh SDK version 6.10.0 or higher"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"PushwooshFramework, PushwooshCore, and PushwooshBridge frameworks integrated in your project","type":"text"}]}]}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Important","type":"text"}],"type":"strong"},{"text":": PushwooshForegroundPush requires the main Pushwoosh SDK to be properly configured for push notifications.","type":"text"}]}]},{"text":"Step 1: Disable Native Alerts","type":"heading","level":2,"anchor":"Step-1-Disable-Native-Alerts"},{"inlineContent":[{"type":"text","text":"Add the following key to your "},{"code":"Info.plist","type":"codeVoice"},{"text":" file to disable native iOS system alerts:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"xml","code":["<key>Pushwoosh_SHOW_ALERT<\/key>","<false\/>"]},{"inlineContent":[{"type":"text","text":"This allows PushwooshForegroundPush to display custom foreground notifications instead of system alerts."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 2: Install Module","anchor":"Step-2-Install-Module"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, use the following URL to add the Pushwoosh dependency:"}]},{"syntax":null,"code":["https:\/\/github.com\/Pushwoosh\/Pushwoosh-XCFramework"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Select the required modules in your target:","type":"text"}]},{"inlineContent":[],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Important"}]},{"type":"text","text":": The modules PushwooshFramework, PushwooshCore, PushwooshBridge, PushwooshForegroundPush, and PushwooshLiveActivities are required."}]}],"type":"aside"}],"title":"Swift Package Manager"},{"title":"CocoaPods","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add to your Podfile:"}]},{"code":["pod 'PushwooshXCFramework'","pod 'PushwooshFramework\/PushwooshForegroundPush'"],"type":"codeListing","syntax":"ruby"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then run:"}]},{"code":["pod install"],"type":"codeListing","syntax":"bash"}]}],"type":"tabNavigator"},{"type":"heading","level":2,"text":"Step 3: Add Required Capabilities","anchor":"Step-3-Add-Required-Capabilities"},{"inlineContent":[{"type":"text","text":"In Xcode:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select your target","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Go to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Signing & Capabilities"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Click "},{"inlineContent":[{"text":"+ Capability","type":"text"}],"type":"strong"},{"type":"text","text"