","type":"codeVoice"},{"type":"text","text":" – Strong feedback"},{"type":"text","text":"• "},{"type":"codeVoice","code":".soft"},{"type":"text","text":" – Gentle feedback"},{"text":"• ","type":"text"},{"type":"codeVoice","code":".rigid"},{"text":" – Sharp feedback","type":"text"},{"text":"• ","type":"text"},{"type":"codeVoice","code":".notification"},{"type":"text","text":" – System notification feedback"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"disappearedPushAnimation","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"PWForegroundPushDisappearedAnimation","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Exit animation:","type":"text"},{"text":"• ","type":"text"},{"code":".balls","type":"codeVoice"},{"text":" – Explodes into particles","type":"text"},{"type":"text","text":"• "},{"type":"codeVoice","code":".regularPush"},{"type":"text","text":" – Slides up and fades"}]}]]]},{"anchor":"Delegate-Methods","type":"heading","level":3,"text":"Delegate Methods"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPush\/PWForegroundPushDelegate","type":"reference","isActive":true},{"text":" protocol provides callbacks for foreground push events:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"didTapForegroundPush(_:)","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Called when user taps on the foreground push notification","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":2,"anchor":"Customization","text":"Customization","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Configure appearance globally using static properties:","type":"text"}]},{"syntax":"swift","type":"code