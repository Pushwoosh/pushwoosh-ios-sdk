{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Prerequisites","text":"Prerequisites","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Before you begin, ensure you have:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Pushwoosh account"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A Pushwoosh project set up in your account"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An iOS platform configured in your Pushwoosh project. We recommend using the Token-Based Authentication configuration as the simplest approach","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your Pushwoosh Application Code from the Control Panel"}]}]},{"content":[{"inlineContent":[{"text":"iOS 15.0+ deployment target","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pushwoosh SDK version 6.10.0 or higher"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"PushwooshFramework, PushwooshCore, and PushwooshBridge frameworks integrated in your project"}],"type":"paragraph"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Important"}]},{"type":"text","text":": PushwooshForegroundPush requires the main Pushwoosh SDK to be properly configured for push notifications."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"type":"heading","anchor":"Step-1-Disable-Native-Alerts","text":"Step 1: Disable Native Alerts","level":2},{"inlineContent":[{"text":"Add the following key to your ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" file to disable native iOS system alerts:"}],"type":"paragraph"},{"syntax":"xml","type":"codeListing","code":["<key>Pushwoosh_SHOW_ALERT<\/key>","<false\/>"]},{"type":"paragraph","inlineContent":[{"text":"This allows PushwooshForegroundPush to display custom foreground notifications instead of system alerts.","type":"text"}]},{"text":"Step 2: Install Module","level":2,"anchor":"Step-2-Install-Module","type":"heading"},{"type":"tabNavigator","tabs":[{"title":"Swift Package Manager","content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, use the following URL to add the Pushwoosh dependency:","type":"text"}]},{"code":["https:\/\/github.com\/Pushwoosh\/Pushwoosh-XCFramework"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Select the required modules in your target:"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[]},{"name":"Note","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Important"}],"type":"strong"},{"text":": The modules PushwooshFramework, PushwooshCore, PushwooshBridge, PushwooshForegroundPush, and PushwooshLiveActivities are required.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add to your Podfile:"}],"type":"paragraph"},{"type":"codeListing","code":["pod 'PushwooshXCFramework'","pod 'PushwooshFramework\/PushwooshForegroundPush'"],"syntax":"ruby"},{"inlineContent":[{"text":"Then run:","type":"text"}],"type":"paragraph"},{"syntax":"bash","code":["pod install"],"type":"codeListing"}],"title":"CocoaPods"}]},{"type":"heading","anchor":"Step-3-Add-Required-Capabilities","text":"Step 3: Add Required Capabilities","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your target"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Go to "},{"type":"strong","inlineContent":[{"type":"text","text":"Signing & Capabilities"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Click "},{"inlineContent":[{"type":"text","text":"+ Capability"}],"type":"strong"},{"type":"text","text":" and add "},{"inlineContent":[{"text":"Push Notifications","type":"text"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Click "},{"type":"strong","inlineContent":[{"type":"text","text":"+ Capability"}]},{"type":"text","text":" and add "},{"inlineContent":[{"type":"text","text":"Background Modes"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Background Modes, enable "},{"inlineContent":[{"text":"Remote notifications","type":"text"}],"type":"strong"},{"text":" checkbox","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[]},{"text":"Step 4: Configure Foreground Push","type":"heading","level":2,"anchor":"Step-4-Configure-Foreground-Push"},{"type":"paragraph","inlineContent":[{"text":"Configure foreground push and set delegate in ","type":"text"},{"code":"application(_:didFinishLaunchingWithOptions:)","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["import UIKit","import PushwooshFramework","import PushwooshForegroundPush","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        Pushwoosh.ForegroundPush.foregroundNotificationWith(","            style: .style1,","            duration: 5,","            vibration: .notification,","            disappearedPushAnimation: .balls","        )","","        Pushwoosh.ForegroundPush.delegate = self","","        return true","    }","","    \/\/ MARK: - Push Notification Registration","","    func application(","        _ application: UIApplication,","        didRegisterForRemoteNotificationsWithDeviceToken deviceToken: Data","    ) {","        Pushwoosh.configure.handlePushRegistration(deviceToken)","    }","","    func application(","        _ application: UIApplication,","        didFailToRegisterForRemoteNotificationsWithError error: Error","    ) {","        print(\"Failed to register for remote notifications: \\(error)\")","    }","","    \/\/ MARK: - PWForegroundPushDelegate","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push tapped: \\(userInfo)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"Configuration-Parameters","text":"Configuration Parameters"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Parameter","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"style"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"PWForegroundPushStyle","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Visual template for the notification. Currently only ","type":"text"},{"code":".style1","type":"codeVoice"},{"type":"text","text":" is available"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"duration","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Int"}]}],[{"type":"paragraph","inlineContent":[{"text":"Display time in seconds","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"vibration"}]}],[{"inlineContent":[{"code":"PWForegroundPushHapticFeedback","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Haptic feedback type:"},{"type":"text","text":"• "},{"code":".none","type":"codeVoice"},{"type":"text","text":" – No vibration"},{"text":"• ","type":"text"},{"type":"codeVoice","code":".light"},{"text":" – Subtle feedback","type":"text"},{"type":"text","text":"• "},{"code":".medium","type":"codeVoice"},{"type":"text","text":" – Standard feedback"},{"text"