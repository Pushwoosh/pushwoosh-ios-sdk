{"primaryContentSections":[{"content":[{"type":"heading","text":"Prerequisites","level":2,"anchor":"Prerequisites"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before you begin, ensure you have:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"A Pushwoosh account"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A Pushwoosh project set up in your account","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"An iOS platform configured in your Pushwoosh project. We recommend using the Token-Based Authentication configuration as the simplest approach"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Your Pushwoosh Application Code from the Control Panel","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"iOS 14.0+ deployment target"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pushwoosh SDK version 6.10.0 or higher","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"PushwooshFramework, PushwooshCore, and PushwooshBridge frameworks integrated in your project","type":"text"}],"type":"paragraph"}]}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Important"}],"type":"strong"},{"text":": PushwooshForegroundPush requires the main Pushwoosh SDK to be properly configured for push notifications.","type":"text"}]}],"style":"note","type":"aside"},{"level":2,"text":"Step 1: Disable Native Alerts","anchor":"Step-1-Disable-Native-Alerts","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the following key to your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" file to disable native iOS system alerts:"}]},{"type":"codeListing","syntax":"xml","code":["<key>Pushwoosh_SHOW_ALERT<\/key>","<false\/>"]},{"inlineContent":[{"type":"text","text":"This allows PushwooshForegroundPush to display custom foreground notifications instead of system alerts."}],"type":"paragraph"},{"text":"Step 2: Install Module","anchor":"Step-2-Install-Module","type":"heading","level":2},{"tabs":[{"title":"Swift Package Manager","content":[{"inlineContent":[{"text":"In Xcode, use the following URL to add the Pushwoosh dependency:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["https:\/\/github.com\/Pushwoosh\/Pushwoosh-XCFramework"],"syntax":null},{"inlineContent":[{"type":"text","text":"Select the required modules in your target:"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Important","type":"text"}]},{"type":"text","text":": The modules PushwooshFramework, PushwooshCore, PushwooshBridge, PushwooshForegroundPush, and PushwooshLiveActivities are required."}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add to your Podfile:","type":"text"}]},{"code":["pod 'PushwooshXCFramework'","pod 'PushwooshFramework\/PushwooshForegroundPush'"],"type":"codeListing","syntax":"ruby"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then run:"}]},{"type":"codeListing","syntax":"bash","code":["pod install"]}],"title":"CocoaPods"}],"type":"tabNavigator"},{"level":2,"text":"Step 3: Add Required Capabilities","type":"heading","anchor":"Step-3-Add-Required-Capabilities"},{"inlineContent":[{"type":"text","text":"In Xcode:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your target"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Go to ","type":"text"},{"inlineContent":[{"type":"text","text":"Signing & Capabilities"}],"type":"strong"}]}]},{"content":[{"inlineContent":[{"text":"Click ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"+ Capability"}]},{"type":"text","text"