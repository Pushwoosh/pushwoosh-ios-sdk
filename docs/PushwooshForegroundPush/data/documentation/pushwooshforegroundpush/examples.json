{"abstract":[{"text":"Practical examples for common foreground push notification scenarios.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide provides working code examples for customizing PushwooshForegroundPush appearance, animations, and user interactions."}],"type":"paragraph"},{"level":2,"text":"Basic Setup","anchor":"Basic-Setup","type":"heading"},{"level":3,"anchor":"Minimal-Configuration","text":"Minimal Configuration","type":"heading"},{"inlineContent":[{"type":"text","text":"The simplest configuration with default appearance:"}],"type":"paragraph"},{"code":["import UIKit","import PushwooshFramework","import PushwooshForegroundPush","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        Pushwoosh.ForegroundPush.foregroundNotificationWith(","            style: .style1,","            duration: 5,","            vibration: .notification,","            disappearedPushAnimation: .balls","        )","","        Pushwoosh.ForegroundPush.delegate = self","","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push: \\(userInfo)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Appearance-Customization","level":2,"type":"heading","text":"Appearance Customization"},{"text":"Custom Gradient Background","level":3,"type":"heading","anchor":"Custom-Gradient-Background"},{"type":"paragraph","inlineContent":[{"text":"Create a vibrant gradient background with custom text colors:","type":"text"}]},{"code":["Pushwoosh.ForegroundPush.gradientColors = [.red, .orange, .yellow]","Pushwoosh.ForegroundPush.titlePushColor = .white","Pushwoosh.ForegroundPush.messagePushColor = .white"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-3.gif","type":"image"}]},{"anchor":"Solid-Background-Color","text":"Solid Background Color","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a solid color instead of gradient:"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.backgroundColor = UIColor(red: 0.1, green: 0.1, blue: 0.1, alpha: 0.95)","Pushwoosh.ForegroundPush.gradientColors = nil"]},{"type":"heading","text":"Custom Fonts","anchor":"Custom-Fonts","level":3},{"type":"paragraph","inlineContent":[{"text":"Use custom fonts for title and message:","type":"text"}]},{"code":["Pushwoosh.ForegroundPush.backgroundColor = .systemPurple","Pushwoosh.ForegroundPush.titlePushFont = UIFont(name: \"YourCustomFont-Bold\", size: 18)","Pushwoosh.ForegroundPush.messagePushFont = UIFont(name: \"YourCustomFont-Regular\", size: 15)","Pushwoosh.ForegroundPush.titlePushColor = .white","Pushwoosh.ForegroundPush.messagePushColor = .white"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"ios-foreground-custom-4.gif","type":"image"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Rich-Media-Support","text":"Rich Media Support"},{"level":3,"anchor":"Push-with-Image-Attachment","type":"heading","text":"Push with Image Attachment"},{"inlineContent":[{"text":"Foreground push notifications support image attachments:","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-2.gif"}]},{"type":"heading","level":3,"text":"Push with GIF Attachment","anchor":"Push-with-GIF-Attachment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Animated GIF images are supported:"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-1.gif"}]},{"inlineContent":[{"text":"The attachment URL is specified in the push notification payload. The SDK automatically downloads and displays the media content.","type":"text"}],"type":"paragraph"},{"text":"Animation Customization","level":2,"anchor":"Animation-Customization","type":"heading"},{"anchor":"Disable-Entry-Animation","text":"Disable Entry Animation","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Show push instantly without slide animation:"}]},{"type":"codeListing","code":["Pushwoosh.ForegroundPush.usePushAnimation = false"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-4.gif"}]},{"type":"heading","text":"Particle Explosion Effect","anchor":"Particle-Explosion-Effect","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use particle explosion when push disappears:"}]},{"code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"],"type":"codeListing","syntax":"swift"},{"text":"Regular Push Animation","anchor":"Regular-Push-Animation","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use standard upward slide animation:"}]},{"code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .regularPush",")"],"type":"codeListing","syntax":"swift"},{"text":"Liquid Glass Effect (iOS 26+)","level":3,"type":"heading","anchor":"Liquid-Glass-Effect-iOS-26+"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable modern Liquid Glass visual effect:"}]},{"syntax":"swift","type":"codeListing","code":["Pushwoosh.ForegroundPush.useLiquidView = true"]},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-5.gif","type":"image"}]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Important"}],"type":"strong"},{"type":"text","text":": Liquid Glass requires iOS 26+ and Swift 5.13+. On earlier iOS versions, standard UIView-based notifications are displayed. Swift versions below 5.13 use blurred UIVisualEffectView."}]}]},{"anchor":"Haptic-Feedback-Options","level":2,"type":"heading","text":"Haptic Feedback Options"},{"text":"No Vibration","type":"heading","level":3,"anchor":"No-Vibration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For silent notifications:"}]},{"code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .none,","    disappearedPushAnimation: .balls",")"],"syntax":"swift","type":"codeListing"},{"text":"Strong Haptic","type":"heading","level":3,"anchor":"Strong-Haptic"},{"inlineContent":[{"type":"text","text":"For important notifications:"}],"type":"paragraph"},{"type":"codeListing","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 7,","    vibration: .heavy,","    disappearedPushAnimation: .balls",")"],"syntax":"swift"},{"level":3,"type":"heading","text":"System Notification Haptic","anchor":"System-Notification-Haptic"},{"type":"paragraph","inlineContent":[{"text":"Use system notification-style haptic:","type":"text"}]},{"code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Handling User Interactions","anchor":"Handling-User-Interactions"},{"text":"Implementing Delegate","anchor":"Implementing-Delegate","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Handle user taps through the delegate method:"}],"type":"paragraph"},{"syntax":"swift","code":["class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","        Pushwoosh.ForegroundPush.delegate = self","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push tapped: \\(userInfo)\")","","        if let customData = userInfo[\"custom\"] as? [String: Any],","           let screenId = customData[\"screen_id\"] as? String {","            navigateToScreen(screenId)","        }","    }","}"],"type":"codeListing"},{"text":"Deep Link Handling","level":3,"anchor":"Deep-Link-Handling","type":"heading"},{"inlineContent":[{"type":"text","text":"Handle deep links from push notifications:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","    if let deepLink = userInfo[\"deep_link\"] as? String,","       let url = URL(string: deepLink) {","        UIApplication.shared.open(url, options: [:]) { success in","            print(\"Deep link opened: \\(success)\")","        }","    }","}"]},{"text":"Complete Custom Setup","type":"heading","level":2,"anchor":"Complete-Custom-Setup"},{"level":3,"text":"Branded Notification","type":"heading","anchor":"Branded-Notification"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Full customization with brand identity:"}]},{"code":["func configureBrandedForegroundPush() {","    Pushwoosh.ForegroundPush.gradientColors = [","        UIColor(red: 0.18, green: 0.31, blue: 0.64, alpha: 1.0),","        UIColor(red: 0.44, green: 0.26, blue: 0.63, alpha: 1.0)","    ]","","    Pushwoosh.ForegroundPush.titlePushColor = .white","    Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.95, alpha: 1.0)","","    Pushwoosh.ForegroundPush.titlePushFont = UIFont(name: \"Helvetica-Bold\", size: 18)","    Pushwoosh.ForegroundPush.messagePushFont = UIFont(name: \"Helvetica\", size: 15)","","    Pushwoosh.ForegroundPush.usePushAnimation = true","    Pushwoosh.ForegroundPush.useLiquidView = true","","    Pushwoosh.ForegroundPush.foregroundNotificationWith(","        style: .style1,","        duration: 6,","        vibration: .notification,","        disappearedPushAnimation: .balls","    )","","    Pushwoosh.ForegroundPush.delegate = self","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"anchor":"Dark-Mode-Support","text":"Dark Mode Support"},{"level":3,"anchor":"Adaptive-Colors","type":"heading","text":"Adaptive Colors"},{"inlineContent":[{"type":"text","text":"Adjust colors based on user interface style:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func configureForegroundPushColors() {","    if #available(iOS 13.0, *) {","        let isDarkMode = UITraitCollection.current.userInterfaceStyle == .dark","","        if isDarkMode {","            Pushwoosh.ForegroundPush.gradientColors = [","                UIColor(red: 0.15, green: 0.15, blue: 0.15, alpha: 1.0),","                UIColor(red: 0.25, green: 0.25, blue: 0.25, alpha: 1.0)","            ]","            Pushwoosh.ForegroundPush.titlePushColor = .white","            Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.85, alpha: 1.0)","        } else {","            Pushwoosh.ForegroundPush.gradientColors = [","                UIColor(red: 0.95, green: 0.95, blue: 0.95, alpha: 1.0),","                UIColor(red: 0.85, green: 0.85, blue: 0.85, alpha: 1.0)","            ]","            Pushwoosh.ForegroundPush.titlePushColor = .black","            Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.15, alpha: 1.0)","        }","    }","}"]},{"type":"heading","text":"Next Steps","anchor":"Next-Steps","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPu