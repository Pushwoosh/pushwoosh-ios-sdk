groundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"]},{"type":"heading","level":2,"text":"Handling User Interactions","anchor":"Handling-User-Interactions"},{"level":3,"type":"heading","anchor":"Implementing-Delegate","text":"Implementing Delegate"},{"type":"paragraph","inlineContent":[{"text":"Handle user taps through the delegate method:","type":"text"}]},{"code":["class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","        Pushwoosh.ForegroundPush.delegate = self","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push tapped: \\(userInfo)\")","","        if let customData = userInfo[\"custom\"] as? [String: Any],","           let screenId = customData[\"screen_id\"] as? String {","            navigateToScreen(screenId)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Deep Link Handling","level":3,"anchor":"Deep-Link-Handling","type":"heading"},{"inlineContent":[{"type":"text","text":"Handle deep links from push notifications:"}],"type":"paragraph"},{"code":["func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","    if let deepLink = userInfo[\"deep_link\"] as? String,","       let url = URL(string: deepLink) {","        UIApplication.shared.open(url, options: [:]) { success in","            print(\"Deep link opened: \\(success)\")","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Complete Custom Setup","type":"heading","anchor":"Complete-Custom-Setup"},{"text":"Branded Notification","level":3,"type":"heading","anchor":"Branded-Notification"},{"inlineContent":[{"text":"Full customization with brand identity:","type":"text