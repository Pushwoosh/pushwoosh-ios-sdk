{"kind":"article","hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPush"]]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This guide provides working code examples for customizing PushwooshForegroundPush appearance, animations, and user interactions.","type":"text"}]},{"level":2,"text":"Basic Setup","type":"heading","anchor":"Basic-Setup"},{"type":"heading","text":"Minimal Configuration","level":3,"anchor":"Minimal-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest configuration with default appearance:"}]},{"code":["import UIKit","import PushwooshFramework","import PushwooshForegroundPush","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        Pushwoosh.ForegroundPush.foregroundNotificationWith(","            style: .style1,","            duration: 5,","            vibration: .notification,","            disappearedPushAnimation: .balls","        )","","        Pushwoosh.ForegroundPush.delegate = self","","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push: \\(userInfo)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Appearance Customization","anchor":"Appearance-Customization","type":"heading"},{"text":"Custom Gradient Background","type":"heading","anchor":"Custom-Gradient-Background","level":3},{"inlineContent":[{"text":"Create a vibrant gradient background with custom text colors:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.gradientColors = [.red, .orange, .yellow]","Pushwoosh.ForegroundPush.titlePushColor = .white","Pushwoosh.ForegroundPush.messagePushColor = .white"]},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-3.gif","type":"image"}]},{"level":3,"type":"heading","anchor":"Solid-Background-Color","text":"Solid Background Color"},{"inlineContent":[{"text":"Use a solid color instead of gradient:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["Pushwoosh.ForegroundPush.backgroundColor = UIColor(red: 0.1, green: 0.1, blue: 0.1, alpha: 0.95)","Pushwoosh.ForegroundPush.gradientColors = nil"],"syntax":"swift"},{"text":"Custom Fonts","level":3,"anchor":"Custom-Fonts","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use custom fonts for title and message:","type":"text"}]},{"type":"codeListing","code":["Pushwoosh.ForegroundPush.backgroundColor = .systemPurple","Pushwoosh.ForegroundPush.titlePushFont = UIFont(name: \"YourCustomFont-Bold\", size: 18)","Pushwoosh.ForegroundPush.messagePushFont = UIFont(name: \"YourCustomFont-Regular\", size: 15)","Pushwoosh.ForegroundPush.titlePushColor = .white","Pushwoosh.ForegroundPush.messagePushColor = .white"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-4.gif"}]},{"level":2,"anchor":"Rich-Media-Support","type":"heading","text":"Rich Media Support"},{"level":3,"anchor":"Push-with-Image-Attachment","text":"Push with Image Attachment","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Foreground push notifications support image attachments:","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-2.gif","type":"image"}]},{"text":"Push with GIF Attachment","type":"heading","anchor":"Push-with-GIF-Attachment","level":3},{"inlineContent":[{"text":"Animated GIF images are supported:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"ios-foreground-custom-1.gif","type":"image"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The attachment URL is specified in the push notification payload. The SDK automatically downloads and displays the media content.","type":"text"}]},{"type":"heading","level":2,"text":"Animation Customization","anchor":"Animation-Customization"},{"text":"Disable Entry Animation","type":"heading","anchor":"Disable-Entry-Animation","level":3},{"inlineContent":[{"type":"text","text":"Show push instantly without slide animation:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.usePushAnimation = false"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-4.gif"}]},{"text":"Particle Explosion Effect","level":3,"anchor":"Particle-Explosion-Effect","type":"heading"},{"inlineContent":[{"type":"text","text":"Use particle explosion when push disappears:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"]},{"level":3,"type":"heading","text":"Regular Push Animation","anchor":"Regular-Push-Animation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use standard upward slide animation:"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .regularPush",")"]},{"anchor":"Liquid-Glass-Effect-iOS-26+","level":3,"type":"heading","text":"Liquid Glass Effect (iOS 26+)"},{"inlineContent":[{"type":"text","text":"Enable modern Liquid Glass visual effect:"}],"type":"paragraph"},{"syntax":"swift","code":["Pushwoosh.ForegroundPush.useLiquidView = true"],"type":"codeListing"},{"inlineContent":[{"type":"image","identifier":"ios-foreground-custom-5.gif"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Important"}],"type":"strong"},{"text":": Liquid Glass requires iOS 26+ and Swift 5.13+. On earlier iOS versions, standard UIView-based notifications are displayed. Swift versions below 5.13 use blurred UIVisualEffectView.","type":"text"}],"type":"paragraph"}]},{"type":"heading","level":2,"anchor":"Haptic-Feedback-Options","text":"Haptic Feedback Options"},{"type":"heading","text":"No Vibration","anchor":"No-Vibration","level":3},{"type":"paragraph","inlineContent":[{"text":"For silent notifications:","type":"text"}]},{"syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .none,","    disappearedPushAnimation: .balls",")"],"type":"codeListing"},{"type":"heading","level":3,"anchor":"Strong-Haptic","text":"Strong Haptic"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For important notifications:"}]},{"syntax":"swift","type":"codeListing","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 7,","    vibration: .heavy,","    disappearedPushAnimation: .balls",")"]},{"text":"System Notification Haptic","type":"heading","level":3,"anchor":"System-Notification-Haptic"},{"inlineContent":[{"type":"text","text":"Use system notification-style haptic:"}],"type":"paragraph"},{"code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"anchor":"Handling-User-Interactions","text":"Handling User Interactions"},{"text":"Implementing Delegate","type":"heading","anchor":"Implementing-Delegate","level":3},{"inlineContent":[{"text":"Handle user taps through the delegate method:","type":"text"}],"type":"paragraph"},{"code":["class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","        Pushwoosh.ForegroundPush.delegate = self","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push tapped: \\(userInfo)\")","","        if let customData = userInfo[\"custom\"] as? [String: Any],","           let screenId = customData[\"screen_id\"] as? String {","            navigateToScreen(screenId)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Deep-Link-Handling","text":"Deep Link Handling","type":"heading"},{"inlineContent":[{"type":"text","text":"Handle deep links from push notifications:"}],"type":"paragraph"},{"type":"codeListing","code":["func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","    if let deepLink = userInfo[\"deep_link\"] as? String,","       let url = URL(string: deepLink) {","        UIApplication.shared.open(url, options: [:]) { success in","            print(\"Deep link opened: \\(success)\")","        }","    }","}"],"syntax":"swift"},{"text":"Complete Custom Setup","anchor":"Complete-Custom-Setup","type":"heading","level":2},{"type":"heading","level":3,"anchor":"Branded-Notification","text":"Branded Notification"},{"inlineContent":[{"type":"text","text":"Full customization with brand identity:"}],"type":"paragraph"},{"code":["func configureBrandedForegroundPush() {","    Pushwoosh.ForegroundPush.gradientColors = [","        UIColor(red: 0.18, green: 0.31, blue: 0.64, alpha: 1.0),","        UIColor(red: 0.44, green: 0.26, blue: 0.63, alpha: 1.0)","    ]","","    Pushwoosh.ForegroundPush.titlePushColor = .white","    Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.95, alpha: 1.0)","","    Pushwoosh.ForegroundPush.titlePushFont = UIFont(name: \"Helvetica-Bold\", size: 18)","    Pushwoosh.ForegroundPush.messagePushFont = UIFont(name: \"Helvetica\", size: 15)","","    Pushwoosh.ForegroundPush.usePushAnimation = true","    Pushwoosh.ForegroundPush.useLiquidView = true","","    Pushwoosh.ForegroundPush.foregroundNotificationWith(","        style: .style1,","        duration: 6,","        vibration: .notification,","        disappearedPushAnimation: .balls","    )","","    Pushwoosh.ForegroundPush.delegate = self","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Dark-Mode-Support","text":"Dark Mode Support"},{"level":3,"type":"heading","text":"Adaptive Colors","anchor":"Adaptive-Colors"},{"type":"paragraph","inlineContent":[{"text":"Adjust colors based on user interface style:","type":"text"}]},{"type":"codeListing","code":["func configureForegroundPushColors() {","    if #available(iOS 13.0, *) {","        let isDarkMode = UITraitCollection.current.userInterfaceStyle == .dark","","        if isDarkMode {","            Pushwoosh.ForegroundPush.gradientColors = [","                UIColor(red: 0.15, green: 0.15, blue: 0.15, alpha: 1.0),","                UIColor(red: 0.25, green: 0.25, blue: 0.25, alpha: 1.0)","            ]","            Pushwoosh.ForegroundPush.titlePushColor = .white","            Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.85, alpha: 1.0)","        } else {","            Pushwoosh.ForegroundPush.gradientColors = [","                UIColor(red: 0.95, green: 0.95, blue: 0.95, alpha: 1.0),","                UIColor(red: 0.85, green: 0.85, blue: 0.85, alpha: 1.0)","            ]","            Pushwoosh.ForegroundPush.titlePushColor = .black","            Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.15, alpha: 1.0)","        }","    }","}"],"syntax":"swift"},{"text":"Next Steps","level":2,"anchor":"Next-Steps","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegr