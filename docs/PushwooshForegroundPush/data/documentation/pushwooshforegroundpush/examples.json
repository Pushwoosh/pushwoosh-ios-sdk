{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"This guide provides working code examples for customizing PushwooshForegroundPush appearance, animations, and user interactions.","type":"text"}],"type":"paragraph"},{"text":"Basic Setup","level":2,"anchor":"Basic-Setup","type":"heading"},{"type":"heading","level":3,"text":"Minimal Configuration","anchor":"Minimal-Configuration"},{"inlineContent":[{"type":"text","text":"The simplest configuration with default appearance:"}],"type":"paragraph"},{"type":"codeListing","code":["import UIKit","import PushwooshFramework","import PushwooshForegroundPush","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        Pushwoosh.ForegroundPush.foregroundNotificationWith(","            style: .style1,","            duration: 5,","            vibration: .notification,","            disappearedPushAnimation: .balls","        )","","        Pushwoosh.ForegroundPush.delegate = self","","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push: \\(userInfo)\")","    }","}"],"syntax":"swift"},{"type":"heading","text":"Appearance Customization","anchor":"Appearance-Customization","level":2},{"anchor":"Custom-Gradient-Background","level":3,"text":"Custom Gradient Background","type":"heading"},{"inlineContent":[{"text":"Create a vibrant gradient background with custom text colors:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Pushwoosh.ForegroundPush.gradientColors = [.red, .orange, .yellow]","Pushwoosh.ForegroundPush.titlePushColor = .white","Pushwoosh.ForegroundPush.messagePushColor = .white"],"type":"codeListing"},{"inlineContent":[{"identifier":"ios-foreground-custom-3.gif","type":"image"}],"type":"paragraph"},{"anchor":"Solid-Background-Color","level":3,"text":"Solid Background Color","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use a solid color instead of gradient:","type":"text"}]},{"type":"codeListing","code":["Pushwoosh.ForegroundPush.backgroundColor = UIColor(red: 0.1, green: 0.1, blue: 0.1, alpha: 0.95)","Pushwoosh.ForegroundPush.gradientColors = nil"],"syntax":"swift"},{"anchor":"Custom-Fonts","text":"Custom Fonts","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use custom fonts for title and message:"}],"type":"paragraph"},{"code":["Pushwoosh.ForegroundPush.backgroundColor = .systemPurple","Pushwoosh.ForegroundPush.titlePushFont = UIFont(name: \"YourCustomFont-Bold\", size: 18)","Pushwoosh.ForegroundPush.messagePushFont = UIFont(name: \"YourCustomFont-Regular\", size: 15)","Pushwoosh.ForegroundPush.titlePushColor = .white","Pushwoosh.ForegroundPush.messagePushColor = .white"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"image","identifier":"ios-foreground-custom-4.gif"}],"type":"paragraph"},{"anchor":"Rich-Media-Support","type":"heading","level":2,"text":"Rich Media Support"},{"type":"heading","level":3,"anchor":"Push-with-Image-Attachment","text":"Push with Image Attachment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Foreground push notifications support image attachments:"}]},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-2.gif","type":"image"}]},{"text":"Push with GIF Attachment","level":3,"anchor":"Push-with-GIF-Attachment","type":"heading"},{"inlineContent":[{"text":"Animated GIF images are supported:","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-1.gif","type":"image"}]},{"inlineContent":[{"type":"text","text":"The attachment URL is specified in the push notification payload. The SDK automatically downloads and displays the media content."}],"type":"paragraph"},{"anchor":"Animation-Customization","text":"Animation Customization","level":2,"type":"heading"},{"anchor":"Disable-Entry-Animation","text":"Disable Entry Animation","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Show push instantly without slide animation:"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.usePushAnimation = false"]},{"inlineContent":[{"type":"image","identifier":"ios-foreground-custom-4.gif"}],"type":"paragraph"},{"text":"Particle Explosion Effect","level":3,"type":"heading","anchor":"Particle-Explosion-Effect"},{"type":"paragraph","inlineContent":[{"text":"Use particle explosion when push disappears:","type":"text"}]},{"syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"],"type":"codeListing"},{"anchor":"Regular-Push-Animation","type":"heading","text":"Regular Push Animation","level":3},{"type":"paragraph","inlineContent":[{"text":"Use standard upward slide animation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .regularPush",")"]},{"text":"Liquid Glass Effect (iOS 26+)","level":3,"anchor":"Liquid-Glass-Effect-iOS-26+","type":"heading"},{"inlineContent":[{"type":"text","text":"Enable modern Liquid Glass visual effect:"}],"type":"paragraph"},{"code":["Pushwoosh.ForegroundPush.useLiquidView = true"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-5.gif","type":"image"}]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Important"}],"type":"strong"},{"text":": Liquid Glass requires iOS 26+ and Swift 5.13+. On earlier iOS versions, standard UIView-based notifications are displayed. Swift versions below 5.13 use blurred UIVisualEffectView.","type":"text"}]}]},{"type":"heading","text":"Haptic Feedback Options","level":2,"anchor":"Haptic-Feedback-Options"},{"text":"No Vibration","anchor":"No-Vibration","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"For silent notifications:","type":"text"}]},{"code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .none,","    disappearedPushAnimation: .balls",")"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Strong Haptic","anchor":"Strong-Haptic","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For important notifications:"}]},{"type":"codeListing","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 7,","    vibration: .heavy,","    disappearedPushAnimation: .balls",")"],"syntax":"swift"},{"type":"heading","anchor":"System-Notification-Haptic","text":"System Notification Haptic","level":3},{"inlineContent":[{"type":"text","text":"Use system notification-style haptic:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"]},{"anchor":"Handling-User-Interactions","text":"Handling User Interactions","type":"heading","level":2},{"text":"Implementing Delegate","anchor":"Implementing-Delegate","type":"heading","level":3},{"inlineContent":[{"text":"Handle user taps through the delegate method:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","        Pushwoosh.ForegroundPush.delegate = self","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push tapped: \\(userInfo)\")","","        if let customData = userInfo[\"custom\"] as? [String: Any],","           let screenId = customData[\"screen_id\"] as? String {","            navigateToScreen(screenId)","        }","    }","}"]},{"anchor":"Deep-Link-Handling","type":"heading","text":"Deep Link Handling","level":3},{"type":"paragraph","inlineContent":[{"text":"Handle deep links from push notifications:","type":"text"}]},{"code":["func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","    if let deepLink = userInfo[\"deep_link\"] as? String,","       let url = URL(string: deepLink) {","        UIApplication.shared.open(url, options: [:]) { success in","            print(\"Deep link opened: \\(success)\")","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"Complete Custom Setup","anchor":"Complete-Custom-Setup","level":2},{"type":"heading","level":3,"anchor":"Branded-Notification","text":"Branded Notification"},{"inlineContent":[{"text":"Full customization with brand identity:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func configureBrandedForegroundPush() {","    Pushwoosh.ForegroundPush.gradientColors = [","        UIColor(red: 0.18, green: 0.31, blue: 0.64, alpha: 1.0),","        UIColor(red: 0.44, green: 0.26, blue: 0.63, alpha: 1.0)","    ]","","    Pushwoosh.ForegroundPush.titlePushColor = .white","    Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.95, alpha: 1.0)","","    Pushwoosh.ForegroundPush.titlePushFont = UIFont(name: \"Helvetica-Bold\", size: 18)","    Pushwoosh.ForegroundPush.messagePushFont = UIFont(name: \"Helvetica\", size: 15)","","    Pushwoosh.ForegroundPush.usePushAnimation = true","    Pushwoosh.ForegroundPush.useLiquidView = true","","    Pushwoosh.ForegroundPush.foregroundNotificationWith(","        style: .style1,","        duration: 6,","        vibration: .notification,","        disappearedPushAnimation: .balls","    )","","    Pushwoosh.ForegroundPush.delegate = self","}"]},{"type":"heading","text":"Dark Mode Support","anchor":"Dark-Mode-Support","level":2},{"type":"heading","level":3,"anchor":"Adaptive-Colors","text":"Adaptive Colors"},{"inlineContent":[{"text":"Adjust colors based on user interface style:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["func configureForegroundPushColors() {","    if #available(iOS 13.0, *) {","        let isDarkMode = UITraitCollection.current.userInterfaceStyle == .dark","","        if isDarkMode {","            Pushwoosh.ForegroundPush.gradientColors = [","                UIColor(red: 0.15, green: 0.15, blue: 0.15, alpha: 1.0),","                UIColor(red: 0.25, green: 0.25, blue: 0.25, alpha: 1.0)","            ]","            Pushwoosh.ForegroundPush.titlePushColor = .white","            Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.85, alpha: 1.0)","        } else {","            Pushwoosh.ForegroundPush.gradientColors = [","                UIColor(red: 0.95, green: 0.95, blue: 0.95, alpha: 1.0),","                UIColor(red: 0.85, green: 0.85, blue: 0.85, alpha: 1.0)","            ]","            Pushwoosh.ForegroundPush.titlePushColor = .black","            Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.15, alpha: 1.0)","        }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Next-Steps","level":2,"text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPush\/GettingStarted"},{"type":"text","text":" - Quick start 