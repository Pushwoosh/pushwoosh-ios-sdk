"},{"type":"heading","text":"Liquid Glass Effect (iOS 26+)","level":3,"anchor":"Liquid-Glass-Effect-iOS-26+"},{"inlineContent":[{"type":"text","text":"Enable modern Liquid Glass visual effect:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Pushwoosh.ForegroundPush.useLiquidView = true"]},{"inlineContent":[{"identifier":"ios-foreground-custom-5.gif","type":"image"}],"type":"paragraph"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Important"}]},{"type":"text","text":": Liquid Glass requires iOS 26+ and Swift 5.13+. On earlier iOS versions, standard UIView-based notifications are displayed. Swift versions below 5.13 use blurred UIVisualEffectView."}]}]},{"anchor":"Haptic-Feedback-Options","text":"Haptic Feedback Options","level":2,"type":"heading"},{"anchor":"No-Vibration","text":"No Vibration","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"For silent notifications:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .none,","    disappearedPushAnimation: .balls",")"]},{"text":"Strong Haptic","level":3,"type":"heading","anchor":"Strong-Haptic"},{"inlineContent":[{"type":"text","text":"For important notifications:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 7,","    vibration: .heavy,","    disappearedPushAnimation: .balls",")"]},{"type":"heading","anchor":"System-Notification-Haptic","level":3,"text":"System Notification Haptic"},{"inlineContent":[{"text":"Use system notification-style haptic:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"],"type":"codeListing"},{"text":"Handling User Interactions","type":"heading","anchor":"Handling-User-Interactions","level":2},{"type":"heading","level":3,"text":"Implementing Delegate","anchor":"Implementing-Delegate"},{"inlineContent":[{"text":"Handle user taps through the delegate method:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","        Pushwoosh.ForegroundPush.delegate = self","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push tapped: \\(userInfo)\")","","        if let customData = userInfo[\"custom\"] as? [String: Any],","           let screenId = customData[\"screen_id\"] as? String {","            navigateToScreen(screenId)","        }","    }","}"]},{"text":"Deep Link Handling","level":3,"anchor":"Deep-Link-Handling","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle deep links from push notifications:"}]},{"syntax":"swift","code":["func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","    if let deepLink = userInfo[\"deep_link\"] as? String,","       let url = URL(string: deepLink) {","        UIApplication.shared.open(url, options: [:]) { success in","            print(\"Deep link opened: \\(success)\")","        }","    }","}"],"type":"codeListing"},{"type":"heading","text":"Complete Custom Setup","anchor":"Complete-Custom-Setup","level":2},{"anchor":"Branded-Notification","type":"heading","level":3,"text":"Branded Notification"},{"inlineContent":[{"type":"text","text":"Full customization with brand identity:"}],"type":"paragraph"},{"code":["func configureBrandedForegroundPush() {