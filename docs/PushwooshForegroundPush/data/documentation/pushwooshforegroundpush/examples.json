{"kind":"article","hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPush"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"PushwooshForegroundPush"}],"title":"Code Examples","role":"article","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"This guide provides working code examples for customizing PushwooshForegroundPush appearance, animations, and user interactions."}],"type":"paragraph"},{"anchor":"Basic-Setup","level":2,"text":"Basic Setup","type":"heading"},{"level":3,"text":"Minimal Configuration","type":"heading","anchor":"Minimal-Configuration"},{"inlineContent":[{"text":"The simplest configuration with default appearance:","type":"text"}],"type":"paragraph"},{"code":["import UIKit","import PushwooshFramework","import PushwooshForegroundPush","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        Pushwoosh.ForegroundPush.foregroundNotificationWith(","            style: .style1,","            duration: 5,","            vibration: .notification,","            disappearedPushAnimation: .balls","        )","","        Pushwoosh.ForegroundPush.delegate = self","","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push: \\(userInfo)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Appearance Customization","anchor":"Appearance-Customization"},{"anchor":"Custom-Gradient-Background","level":3,"type":"heading","text":"Custom Gradient Background"},{"inlineContent":[{"text":"Create a vibrant gradient background with custom text colors:","type":"text"}],"type":"paragraph"},{"code":["Pushwoosh.ForegroundPush.gradientColors = [.red, .orange, .yellow]","Pushwoosh.ForegroundPush.titlePushColor = .white","Pushwoosh.ForegroundPush.messagePushColor = .white"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-3.gif","type":"image"}]},{"level":3,"anchor":"Solid-Background-Color","type":"heading","text":"Solid Background Color"},{"type":"paragraph","inlineContent":[{"text":"Use a solid color instead of gradient:","type":"text"}]},{"code":["Pushwoosh.ForegroundPush.backgroundColor = UIColor(red: 0.1, green: 0.1, blue: 0.1, alpha: 0.95)","Pushwoosh.ForegroundPush.gradientColors = nil"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Custom-Fonts","type":"heading","text":"Custom Fonts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use custom fonts for title and message:"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.backgroundColor = .systemPurple","Pushwoosh.ForegroundPush.titlePushFont = UIFont(name: \"YourCustomFont-Bold\", size: 18)","Pushwoosh.ForegroundPush.messagePushFont = UIFont(name: \"YourCustomFont-Regular\", size: 15)","Pushwoosh.ForegroundPush.titlePushColor = .white","Pushwoosh.ForegroundPush.messagePushColor = .white"]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-4.gif"}]},{"level":2,"anchor":"Rich-Media-Support","type":"heading","text":"Rich Media Support"},{"text":"Push with Image Attachment","anchor":"Push-with-Image-Attachment","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Foreground push notifications support image attachments:"}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"ios-foreground-custom-2.gif"}],"type":"paragraph"},{"anchor":"Push-with-GIF-Attachment","level":3,"text":"Push with GIF Attachment","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Animated GIF images are supported:"}]},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-1.gif","type":"image"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The attachment URL is specified in the push notification payload. The SDK automatically downloads and displays the media content."}]},{"level":2,"anchor":"Animation-Customization","type":"heading","text":"Animation Customization"},{"text":"Disable Entry Animation","level":3,"anchor":"Disable-Entry-Animation","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Show push instantly without slide animation:"}]},{"code":["Pushwoosh.ForegroundPush.usePushAnimation = false"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-4.gif"}]},{"level":3,"anchor":"Particle-Explosion-Effect","text":"Particle Explosion Effect","type":"heading"},{"inlineContent":[{"type":"text","text":"Use particle explosion when push disappears:"}],"type":"paragraph"},{"code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"],"type":"codeListing","syntax":"swift"},{"text":"Regular Push Animation","type":"heading","level":3,"anchor":"Regular-Push-Animation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use standard upward slide animation:"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .regularPush",")"]},{"anchor":"Liquid-Glass-Effect-iOS-26+","type":"heading","level":3,"text":"Liquid Glass Effect (iOS 26+)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable modern Liquid Glass visual effect:"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.useLiquidView = true"]},{"inlineContent":[{"identifier":"ios-foreground-custom-5.gif","type":"image"}],"type":"paragraph"},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Important","type":"text"}]},{"type":"text","text":": Liquid Glass requires iOS 26+ and Swift 5.13+. On earlier iOS versions, standard UIView-based notifications are displayed. Swift versions below 5.13 use blurred UIVisualEffectView."}]}]},{"level":2,"text":"Haptic Feedback Options","type":"heading","anchor":"Haptic-Feedback-Options"},{"level":3,"text":"No Vibration","type":"heading","anchor":"No-Vibration"},{"inlineContent":[{"text":"For silent notifications:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .none,","    disappearedPushAnimation: .balls",")"],"type":"codeListing"},{"text":"Strong Haptic","anchor":"Strong-Haptic","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For important notifications:"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 7,","    vibration: .heavy,","    disappearedPushAnimation: .balls",")"]},{"text":"System Notification Haptic","level":3,"type":"heading","anchor":"System-Notification-Haptic"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use system notification-style haptic:"}]},{"syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"],"type":"codeListing"},{"type":"heading","level":2,"anchor":"Handling-User-Interactions","text":"Handling User Interactions"},{"level":3,"text":"Implementing Delegate","type":"heading","anchor":"Implementing-Delegate"},{"type":"paragraph","inlineContent":[{"text":"Handle user taps through the delegate method:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","        Pushwoosh.ForegroundPush.delegate = self","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push tapped: \\(userInfo)\")","","        if let customData = userInfo[\"custom\"] as? [String: Any],","           let screenId = customData[\"screen_id\"] as? String {","            navigateToScreen(screenId)","        }","    }","}"]},{"type":"heading","anchor":"Deep-Link-Handling","level":3,"text":"Deep Link Handling"},{"inlineContent":[{"type":"text","text":"Handle deep links from push notifications:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","    if let deepLink = userInfo[\"deep_link\"] as? String,","       let url = URL(string: deepLink) {","        UIApplication.shared.open(url, options: [:]) { success in","            print(\"Deep link opened: \\(success)\")","        }","    }","}"]},{"text":"Complete Custom Setup","anchor":"Complete-Custom-Setup","type":"heading","level":2},{"level":3,"text":"Branded Notification","type":"heading","anchor":"Branded-Notification"},{"inlineContent":[{"text":"Full customization with brand identity:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func configureBrandedForegroundPush() {","    Pushwoosh.ForegroundPush.gradientColors = [","        UIColor(red: 0.18, green: 0.31, blue: 0.64, alpha: 1.0),","        UIColor(red: 0.44, green: 0.26, blue: 0.63, alpha: 1.0)","    ]","","    Pushwoosh.ForegroundPush.titlePushColor = .white","    Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.95, alpha: 1.0)","","    Pushwoosh.ForegroundPush.titlePushFont = UIFont(name: \"Helvetica-Bold\", size: 18)","    Pushwoosh.ForegroundPush.messagePushFont = UIFont(name: \"Helvetica\", size: 15)","","    Pushwoosh.ForegroundPush.usePushAnimation = true","    Pushwoosh.ForegroundPush.useLiquidView = true","","    Pushwoosh.ForegroundPush.foregroundNotificationWith(","        style: .style1,","        duration: 6,","        vibration: .notification,","        disappearedPushAnimation: .balls","    )","","    Pushwoosh.ForegroundPush.delegate = self","}"]},{"anchor":"Dark-Mode-Support","level":2,"text":"Dark Mode Support","type":"heading"},{"text":"Adaptive Colors","type":"heading","anchor":"Adaptive-Colors","level":3},{"inlineContent":[{"text":"Adjust colors based on user interface style:","type":"text"}],"type":"paragraph"},{"code":["func configureForegroundPushColors() {","    if #available(iOS 13.0, *) {","        let isDarkMode = UITraitCollection.current.userInterfaceStyle == .dark","","        if isDarkMode {","            Pushwoosh.ForegroundPush.gradientColors = [","                UIColor(red: 0.15, green: 0.15, blue: 0.15, alpha: 1.0),","                UIColor(red: 0.25, green: 0.25, blue: 0.25, alpha: 1.0)","            ]","            Pushwoosh.ForegroundPush.titlePushColor = .white","            Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.85, alpha: 1.0)","        } else {","            Pushwoosh.ForegroundPush.gradientColors = [","                UIColor(red: 0.95, green: 0.95, blue: 0.95, alpha: 1.0),","                UIColor(red: 0.85, green: 0.85, blue: 0.85, alpha: 1.0)","            ]","            Pushwoosh.ForegroundPush.titlePushColor = .black","            Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.15, alpha: 1.0)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Next Steps","level":2,"anchor":"Next-Steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPush\/GettingStarted","isActive":true},{"type":"text","text":" - Quick start guide"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPush\/PushwooshForegroundPushImplementation","isActive":true,"type":"reference"},{"text":" - Full API reference","type":"text"}]}]}],"type":"unorderedList"}]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPush\/Examples","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Practical examples for common foreground push notification scenarios."}],"seeAlsoSections":[{"title":"Getting Started","generated":true,"identifiers":["doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPush\/GettingStarted"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshforegroundpush\/examples"]},{"paths":["\/documentation\/pushwooshforegroundpush\/examples"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"references":{"ios-foreground-custom-1.gif":{"type":"image","alt":"Foreground push with animated GIF","variants":[{"traits":["1x","light"],"url":"\/images\/ios-foreground-custom-1.gif"}],"identifier":"ios-foreground-custom-1.gif"},"ios-foreground-custom-3.gif":{"alt":"Foreground push with custom gradient and text colors","type":"image","identifier":"ios-foreground-custom-3.gif","variants":[{"traits":["1x","light"],"url":"\/images\/ios-foreground-custom-3.gif"}]},"ios-foreground-custom-2.gif":{"type":"image","alt":"Foreground push with card image attachment","variants":[{"traits":["1x","light"],"url":"\/images\/ios-foreground-custom-2.gif"}],"identifier":"ios-foreground-custom-2.gif"},"doc://com.pushwoosh.PushwooshForegroundPush/d