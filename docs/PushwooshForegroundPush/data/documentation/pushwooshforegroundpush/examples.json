{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide provides working code examples for customizing PushwooshForegroundPush appearance, animations, and user interactions."}],"type":"paragraph"},{"text":"Basic Setup","level":2,"anchor":"Basic-Setup","type":"heading"},{"text":"Minimal Configuration","anchor":"Minimal-Configuration","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The simplest configuration with default appearance:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import UIKit","import PushwooshFramework","import PushwooshForegroundPush","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","","        Pushwoosh.ForegroundPush.foregroundNotificationWith(","            style: .style1,","            duration: 5,","            vibration: .notification,","            disappearedPushAnimation: .balls","        )","","        Pushwoosh.ForegroundPush.delegate = self","","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push: \\(userInfo)\")","    }","}"]},{"anchor":"Appearance-Customization","text":"Appearance Customization","level":2,"type":"heading"},{"type":"heading","level":3,"anchor":"Custom-Gradient-Background","text":"Custom Gradient Background"},{"inlineContent":[{"text":"Create a vibrant gradient background with custom text colors:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.gradientColors = [.red, .orange, .yellow]","Pushwoosh.ForegroundPush.titlePushColor = .white","Pushwoosh.ForegroundPush.messagePushColor = .white"]},{"inlineContent":[{"type":"image","identifier":"ios-foreground-custom-3.gif"}],"type":"paragraph"},{"text":"Solid Background Color","level":3,"anchor":"Solid-Background-Color","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use a solid color instead of gradient:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.ForegroundPush.backgroundColor = UIColor(red: 0.1, green: 0.1, blue: 0.1, alpha: 0.95)","Pushwoosh.ForegroundPush.gradientColors = nil"]},{"anchor":"Custom-Fonts","level":3,"type":"heading","text":"Custom Fonts"},{"type":"paragraph","inlineContent":[{"text":"Use custom fonts for title and message:","type":"text"}]},{"code":["Pushwoosh.ForegroundPush.backgroundColor = .systemPurple","Pushwoosh.ForegroundPush.titlePushFont = UIFont(name: \"YourCustomFont-Bold\", size: 18)","Pushwoosh.ForegroundPush.messagePushFont = UIFont(name: \"YourCustomFont-Regular\", size: 15)","Pushwoosh.ForegroundPush.titlePushColor = .white","Pushwoosh.ForegroundPush.messagePushColor = .white"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-4.gif"}]},{"level":2,"type":"heading","text":"Rich Media Support","anchor":"Rich-Media-Support"},{"text":"Push with Image Attachment","type":"heading","anchor":"Push-with-Image-Attachment","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Foreground push notifications support image attachments:"}]},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-2.gif","type":"image"}]},{"level":3,"text":"Push with GIF Attachment","type":"heading","anchor":"Push-with-GIF-Attachment"},{"inlineContent":[{"text":"Animated GIF images are supported:","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-1.gif"}]},{"type":"paragraph","inlineContent":[{"text":"The attachment URL is specified in the push notification payload. The SDK automatically downloads and displays the media content.","type":"text"}]},{"level":2,"anchor":"Animation-Customization","text":"Animation Customization","type":"heading"},{"text":"Disable Entry Animation","anchor":"Disable-Entry-Animation","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Show push instantly without slide animation:"}]},{"syntax":"swift","code":["Pushwoosh.ForegroundPush.usePushAnimation = false"],"type":"codeListing"},{"inlineContent":[{"identifier":"ios-foreground-custom-4.gif","type":"image"}],"type":"paragraph"},{"level":3,"anchor":"Particle-Explosion-Effect","text":"Particle Explosion Effect","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use particle explosion when push disappears:","type":"text"}]},{"type":"codeListing","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"],"syntax":"swift"},{"type":"heading","level":3,"text":"Regular Push Animation","anchor":"Regular-Push-Animation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use standard upward slide animation:"}]},{"type":"codeListing","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .regularPush",")"],"syntax":"swift"},{"type":"heading","text":"Liquid Glass Effect (iOS 26+)","level":3,"anchor":"Liquid-Glass-Effect-iOS-26+"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable modern Liquid Glass visual effect:"}]},{"code":["Pushwoosh.ForegroundPush.useLiquidView = true"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"image","identifier":"ios-foreground-custom-5.gif"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Important"}],"type":"strong"},{"type":"text","text":": Liquid Glass requires iOS 26+ and Swift 5.13+. On earlier iOS versions, standard UIView-based notifications are displayed. Swift versions below 5.13 use blurred UIVisualEffectView."}]}]},{"type":"heading","anchor":"Haptic-Feedback-Options","level":2,"text":"Haptic Feedback Options"},{"level":3,"text":"No Vibration","anchor":"No-Vibration","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For silent notifications:"}]},{"type":"codeListing","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .none,","    disappearedPushAnimation: .balls",")"],"syntax":"swift"},{"level":3,"text":"Strong Haptic","type":"heading","anchor":"Strong-Haptic"},{"inlineContent":[{"type":"text","text":"For important notifications:"}],"type":"paragraph"},{"code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 7,","    vibration: .heavy,","    disappearedPushAnimation: .balls",")"],"syntax":"swift","type":"codeListing"},{"text":"System Notification Haptic","type":"heading","anchor":"System-Notification-Haptic","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use system notification-style haptic:"}]},{"syntax":"swift","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"],"type":"codeListing"},{"type":"heading","anchor":"Handling-User-Interactions","level":2,"text":"Handling User Interactions"},{"anchor":"Implementing-Delegate","level":3,"type":"heading","text":"Implementing Delegate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle user taps through the delegate method:"}]},{"code":["class AppDelegate: UIResponder, UIApplicationDelegate, PWForegroundPushDelegate {","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?","    ) -> Bool {","        Pushwoosh.ForegroundPush.delegate = self","        return true","    }","","    func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","        print(\"Foreground custom push tapped: \\(userInfo)\")","","        if let customData = userInfo[\"custom\"] as? [String: Any],","           let screenId = customData[\"screen_id\"] as? String {","            navigateToScreen(screenId)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Deep Link Handling","type":"heading","anchor":"Deep-Link-Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle deep links from push notifications:"}]},{"code":["func didTapForegroundPush(_ userInfo: [AnyHashable: Any]) {","    if let deepLink = userInfo[\"deep_link\"] as? String,","       let url = URL(string: deepLink) {","        UIApplication.shared.open(url, options: [:]) { success in","            print(\"Deep link opened: \\(success)\")","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Complete Custom Setup","type":"heading","anchor":"Complete-Custom-Setup","level":2},{"text":"Branded Notification","level":3,"type":"heading","anchor":"Branded-Notification"},{"inlineContent":[{"text":"Full customization with brand identity:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func configureBrandedForegroundPush() {","    Pushwoosh.ForegroundPush.gradientColors = [","        UIColor(red: 0.18, green: 0.31, blue: 0.64, alpha: 1.0),","        UIColor(red: 0.44, green: 0.26, blue: 0.63, alpha: 1.0)","    ]","","    Pushwoosh.ForegroundPush.titlePushColor = .white","    Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.95, alpha: 1.0)","","    Pushwoosh.ForegroundPush.titlePushFont = UIFont(name: \"Helvetica-Bold\", size: 18)","    Pushwoosh.ForegroundPush.messagePushFont = UIFont(name: \"Helvetica\", size: 15)","","    Pushwoosh.ForegroundPush.usePushAnimation = true","    Pushwoosh.ForegroundPush.useLiquidView = true","","    Pushwoosh.ForegroundPush.foregroundNotificationWith(","        style: .style1,","        duration: 6,","        vibration: .notification,","        disappearedPushAnimation: .balls","    )","","    Pushwoosh.ForegroundPush.delegate = self","}"],"type":"codeListing"},{"type":"heading","text":"Dark Mode Support","level":2,"anchor":"Dark-Mode-Support"},{"type":"heading","level":3,"anchor":"Adaptive-Colors","text":"Adaptive Colors"},{"inlineContent":[{"text":"Adjust colors based on user interface style:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func configureForegroundPushColors() {","    if #available(iOS 13.0, *) {","        let isDarkMode = UITraitCollection.current.userInterfaceStyle == .dark","","        if isDarkMode {","            Pushwoosh.ForegroundPush.gradientColors = [","                UIColor(red: 0.15, green: 0.15, blue: 0.15, alpha: 1.0),","                UIColor(red: 0.25, green: 0.25, blue: 0.25, alpha: 1.0)","            ]","            Pushwoosh.ForegroundPush.titlePushColor = .white","            Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.85, alpha: 1.0)","        } else {","            Pushwoosh.ForegroundPush.gradientColors = [","                UIColor(red: 0.95, green: 0.95, blue: 0.95, alpha: 1.0),","                UIColor(red: 0.85, green: 0.85, blue: 0.85, alpha: 1.0)","            ]","            Pushwoosh.ForegroundPush.titlePushColor = .black","            Pushwoosh.ForegroundPush.messagePushColor = UIColor(white: 0.15, alpha: 1.0)","        }","    }","}"],"type":"codeListing"},{"text":"Next Steps","anchor":"Next-Steps","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshForegroundPush\/documentation\/PushwooshForegroundPush\/GettingStarted","type":"reference"},{"type":"text","text":" - Quick start guide"}],"type":"paragrap