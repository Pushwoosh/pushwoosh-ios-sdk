port","type":"heading"},{"text":"Push with Image Attachment","anchor":"Push-with-Image-Attachment","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Foreground push notifications support image attachments:"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"identifier":"ios-foreground-custom-2.gif","type":"image"}]},{"text":"Push with GIF Attachment","level":3,"anchor":"Push-with-GIF-Attachment","type":"heading"},{"inlineContent":[{"text":"Animated GIF images are supported:","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-1.gif"}]},{"inlineContent":[{"type":"text","text":"The attachment URL is specified in the push notification payload. The SDK automatically downloads and displays the media content."}],"type":"paragraph"},{"type":"heading","text":"Animation Customization","anchor":"Animation-Customization","level":2},{"level":3,"type":"heading","text":"Disable Entry Animation","anchor":"Disable-Entry-Animation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Show push instantly without slide animation:"}]},{"syntax":"swift","code":["Pushwoosh.ForegroundPush.usePushAnimation = false"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"ios-foreground-custom-4.gif"}]},{"type":"heading","text":"Particle Explosion Effect","level":3,"anchor":"Particle-Explosion-Effect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use particle explosion when push disappears:"}]},{"syntax":"swift","type":"codeListing","code":["Pushwoosh.ForegroundPush.foregroundNotificationWith(","    style: .style1,","    duration: 5,","    vibration: .notification,","    disappearedPushAnimation: .balls",")"]},{"level":3,"anchor":"Regular-Push-Animation","type":"heading","text":"Regular Push Animation"},{"type":"paragraph","inlineContent":[{"text":"Use standard upward slide animation:","type":"text"}]},{"syntax":"swift","type":"codeLis