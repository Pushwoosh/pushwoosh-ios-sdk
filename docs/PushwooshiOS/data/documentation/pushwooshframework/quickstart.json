{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework"]]},"abstract":[{"type":"text","text":"Get your first push notification running in minutes."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"This quick start guide helps you set up Pushwoosh SDK and send your first push notification as quickly as possible. For comprehensive integration steps, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/GettingStarted"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Important","content":[{"inlineContent":[{"text":"Integrate through ","type":"text"},{"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/configure-swift.type.property","type":"reference","isActive":true},{"text":" and the module accessors, not through ","type":"text"},{"code":"Pushwoosh.sharedInstance()","type":"codeVoice"},{"text":", which is deprecated since 7.3.0. Registration, user data, tags and settings go through ","type":"text"},{"code":"Pushwoosh.configure","type":"codeVoice"},{"type":"text","text":" (Objective-C: "},{"type":"codeVoice","code":"[Pushwoosh configure]"},{"text":"); each feature has its own accessor: ","type":"text"},{"type":"codeVoice","code":"Pushwoosh.media"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pushwoosh.inbox"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Pushwoosh.inApp"},{"text":", ","type":"text"},{"code":"Pushwoosh.inline","type":"codeVoice"},{"type":"text","text":", "},{"code":"Pushwoosh.debug","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"Pushwoosh.LiveActivities"},{"text":", ","type":"text"},{"code":"Pushwoosh.VoIP","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Pushwoosh.ForegroundPush","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Pushwoosh.Keychain","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Pushwoosh.InboxKit"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"important","type":"aside"},{"level":2,"anchor":"Prerequisites","text":"Prerequisites","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Active Pushwoosh account with a configured project"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS platform set to Token-Based Authentication (recommended)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gateway set to "},{"code":"Sandbox","type":"codeVoice"},{"text":" for simulator testing","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Your Application Code and Device API Token from Pushwoosh Control Panel"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Installation","text":"Installation","level":2},{"type":"tabNavigator","tabs":[{"content":[{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, select File → Add Package Dependencies","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enter the repository URL:","type":"text"}]}]}]},{"type":"codeListing","syntax":null,"code":["https:\/\/github.com\/Pushwoosh\/Pushwoosh-XCFramework"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the following frameworks to the app target:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"PushwooshFramework"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"PushwooshCore"}]}]},{"content":[{"inlineContent":[{"text":"PushwooshBridge","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"type":"orderedList","start":3},{"inlineContent":[{"text":"The Notification Service Extension target gets the same three frameworks (see step 4).","type":"text"}],"type":"paragraph"}],"title":"Swift Package Manager"},{"title":"CocoaPods","content":[{"type":"paragraph","inlineContent":[{"text":"Add to your ","type":"text"},{"code":"Podfile","type":"codeVoice"},{"text":", with a block for the Notification Service Extension target (see step 4):","type":"text"}]},{"syntax":"ruby","type":"codeListing","code":["target 'YourApp' do","  pod 'PushwooshXCFramework'","end","","target 'NotificationService' do","  pod 'PushwooshXCFramework'","end"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then run:"}]},{"type":"codeListing","code":["pod install"],"syntax":"bash"}]}]},{"anchor":"Configuration","level":2,"type":"heading","text":"Configuration"},{"level":3,"type":"heading","anchor":"1-Add-Required-Infoplist-Keys","text":"1. Add Required Info.plist Keys"},{"type":"paragraph","inlineContent":[{"text":"Add these two keys to your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Pushwoosh_APPID","type":"codeVoice"},{"text":" → Your Application Code","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Pushwoosh_API_TOKEN","type":"codeVoice"},{"text":" → Your Device API Token","type":"text"}]}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"xml","code":["<key>Pushwoosh_APPID<\/key>","<string>YOUR-APPLICATION-CODE<\/string>","<key>Pushwoosh_API_TOKEN<\/key>","<string>YOUR-DEVICE-API-TOKEN<\/string>"]},{"type":"heading","anchor":"2-Enable-Push-Notifications-Capability","level":3,"text":"2. Enable Push Notifications Capability"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your app target in Xcode"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Go to Signing & Capabilities"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Click + Capability"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add “Push Notifications”","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add “Background Modes” and check “Remote notifications”"}],"type":"paragraph"}]}]},{"level":3,"text":"3. Initialize SDK","type":"heading","anchor":"3-Initialize-SDK"},{"type":"paragraph","inlineContent":[{"text":"In your AppDelegate or App struct:","type":"text"}]},{"tabs":[{"content":[{"type":"codeListing","syntax":"swift","code":["import PushwooshFramework","","class AppDelegate: NSObject, UIApplicationDelegate {","    func application(_ application: UIApplication,","                    didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","        Pushwoosh.configure.registerForPushNotifications()","","        return true","    }","","    func application(_ application: UIApplication,","                    didRegisterForRemoteNotificationsWithDeviceToken deviceToken: Data) {","        Pushwoosh.configure.handlePushRegistration(deviceToken)","    }","}"]}],"title":"Swift"},{"title":"Objective-C","content":[{"type":"codeListing","syntax":"objc","code":["#import <PushwooshFramework\/PushwooshFramework.h>","","@interface AppDelegate : NSObject <UIApplicationDelegate>","@end","","@implementation AppDelegate","","- (BOOL)application:(UIApplication *)application","        didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {","","    [Pushwoosh.configure registerForPushNotifications];","","    return YES;","}","","- (void)application:(UIApplication *)application","        didRegisterForRemoteNotificationsWithDeviceToken:(NSData *)deviceToken {","    [Pushwoosh.configure handlePushRegistration:deviceToken];","}","","@end"]}]}],"type":"tabNavigator"},{"level":3,"type":"heading","anchor":"4-Add-a-Notification-Service-Extension-and-an-App-Group","text":"4. Add a Notification Service Extension and an App Group"},{"inlineContent":[{"text":"This step is required. The message delivery event is sent only by the Notification Service Extension: without it pushes are shown, but they are never counted as delivered. The extension also applies the badge and downloads media attachments. The app and the extension share data through an App Group.","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, choose File → New → Target → Notification Service Extension."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Link PushwooshFramework, PushwooshCore and PushwooshBridge to the extension target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace the generated class with a subclass of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshNotificationServiceExtension"},{"text":":","type":"text"}]}]}]},{"type":"tabNavigator","tabs":[{"title":"Swift","content":[{"type":"codeListing","syntax":"swift","code":["import PushwooshFramework","","class NotificationService: PushwooshNotificationServiceExtension {}"]}]},{"title":"Objective-C","content":[{"syntax":"objc","code":["#import <PushwooshFramework\/PushwooshFramework.h>","","@interface NotificationService : PushwooshNotificationServiceExtension","@end","","@implementation NotificationService","@end"],"type":"codeListing"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a class of your own, set the extension’s "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" to "},{"code":"PushwooshNotificationServiceExtension","type":"codeVoice"},{"type":"text","text":"."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Signing & Capabilities, add the App Groups capability to the app target and to the extension target, with the same group selected in both.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Set that group as ","type":"text"},{"type":"codeVoice","code":"PW_APP_GROUPS_NAME"},{"type":"text","text":" in the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" of the app and of the extension:"}],"type":"paragraph"}]}],"start":4,"type":"orderedList"},{"type":"codeListing","syntax":"xml","code":["<key>PW_APP_GROUPS_NAME<\/key>","<string>group.com.example.app<\/string>"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep "},{"type":"codeVoice","code":"Pushwoosh_APPID"},{"type":"text","text":" in the app’s "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" only: the extension inherits it, like the other "},{"type":"codeVoice","code":"Pushwoosh_*"},{"type":"text","text":" keys, from the app."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"iOS starts the extension only for pushes whose "},{"type":"codeVoice","code":"aps"},{"type":"text","text":" dictionary carries "},{"type":"codeVoice","code":"mutable-content: 1"},{"text":".","type":"text"}],"type":"paragraph"}]}],"start":6,"type":"orderedList"},{"inlineContent":[{"type":"text","text":"For how the delivery event is sent and what the App Group is used for, see "},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/AdvancedIntegration#Delivery-Event","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"5-Register-for-Push-Notifications","type":"heading","text":"5. Register for Push Notifications","level":3},{"type":"paragraph","inlineContent":[{"text":"Run your app and grant push notification permissions when prompted. Check the console for a successful registration log containing your HWID and push token.","type":"text"}]},{"level":2,"type":"heading","text":"Send Your First Push","anchor":"Send-Your-First-Push"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open Pushwoosh Control Pa