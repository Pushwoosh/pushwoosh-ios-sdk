ved\", [","        \"campaign_id\": message.customData?[\"campaign_id\"] ?? \"\",","        \"app_state\": UIApplication.shared.applicationState.rawValue","    ])","","    if let action = message.customData?[\"action\"] as? String {","        switch action {","        case \"refresh_orders\":","            OrderManager.shared.refreshOrders()","        case \"update_cart\":","            CartManager.shared.syncWithServer()","        default:","            break","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Show in-app notification banner when app is in foreground:"}],"type":"paragraph"},{"syntax":"swift","code":["func pushwoosh(_ pushwoosh: Pushwoosh, onMessageReceived message: PWMessage) {","    guard UIApplication.shared.applicationState == .active else { return }","","    let banner = InAppNotificationBanner(","        title: message.title ?? \"New Notification\",","        message: message.message ?? \"\"","    )","    banner.show()","}"],"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/pushwooshframework\/pwmessagingdelegate\/pushwoosh(_:onmessagereceived:)"],"traits":[{"interfaceLanguage":"swift"}]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshframework\/pwmessagingdelegate\/pushwoosh(_:onmessagereceived:)"]}],"abstract":[{"type":"text","text":"Called when the application receives a push notification."}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PWMessagingDelegate"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PWMessagingDelegate\/pushwoosh(_:onMessageOpened:)","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/showPushnotificationAlert"],"title":"Related Documentation"},{"generated":true,"title":"Handling Notifications","identifiers":["doc:\/\/com.pushwoosh.