 = message.customData?[\"tab\"] as? Int else { return }","","    if let tabBarController = window?.rootViewController as? UITabBarController {","        tabBarController.selectedIndex = tabIndex","    }","}"]}]}],"abstract":[{"text":"Called when the user taps on a push notification.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PWMessagingDelegate"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"pushwoosh"},{"kind":"text","text":"("},{"preciseIdentifier":"c:objc(cs)Pushwoosh","text":"Pushwoosh","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"onMessageOpened"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"PWMessage","preciseIdentifier":"c:objc(cs)PWMessage"},{"text":")","kind":"text"}],"roleHeading":"Instance Method","navigatorTitle":[{"text":"pushwoosh:onMessageOpened:","kind":"identifier"}],"modules":[{"name":"PushwooshFramework"}],"externalID":"c:objc(pl)PWMessagingDelegate(im)pushwoosh:onMessageOpened:","role":"symbol","title":"pushwoosh(_:onMessageOpened:)","symbolKind":"method","required":true},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PWMessagingDelegate\/pushwoosh(_:onMessageOpened:)"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PWMessagingDelegate\/pushwoosh(_:onMessageReceived:)","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/delegate"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PWMessagingDelegate\/pushwoosh(_:onMessageReceived:)"],"title":"Handling Notifications","generated":true}],"variants":[{"traits":[{"interfaceLangua