{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Delegate protocol for handling in-app purchase events from rich media."}],"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PWPurchaseDelegate","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"PWPurchaseDelegate"}],"symbolKind":"protocol","role":"symbol","externalID":"c:objc(pl)PWPurchaseDelegate","title":"PWPurchaseDelegate","roleHeading":"Protocol","modules":[{"name":"PushwooshFramework"}]},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PWPurchaseDelegate","kind":"identifier"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSObject","text":"NSObjectProtocol"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Implement "},{"type":"codeVoice","code":"PWPurchaseDelegate"},{"text":" to respond to in-app purchase events initiated from Pushwoosh rich media notifications. This enables:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Promotional purchases from push notifications"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product information display"}]}]},{"content":[{"inlineContent":[{"text":"Purchase completion handling","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Error handling for failed transactions","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Implementation","anchor":"Implementation"},{"syntax":"swift","type":"codeListing","code":["class AppDelegate: UIResponder, UIApplicationDelegate, PWPurchaseDelegate {","","    func application(_ application: UIApplication,","             