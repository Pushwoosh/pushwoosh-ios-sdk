","","        if let favoriteCategories = tags[\"favorite_categories\"] as? [String] {","            self.userSettings.favoriteCategories = favoriteCategories","        }","","        if let notificationsEnabled = tags[\"notifications_enabled\"] as? Bool {","            self.userSettings.notificationsEnabled = notificationsEnabled","        }","","        self.refreshUI()","    }","","    let errorHandler: PushwooshErrorHandler = { error in","        self.logger.error(\"Failed to load preferences: \\(error?.localizedDescription ?? \"Unknown error\")\")","    }","","    Pushwoosh.configure.getTags(successHandler, onFailure: errorHandler)","}"],"syntax":"swift"}],"kind":"content"}],"abstract":[{"type":"text","text":"Completion handler called when tags are successfully retrieved from the server."}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Type Alias","externalID":"c:PushNotificationManager.h@T@PushwooshGetTagsHandler","navigatorTitle":[{"text":"PushwooshGetTagsHandler","kind":"identifier"}],"fragments":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PushwooshGetTagsHandler"}],"title":"PushwooshGetTagsHandler","modules":[{"name":"PushwooshFramework"}],"symbolKind":"typealias","role":"symbol"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshErrorHandler","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/getTags(_:onFailure:)"],"title":"Related Documentation"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework"]]},"kind":"symbol","references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/Pushwoosh/getTags(_:onFailure:)":{"abstract":[{"text":"Retrieves the current device’s tags from the Pushwoosh server.","type":"text"}],"kind":"symbol","url":"\/documentation\/pushwooshframework\/pushwoosh\/gettags(_:onfailure:)","n