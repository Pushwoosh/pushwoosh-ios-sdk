ontent":[{"type":"text","text":"The SDK fetches the flags when a session starts, every hour in foreground, after the first push"},{"type":"text","text":" "},{"type":"text","text":"registration and after a user id change, and keeps the last response on disk. "},{"code":"get","type":"codeVoice"},{"type":"text","text":" answers"},{"type":"text","text":" "},{"text":"synchronously from it and returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" until the first response, when the cache is older than","type":"text"},{"type":"text","text":" "},{"text":"24 hours, or while it belongs to another user id or application code. Within 5 minutes of the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"last request, "},{"type":"codeVoice","code":"refresh"},{"text":" completes from a valid cache without a request.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let flags = Pushwoosh.configure.featureFlags","if flags.isEnabled(\"new_checkout\", default: false) {","    showNewCheckout(color: flags.get(\"new_checkout\")?.string(forProperty: \"color\", default: nil))","} else {","    showOldCheckout()","}","flags.logImpression(\"new_checkout\")"]},{"inlineContent":[{"type":"text","text":"Update listeners are held weakly: keep a strong reference to the listener."}],"type":"paragraph"}]}],"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshCore":{"abstract":[],"type":"topic","title":"PushwooshCore","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshCore","kind":"symbol","role":"collection","url":"\/documentation\/pushwooshframework\/pushwooshcore"},"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshCore/PushwooshConfig/featureFlags":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"featureFlags"},{"text":"