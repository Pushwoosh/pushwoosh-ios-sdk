xt","text":" answers"},{"text":" ","type":"text"},{"type":"text","text":"synchronously from it and returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" until the first response, when the cache is older than"},{"type":"text","text":" "},{"type":"text","text":"24 hours, or while it belongs to another user id or application code. Within 5 minutes of the"},{"type":"text","text":" "},{"text":"last request, ","type":"text"},{"code":"refresh","type":"codeVoice"},{"type":"text","text":" completes from a valid cache without a request."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let flags = Pushwoosh.configure.featureFlags","if flags.isEnabled(\"new_checkout\", default: false) {","    showNewCheckout(color: flags.get(\"new_checkout\")?.string(forProperty: \"color\", default: nil))","} else {","    showOldCheckout()","}","flags.logImpression(\"new_checkout\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Update listeners are held weakly: keep a strong reference to the listener."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshCore","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshCore\/PushwooshConfig"]]},"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework":{"role":"collection","url":"\/documentation\/pushwooshframework","title":"PushwooshFramework","type":"topic","kind":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework","abstract":[{"type":"text","text":"Push notification SDK for iOS applications."}]},"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshCore/PushwooshConfig":{"kind":"symbol","title":"PushwooshConfig","abstract":[],"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshCore\/PushwooshConfig