{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh"]]},"abstract":[{"text":"Provides access to Rich Media presentation and color scheme configuration.","type":"text"}],"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/debug-swift.type.property","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/configure-swift.type.property"],"title":"Related Documentation"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"media"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PWMedia","preciseIdentifier":"c:objc(cs)PWMedia"},{"kind":"text","text":".Type { "},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Use this property to configure how Rich Media content is displayed. You can choose between modal presentation with customizable animations or legacy full-screen presentation."}],"type":"paragraph"},{"inlineContent":[{"text":"Available presentation styles:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".modal"},{"type":"text","text":" - Modal window with customizable position, animations, and swipe-to-dismiss"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".legacy"},{"type":"text","text":" - Legacy full-screen presentation"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Access style-specific configuration via ","type":"text"},{"code":"modalRichMedia","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"legacyRichMedia","type":"codeVoice"},{"type":"text","text":" sub-interfaces:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"Pushwoosh.media.modalRichMedia","type":"codeVoice"},{"text":" - Modal-specific settings (position, animations, corners, haptic feedback, delegate)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Pushwoosh.media.legacyRichMedia"},{"type":"text","text":" - Legacy-specific settings (delegate)"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The presentation style is persisted across app launches. If you remove the configuration from your code, it reverts to Info.plist settings on the next launch.","type":"text"}]},{"text":"Color scheme","level":3,"anchor":"Color-scheme","type":"heading"},{"inlineContent":[{"type":"text","text":"Rich Media content reads its theme through the "},{"type":"codeVoice","code":"prefers-color-scheme"},{"type":"text","text":" CSS media query. The color scheme setting controls which value the SDK reports; the SDK never recolors content, so a campaign without a dark variant stays light regardless of the setting."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".app"},{"type":"text","text":" - follows the interface style of your app UI (default)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".system"},{"type":"text","text":" - follows the device appearance setting, ignoring window- and controller-level overrides such as "},{"code":"preferredColorScheme(_:)","type":"codeVoice"},{"type":"text","text":". An app-wide "},{"type":"codeVoice","code":"UIUserInterfaceStyle"},{"text":" in Info.plist still applies, so with that key set ","type":"text"},{"type":"codeVoice","code":".system"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".app"},{"type":"text","text":" report the same style"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".light","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".dark","type":"codeVoice"},{"text":" - fixed scheme","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The value is persisted, takes precedence over Info.plist, and is read when a Rich Media is presented. The same options exist on Android, so both platforms render the same variant for the same setting.","type":"text"}]},{"type":"heading","anchor":"Example","text":"Example","level":2},{"type":"paragraph","inlineContent":[{"text":"Configure Rich Media with modal presentation style:","type":"text"}]},{"type":"codeListing","code":["func application(_ application: UIApplication,","                 didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    \/\/ Select modal presentation style","    Pushwoosh.media.setRichMediaPresentationStyle(.modal)","","    \/\/ Configure modal-specific settings","    Pushwoosh.media.modalRichMedia.configure(","        with: .PWModalWindowPositionBottom,","        present: .PWAnimationPresentSlideUp,","        dismiss: .PWAnimationDismissSlideDown","    )","    Pushwoosh.media.modalRichMedia.setDismissSwipeDirections([NSNumber(value: DismissSwipeDirection.PWSwipeDismissDown.rawValue)])","","    Pushwoosh.media.modalRichMedia.setCornerType([.PWCornerTypeTopLeft, .PWCornerTypeTopRight], withRadius: 16)","","    \/\/ Set delegate for Rich Media lifecycle events","    Pushwoosh.media.modalRichMedia.delegate = self","","    Pushwoosh.configure.registerForPushNotifications()","    return true","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure Rich Media with legacy presentation style:"}]},{"type":"codeListing","syntax":"swift","code":["func application(_ application: UIApplication,","                 didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    \/\/ Select legacy (full-screen) presentation style","    Pushwoosh.media.setRichMediaPresentationStyle(.legacy)","","    \/\/ Set delegate for Rich Media lifecycle events","    Pushwoosh.media.legacyRichMedia.delegate = self","","    Pushwoosh.configure.registerForPushNotifications()","    return true","}"]},{"inlineContent":[{"text":"Force a fixed color scheme, for example while dark campaign variants are not ready yet:","type":"text"}],"type":"paragraph"},{"code":["Pushwoosh.media.setRichMediaColorScheme(.light)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Configure via Info.plist instead of code:","type":"text"}]},{"inlineContent":[{"type":"text","text":"Add "},{"code":"Pushwoosh_RICH_MEDIA_STYLE","type":"codeVoice"},{"type":"text","text":" key with value "},{"code":"MODAL_RICH_MEDIA","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":"LEGACY_RICH_MEDIA"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"type":"codeVoice","code":"Pushwoosh_RICH_MEDIA_COLOR_SCHEME"},{"type":"text","text":" key with value "},{"type":"codeVoice","code":"APP"},{"type":"text","text":", "},{"type":"codeVoice","code":"SYSTEM"},{"type":"text","text":", "},{"type":"codeVoice","code":"LIGHT"},{"type":"text","text":" or "},{"type":"codeVoice","code":"DARK"},{"text":".","type":"text"}]},{"text":"Related API","level":2,"anchor":"Related-API","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PWMedia"},{"text":" and its sub-interfaces are documented in the PushwooshCore module:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Style: ","type":"text"},{"type":"codeVoice","code":"setRichMediaPresentationStyle(_:)"},{"type":"text","text":", "},{"code":"richMediaPresentationStyle()","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Color scheme: "},{"code":"setRichMediaColorScheme(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":"richMediaColorScheme()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PWRichMediaColorScheme","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Sub-interfaces: ","type":"text"},{"code":"modalRichMedia","type":"codeVoice"},{"text":", ","type":"text"},{"code":"legacyRichMedia","type":"codeVoice"}]}]}],"type":"unorderedList"}]}],"metadata":{"title":"media","externalID":"s:So9PushwooshC0A9FrameworkE5mediaSo7PWMediaCmvpZ","role":"symbol","modules":[{"name":"PushwooshFramework"}],"roleHeading":"Type Property","symbolKind":"property","extendedModule":"PushwooshFramework","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"media","kind":"identifier"},{"text":": ","kind":"text"},{"text":"PWMedia","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)PWMedia"},{"kind":"text","text":".Type"}]},"sections":[],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/media-swift.type.property","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshframework\/pushwoosh\/media-swift.type.property"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/Pushwoosh/media-swift.type.property":{"type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/media-swift.type.property","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"media"},{"text":": ","kind":"text"},{"text":"PWMedia","preciseIdentifier":"c:objc(cs)PWMedia","kind":"typeIdentifier"},{"text":".Type","k