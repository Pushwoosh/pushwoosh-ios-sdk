{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Stops communication with Pushwoosh server."}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/startServerCommunication()"],"title":"Related Documentation"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshframework\/pushwoosh\/stopservercommunication()"]},{"paths":["\/documentation\/pushwooshframework\/pushwoosh\/stopservercommunication()"],"traits":[{"interfaceLanguage":"occ"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stopServerCommunication","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":["iOS"],"languages":["swift"]}]},{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Temporarily disables all network communication with Pushwoosh servers. Use this for:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"GDPR compliance (user opts out of data collection)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Privacy-first onboarding (wait for user consent)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Offline mode support","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Debugging network issues"}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Behavior When Stopped","anchor":"Behavior-When-Stopped"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"No data is sent to Pushwoosh servers","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Tags and events are queued locally","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Push notifications can still be received (via APNs)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Queued data is sent when communication resumes"}]}]}],"type":"unorderedList"},{"type":"heading","text":"Example","anchor":"Example","level":2},{"inlineContent":[{"type":"text","text":"Implement GDPR-compliant data collection opt-out:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func handleGDPROptOut() {","    Pushwoosh.configure.stopServerCommunication()","","    userDefaults.set(false, forKey: \"analyticsEnabled\")","","    showConfirmation(\"Data collection disabled\")","}","","func handleGDPROptIn() {","    Pushwoosh.configure.startServerCommunication()","","    userDefaults.set(true, forKey: \"analyticsEnabled\")","}"]},{"inlineContent":[{"text":"Wait for privacy consent before enabling SDK:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    if !userDefaults.bool(forKey: \"privacyConsentGiven\") {","        Pushwoosh.configure.stopServerCommunication()","    }","","    return true","}","","func privacyConsentViewController(_ controller: PrivacyConsentViewController,","                                   didFinishWithConsent consent: Bool) {","    userDefaults.set(consent, forKey: \"privacyConsentGiven\")","","    if consent {","        Pushwoosh.configure.startServerCommunication()","        Pushwoosh.configure.registerForPushNotifications()","    }","}"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/stopServerCommunication()"},"m