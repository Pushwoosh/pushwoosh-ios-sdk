osh.configure.registerForPushNotifications { token, error in","            if let error = error {","                continuation.resume(throwing: error)","            } else {","                continuation.resume(returning: token)","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Show different UI based on result:"}]},{"code":["func requestPushPermission() {","    Pushwoosh.configure.registerForPushNotifications { token, error in","        DispatchQueue.main.async {","            if token != nil {","                self.showSuccessState()","            } else if let error = error as NSError?,","                      error.code == 3010 {","                self.showPermissionDeniedState()","            } else {","                self.showErrorState()","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh"]]},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/registerForPushNotifications(completion:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/pushwooshframework\/pushwoosh\/registerforpushnotifications(completion:)"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/pushwooshframework\/pushwoosh\/registerforpushnotifications(completion:)"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/Pushwoosh":{"role":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh","url":"\/documentation\/pushwooshframework\/pushwoosh","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"Pushwoosh","kind":"identifier"}]