]) {","    let completedTransactions = transactions.filter {","        $0.transactionState == .purchased || $0.transactionState == .restored","    }","","    if !completedTransactions.isEmpty {","        Pushwoosh.configure.sendSKPaymentTransactions(completedTransactions)","    }","}"],"type":"codeListing"}],"kind":"content"}],"deprecationSummary":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Since 7.3.0: Use Pushwoosh.configure.sendSKPaymentTransactions(_:) instead."}]}],"abstract":[{"type":"text","text":"Sends in-app purchase transactions to Pushwoosh."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework":{"role":"collection","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework","url":"\/documentation\/pushwooshframework","kind":"symbol","type":"topic","title":"PushwooshFramework","abstract":[{"type":"text","text":"Push notification SDK for iOS applications."}]},"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PWPurchaseDelegate":{"abstract":[{"type":"text","text":"Delegate protocol for handling in-app purchase events from rich media."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PWPurchaseDelegate"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PWPurchaseDelegate","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PWPurchaseDelegate"}],"kind":"symbol","url":"\/documentation\/pushwooshframework\/pwpurchasedelegate","type":"topic","title":"PWPurchaseDelegate"},"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/Pushwoosh":{"role":"symbol","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh","url":"\/documentation\/pushwooshframework\/pushwoosh","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":