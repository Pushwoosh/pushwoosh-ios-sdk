{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"c:objc(cs)Pushwoosh(py)additionalAuthorizationOptions","role":"symbol","platforms":[{"beta":false,"name":"iOS","introducedAt":"12.0","unavailable":false,"deprecated":false}],"title":"additionalAuthorizationOptions","modules":[{"name":"PushwooshFramework"}],"fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"additionalAuthorizationOptions","kind":"identifier"},{"kind":"text","text":": "},{"text":"UNAuthorizationOptions","kind":"typeIdentifier","preciseIdentifier":"c:@E@UNAuthorizationOptions"}],"symbolKind":"property","navigatorTitle":[{"text":"additionalAuthorizationOptions","kind":"identifier"}],"roleHeading":"Instance Property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"additionalAuthorizationOptions","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@E@UNAuthorizationOptions","text":"UNAuthorizationOptions","kind":"typeIdentifier"},{"kind":"text","text":" { "},{"text":"get","kind":"keyword"},{"kind":"text","text":" "},{"text":"set","kind":"keyword"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["iOS"]}]},{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the SDK calls "},{"type":"codeVoice","code":"registerForPushNotifications"},{"text":", it automatically requests these permissions:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".badge"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".sound"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".alert","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".carPlay"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"setAdditionalAuthorizationOptions"},{"type":"text","text":" to request extra capabilities on top of the defaults. The options are combined (bitwise OR) with the defaults before being passed to "},{"code":"UNUserNotificationCenter.requestAuthorization(options:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Available-Options","type":"heading","text":"Available Options","level":3},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Option","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"iOS","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".provisional"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"12+"}]}],[{"type":"paragraph","inlineContent":[{"text":"Deliver notifications quietly without showing a permission dialog. Users see them in Notification Center and decide whether to keep or disable.","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":".criticalAlert"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"12+","type":"text"}]}],[{"inlineContent":[{"text":"Bypass Do Not Disturb and the mute switch. Requires a special entitlement from Apple. For medical, health, safety, and public security apps.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".providesAppNotificationSettings"}],"type":"paragraph"}],[{"inlineContent":[{"text":"12+","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Adds a “Configure in App” button in the system notification settings. When tapped, iOS calls "},{"code":"userNotificationCenter(_:openSettingsFor:)","type":"codeVoice"},{"type":"text","text":" on your delegate."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".announcement","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"13+"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Allows Siri to read notifications aloud through AirPods and compatible headphones."}]}]]],"type":"table","header":"row"},{"level":2,"type":"heading","anchor":"Important","text":"Important"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"setAdditionalAuthorizationOptions","type":"codeVoice"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/registerForPushNotifications()","isActive":true,"type":"reference"},{"text":". Options set after registration have no effect until the next authorization request.","type":"text"}]},{"anchor":"Provisional-Soft-Opt-In","level":2,"text":"Provisional (Soft Opt-In)","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Deliver notifications silently without prompting the user for permission. This is useful to demonstrate value before asking for full notification access:","type":"text"}]},{"syntax":"swift","code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    if #available(iOS 12.0, *) {","        Pushwoosh.configure.setAdditionalAuthorizationOptions([.provisional])","    }","","    Pushwoosh.configure.registerForPushNotifications()","","    return true","}"],"type":"codeListing"},{"text":"In-App Notification Settings","level":2,"type":"heading","anchor":"In-App-Notification-Settings"},{"type":"paragraph","inlineContent":[{"text":"Add a “Configure in App” button to the system Settings > Notifications screen for your app. When the user taps it, implement the ","type":"text"},{"type":"codeVoice","code":"openSettingsFor"},{"type":"text","text":" callback to navigate to your custom settings screen:"}]},{"type":"codeListing","code"