{"abstract":[{"text":"Additional notification authorization options beyond the SDK defaults.","type":"text"}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/additionalAuthorizationOptions","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"additionalAuthorizationOptions","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"UNAuthorizationOptions","preciseIdentifier":"c:@E@UNAuthorizationOptions"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the SDK calls "},{"type":"codeVoice","code":"registerForPushNotifications"},{"text":", it automatically requests these permissions:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".badge"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".sound"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".alert","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":".carPlay","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Use "},{"code":"setAdditionalAuthorizationOptions","type":"codeVoice"},{"text":" to request extra capabilities on top of the defaults. The options are combined (bitwise OR) with the defaults before being passed to ","type":"text"},{"type":"codeVoice","code":"UNUserNotificationCenter.requestAuthorization(options:)"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Available Options","anchor":"Available-Options","type":"heading","level":3},{"rows":[[[{"inlineContent":[{"text":"Option","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".provisional"}],"type":"paragraph"}],[{"inlineContent":[{"text":"12+","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deliver notifications quietly without showing a permission dialog. Users see them in Notification Center and decide whether to keep or disable."}]}]],[[{"inlineContent":[{"type":"codeVoice","code":".criticalAlert"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"12+"}]}],[{"inlineContent":[{"type":"text","text":"Bypass Do Not Disturb and the mute switch. Requires a special entitlement from Apple. For medical, health, safety, and public security apps."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".providesAppNotificationSettings"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"12+"}]}],[{"type":"paragraph","inlineContent":[{"text":"Adds a “Configure in App” button in the system notification settings. When tapped, iOS calls ","type":"text"},{"code":"userNotificationCenter(_:openSettingsFor:)","type":"codeVoice"},{"text":" on your delegate.","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":".announcement"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"13+"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Allows Siri to read notifications aloud through AirPods and compatible headphones."}]}]]],"type":"table","header":"row"},{"anchor":"Important","level":2,"type":"heading","text":"Important"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"setAdditionalAuthorizationOptions"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" "},{"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/registerForPushNotifications()","type":"reference","isActive":true},{"type":"text","text":". Options set after registration have no effect until the next authorization request."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Provisional (Soft Opt-In)","anchor":"Provisional-Soft-Opt-In"},{"type":"paragraph","inlineContent":[{"text":"Deliver notifications silently without prompting the user for permission. This is useful to demonstrate value before asking for full notification access:","type":"text"}]},{"code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    Pushwoosh.configure.setAdditionalAuthorizationOptions([.provisional])","","    Pushwoosh.configure.registerForPushNotifications()","","    return true","}"],"syntax":"swift","type":"codeListing"},{"text":"In-App Notification Settings","type":"heading","anchor":"In-App-Notification-Settings","level":2},{"inlineContent":[{"text":"Add a “Configure in App” button to the system Settings > Notifications screen for your app. When the user taps it, implement the ","type":"text"},{"type":"codeVoice","code":"openSettingsFor"},{"type":"text","text":" callback to navigate to your custom settings screen:"}],"type":"paragraph"},{"code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    Pushwoosh.configure.setAdditionalAuthorizationOptions([.providesAppNotificationSettings])","","    Pushwoosh.configure.addNotificationCenterDelegate(self)","    Pushwoosh.configure.registerForPushNotifications()","","    return true","}","","\/\/ Called when user taps \"Configure in App\" in system notification settings","func userNotificationCenter(_ center: UNUserNotificationCenter,","                            openSettingsFor notification: UNNotification?) {","    \/\/ Navigate to your in-app notification settings screen","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Critical-Alerts","level":2,"type":"heading","text":"Critical Alerts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For medical, health, and safety apps that need to bypass Do Not Disturb and the mute switch. Requires a special entitlement approved by Apple:"}]},{"syntax":"swift","code":["Pushwoosh.configure.setAdditionalAuthorizationOptions([.criticalAlert])","","Pushwoosh.configure.registerForPushNotifications()"],"type":"codeListing"},{"level":2,"type":"heading","text":"Combining Multiple Options","anchor":"Combining-Multiple-Options"},{"inlineContent":[{"type":"text","text":"Options can be combined:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Pushwoosh.configure.setAdditionalAuthorizationOptions([.provisional, .providesAppNotificationSettings])"]},{"inlineContent":[{"text":"Objective-C:","type":"text"}],"type":"paragraph"},{"syntax":"objc","code":["[Pushwoosh.configure setAdditionalAuthorizationOptions:UNAuthorizationOptionProvisional | UNAuthorizationOptionProvidesAppNotificationSettings];","","[Pushwoosh.configure registerForPushNotifications];"],"type":"codeListing"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/registerForPushNotifications()"],"title":"Related Documentation"}],"variants":[{"paths":["\/documentation\/pushwooshframework\/pushwoosh\/additionalauthorizationoptions"],"traits":[{"interfaceLanguage":"swift"}]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshframework\/pushwoosh\/additionalauthorizationoptions"]}],"deprecationSummary":[{"inlineContent":[{"type":"text","text":"Since 7.3.0: Use Pushwoosh.configure.setAdditionalAuthorizationOptions(_:) and getAdditionalAuthori