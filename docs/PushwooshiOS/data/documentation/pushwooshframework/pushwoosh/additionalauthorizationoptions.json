ity apps."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".providesAppNotificationSettings","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"12+","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Adds a “Configure in App” button in the system notification settings. When tapped, iOS calls "},{"type":"codeVoice","code":"userNotificationCenter(_:openSettingsFor:)"},{"type":"text","text":" on your delegate."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".announcement","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"13+"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Allows Siri to read notifications aloud through AirPods and compatible headphones.","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"heading","text":"Important","anchor":"Important","level":2},{"inlineContent":[{"type":"text","text":"Call "},{"code":"setAdditionalAuthorizationOptions","type":"codeVoice"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/registerForPushNotifications()","isActive":true},{"type":"text","text":". Options set after registration have no effect until the next authorization request."}],"type":"paragraph"},{"text":"Provisional (Soft Opt-In)","level":2,"type":"heading","anchor":"Provisional-Soft-Opt-In"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deliver notifications silently without prompting the user for permission. This is useful to demonstrate value before asking for full notification access:"}]},{"code":["func application(_ application: UIApplication,","                didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","","    if #available(iOS 12.0, *) {","        Pushwoosh.configure.setAdditionalAutho