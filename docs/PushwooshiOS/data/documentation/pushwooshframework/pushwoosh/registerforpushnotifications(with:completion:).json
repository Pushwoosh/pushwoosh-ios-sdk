 = error {","            self.logger.error(\"Registration failed: \\(error.localizedDescription)\")","            self.analytics.track(\"push_registration_failed\")","            return","        }","","        self.logger.info(\"Push registration successful\")","        self.analytics.track(\"push_registration_success\", properties: [","            \"has_token\": token != nil","        ])","","        self.updateOnboardingProgress(.notificationsEnabled)","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"deprecationSummary":[{"inlineContent":[{"text":"Since 7.3.0: Use Pushwoosh.configure.registerForPushNotifications(with:completion:) instead.","type":"text"}],"type":"paragraph"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshframework\/pushwoosh\/registerforpushnotifications(with:completion:)"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshframework\/pushwoosh\/registerforpushnotifications(with:completion:)"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/registerForPushNotifications(with:)"],"title":"Related Documentation"}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/registerForPushNotifications(with:completion:)","interfaceLanguage":"swift"},"metadata":{"platforms":[],"externalID":"c:objc(cs)Pushwoosh(im)registerForPushNotificationsWith:completion:","title":"registerForPushNotifications(with:completion:)","navigatorTitle":[{"text":"registerForPushNotificationsWith:completion:","kind":"identifier"}],"modules":[{"name":"PushwooshFramework"}],"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","fra