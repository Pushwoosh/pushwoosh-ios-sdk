alizedDescription)\")","            self.analytics.track(\"push_registration_failed\")","            return","        }","","        self.logger.info(\"Push registration successful\")","        self.analytics.track(\"push_registration_success\", properties: [","            \"has_token\": token != nil","        ])","","        self.updateOnboardingProgress(.notificationsEnabled)","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"abstract":[{"type":"text","text":"Registers the device for push notifications with initial tags and a completion handler."}],"sections":[],"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/Pushwoosh/registerForPushNotifications(with:completion:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"registerForPushNotifications","kind":"identifier"},{"kind":"text","text":"("},{"text":"with","kind":"externalParam"},{"kind":"text","text":": ["},{"text":"AnyHashable","kind":"typeIdentifier","preciseIdentifier":"s:s11AnyHashableV"},{"text":" : ","kind":"text"},{"text":"Any","kind":"keyword"},{"text":"], ","kind":"text"},{"kind":"externalParam","text":"completion"},{"kind":"text","text":": "},{"text":"PushwooshRegistrationHandler","preciseIdentifier":"c:PWTypes.h@T@PushwooshRegistrationHandler","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","title":"registerForPushNotifications(with:completion:)","abstract":[{"text":"Registers the device for push notifications with initial tags and a completion handler.","type":"text"}],"url":"\/documentation\/pushwooshframework\/pushwoosh\/registerforpushnotifications(with:completion:)","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"registerForPushNotificationsWith:completion:"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/Pushwoosh\/registerForPushNotifications(with:completion:)"},"doc://com.pushwoosh.PushwooshiOS/documentation/Pushwoosh