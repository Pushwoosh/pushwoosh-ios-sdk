{"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework"]]},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshErrorHandler","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"Completion handler called when an operation fails."}],"metadata":{"modules":[{"name":"PushwooshFramework"}],"symbolKind":"typealias","roleHeading":"Type Alias","externalID":"c:PushNotificationManager.h@T@PushwooshErrorHandler","title":"PushwooshErrorHandler","fragments":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PushwooshErrorHandler"}],"navigatorTitle":[{"kind":"identifier","text":"PushwooshErrorHandler"}],"role":"symbol"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshGetTagsHandler"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PushwooshErrorHandler"},{"text":" = ((any ","kind":"text"},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"text":")?) -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"}],"platforms":["iOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This closure is called when a Pushwoosh operation fails, providing an error object describing what went wrong."}]},{"inlineContent":[{"text":"The handler receives an optional ","type":"text"},{"type":"codeVoice","code":"NSError"},{"text":" parameter. If the error is ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":", the operation succeeded (though typically success handlers use different callback types)."}],"type":"parag