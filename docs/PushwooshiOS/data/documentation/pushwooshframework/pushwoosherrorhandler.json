 error = error {","            self.logger.error(\"Failed to set tags: \\(error.localizedDescription)\")","","            if retryCount < 3 {","                DispatchQueue.main.asyncAfter(deadline: .now() + 2.0) {","                    self.setUserPreferences(preferences, retryCount: retryCount + 1)","                }","            } else {","                self.showAlert(title: \"Sync Error\", message: \"Could not save preferences. Please try again later.\")","            }","        }","    }","","    Pushwoosh.configure.setTags(preferences, onFailure: errorHandler)","}"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshframework\/pushwoosherrorhandler"]},{"paths":["\/documentation\/pushwooshframework\/pushwoosherrorhandler"],"traits":[{"interfaceLanguage":"occ"}]}],"kind":"symbol","metadata":{"navigatorTitle":[{"text":"PushwooshErrorHandler","kind":"identifier"}],"roleHeading":"Type Alias","externalID":"c:PushNotificationManager.h@T@PushwooshErrorHandler","role":"symbol","title":"PushwooshErrorHandler","symbolKind":"typealias","modules":[{"name":"PushwooshFramework"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"text":"PushwooshErrorHandler","kind":"identifier"}]},"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshRegistrationHandler":{"role":"symbol","abstract":[{"type":"text","text":"Completion handler called when push notification registration completes."}],"fragments":[{"kind":"identifier","text":"PushwooshRegistrationHandler"}],"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshRegistrationHandler","type":"topic","url":"\/documentation\/pushwooshframework\/pushwooshregistrationhandler","kind":"symbol","title":"PushwooshRegistrationHandler"},"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshErrorHandler":{"role":"symbol","abstract":[{"type":"text","text":"Completion hand