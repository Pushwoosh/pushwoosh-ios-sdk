)","}"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework"]]},"sections":[],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshErrorHandler","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshGetTagsHandler"],"title":"Related Documentation"}],"abstract":[{"type":"text","text":"Completion handler called when an operation fails."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshframework\/pushwoosherrorhandler"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshframework\/pushwoosherrorhandler"]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"PushwooshErrorHandler"}],"roleHeading":"Type Alias","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PushwooshErrorHandler"}],"externalID":"c:PushNotificationManager.h@T@PushwooshErrorHandler","role":"symbol","modules":[{"name":"PushwooshFramework"}],"title":"PushwooshErrorHandler","symbolKind":"typealias"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshGetTagsHandler":{"navigatorTitle":[{"text":"PushwooshGetTagsHandler","kind":"identifier"}],"url":"\/documentation\/pushwooshframework\/pushwooshgettagshandler","abstract":[{"text":"Completion handler called when tags are successfully retrieved from the server.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshGetTagsHandler","title":"PushwooshGetTagsHandler","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PushwooshGetTagsHandler"}]},"doc://com.pushwoosh.PushwooshiOS/do