 optional "},{"code":"NSError","type":"codeVoice"},{"type":"text","text":" parameter. If the error is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", the operation succeeded (though typically success handlers use different callback types)."}],"type":"paragraph"},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"inlineContent":[{"text":"Handle tag setting errors with retry logic:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func setUserPreferences(_ preferences: [String: Any], retryCount: Int = 0) {","    let errorHandler: PushwooshErrorHandler = { error in","        if let error = error {","            self.logger.error(\"Failed to set tags: \\(error.localizedDescription)\")","","            if retryCount < 3 {","                DispatchQueue.main.asyncAfter(deadline: .now() + 2.0) {","                    self.setUserPreferences(preferences, retryCount: retryCount + 1)","                }","            } else {","                self.showAlert(title: \"Sync Error\", message: \"Could not save preferences. Please try again later.\")","            }","        }","    }","","    Pushwoosh.configure.setTags(preferences, completion: errorHandler)","}"]}],"kind":"content"}],"sections":[],"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshErrorHandler":{"abstract":[{"type":"text","text":"Completion handler called when an operation fails."}],"type":"topic","title":"PushwooshErrorHandler","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshErrorHandler","kind":"symbol","navigatorTitle":[{"text":"PushwooshErrorHandler","kind":"identifier"}],"role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PushwooshErrorHandler"}],"url":"\/documentation\/pushwooshframework\/pushwoosherrorhandler"},"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/Pushwoosh