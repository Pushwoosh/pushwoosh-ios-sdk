","","            if retryCount < 3 {","                DispatchQueue.main.asyncAfter(deadline: .now() + 2.0) {","                    self.setUserPreferences(preferences, retryCount: retryCount + 1)","                }","            } else {","                self.showAlert(title: \"Sync Error\", message: \"Could not save preferences. Please try again later.\")","            }","        }","    }","","    Pushwoosh.configure.setTags(preferences, onFailure: errorHandler)","}"]}],"kind":"content"}],"abstract":[{"text":"Completion handler called when an operation fails.","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/pushwooshframework\/pushwoosherrorhandler"],"traits":[{"interfaceLanguage":"swift"}]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshframework\/pushwoosherrorhandler"]}],"metadata":{"symbolKind":"typealias","externalID":"c:PushNotificationManager.h@T@PushwooshErrorHandler","role":"symbol","title":"PushwooshErrorHandler","navigatorTitle":[{"text":"PushwooshErrorHandler","kind":"identifier"}],"modules":[{"name":"PushwooshFramework"}],"fragments":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"text":"PushwooshErrorHandler","kind":"identifier"}],"roleHeading":"Type Alias"},"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshRegistrationHandler":{"url":"\/documentation\/pushwooshframework\/pushwooshregistrationhandler","abstract":[{"type":"text","text":"Completion handler called when push notification registration completes."}],"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshRegistrationHandler","role":"symbol","kind":"symbol","fragments":[{"kind":"identifier","text":"PushwooshRegistrationHandler"}],"title":"PushwooshRegistrationHandler","type":"topic"},"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshGetTagsHandler":{"url":"\/documentation\/pushwooshframework\/pushwooshgettagshand