gatorTitle":[{"text":"PushwooshNotificationServiceExtension","kind":"identifier"}],"role":"symbol","symbolKind":"class","title":"PushwooshNotificationServiceExtension","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PushwooshNotificationServiceExtension"}]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PushwooshNotificationServiceExtension"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"Minimal integration — no code required beyond the subclass:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import PushwooshFramework","","class NotificationService: PushwooshNotificationServiceExtension {}"],"type":"codeListing"},{"inlineContent":[{"text":"Or point the extension’s Info.plist ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" at"},{"type":"text","text":" "},{"type":"codeVoice","code":"PushwooshNotificationServiceExtension"},{"type":"text","text":" directly and write no Swift\/Obj-C at all."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Requirements:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"Pushwoosh_APPID","type":"codeVoice"},{"type":"text","text":" in the main app Info.plist. You do not need to duplicate it in the extension"},{"text":" ","type":"text"},{"type":"text","text":"Info.plist — when missing there, Pushwoosh inherits it (and other "},{"code":"Pushwoosh_*","type":"codeVoice"},{"type":"text","text":" keys) from the"},{"text":" ","type":"text"},{"type":"text","text":"host app. Set it explicitly in the extension Info.plist only to override the host."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","co