ze the"},{"text":" ","type":"text"},{"type":"text","text":"content before it is shown: call "},{"type":"codeVoice","code":"super"},{"text":" with your own content handler, mutate the content","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"inside it, then forward to the original handler. Pushwoosh still runs the delivery event,"},{"type":"text","text":" "},{"type":"text","text":"badge, attachment and timeout fallback."}]},{"code":["override func didReceive(_ request: UNNotificationRequest,","                         withContentHandler contentHandler: @escaping (UNNotificationContent) -> Void) {","    super.didReceive(request) { content in","        let mutable = (content.mutableCopy() as? UNMutableNotificationContent) ?? content","        \/\/ customize `mutable` here","        contentHandler(mutable)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"For full control, skip "},{"type":"codeVoice","code":"super"},{"text":" and drive everything yourself (in that case send the delivery","type":"text"},{"type":"text","text":" "},{"text":"event via ","type":"text"},{"code":"PWNotificationExtensionManager","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}]}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework"]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshNotificationServiceExtension"},"references":{"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework":{"role":"collection","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework","url":"\/documentation\/pushwooshframework","kind":"symbol","type":"topic","title":"PushwooshFramework","abstract":[{"type":"text","text":"Push notification SDK for iOS applications."}]},"doc://com.pushwoosh.PushwooshiOS/s7CVarArgP":{"tit