{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Drop-in base class for a Notification Service Extension. Subclass it (or set it directly as","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the extension’s "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":") and Pushwoosh handles everything required for a"},{"text":" ","type":"text"},{"text":"push: sending the message delivery event, badge counting, downloading the media attachment,","type":"text"},{"type":"text","text":" "},{"text":"and the mandatory ","type":"text"},{"type":"codeVoice","code":"serviceExtensionTimeWillExpire"},{"type":"text","text":" fallback."}],"metadata":{"roleHeading":"Class","externalID":"c:objc(cs)PushwooshNotificationServiceExtension","modules":[{"name":"PushwooshFramework"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PushwooshNotificationServiceExtension"}],"platforms":[{"deprecated":false,"unavailable":false,"beta":false,"name":"iOS","introducedAt":"10.0"}],"symbolKind":"class","role":"symbol","title":"PushwooshNotificationServiceExtension","navigatorTitle":[{"text":"PushwooshNotificationServiceExtension","kind":"identifier"}]},"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshNotificationServiceExtension","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework"]]},"relationshipsSections":[{"title":"Inherits From","kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/objc(cs)UNNotificationServiceExtension"]},{"identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/objc(pl)NSObject","doc:\/\/com.pushwoosh.PushwooshiOS\/s7CVarArgP","doc:\/\/com.pushwoosh.PushwooshiOS\/s28CustomDebugStringConvertibleP","doc:\/\/com.pushwoosh.PushwooshiOS\/s23CustomStringConvertibleP","doc:\/\/com.pushwoosh.PushwooshiOS\/SQ","doc:\/\/com.pushwoosh.PushwooshiOS\/SH"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PushwooshNotificationServiceExtension"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Minimal integration — no code required beyond the subclass:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import PushwooshFramework","","class NotificationService: PushwooshNotificationServiceExtension {}"]},{"type":"paragraph","inlineContent":[{"text":"Or point the extension’s Info.plist ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" at"},{"type":"text","text":" "},{"type":"codeVoice","code":"PushwooshNotificationServiceExtension"},{"type":"text","text":" directly and write no Swift\/Obj-C at all."}]},{"type":"paragraph","inlineContent":[{"text":"Requirements:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Pushwoosh_APPID","type":"codeVoice"},{"type":"text","text":" in the main app Info.plist. You do not need to duplicate it in the extension"},{"type":"text","text":" "},{"text":"Info.plist — when missing there, Pushwoosh inherits it (and other ","type":"text"},{"code":"Pushwoosh_*","type":"codeVoice"},{"type":"text","text":" keys) from the"},{"text":" ","type":"text"},{"type":"text","text":"host app. Set it explicitly in the extension Info.plist only to override the host."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"mutable-content: 1"},{"type":"text","text":" in the push payload (so the extension is invoked)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"App Group shared between the app and the extension for badge \/ reverse-proxy sync","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(set "},{"type":"codeVoice","code":"PW_APP_GROUPS_NAME"},{"type":"text","text":" in Info.plist or override "},{"code":"pushwooshAppGroupsName","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Note: if the host app uses a reverse proxy ("},{"type":"codeVoice","code":"Pushwoosh_ALLOW_REVERSE_PROXY"},{"type":"text","text":"), the extension"},{"type":"text","text":" "},{"type":"text","text":"needs this App Group to read the proxy URL the app stored there — otherwise the delivery event"},{"type":"text","text":" "},{"type":"text","text":"is held back (it will not bypass the proxy). Add the App Group capability to the extension target."}]}]}]},{"inlineContent":[{"text":"Customization, from least to most control:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Override ","type":"text"},{"code":"pushwooshAppGroupsName","type":"codeVoice"},{"type":"text","text":" to set the App Group programmatically."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Override ","type":"text"},{"type":"codeVoice","code":"pushwooshPrepareForRequest:completion:"},{"text":" to run async preparation before processing","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(e.g. Push Stories media prefetch) without touching the standard "},{"type":"codeVoice","code":"didReceive"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Override the standard ","type":"text"},{"type":"codeVoice","code":"didReceiveNotificationRequest:withContentHandler:"},{"text":" to customize the","type":"text"},{"text":" ","type":"text"},{"text":"content before it is shown: call ","type":"text"},{"code":"super","type":"codeVoice"},{"type":"text","text":" with your own content handler, mutate the content"},{"type":"text","text":" "},{"type":"text","text":"inside it, then forward to the original handler. Pushwoosh still runs the delivery event,"},{"type":"text","text":" "},{"text":"badge, attachment and timeout fallback.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["override func didReceive(_ request: UNNotificationRequest,","                         withContentHandler contentHandler: @escaping (UNNotificationContent) -> Void) {","    super.didReceive(request) { content in","        let mutable = (content.mutableCopy() as? UNMutableNotificationContent) ?? content","        \/\/ customize `mutable` here","        contentHandler(mutable)","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"For full control, skip "},{"type":"codeVoice","code":"super"},{"text":" and drive everything yourself (in that case send the delivery","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"event via "},{"type":"codeVoice","code":"PWNotificationExtensionManager"},{"type":"text","text":")."}],"type":"paragraph"}]}]}]}],"variants":[{"paths":["\/documentation\/pushwooshframework\/pushwooshnotificationserviceextension"],"traits":[{"interfaceLanguage":"swift"}]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/pushwooshframework\/pushwooshnotificationserviceextension"]}],"sections":[],"topicSections":[{"title":"Instance Methods","identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshNotificationServiceExtension\/pushwooshAppGroupsName()","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshNotificationServiceExtension\/pushwooshPrepare(for:completion:)"]}],"references":{"doc://com.pushwoosh.PushwooshiOS/objc(pl)NSObject":{"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/objc(pl)NSObject","title":"ObjectiveC.NSObjectProtocol","type":"unresolvable"},"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshNotificationServiceExtension/pushwooshAppGroupsName