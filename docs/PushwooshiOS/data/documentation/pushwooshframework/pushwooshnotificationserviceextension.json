ad (so the extension is invoked).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"App Group shared between the app and the extension for badge \/ reverse-proxy sync"},{"type":"text","text":" "},{"type":"text","text":"(set "},{"code":"PW_APP_GROUPS_NAME","type":"codeVoice"},{"type":"text","text":" in Info.plist or override "},{"type":"codeVoice","code":"pushwooshAppGroupsName"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Note: if the host app uses a reverse proxy ("},{"code":"Pushwoosh_ALLOW_REVERSE_PROXY","type":"codeVoice"},{"type":"text","text":"), the extension"},{"type":"text","text":" "},{"type":"text","text":"needs this App Group to read the proxy URL the app stored there — otherwise the delivery event"},{"text":" ","type":"text"},{"type":"text","text":"is held back (it will not bypass the proxy). Add the App Group capability to the extension target."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Customization, from least to most control:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Override ","type":"text"},{"code":"pushwooshAppGroupsName","type":"codeVoice"},{"text":" to set the App Group programmatically.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Override "},{"type":"codeVoice","code":"pushwooshPrepareForRequest:completion:"},{"type":"text","text":" to run async preparation before processing"},{"type":"text","text":" "},{"type":"text","text":"(e.g. Push Stories media prefetch) without touching the standard "},{"type":"codeVoice","code":"didReceive"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Override the standard "},{"code":"didReceiveNotificationRequest:withContentHandler:","type":"codeVoice"},{"text":" to customize the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"content before it is shown: call "},{"code":"super","type":"codeVoice"},{"type":"text","text":" with your own content handler, mutate the content"},{"type":"text","text":" "},{"text":"inside it, then forward to the original handler. Pushwoosh still runs the delivery event,","type":"text"},{"type":"text","text":" "},{"text":"badge, attachment and timeout fallback.","type":"text"}]},{"code":["override func didReceive(_ request: UNNotificationRequest,","                         withContentHandler contentHandler: @escaping (UNNotificationContent) -> Void) {","    super.didReceive(request) { content in","        let mutable = (content.mutableCopy() as? UNMutableNotificationContent) ?? content","        \/\/ customize `mutable` here","        contentHandler(mutable)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"For full control, skip ","type":"text"},{"type":"codeVoice","code":"super"},{"text":" and drive everything yourself (in that case send the delivery","type":"text"},{"text":" ","type":"text"},{"text":"event via ","type":"text"},{"type":"codeVoice","code":"PWNotificationExtensionManager"},{"type":"text","text":")."}],"type":"paragraph"}]}]}]}],"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshNotificationServiceExtension","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Drop-in base class for a Notification Service Extension. Subclass it (or set it directly as"},{"text":" ","type":"text"},{"type":"text","text":"the extension’s "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":") and Pushwoosh handles everything required for a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"push: sending the message delivery event, badge counting, downloading the media attachment,"},{"type":"text","text":" "},{"text":"and the mandatory ","type":"text"},{"type":"codeVoice","