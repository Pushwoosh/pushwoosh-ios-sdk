.pushwoosh.PushwooshiOS\/SH"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Drop-in base class for a Notification Service Extension. Subclass it (or set it directly as","type":"text"},{"text":" ","type":"text"},{"text":"the extension’s ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":") and Pushwoosh handles everything required for a","type":"text"},{"text":" ","type":"text"},{"text":"push: sending the message delivery event, badge counting, downloading the media attachment,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and the mandatory "},{"code":"serviceExtensionTimeWillExpire","type":"codeVoice"},{"type":"text","text":" fallback."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"PushwooshNotificationServiceExtension","kind":"identifier"}],"languages":["swift"],"platforms":["iOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Minimal integration — no code required beyond the subclass:","type":"text"}]},{"syntax":"swift","code":["import PushwooshFramework","","class NotificationService: PushwooshNotificationServiceExtension {}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or point the extension’s Info.plist "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" at","type":"text"},{"type":"text","text":" "},{"code":"PushwooshNotificationServiceExtension","type":"codeVoice"},{"text":" directly and write no Swift\/Obj-C at all.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Requirements:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Pushwoosh_APPID"},{"text":" in the main app Info.plist. You do not need to duplicate it in the extension","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Info.plist — when missing there, Pushwoosh inherits it (and other "},{"code":"Pushwoosh_*","type":"codeVoice"},{"text":" keys) from the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"host app. Set it explicitly in the extension Info.plist only to override the host."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"mutable-content: 1"},{"type":"text","text":" in the push payload (so the extension is invoked)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"App Group shared between the app and the extension for badge \/ reverse-proxy sync","type":"text"},{"text":" ","type":"text"},{"text":"(set ","type":"text"},{"type":"codeVoice","code":"PW_APP_GROUPS_NAME"},{"type":"text","text":" in Info.plist or override "},{"code":"pushwooshAppGroupsName","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Note: if the host app uses a reverse proxy ("},{"type":"codeVoice","code":"Pushwoosh_ALLOW_REVERSE_PROXY"},{"text":"), the extension","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"needs this App Group to read the proxy URL the app stored there — otherwise the delivery event"},{"text":" ","type":"text"},{"text":"is held back (it will not bypass the proxy). Add the App Group capability to the extension target.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Customization, from least to most control:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Override ","type":"text"},{"code":"pushwooshAppGroupsName","type":"codeVoice"},{"type":"text","text":" to set the App Group programmatically."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Override "},{"type":"codeVoice","code":"pushwooshPrepareForRequest:completion:"},{"text":" to run async preparation before processing","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(e.g. Push Stories media prefetch) without touching the standard "},{"type":"codeVoice","code":"didReceive"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Override the standard "},{"code":"didReceiveNotificationRequest:withContentHandler:","type":"codeVoice"},{"type":"text","text":" to customize the"},{"type":"text","text":" "},{"type":"text","text":"content before it is shown: call "},{"type":"codeVoice","code":"super"},{"text":" with your own content handler, mutate the content","type":"text"},{"text":" ","type":"text"},{"text":"inside it, then forward to the original handler. Pushwoosh still runs the delivery event,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"badge, attachment and timeout fallback."}],"type":"paragraph"},{"code":["override func didReceive(_ request: UNNotificationRequest,","                         withContentHandler contentHandler: @escaping (UNNotificationContent) -> Void) {","    super.didReceive(request) { content in","        let mutable = (content.mutableCopy() as? UNMutableNotificationContent) ?? content","        \/\/ customize `mutable` here","        contentHandler(mutable)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For full control, skip ","type":"text"},{"type":"codeVoice","code":"super"},{"text":" and drive everything yourself (in that case send the delivery","type":"text"},{"type":"text","text":" "},{"type":"text","text":"event via "},{"type":"codeVoice","code":"PWNotificationExtensionManager"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"kind":"symbol","sections":[],"references":{"doc://com.pushwoosh.PushwooshiOS/objc(pl)NSObject":{"identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/objc(pl)NSObject","title":"ObjectiveC.NSObjectProtocol","type":"unresolvable"},"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework":{"role":"collection","url":"\/documentation\/pushwooshframe