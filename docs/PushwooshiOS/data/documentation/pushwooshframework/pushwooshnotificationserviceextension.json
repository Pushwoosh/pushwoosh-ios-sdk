{"identifier":{"url":"doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshNotificationServiceExtension","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/pushwooshframework\/pushwooshnotificationserviceextension"]},{"paths":["\/documentation\/pushwooshframework\/pushwooshnotificationserviceextension"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"Drop-in base class for a Notification Service Extension. Subclass it (or set it directly as"},{"type":"text","text":" "},{"type":"text","text":"the extension’s "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":") and Pushwoosh handles everything required for a"},{"type":"text","text":" "},{"type":"text","text":"push: sending the message delivery event, badge counting, downloading the media attachment,"},{"text":" ","type":"text"},{"type":"text","text":"and the mandatory "},{"type":"codeVoice","code":"serviceExtensionTimeWillExpire"},{"type":"text","text":" fallback."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/objc(cs)UNNotificationServiceExtension"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"},{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/objc(pl)NSObject","doc:\/\/com.pushwoosh.PushwooshiOS\/s7CVarArgP","doc:\/\/com.pushwoosh.PushwooshiOS\/s28CustomDebugStringConvertibleP","doc:\/\/com.pushwoosh.PushwooshiOS\/s23CustomStringConvertibleP","doc:\/\/com.pushwoosh.PushwooshiOS\/SQ","doc:\/\/com.pushwoosh.PushwooshiOS\/SH"]}],"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"PushwooshNotificationServiceExtension","kind":"identifier"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Minimal integration — no code required beyond the subclass:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import PushwooshFramework","","class NotificationService: PushwooshNotificationServiceExtension {}"]},{"type":"paragraph","inlineContent":[{"text":"Or point the extension’s Info.plist ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" at"},{"type":"text","text":" "},{"type":"codeVoice","code":"PushwooshNotificationServiceExtension"},{"text":" directly and write no Swift\/Obj-C at all.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Requirements:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Pushwoosh_APPID"},{"type":"text","text":" in the main app Info.plist. You do not need to duplicate it in the extension"},{"type":"text","text":" "},{"type":"text","text":"Info.plist — when missing there, Pushwoosh inherits it (and other "},{"type":"codeVoice","code":"Pushwoosh_*"},{"type":"text","text":" keys) from the"},{"type":"text","text":" "},{"text":"host app. Set it explicitly in the extension Info.plist only to override the host.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"mutable-content: 1","type":"codeVoice"},{"text":" in the push payload (so the extension is invoked).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"App Group shared between the app and the extension for badge \/ reverse-proxy sync"},{"type":"text","text":" "},{"text":"(set ","type":"text"},{"type":"codeVoice","code":"PW_APP_GROUPS_NAME"},{"text":" in Info.plist or override ","type":"text"},{"type":"codeVoice","code":"pushwooshAppGroupsName"},{"type":"text","text":")."},{"text":" ","type":"text"},{"type":"text","text":"Note: if the host app uses a reverse proxy ("},{"type":"codeVoice","code":"Pushwoosh_ALLOW_REVERSE_PROXY"},{"text":"), the extension","type":"text"},{"text":" ","type":"text"},{"text":"needs this App Group to read the proxy URL the app stored there — otherwise the delivery event","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is held back (it will not bypass the proxy). Add the App Group capability to the extension target."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Customization, from least to most control:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Override ","type":"text"},{"code":"pushwooshAppGroupsName","type":"codeVoice"},{"type":"text","text":" to set the App Group programmatically."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Override "},{"code":"pushwooshPrepareForRequest:completion:","type":"codeVoice"},{"text":" to run async preparation before processing","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(e.g. Push Stories media prefetch) without touching the standard "},{"type":"codeVoice","code":"didReceive"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Override the standard "},{"type":"codeVoice","code":"didReceiveNotificationRequest:withContentHandler:"},{"text":" to customize the","type":"text"},{"text":" ","type":"text"},{"text":"content before it is shown: call ","type":"text"},{"type":"codeVoice","code":"super"},{"type":"text","text":" with your own content handler, mutate the content"},{"type":"text","text":" "},{"text":"inside it, then forward to the original handler. Pushwoosh still runs the delivery event,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"badge, attachment and timeout fallback."}],"type":"paragraph"},{"syntax":"swift","code":["override func didReceive(_ request: UNNotificationRequest,","                         withContentHandler contentHandler: @escaping (UNNotificationContent) -> Void) {","    super.didReceive(request) { content in","        let mutable = (content.mutableCopy() as? UNMutableNotificationContent) ?? content","        \/\/ customize `mutable` here","        contentHandler(mutable)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"For full control, skip ","type":"text"},{"type":"codeVoice","code":"super"},{"text":" and drive everything yourself (in that case send the delivery","type":"text"},{"type":"text","text":" "},{"text":"event via ","type":"text"},{"type":"codeVoice","code":"PWNotificationExtensionManager"},{"type":"text","text":")."}]}]}]}]}],"hierarchy":{"paths":[["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework"]]},"metadata":{"title":"PushwooshNotificationServiceExtension","platforms":[{"introducedAt":"10.0","name":"iOS","deprecated":false,"unavailable":false,"beta":false}],"modules":[{"name":"PushwooshFramework"}],"symbolKind":"class","navigatorTitle":[{"text":"PushwooshNotificationServiceExtension","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PushwooshNotificationServiceExtension"}],"roleHeading":"Class","externalID":"c:objc(cs)PushwooshNotificationServiceExtension","role":"symbol"},"topicSections":[{"title":"Instance Methods","identifiers":["doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshNotificationServiceExtension\/pushwooshAppGroupsName()","doc:\/\/com.pushwoosh.PushwooshiOS\/documentation\/PushwooshFramework\/PushwooshNotificationServiceExtension\/pushwooshPrepare(for:completion:)"]}],"references":{"doc://com.pushwoosh.PushwooshiOS/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/com.pushwoosh.PushwooshiOS\/SH"},"doc://com.pushwoosh.PushwooshiOS/documentation/PushwooshFramework/PushwooshNotificationServiceExtension":{"role":"symbol","abstract":[{"type":"text","text":"Drop-in ba