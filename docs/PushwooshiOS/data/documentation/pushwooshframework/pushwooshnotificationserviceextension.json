:"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"mutable-content: 1","type":"codeVoice"},{"text":" in the push payload (so the extension is invoked).","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"App Group shared between the app and the extension for badge \/ reverse-proxy sync","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(set "},{"code":"PW_APP_GROUPS_NAME","type":"codeVoice"},{"type":"text","text":" in Info.plist or override "},{"type":"codeVoice","code":"pushwooshAppGroupsName"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"Note: if the host app uses a reverse proxy (","type":"text"},{"type":"codeVoice","code":"Pushwoosh_ALLOW_REVERSE_PROXY"},{"text":"), the extension","type":"text"},{"type":"text","text":" "},{"text":"needs this App Group to read the proxy URL the app stored there — otherwise the delivery event","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is held back (it will not bypass the proxy). Add the App Group capability to the extension target."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Customization, from least to most control:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Override "},{"code":"pushwooshAppGroupsName","type":"codeVoice"},{"type":"text","text":" to set the App Group programmatically."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Override "},{"code":"pushwooshPrepareForRequest:completion:","type":"codeVoice"},{"type":"text","text":" to run async preparation before processing"},{"type":"text","text":" "},{"text":"(e.g. Push Stories media prefetch) without touching the standard ","type":"text"},{"code":"didReceive","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Override the standard "},{"type":"codeVoice","code":"d