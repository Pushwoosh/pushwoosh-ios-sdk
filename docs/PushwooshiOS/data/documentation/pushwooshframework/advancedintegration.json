Handler();","    }","}"],"type":"codeListing","syntax":"objc"}],"title":"Objective-C"}]},{"level":2,"text":"Lazy Initialization","type":"heading","anchor":"Lazy-Initialization"},{"inlineContent":[{"text":"By default, the Pushwoosh SDK initializes automatically when the app launches. Lazy initialization allows you to delay SDK startup until explicitly called.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This is useful when:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"You need to obtain user consent before initializing the SDK","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You want conditional initialization based on user preferences"}]}]},{"content":[{"inlineContent":[{"text":"You need to configure settings before SDK starts","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Enable Lazy Initialization","level":3,"type":"heading","anchor":"Enable-Lazy-Initialization"},{"inlineContent":[{"type":"text","text":"Add the following key to your "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"xml","type":"codeListing","code":["<key>Pushwoosh_LAZY_INITIALIZATION<\/key>","<true\/>"]},{"inlineContent":[{"type":"text","text":"With this flag enabled, the SDK will not start automatically. Services will only activate when you explicitly call Pushwoosh SDK methods, such as:"}],"type":"paragraph"},{"type":"tabNavigator","tabs":[{"title":"Swift","content":[{"type":"codeListing","syntax":"swift","code":["Pushwoosh.configure.registerForPushNotifications()"]}]},{"content":[{"syntax":"objc","type":"codeListing","code":["[Pushwoosh.configure registerForPushNotifications];"]}],"title":"Objective-C"}]},{"text":"Info.plist Configuration Properties","level":2,"anchor":"Infoplist-Configuration-Properties","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The SDK supports multiple con